index 00000000..d7e1f03d
--- /dev/null
+++ b/packages/brumate/src/runtime/client/waits.ts
@@ -0,0 +1,169 @@
+// SPIKE (browser-await-spike, option 3): a render that the compiler splits at `await $memo`, and
+// the `#loading` boundary that the browser shows while such a render waits. Throwaway code.
+
+import { clear, rendered } from './blocks.ts';
+import { fail } from './errors.ts';
+import { insertHTML, parseHTML } from './insert.ts';
+import type { ScopeId } from '../shared.ts';
+import { afterInsert, resolveScope } from './scopes.ts';
+import { scopes } from './state.ts';
+import type { Scope } from './state.ts';
+import { isThenable } from './updates.ts';
+
+/** A `#loading` body that the browser renders: the waits in it that have not settled. */
+interface Boundary {
+  n: number;
+  done?: () => void;
+}
+
+/** The `#loading` boundary of the render that runs, if any. */
+let boundary: Boundary | undefined;
+
+function toFragment(out: string | DocumentFragment, near?: Node): DocumentFragment {
+  return typeof out === 'string' ? parseHTML(out, near) : out;
+}
+
+/**
+ * The rest of a render after `await $memo`. A settled value goes on now, in the same render.
+ * A promise leaves a range of two comments, which the rest fills when the promise settles.
+ */
+export function wait(
+  id: ScopeId,
+  value: unknown,
+  then: (value: unknown) => string | DocumentFragment,
+): string | DocumentFragment {
+  if (!isThenable(value)) {
+    return then(value);
+  }
+  const scope = resolveScope(id)!;
+  // A start that `MARKER` counts, so `rangeEnd` pairs it with its end and a block that closes
+  // removes the whole range.
+  const start = document.createComment(`l${scope.id}w`);
+  const end = document.createComment('/w');
+  const range = document.createDocumentFragment();
+  range.append(start, end);
+  // The scope has no slots until the rest runs, so no insert runs its memos. The rest sets the
+  // settled value, so its memo has nothing to load.
+  const index = rendered.indexOf(scope);
+  if (index !== -1) {
+    rendered.splice(index, 1);
+  }
+  const own = boundary;
+  if (own) {
+    own.n++;
+  }
+  Promise.resolve(value).then(
+    (result) => {
+      // The block around the component removed it while it waited, or the page went.
+      if (scopes.get(scope.id) !== scope || !end.parentNode) {
+        return;
+      }
+      const outer = boundary;
+      boundary = own;
+      let out: string | DocumentFragment;
+      try {
+        out = then(result);
+      } finally {
+        boundary = outer;
+      }
+      insertHTML(end, out);
+      if (own && --own.n === 0) {
+        own.done?.();
+      }
+    },
+    (error) => fail(scope, error),
+  );
+  return range;
+}
+
+/**
+ * A `#loading` block in markup that the browser renders. The body renders first. When nothing
+ * in it waits, it shows at once. Otherwise the fallback shows until every wait in the body
+ * settles, and the body, which filled its ranges meanwhile, takes its place.
+ */
+export function loading(
+  body: () => string | DocumentFragment,
+  fallback: () => string | DocumentFragment,
+  row?: Scope,
+): string | DocumentFragment {
+  const outer = boundary;
+  const own: Boundary = { n: 0 };
+  boundary = own;
+  let out: string | DocumentFragment;
+  try {
+    out = body();
+  } finally {
+    boundary = outer;
+  }
+  if (own.n === 0) {
+    return out;
+  }
+  // The scopes and the work of the body wait with it, so the insert of the fallback does not
+  // take them.
+  const work = take();
+  // A row of a list that waits keeps an item marker, so the next update of the list finds it.
+  let item: Scope | undefined;
+  for (const made of work[0]) {
+    if (row && made.p === row) {
+      item ??= made;
+    }
+  }
+  const start = document.createComment(item ? `i${item.id}` : 'l0b');
+  const end = document.createComment(item ? '/i' : '/l');
+  const shown = document.createDocumentFragment();
+  shown.append(start, toFragment(fallback(), start), end);
+  own.done = () => {
+    // The block around it closed while the fallback showed.
+    if (!end.parentNode) {
+      return;
+    }
+    clear(start, end);
+    give(work);
+    insertHTML(end, out);
+  };
+  return shown;
+}
+
+/** The scopes that renders made, and the work that waits for their insert. */
+type Work = [Scope[], (() => void)[]];
+
+function take(): Work {
+  return [rendered.splice(0), afterInsert.splice(0)];
+}
+
+function give([made, queued]: Work): void {
+  rendered.push(...made);
+  afterInsert.push(...queued);
+}
+
+/**
+ * The root boundary, for a body that a block outside every `#loading` renders on an update.
+ * `show` runs at once when nothing in the body waits. Otherwise the block keeps what it shows,
+ * and `show` runs when the last wait settles, unless `stale` says the block moved on.
+ */
+export function hold(
+  render: () => string | DocumentFragment,
+  show: (out: string | DocumentFragment) => void,
+  stale: () => boolean,
+): void {
+  const outer = boundary;
+  const own: Boundary = { n: 0 };
+  boundary = own;
+  let out: string | DocumentFragment;
+  try {
+    out = render();
+  } finally {
+    boundary = outer;
+  }
+  if (own.n === 0) {
+    show(out);
+    return;
+  }
+  const work = take();
+  own.done = () => {
+    if (!stale()) {
+      give(work);
+      show(out);
+    }
+  };
+}
diff --git a/packages/brumate/test/_spike/await.test.ts b/packages/brumate/test/_spike/await.test.ts
new file mode 100644
index 00000000..fd4dabda
--- /dev/null
+++ b/packages/brumate/test/_spike/await.test.ts
@@ -0,0 +1,250 @@
+// @vitest-environment happy-dom
+// SPIKE (browser-await-spike, option 3). Compiles the fixtures of the spike, applies by hand what
+// the compiler would emit for a render split at `await $memo` and for a `#loading` block in a
+// browser render, and runs them on the real client runtime. Throwaway code.
+import { copyFileSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { afterEach, beforeAll, describe, expect, it, vi } from 'vitest';
+import { analyzeProject, compile } from '../../src/index.ts';
+import { render as renderParts } from '../../src/runtime/server.ts';
+
+const input = resolve(
+  import.meta.dirname,
+  '../../../../docs/roadmaps/brumate/nodes/browser-await-spike/prototype',
+);
+const output = resolve(import.meta.dirname, '../.output/spike-await');
+const file = (name: string): string => pathToFileURL(join(output, name)).href;
+const modules = new Map<string, string>();
+
+function toRender(code: string): string {
+  return code
+    .replace(/\.brm\?brumate-render"/g, '.brm.render.ts"')
+    .replace(/\.brm\?brumate-client&part=(\w+)"/g, '.brm.client.$1.ts"')
+    .replace(/\.brm\?brumate-client"/g, '.brm.client.ts"');
+}
+
+/**
+ * Option 3 in the render module: each `const x = (...)` of an awaited memo becomes
+ * `return $$b.wait($$s1, $$wN = (...), (x) => {`, and the rest of the render goes in the arrow.
+ * The rest sets the settled value in the slot of the memo.
+ */
+function splitAtAwaits(code: string, names: string[]): string {
+  let closes = 0;
+  for (const [index, name] of names.entries()) {
+    const declaration = new RegExp(`\\n(\\s*)const ${name} = \\((.*)\\);\\n`);
+    code = code.replace(
+      declaration,
+      `\n$1let $$$$w${index};\n$1return $$$$b.wait($$$$s1, $$$$w${index} = ($2), (${name}) => {\n`,
+    );
+    closes++;
+  }
+  return code.replace(
+    /\n {2}return \$\$f;\n\}/,
+    () => `\n  return $$f;\n${'  });\n'.repeat(closes)}}`,
+  );
+}
+
+/** A `#loading` block in a browser render: the body of `r2`, with the fallback of the block. */
+function wrapLoading(code: string, fallback: string): string {
+  return code.replace(
+    /export function r2\(\$\$p\) \{\n([\s\S]*?)\n {2}return \$\$f;\n\}/,
+    (_, body: string) =>
+      // A function, so `$$` stays as it is.
+      `export function r2($$p) {\n  return $$b.loading(() => {\n${body}\n  return $$f;\n  }, () => ${JSON.stringify(fallback)});\n}`,
+  );
+}
+
+beforeAll(() => {
+  rmSync(output, { recursive: true, force: true });
+  mkdirSync(output, { recursive: true });
+  const sources = new Map<string, string>();
+  for (const name of readdirSync(input)) {
+    if (name.endsWith('.brm')) {
+      sources.set(name, readFileSync(join(input, name), 'utf8'));
+    } else {
+      copyFileSync(join(input, name), join(output, name));
+    }
+  }
+  const liveProps = analyzeProject(sources);
+  for (const [name, source] of sources) {
+    const { server, client, parts, render, plan } = compile(source, {
+      filename: name,
+      liveProps: liveProps.get(name),
+      path: join(input, name),
+    });
+    for (const [part, code] of Object.entries(parts)) {
+      const patched =
+        name === 'WithLoading.brm' ? wrapLoading(code, '<p class="wait">wait</p>') : code;
+      writeFileSync(join(output, `${name}.client.${part}.ts`), toRender(patched));
+    }
+    writeFileSync(join(output, `${name}.ts`), server.replace(/\.brm'/g, ".brm.ts'"));
+    writeFileSync(join(output, `${name}.client.ts`), toRender(client));
+    const split = name === 'User.brm' ? splitAtAwaits(render, ['user']) : render;
+    writeFileSync(join(output, `${name}.render.ts`), toRender(split));
+    modules.set(plan.id, file(`${name}.client.ts`));
+  }
+});
+
+let stop: (() => void) | undefined;
+
+afterEach(() => {
+  stop?.();
+  document.body.innerHTML = '';
+  (globalThis as { loads?: number[] }).loads = [];
+});
+
+/** `rootWait` sets the spike's feature flag before the core loads again. */
+async function resume(name: string, rootWait = false): Promise<void> {
+  (globalThis as { __BRUMATE_HAS_ROOT_WAIT__?: boolean }).__BRUMATE_HAS_ROOT_WAIT__ = rootWait;
+  const server = await import(file(`${name}.brm.ts`));
+  const { html, state } = await renderParts(server.default, {});
+  document.body.innerHTML = html + state;
+  for (const script of document.body.querySelectorAll('script[b-state]')) {
+    Object.defineProperty(document, 'currentScript', { configurable: true, value: script });
+    // oxlint-disable-next-line no-eval -- The state record of the page.
+    (0, eval)(script.textContent!);
+    delete (document as { currentScript?: unknown }).currentScript;
+  }
+  vi.resetModules();
+  const { start } = await import('../../src/runtime/loader.ts');
+  stop = start({ load: async (id) => import(modules.get(id)!) });
+}
+
+function click(selector: string): void {
+  document.querySelector(selector)!.dispatchEvent(new Event('click', { bubbles: true }));
+}
+
+function waitFor(assertion: () => void): Promise<void> {
+  return vi.waitFor(assertion, { timeout: 5000, interval: 10 });
+}
+
+function text(selector: string): string | undefined {
+  return document.querySelector(selector)?.textContent ?? undefined;
+}
+
+function loads(): number[] {
+  return ((globalThis as { loads?: number[] }).loads ??= []);
+}
+
+function pause(ms: number): Promise<void> {
+  return new Promise((done) => setTimeout(done, ms));
+}
+
+function users(): string[] {
+  return [...document.querySelectorAll('.user')].map((p) => p.textContent!);
+}
+
+describe.each([false, true])('root wait %s', (rootWait) => {
+  it('shows the #loading fallback, then the body with the value, and loads once', async () => {
+    await resume('WithLoading', rootWait);
+    click('.toggle');
+    await waitFor(() => expect(text('.wait')).toBe('wait'));
+    expect(document.querySelector('.sib')).toBeNull();
+    await waitFor(() => expect(text('.u1')).toBe('ada1 ADA1 0'));
+    expect(document.querySelector('.wait')).toBeNull();
+    expect(text('.sib')).toBe('sib');
+    // The script before the await ran once, and the memo took the load of the render.
+    expect(loads()).toEqual([1]);
+    // Handlers and updates of the split component work.
+    click('.i1');
+    await waitFor(() => expect(text('.u1')).toBe('ada1 ADA1 1'));
+    expect(loads()).toEqual([1]);
+  });
+
+  it('drops the #loading body when the block closes while the fallback shows', async () => {
+    await resume('WithLoading', rootWait);
+    click('.toggle');
+    await waitFor(() => expect(text('.wait')).toBe('wait'));
+    click('.toggle');
+    // Past the load, which takes 150 ms.
+    await pause(300);
+    expect(document.querySelector('.sib')).toBeNull();
+    expect(users()).toEqual([]);
+    click('.toggle');
+    await waitFor(() => expect(users()).toEqual(['ada1 ADA1 0']));
+    await pause(300);
+    expect(users()).toEqual(['ada1 ADA1 0']);
+  });
+
+  it('drops the rest of the render when the branch closes while it waits', async () => {
+    await resume('NoLoading', rootWait);
+    click('.toggle');
+    await waitFor(() => expect(loads()).toEqual([2]));
+    click('.toggle');
+    await pause(300);
+    expect(users()).toEqual([]);
+    expect(document.querySelector('.sib')).toBeNull();
+    click('.toggle');
+    await waitFor(() => expect(users()).toEqual(['ada2 ADA2 0']));
+    await pause(300);
+    expect(users()).toEqual(['ada2 ADA2 0']);
+  });
+
+  it('renders a #for row that awaits, and keeps the rows in order', async () => {
+    await resume('Rows', rootWait);
+    click('.add');
+    click('.add');
+    await waitFor(() => expect(users()).toEqual(['ada3 ADA3 0', 'ada4 ADA4 0']));
+    click('.i4');
+    await waitFor(() => expect(text('.u4')).toBe('ada4 ADA4 1'));
+    expect(loads()).toEqual([3, 4]);
+  });
+});
+
+it('fill in place: without #loading, shows the rest of the block, then the component', async () => {
+  await resume('NoLoading');
+  click('.toggle');
+  await waitFor(() => expect(text('.sib')).toBe('sib'));
+  expect(document.querySelector('.u2')).toBeNull();
+  await waitFor(() => expect(text('.u2')).toBe('ada2 ADA2 0'));
+  click('.i2');
+  await waitFor(() => expect(text('.u2')).toBe('ada2 ADA2 1'));
+  expect(loads()).toEqual([2]);
+});
+
+it('fill in place: the old branch goes at once', async () => {
+  await resume('Switch');
+  click('.toggle');
+  await waitFor(() => expect(text('.sib')).toBe('sib'));
+  expect(document.querySelector('.old')).toBeNull();
+  expect(users()).toEqual([]);
+  await waitFor(() => expect(users()).toEqual(['ada7 ADA7 0']));
+});
+
+it('root wait: without #loading, the block shows its new body when the waits settle', async () => {
+  await resume('NoLoading', true);
+  click('.toggle');
+  await waitFor(() => expect(loads()).toEqual([2]));
+  expect(document.querySelector('.sib')).toBeNull();
+  await waitFor(() => expect(users()).toEqual(['ada2 ADA2 0']));
+  expect(text('.sib')).toBe('sib');
+  click('.i2');
+  await waitFor(() => expect(text('.u2')).toBe('ada2 ADA2 1'));
+});
+
+it('root wait: the old branch stays until the new one is ready', async () => {
+  await resume('Switch', true);
+  click('.toggle');
+  await waitFor(() => expect(loads()).toEqual([7]));
+  expect(text('.old')).toBe('old');
+  expect(document.querySelector('.sib')).toBeNull();
+  await waitFor(() => expect(users()).toEqual(['ada7 ADA7 0']));
+  expect(document.querySelector('.old')).toBeNull();
+  expect(text('.sib')).toBe('sib');
+  // Back to the old branch, which does not wait, at once.
+  click('.toggle');
+  await waitFor(() => expect(text('.old')).toBe('old'));
+  expect(users()).toEqual([]);
+});
+
+it('root wait: a switch back while the new branch waits keeps the old branch', async () => {
+  await resume('Switch', true);
+  click('.toggle');
+  await waitFor(() => expect(loads()).toEqual([7]));
+  click('.toggle');
+  await pause(300);
+  expect(text('.old')).toBe('old');
+  expect(users()).toEqual([]);
+  expect(document.querySelectorAll('.old').length).toBe(1);
+});
