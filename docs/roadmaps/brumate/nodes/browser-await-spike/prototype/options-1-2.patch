+import { rendered } from '../../src/runtime/client/blocks.ts';
+import { fail } from '../../src/runtime/client/errors.ts';
+import { afterInsert, disposeKinds } from '../../src/runtime/client/scopes.ts';
+import { isThenable } from '../../src/runtime/client/updates.ts';
+import type { Scope } from '../../src/runtime/client/state.ts';
+
+class Suspend {
+  constructor(readonly p: PromiseLike<unknown>) {}
+}
+const settled = new WeakMap<object, { v: unknown; e?: boolean }>();
+let attempt: { c: unknown[]; i: number } | undefined;
+
+export function use(compute: () => unknown): unknown {
+  const a = attempt;
+  let value: unknown;
+  if (a && a.i < a.c.length) {
+    value = a.c[a.i++];
+  } else {
+    value = compute();
+    if (a) {
+      a.c.push(value);
+      a.i++;
+    }
+  }
+  if (!isThenable(value)) {
+    return value;
+  }
+  const result = settled.get(value);
+  if (result) {
+    if (result.e) {
+      throw result.v;
+    }
+    return result.v;
+  }
+  throw new Suspend(value);
+}
+
+export function retry<T>(
+  scope: Scope,
+  kinds: number[],
+  render: () => T,
+  insert: (out: T) => void,
+  cache: { c: unknown[]; i: number } = { c: [], i: 0 },
+): void {
+  const outer = attempt;
+  attempt = cache;
+  cache.i = 0;
+  let out: T;
+  try {
+    out = render();
+  } catch (error) {
+    if (!(error instanceof Suspend)) {
+      throw error;
+    }
+    disposeKinds(scope, kinds);
+    afterInsert.length = 0;
+    rendered.length = 0;
+    Promise.resolve(error.p).then(
+      (v) => settled.set(error.p as object, { v }),
+      (v) => settled.set(error.p as object, { v, e: true }),
+    ).then(() => retry(scope, kinds, render, insert, cache), (e) => fail(scope, e));
+    return;
+  } finally {
+    attempt = outer;
+  }
+  insert(out);
+}
