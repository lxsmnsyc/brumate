+// @vitest-environment happy-dom
+// SPIKE: what an async render costs over a sync one, for 1,000 rows that clone a template.
+import { it } from 'vitest';
+
+const template = document.createElement('template');
+template.innerHTML = '<li><button class="todo">x</button></li>';
+
+function row(): DocumentFragment {
+  return template.content.cloneNode(true) as DocumentFragment;
+}
+async function asyncRow(): Promise<DocumentFragment> {
+  return template.content.cloneNode(true) as DocumentFragment;
+}
+// A row whose child component renders async too: two awaits deep.
+async function asyncChild(): Promise<DocumentFragment> {
+  return template.content.cloneNode(true) as DocumentFragment;
+}
+async function asyncNested(): Promise<DocumentFragment> {
+  const f = template.content.cloneNode(true) as DocumentFragment;
+  f.firstChild!.appendChild(await asyncChild());
+  return f;
+}
+
+function median(values: number[]): number {
+  values.sort((a, b) => a - b);
+  return values[Math.floor(values.length / 2)]!;
+}
+
+it('times 1,000 rows', async () => {
+  const n = 1000;
+  const sync: number[] = [];
+  const serial: number[] = [];
+  const all: number[] = [];
+  const nested: number[] = [];
+  for (let round = 0; round < 41; round++) {
+    let ul = document.createElement('ul');
+    let t = performance.now();
+    for (let i = 0; i < n; i++) ul.append(row());
+    sync.push(performance.now() - t);
+    ul = document.createElement('ul');
+    t = performance.now();
+    for (let i = 0; i < n; i++) ul.append(await asyncRow());
+    serial.push(performance.now() - t);
+    ul = document.createElement('ul');
+    t = performance.now();
+    const rows: Promise<DocumentFragment>[] = [];
+    for (let i = 0; i < n; i++) rows.push(asyncRow());
+    ul.append(...(await Promise.all(rows)));
+    all.push(performance.now() - t);
+    ul = document.createElement('ul');
+    t = performance.now();
+    const deep: Promise<DocumentFragment>[] = [];
+    for (let i = 0; i < n; i++) deep.push(asyncNested());
+    ul.append(...(await Promise.all(deep)));
+    nested.push(performance.now() - t);
+  }
+  console.log(
+    JSON.stringify({ sync: median(sync), serial: median(serial), all: median(all), nested: median(nested) }),
+  );
+});
