<script>
  import { $setContext, $signal } from 'brumate/signals';
  import { PcTotal } from './pcCtx.ts';
  import CtxEffMid from './CtxEffMid.brm';
  let total = $signal(0);
  function addTotal(n: number) { total += n; }
  function readTotal() { return total; }
  $setContext(PcTotal, { add: addTotal, read: readTotal });
</script>
<p class="total">{total}</p>
<CtxEffMid />
