<script>
  import { $signal, $setContext } from 'brumate/signals';
  import { LabelCtx } from './ctx';
  import Child from './Child.brm';
  let name = $signal('Ada');
  function nameOf() { return name; }
  $setContext(LabelCtx, { label: nameOf });
</script>
<button onClick=(() => (name = 'Grace'))>Rename</button>
<Child />
