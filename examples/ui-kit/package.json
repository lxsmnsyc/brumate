{
  "name": "example-ui-kit",
  "version": "0.0.1",
  "private": true,
  "description": "A package of brumate components, used by examples/kit-app",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*.brm": "./src/*.brm",
    "./*.brm.ts": "./src/*.brm.ts",
    "./greeting": "./src/greeting.ts"
  },
  "scripts": {
    "typecheck": "brumate-tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@brumate/tsc": "workspace:*",
    "brumate": "workspace:*",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "brumate": "workspace:*"
  },
  "brumate": {
    "version": 1,
    "dir": "src"
  }
}
