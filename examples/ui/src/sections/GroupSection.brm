<script>
  import Button from '@brumate/ui/Button.brm';
  import Group from '@brumate/ui/Group.brm';
  import Heading from '@brumate/ui/Heading.brm';
  import Label from '@brumate/ui/Label.brm';
  import Separator from '@brumate/ui/Separator.brm';
  import Text from '@brumate/ui/Text.brm';
</script>

<section aria-labelledby="group">
  <h2 id="group">Group, Label, Text, Heading and Separator</h2>
  <Heading level=(3)>A field of parts</Heading>
  <Label for="amount">Amount</Label>
  <Group class="amount" aria-label="Amount">
    <input id="amount" class="amount-field" inputmode="numeric" aria-describedby="amount-help">
    <Separator orientation="vertical" class="divider" />
    <Button class="press" aria-label="Add one">+</Button>
  </Group>
  <Text id="amount-help" class="help">A whole number.</Text>
  <Separator />
</section>
