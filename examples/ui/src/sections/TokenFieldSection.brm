<script>
  import { $bind, $signal } from 'brumate/signals';
  import Label from '@brumate/ui/Label.brm';
  import Token from '@brumate/ui/Token.brm';
  import TokenField from '@brumate/ui/TokenField.brm';
  import TokenInput from '@brumate/ui/TokenInput.brm';
  import type { TokenSegment } from '@brumate/ui/token-field.ts';

  let note = $signal<TokenSegment[]>([{ type: 'text', text: 'Hi ' }]);
</script>

<section aria-labelledby="token-field">
  <h2 id="token-field">TokenField</h2>
  <TokenField class="note-field" pattern="[#@]\S+" value=$bind(note)>
    <Label>Note</Label>
    <TokenInput class="note-input" token=noteToken style="border: 1px solid #555; padding: 0.5rem; min-width: 16rem" />
  </TokenField>
  <p class="note-state">{note.map((segment) => (segment.type === 'token' ? `[${segment.text}]` : segment.text)).join('')}</p>
</section>

#template noteToken(segment: TokenSegment) {
  <Token class="note-token" style="background: #ddd; padding: 0 0.3rem">{segment.text}</Token>
}
