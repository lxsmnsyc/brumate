<script>
  import Button from '@brumate/ui/Button.brm';
  import Tree from '@brumate/ui/Tree.brm';
  import NavigationTree from '@brumate/ui/NavigationTree.brm';
  import NavigationTreeItem from '@brumate/ui/NavigationTreeItem.brm';
  import NavigationTreeItemLink from '@brumate/ui/NavigationTreeItemLink.brm';
  import type { NavigationNode } from '@brumate/ui/navigation-tree.ts';
  import Table from '@brumate/ui/Table.brm';
  import Slider from '@brumate/ui/Slider.brm';

  // A tree of links to the sections of this page.
  interface Section extends NavigationNode {
    title: string;
    children?: Section[];
  }
  const sections: Section[] = [
    {
      id: 'collections',
      title: 'Collections',
      children: [
        { id: 'tree-link', title: 'Tree', href: '#tree' },
        { id: 'table-link', title: 'Table', href: '#table' },
      ],
    },
    { id: 'slider-link', title: 'Slider', href: '#slider' },
  ];
</script>

<section aria-labelledby="navigation-tree">
  <h2 id="navigation-tree">NavigationTree</h2>
  <nav aria-label="Sections">
    <NavigationTree class="section-tree" aria-label="Sections" items=sections item=sectionRow selectedRoute="#table" />
  </nav>
</section>

#template sectionRow(section: Section) {
  <NavigationTreeItem class=(`section-row section-${section.id}`) textValue=(section.title) href=(section.href)>
    #if (section.children) {
      <Button slot="chevron" class="section-chevron">▸</Button>
    }
    <NavigationTreeItemLink class=(`section-link section-link-${section.id}`)>{section.title}</NavigationTreeItemLink>
  </NavigationTreeItem>
}
