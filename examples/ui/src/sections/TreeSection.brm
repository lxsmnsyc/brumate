<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import Tree from '@brumate/ui/Tree.brm';
  import TreeItem from '@brumate/ui/TreeItem.brm';
  import { treeData } from '@brumate/ui/data.brm.ts';
  import type { TreeDataNode } from '@brumate/ui/data.ts';
  import type { Key } from '@brumate/ui/collection.ts';

  // A file tree: folders with children, opened and selected.
  interface Folder {
    id: string;
    name: string;
    children?: Folder[];
  }
  const { items: folders, append: addFolderItem } = treeData<Folder>({
    initialItems: [
      {
        id: 'src',
        name: 'src',
        children: [
          { id: 'app', name: 'app.brm' },
          { id: 'lib', name: 'lib', children: [{ id: 'util', name: 'util.ts' }] },
        ],
      },
      { id: 'readme', name: 'README.md' },
    ],
  });
  let openFolders = $signal<Key[]>([]);
  let pickedFolder = $signal<Key[]>([]);
</script>

<section aria-labelledby="tree">
  <h2 id="tree">Tree</h2>
  <Tree class="folder-tree" aria-label="Folders" items=folders item=folderRow selectionMode="single" selectedKeys=$bind(pickedFolder) expandedKeys=$bind(openFolders) />
  <p class="folder-state">{openFolders.join(',') || 'None'} / {pickedFolder.join(',') || 'None'}</p>
  <Button class="press folder-add" onPress=(() => addFolderItem('src', { id: 'main', name: 'main.ts' }))>Add main.ts</Button>
</section>

#template folderRow(folder: TreeDataNode<Folder>) {
  <TreeItem class=(`folder-row folder-${folder.id}`) textValue=(folder.value.name)>
    #if (folder.children) {
      <Button slot="chevron" class="folder-chevron">▸</Button>
    }
    {folder.value.name}
  </TreeItem>
}
