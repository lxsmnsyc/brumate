<script>
  import { prevent } from 'brumate/events';
  import { $bind, $signal } from 'brumate/signals';
  import FieldError from '@brumate/ui/FieldError.brm';
  import Button from '@brumate/ui/Button.brm';
  import Label from '@brumate/ui/Label.brm';
  import ListBox from '@brumate/ui/ListBox.brm';
  import ListBoxItem from '@brumate/ui/ListBoxItem.brm';
  import Select from '@brumate/ui/Select.brm';
  import SelectValue from '@brumate/ui/SelectValue.brm';
  import Popover from '@brumate/ui/Popover.brm';
  import type { Key } from '@brumate/ui/collection.ts';

  let pet = $signal<Key | null>(null);
  let petSent = $signal('');
</script>

<section aria-labelledby="select">
  <h2 id="select">Select</h2>
  <form
    class="pet-form"
    onSubmit=(prevent((event) => {
      petSent = String(new FormData(event.currentTarget as HTMLFormElement).get('pet'));
    }))
  >
    <Select class="pet-select" name="pet" isRequired selectedKey=$bind(pet)>
      <Label>Pet</Label>
      <Button class="press pet-trigger"><SelectValue /></Button>
      <FieldError class="pet-error" />
      <Popover class="popover pet-popover">
        <ListBox class="listbox pet-list">
          #for (name of ['Cat', 'Dog', 'Fish'] by name) {
            <ListBoxItem id=(name.toLowerCase()) class="option">{name}</ListBoxItem>
          }
        </ListBox>
      </Popover>
    </Select>
    <button class="press pet-send" type="submit">Send</button>
  </form>
  <p class="pet-state">{petSent || 'Not sent'}</p>
</section>
