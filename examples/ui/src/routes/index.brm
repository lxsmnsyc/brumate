<script>
  import { createForm } from 'brumate/forms';
  import { parseSubmission } from 'brumate/server';
  import { $bind, $signal } from 'brumate/signals';
  import Checkbox from '@brumate/ui/Checkbox.brm';
  import CheckboxGroup from '@brumate/ui/CheckboxGroup.brm';
  import FieldError from '@brumate/ui/FieldError.brm';
  import FileTrigger from '@brumate/ui/FileTrigger.brm';
  import Form from '@brumate/ui/Form.brm';
  import Input from '@brumate/ui/Input.brm';
  import Radio from '@brumate/ui/Radio.brm';
  import RadioGroup from '@brumate/ui/RadioGroup.brm';
  import SearchField from '@brumate/ui/SearchField.brm';
  import Switch from '@brumate/ui/Switch.brm';
  import TextArea from '@brumate/ui/TextArea.brm';
  import TextField from '@brumate/ui/TextField.brm';
  import { Order } from '../order.ts';
  import Breadcrumb from '@brumate/ui/Breadcrumb.brm';
  import Breadcrumbs from '@brumate/ui/Breadcrumbs.brm';
  import Button from '@brumate/ui/Button.brm';
  import Group from '@brumate/ui/Group.brm';
  import Heading from '@brumate/ui/Heading.brm';
  import Keyboard from '@brumate/ui/Keyboard.brm';
  import Label from '@brumate/ui/Label.brm';
  import Link from '@brumate/ui/Link.brm';
  import Meter from '@brumate/ui/Meter.brm';
  import ProgressBar from '@brumate/ui/ProgressBar.brm';
  import Separator from '@brumate/ui/Separator.brm';
  import Text from '@brumate/ui/Text.brm';
  import ToggleButton from '@brumate/ui/ToggleButton.brm';
  import ToggleButtonGroup from '@brumate/ui/ToggleButtonGroup.brm';
  import Toolbar from '@brumate/ui/Toolbar.brm';
  import VisuallyHidden from '@brumate/ui/VisuallyHidden.brm';

  let presses = $signal(0);
  let last = $signal('nothing yet');
  let pinned = $signal(false);
  let query = $signal('');
  let searched = $signal('');
  let size = $signal<string | null>(null);
  let toppings = $signal<string[]>([]);
  let dark = $signal(false);
  let align = $signal(['left']);
  let files = $signal('No files picked.');

  async function order(form: FormData) {
    'use server';
    const submission = await parseSubmission(Order, form);
    if (submission.status !== 'success') {
      return submission.reply();
    }
    return submission.reply({ reset: true });
  }

  const { attrs, fields, result } = createForm(order, Order, { defaultValue: { email: '' } });
</script>

#head {
  <title>@brumate/ui</title>
}

<h1>@brumate/ui</h1>
<p>Every part of the package, with the styles of this page only. Tab from the top of the page to see the link that skips to the content.</p>

<section aria-labelledby="visually-hidden">
  <h2 id="visually-hidden">VisuallyHidden</h2>
  <p>The button shows only a mark, and its name is hidden from sight.</p>
  <button type="button" class="close">
    <span aria-hidden="true">×</span>
    <VisuallyHidden>Close</VisuallyHidden>
  </button>
</section>

<section aria-labelledby="button">
  <h2 id="button">Button</h2>
  <p>It presses with a mouse, a touch, Enter, Space or a screen reader, and shows its state as data attributes.</p>
  <Button
    class="press"
    onPress=((event) => {
      presses++;
      last = event.pointerType;
    })
  >Press me</Button>
  <Button class="press" isDisabled=(true)>Disabled</Button>
  <Button class="press" isPending=(true)>Saving</Button>
  <p class="pressed" aria-live="polite">Pressed {presses} times, last with {last}.</p>
</section>

<section aria-labelledby="keyboard">
  <h2 id="keyboard">Keyboard</h2>
  <p>Paste with <Keyboard>⌘V</Keyboard>.</p>
</section>

<section aria-labelledby="toggle-button">
  <h2 id="toggle-button">ToggleButton</h2>
  <p>It stays pressed, and the page binds its state.</p>
  <ToggleButton class="press pin" isSelected=$bind(pinned)>Pin</ToggleButton>
  <p class="pinned">The note is {pinned ? 'pinned' : 'not pinned'}.</p>
</section>

<section aria-labelledby="link">
  <h2 id="link">Link</h2>
  <p>
    <Link class="link" href="#link">This section</Link>,
    <Link class="link" href="#main" isCurrent=(true)>the current page</Link> and
    <Link class="link" href="#main" isDisabled=(true)>a disabled link</Link>.
  </p>
</section>

<section aria-labelledby="group">
  <h2 id="group">Group, Label, Text, Heading and Separator</h2>
  <Heading level=(3)>A field of parts</Heading>
  <Label for="amount">Amount</Label>
  <Group class="amount" aria-label="Amount">
    <input id="amount" class="amount-field" inputmode="numeric" aria-describedby="amount-help">
    <Separator orientation="vertical" class="divider" />
    <Button class="press" aria-label="Add one">+</Button>
  </Group>
  <Text id="amount-help" class="help">A whole number.</Text>
  <Separator />
</section>

<section aria-labelledby="text-field">
  <h2 id="text-field">TextField, TextArea and FieldError</h2>
  <Form class="signup">
    <TextField class="name-field" name="name" isRequired=(true)>
      <Label>Name</Label>
      <Input class="field" />
      <Text slot="description" class="help">As it is on your card.</Text>
      <FieldError class="error" />
    </TextField>
    <TextField class="bio-field" name="bio">
      <Label>About you</Label>
      <TextArea class="field" rows="3" />
    </TextField>
    <Button class="press" type="submit">Sign up</Button>
  </Form>
</section>

<section aria-labelledby="create-form">
  <h2 id="create-form">With createForm</h2>
  <form action=order {...attrs} class="order">
    <TextField field=(fields.email) type="email">
      <Label>Email for the receipt</Label>
      <Input class="field" />
      <FieldError class="error" />
    </TextField>
    <Button class="press" type="submit">Order</Button>
    #if (result?.status === 'success') {
      <p class="ordered">Ordered.</p>
    }
  </form>
</section>

<section aria-labelledby="search-field">
  <h2 id="search-field">SearchField</h2>
  <SearchField class="search" value=$bind(query) onSubmit=((value) => (searched = value))>
    <Label>Search the parts</Label>
    <Input class="field" />
    <Button class="press clear">×</Button>
  </SearchField>
  <p class="searched">Searched for {searched || 'nothing yet'}.</p>
</section>

<section aria-labelledby="boxes">
  <h2 id="boxes">Checkbox, CheckboxGroup, RadioGroup and Switch</h2>
  <Form class="pizza">
    <CheckboxGroup class="toppings" name="toppings" value=$bind(toppings) isRequired=(true)>
      <Label>Toppings</Label>
      <Checkbox class="box" value="cheese"><span class="mark" aria-hidden="true"></span>Cheese</Checkbox>
      <Checkbox class="box" value="olives"><span class="mark" aria-hidden="true"></span>Olives</Checkbox>
      <FieldError class="error" />
    </CheckboxGroup>
    <RadioGroup class="sizes" name="size" value=$bind(size) orientation="horizontal">
      <Label>Size</Label>
      <Radio class="box" value="small"><span class="mark round" aria-hidden="true"></span>Small</Radio>
      <Radio class="box" value="large"><span class="mark round" aria-hidden="true"></span>Large</Radio>
    </RadioGroup>
    <Button class="press" type="submit">Order the pizza</Button>
  </Form>
  <p class="pizza-value">{toppings.join(', ') || 'No toppings'}, {size ?? 'no size'}.</p>
  <RadioGroup class="crust" name="crust" value="thin" isReadOnly=(true) orientation="horizontal">
    <Label>Crust, set by the shop</Label>
    <Radio class="box" value="thin"><span class="mark round" aria-hidden="true"></span>Thin</Radio>
    <Radio class="box" value="thick"><span class="mark round" aria-hidden="true"></span>Thick</Radio>
  </RadioGroup>
  <Checkbox class="box sauce" isSelected=(true) isReadOnly=(true)><span class="mark" aria-hidden="true"></span>Sauce, always on</Checkbox>
  <Switch class="box theme" isSelected=$bind(dark)><span class="track" aria-hidden="true"></span>Dark mode</Switch>
  <p class="theme-value">Dark mode is {dark ? 'on' : 'off'}.</p>
</section>

<section aria-labelledby="toolbar">
  <h2 id="toolbar">Toolbar and ToggleButtonGroup</h2>
  <Toolbar class="tools" aria-label="Edit">
    <Button class="press">Cut</Button>
    <Button class="press">Copy</Button>
    <Separator orientation="vertical" class="divider" />
    <ToggleButtonGroup class="align" aria-label="Align" selectedKeys=$bind(align) disallowEmptySelection=(true)>
      <ToggleButton id="left" class="press">Left</ToggleButton>
      <ToggleButton id="center" class="press">Center</ToggleButton>
    </ToggleButtonGroup>
  </Toolbar>
  <p class="aligned">Aligned {align[0]}.</p>
</section>

<section aria-labelledby="breadcrumbs">
  <h2 id="breadcrumbs">Breadcrumbs</h2>
  <nav aria-label="Trail">
    <Breadcrumbs class="trail">
      <Breadcrumb><Link class="link" href="#main">Home</Link></Breadcrumb>
      <Breadcrumb><Link class="link" href="#breadcrumbs">Parts</Link></Breadcrumb>
      <Breadcrumb isCurrent=(true)><Link class="link" href="#breadcrumbs">Breadcrumbs</Link></Breadcrumb>
    </Breadcrumbs>
  </nav>
</section>

<section aria-labelledby="meter">
  <h2 id="meter">Meter and ProgressBar</h2>
  <Meter class="bar" value=(40)><Label>Disk space</Label></Meter>
  <ProgressBar class="bar" value=(3) maxValue=(4)><Label>Upload</Label></ProgressBar>
</section>

<section aria-labelledby="file-trigger">
  <h2 id="file-trigger">FileTrigger</h2>
  <FileTrigger allowsMultiple=(true) onSelect=((list) => (files = `${list?.length ?? 0} files picked.`))>
    <Button class="press">Pick files</Button>
  </FileTrigger>
  <p class="files">{files}</p>
</section>

<style>
  /* The page's own look for the parts, from their data attributes. */
  :global(.press) {
    padding: 0.5rem 1rem;
    border: 1px solid #555;
    border-radius: 0.5rem;
    background: #fff;
    color: #111;
    font: inherit;
  }

  :global(.press[data-hovered]) {
    background: #f1f1f1;
  }

  :global(.press[data-pressed]) {
    background: #ddd;
  }

  :global(.press[data-focus-visible]) {
    outline: 3px solid #2457d6;
    outline-offset: 2px;
  }

  :global(.press[data-selected]) {
    background: #2457d6;
    color: #fff;
  }

  :global(.link[data-current]) {
    font-weight: 700;
  }

  :global(.link[data-disabled]) {
    color: #595959;
  }

  :global(.amount) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    border: 1px solid #555;
    border-radius: 0.5rem;
  }

  :global(.amount[data-focus-within]) {
    outline: 3px solid #2457d6;
    outline-offset: 2px;
  }

  :global(.divider) {
    align-self: stretch;
    width: 1px;
    background: #555;
  }

  :global(.field) {
    padding: 0.4rem 0.6rem;
    border: 1px solid #555;
    border-radius: 0.5rem;
    font: inherit;
  }

  :global(.field[data-invalid]) {
    border-color: #b3261e;
  }

  :global(.error) {
    display: block;
    color: #b3261e;
  }

  :global(.search[data-empty] .clear) {
    visibility: hidden;
  }

  :global(.box) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-inline-end: 1rem;
  }

  :global(.mark) {
    width: 1rem;
    height: 1rem;
    border: 2px solid #555;
    border-radius: 0.25rem;
  }

  :global(.mark.round) {
    border-radius: 50%;
  }

  :global(.box[data-selected] .mark) {
    background: #2457d6;
    border-color: #2457d6;
  }

  :global(.box[data-focus-visible] .mark),
  :global(.box[data-focus-visible] .track) {
    outline: 3px solid #2457d6;
    outline-offset: 2px;
  }

  :global(.track) {
    width: 2rem;
    height: 1rem;
    border: 2px solid #555;
    border-radius: 1rem;
  }

  :global(.theme[data-selected] .track) {
    background: #2457d6;
  }

  :global(.tools),
  :global(.align) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  :global(.trail) {
    display: flex;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  :global(.trail li + li)::before {
    content: '/';
    margin-inline-end: 0.5rem;
  }

  :global(.bar) {
    display: grid;
    gap: 0.25rem;
    max-width: 20rem;
    margin-block: 0.5rem;
  }

  :global(.bar)::after {
    content: '';
    height: 0.5rem;
    border: 1px solid #555;
    background: linear-gradient(to right, #2457d6 var(--percentage), transparent 0);
  }

  :global(.help) {
    display: block;
    color: #595959;
  }

  :global(.press[data-disabled]),
  :global(.press[data-pending]) {
    color: #595959;
  }
</style>
