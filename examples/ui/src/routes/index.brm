<script>
  import Sections from '../sections.brm';
</script>


#head {
  <title>@brumate/ui</title>
}

<h1>@brumate/ui</h1>
<p>Every part of the package, with the styles of this page only. Tab from the top of the page to see the link that skips to the content.</p>

<Sections />

<style>
  /* The page's own look for the parts, from their data attributes. */
  :global(.press) {
    padding: 0.5rem 1rem;
    border: 1px solid #555;
    border-radius: 0.5rem;
    background: #fff;
    color: #111;
    font: inherit;
  }

  :global(.press[data-hovered]) {
    background: #f1f1f1;
  }

  :global(.press[data-pressed]) {
    background: #ddd;
  }

  :global(.press[data-focus-visible]) {
    outline: 3px solid #2457d6;
    outline-offset: 2px;
  }

  :global(.press[data-selected]) {
    background: #2457d6;
    color: #fff;
  }

  :global(.link[data-current]) {
    font-weight: 700;
  }

  :global(.link[data-disabled]) {
    color: #595959;
  }

  :global(.amount) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    border: 1px solid #555;
    border-radius: 0.5rem;
  }

  :global(.amount[data-focus-within]) {
    outline: 3px solid #2457d6;
    outline-offset: 2px;
  }

  :global(.divider) {
    align-self: stretch;
    width: 1px;
    background: #555;
  }

  :global(.field) {
    padding: 0.4rem 0.6rem;
    border: 1px solid #555;
    border-radius: 0.5rem;
    font: inherit;
  }

  :global(.field[data-invalid]) {
    border-color: #b3261e;
  }

  :global(.error) {
    display: block;
    color: #b3261e;
  }

  :global(.search[data-empty] .clear) {
    visibility: hidden;
  }

  :global(.box) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-inline-end: 1rem;
  }

  :global(.mark) {
    width: 1rem;
    height: 1rem;
    border: 2px solid #555;
    border-radius: 0.25rem;
  }

  :global(.mark.round) {
    border-radius: 50%;
  }

  :global(.box[data-selected] .mark) {
    background: #2457d6;
    border-color: #2457d6;
  }

  :global(.box[data-focus-visible] .mark),
  :global(.box[data-focus-visible] .track) {
    outline: 3px solid #2457d6;
    outline-offset: 2px;
  }

  :global(.track) {
    width: 2rem;
    height: 1rem;
    border: 2px solid #555;
    border-radius: 1rem;
  }

  :global(.theme[data-selected] .track) {
    background: #2457d6;
  }

  :global(.tools),
  :global(.align) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  :global(.trail) {
    display: flex;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  :global(.trail li + li)::before {
    content: '/';
    margin-inline-end: 0.5rem;
  }

  :global(.bar) {
    display: grid;
    gap: 0.25rem;
    max-width: 20rem;
    margin-block: 0.5rem;
  }

  :global(.bar)::after {
    content: '';
    height: 0.5rem;
    border: 1px solid #555;
    background: linear-gradient(to right, #2457d6 var(--percentage), transparent 0);
  }

  :global(.popover) {
    padding: 1rem;
    border: 1px solid #555;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: 0 8px 24px rgb(0 0 0 / 15%);
    transition: opacity 0.2s;
  }

  :global(.popover[data-closed]) {
    opacity: 0;
  }

  :global(.settings) {
    display: grid;
    gap: 0.75rem;
  }

  :global(.settings h3) {
    margin: 0;
  }

  :global(.listbox) {
    display: grid;
    max-width: 16rem;
    max-height: 12rem;
    overflow: auto;
    padding: 0.25rem;
    border: 1px solid #555;
    border-radius: 0.5rem;
  }

  :global(.listbox:focus-visible) {
    outline: 3px solid #2457d6;
  }

  :global(.listbox-header) {
    padding: 0.5rem 0.5rem 0.25rem;
    color: #595959;
    font-size: 0.8rem;
    font-weight: 700;
  }

  :global(.option) {
    padding: 0.35rem 0.5rem;
    border-radius: 0.25rem;
    outline: none;
  }

  :global(.planet-tab) {
    position: relative;
  }

  :global(.planet-bar) {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: #333;
    transition-duration: 0.2s;
  }

  :global(.action-menu),
  :global(.command-menu) {
    display: grid;
    min-width: 10rem;
    padding: 0.25rem;
    border: 1px solid #ccc;
    background: #fff;
  }

  :global(.action-menu .option[data-focused]),
  :global(.command-menu .option[data-focused]) {
    background: #eee;
  }

  :global(.option[data-hovered]) {
    background: #f1f1f1;
  }

  :global(.option[data-focus-visible]) {
    outline: 2px solid #2457d6;
    outline-offset: -2px;
  }

  :global(.option[data-selected]) {
    background: #2457d6;
    color: #fff;
  }

  :global(.tip) {
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    background: #111;
    color: #fff;
    font-size: 0.875rem;
  }

  :global(.toasts) {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.5rem;
  }

  :global(.toast) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: #111;
    color: #fff;
    transition: opacity 0.2s, translate 0.2s;
  }

  :global(.toast[data-closed]) {
    opacity: 0;
    translate: 0 0.5rem;
  }

  :global([data-modal-overlay]) {
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 40%);
    transition: opacity 0.15s;
  }

  :global([data-modal-overlay][data-closed]) {
    opacity: 0;
  }

  :global(.modal) {
    max-width: 24rem;
    max-height: calc(var(--visual-viewport-height) * 0.9);
    padding: 1.25rem;
    border-radius: 0.75rem;
    background: #fff;
    transition: scale 0.15s;
  }

  :global([data-closed] > .modal) {
    scale: 0.96;
  }

  :global(.confirm),
  :global(.menu) {
    display: grid;
    gap: 0.75rem;
  }

  :global(.sheet) {
    position: fixed;
    inset-block: 0;
    width: min(18rem, 80vw);
    padding: 1.25rem;
    background: #fff;
    transition: translate 0.2s;
  }

  :global(.sheet[data-side='left']) {
    left: 0;
  }

  :global(.sheet[data-side='right']) {
    right: 0;
  }

  :global([data-closed] > .sheet[data-side='left']) {
    translate: -100% 0;
  }

  :global([data-closed] > .sheet[data-side='right']) {
    translate: 100% 0;
  }

  :global(.arrow) {
    width: 12px;
    height: 12px;
    margin-left: -6px;
    background: #fff;
    border-top: 1px solid #555;
    border-left: 1px solid #555;
    rotate: 45deg;
  }

  :global(.arrow[data-placement='bottom']) {
    top: -7px;
  }

  :global(.note) {
    transition: opacity 0.3s;
  }

  :global(.faq-panel) {
    height: var(--disclosure-panel-height, auto);
    overflow: clip;
    transition: height 0.3s;
  }

  :global(.note[data-closed]) {
    opacity: 0;
  }

  :global(.help) {
    display: block;
    color: #595959;
  }

  :global(.press[data-disabled]),
  :global(.press[data-pending]) {
    color: #595959;
  }
</style>
