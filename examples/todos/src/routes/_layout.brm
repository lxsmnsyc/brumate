<script>
  import { href } from 'brumate/routes';
  import { $props, $signal } from 'brumate/signals';

  // Wraps every page. `children` is the page, and `aside` is the @aside route for the same path.
  const { children, aside } = $props();
  // Client state in a layout stays when a link changes only the route inside it.
  let wide = $signal(false);
</script>

<style>
  /* A todo is a button, so a keyboard can toggle it too. */
  :global(.todo) {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  :global(.done .todo) {
    text-decoration: line-through;
  }
  .page {
    display: flex;
    gap: 2rem;
  }
  .wide {
    gap: 6rem;
  }
</style>

<html lang="en">
  <head>
    <meta charset="utf-8">
  </head>
  <body>
    <nav><a href="/">Todos</a> | <a href=(href('/counter/[start]', { start: '10' }))>Counter</a> | <a href="/guestbook">Guestbook</a>
      <button class="toggle" onClick=(() => (wide = !wide))>{wide ? 'Narrow' : 'Wide'}</button>
    </nav>
    <div class=(wide ? 'page wide' : 'page')>
      <main>{children}</main>
      <aside>{aside}</aside>
    </div>
  </body>
</html>
