<script>
  import { $memo, $props, $signal, $title } from 'brumate/signals';
  import Counter from './Counter.brm';
  import { save } from './store.ts';
  import type { Todo } from './store.ts';

  const { initial } = $props<{ initial: Todo[] }>();
  let todos = $signal(initial);
  let draft = $signal('');
  const left = $memo(todos.filter((todo) => !todo.done).length);
  $title(`${left} left`);

  async function slowQuote() {
    'use server';
    await new Promise((resolve) => setTimeout(resolve, 1500));
    return 'Ship less code to the browser.';
  }

  // Streams in after the rest of the page.
  const quote = $memo(slowQuote());

  async function add() {
    if (draft.trim() === '') {
      return;
    }
    todos = [...todos, { id: crypto.randomUUID(), title: draft, done: false }];
    draft = '';
    await save(todos);
  }
</script>

<h1>Todos</h1>
<form onSubmit:prevent=add>
  <input value=draft placeholder="What needs doing?" aria-label="New todo" onInput=((event) => (draft = event.currentTarget.value))>
  <button>Add</button>
</form>
<ul>
  #for (todo of todos by todo.id) {
    <script>
      function toggle() {
        todos = todos.map((item) => (item.id === todo.id ? { ...item, done: !item.done } : item));
      }
    </script>
    <li class={ done: todo.done }><button class="todo" onClick=toggle>{todo.title}</button></li>
  } #else {
    <li>Nothing to do.</li>
  }
</ul>
<p>{left} left</p>

#loading {
  <blockquote>{quote}</blockquote>
} #else {
  <p>Loading a quote…</p>
}

<h2>Counter</h2>
<Counter start=3 />

<style>
  /* A todo is a button, so a keyboard can toggle it too. */
  .todo {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .done .todo {
    text-decoration: line-through;
  }
</style>
