<script module>
  // The page is the same for everyone, so the server keeps it for a minute.
  export const cache = { maxAge: 60 };
</script>

<script>
  import { $action, $isPending, $memo, $signal } from 'brumate/signals';
  import { getEvent } from 'brumate/server';
  import { addNote, listNotes } from '../notes.ts';

  let count = $signal(0);

  async function add(form: FormData) {
    'use server';
    const event = getEvent();
    const result = await addNote(form);
    event.refresh(listNotes);
    return result;
  }

  const result = $action(add);
  const notes = $memo(listNotes());
</script>

#head {
  <title>Notes</title>
}

<h1>Notes</h1>
<button class="count" onClick=(() => count++)>Clicked {count} times</button>
<form action=add>
  <input name="text" aria-label="Note">
  <button disabled=($isPending(result))>Add</button>
</form>
#if (result?.error) {
  <p class="error">{result.error}</p>
}
<ul>
  #for (note of notes by note) {
    <li>{note}</li>
  }
</ul>
