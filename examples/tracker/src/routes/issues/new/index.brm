<script>
  import { createForm } from 'brumate/forms';
  import { href } from 'brumate/routes';
  import { getEvent, parseSubmission, redirect } from 'brumate/server';
  import { $isPending } from 'brumate/signals';
  import { LABELS } from '../../../labels.ts';
  import { NewIssue } from '../../../schema.ts';
  import { session } from '../../../session.ts';
  import { addIssue } from '../../../store.ts';

  async function create(form: FormData) {
    'use server';
    const event = getEvent();
    const user = await session.get(event);
    // The middleware guards the page, but not this call, which posts to /_brumate.
    if (!user) {
      redirect('/sign-in?next=/issues/new');
    }
    const submission = await parseSubmission(NewIssue, form);
    if (submission.status !== 'success') {
      // The page shows the errors, and the fields show what was typed, with or without scripts.
      return submission.reply();
    }
    const issue = addIssue({ ...submission.value, author: user.name });
    redirect(href('/issues/[id]', { id: String(issue.id) }));
  }

  const { attrs, fields, result } = createForm(create, NewIssue, {
    defaultValue: { title: '', body: '', labels: [] as string[] },
  });
</script>

#head {
  <title>New issue</title>
}

<h1>New issue</h1>
<form action=create {...attrs}>
  <label>
    Title
    <input {...fields.title.attrs}>
  </label>
  #if (fields.title.errors) {
    <p class="error" {...fields.title.errorAttrs}>{fields.title.errors[0]}</p>
  }
  <label>
    Description
    <textarea name=(fields.body.name) id=(fields.body.id) rows="5">{fields.body.value ?? ''}</textarea>
  </label>
  <fieldset aria-describedby=(fields.labels.errors ? fields.labels.errorAttrs.id : undefined)>
    <legend>Labels</legend>
    #for (label of LABELS) {
      <label class="check">
        <input type="checkbox" name="labels[]" value=label checked=(fields.labels.value?.includes(label))>
        {label}
      </label>
    }
  </fieldset>
  #if (fields.labels.errors) {
    <p class="error" {...fields.labels.errorAttrs}>{fields.labels.errors[0]}</p>
  }
  <button disabled=($isPending(result))>Open the issue</button>
</form>

<style>
  form {
    display: grid;
    gap: 0.75rem;
    max-width: 32rem;
  }
  label {
    display: grid;
  }
  input,
  textarea,
  button {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
  }
  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .check {
    display: flex;
    gap: 0.3rem;
  }
  button {
    justify-self: start;
  }
</style>
