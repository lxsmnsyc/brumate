<script>
  import { $getContext } from 'brumate/signals';
  import { CurrentUser } from '../user.ts';
  const user = $getContext(CurrentUser);
</script>

#head {
  <title>About</title>
}

<h1>About</h1>
<p>
  A small issue tracker, built to show the parts of brumate working together. The server
  renders every page, and the browser loads the code of a button only when it is used.
</p>
<p>
  This page has no data, so the build writes it as a static file. The other pages render on
  each request.
</p>
<!-- The static file is the same for everyone, so the server renders the line about the user later. -->
#defer ('load') {
  <p class="who">{user ? `You are signed in as ${user}.` : 'You are not signed in.'}</p>
} #else {
  <p class="who">Checking who you are…</p>
}
<h2>Shortcuts</h2>
<ul>
  <li><kbd>/</kbd> searches the issues.</li>
  <li><kbd>Esc</kbd> closes a dialog.</li>
</ul>
