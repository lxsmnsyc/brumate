<script>
  import { $props, $signal } from 'brumate/signals';
  import { build, remove, swap, update } from '../../../harness/rows.mjs';
  import type { Row } from '../../../harness/rows.mjs';

  const { initial } = $props<{ initial: Row[] }>();
  let rows = $signal(initial);
  let selected = $signal(0);
  let next = $signal(initial.length + 1);

  function create(count: number) {
    rows = build(next, count);
    next = next + count;
  }
  function append() {
    rows = [...rows, ...build(next, 1000)];
    next = next + 1000;
  }
</script>

<div class="jumbotron">
  <h1>brumate</h1>
  <button id="run" onClick=(() => create(1000))>Create 1,000 rows</button>
  <button id="runlots" onClick=(() => create(10000))>Create 10,000 rows</button>
  <button id="add" onClick=append>Append 1,000 rows</button>
  <button id="update" onClick=(() => (rows = update(rows)))>Update every 10th row</button>
  <button id="clear" onClick=(() => (rows = []))>Clear</button>
  <button id="swaprows" onClick=(() => (rows = swap(rows)))>Swap rows</button>
</div>
<table class="table">
  <tbody>
    #for (row of rows by row.id) {
      <tr class=(selected === row.id ? 'danger' : '')>
        <td class="col-md-1">{row.id}</td>
        <td class="col-md-4"><a class="lbl" onClick=(() => (selected = row.id))>{row.label}</a></td>
        <td class="col-md-1"><a class="remove" onClick=(() => (rows = remove(rows, row.id)))>x</a></td>
        <td class="col-md-6"></td>
      </tr>
    }
  </tbody>
</table>
