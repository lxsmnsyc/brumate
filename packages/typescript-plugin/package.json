{
  "name": "@brumate/typescript-plugin",
  "version": "0.1.2",
  "description": "TypeScript server plugin for .brm files",
  "homepage": "https://github.com/lxsmnsyc/brumate",
  "bugs": "https://github.com/lxsmnsyc/brumate/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/brumate.git",
    "directory": "packages/typescript-plugin"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brumate/language-core": "workspace:*",
    "@volar/typescript": "2.4.28"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
