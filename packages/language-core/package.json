{
  "name": "@brumate/language-core",
  "version": "0.2.1",
  "description": "Volar language plugin for .brm files",
  "homepage": "https://github.com/lxsmnsyc/brumate",
  "bugs": "https://github.com/lxsmnsyc/brumate/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/brumate.git",
    "directory": "packages/language-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@volar/language-core": "2.4.28",
    "brumate": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@volar/typescript": "2.4.28",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
