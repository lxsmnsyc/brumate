<script>
  import { $getContext, $memo, $props } from 'brumate/signals';
  import { Grid } from './grid.ts';

  const { day } = $props<{ day: number }>();
  const grid = $getContext(Grid);
  const isSelected = $memo(grid.selected === day);
</script>

<button aria-selected=(String(isSelected)) tabindex=(grid.focused === day ? 0 : -1) onClick=(() => grid.select(day))>{day}</button>
