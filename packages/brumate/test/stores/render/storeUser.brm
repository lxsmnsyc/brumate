<script>
  import { $setContext, $signal } from 'brumate/signals';
  import { store } from 'brumate/store';
  import StoreDiamondMid from './StoreDiamondMid.brm';
  import { Level } from './contexts.ts';

  let letters = $signal(['a', 'b']);
  const last = store(1);
  $setContext(Level, last);

  function grow() {
    letters = [...letters, String.fromCharCode(97 + letters.length)];
    last.set(letters.length - 1);
  }
</script>

<button class="grow" onClick=grow>Grow</button>
<button class="later" onClick=(() => setTimeout(() => last.set(0), 0))>Later</button>
<StoreDiamondMid {letters} />
