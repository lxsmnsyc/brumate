<script>
  import { $memo, $props, $setContext, $toStore } from 'brumate/signals';
  import { Level } from './contexts.ts';

  const { letters, children } = $props<{ letters: string[]; children?: unknown }>();
  const last = $memo(letters.length - 1);
  $setContext(Level, $toStore(last));
</script>

<div class="wrap">{children}</div>
