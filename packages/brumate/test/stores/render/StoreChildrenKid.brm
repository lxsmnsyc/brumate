<script>
  import { $memo, $props, $getContext, $store } from 'brumate/signals';
  import { ran } from './runs.ts';
  import { Level } from './contexts.ts';

  const { list } = $props<{ list: string[] }>();
  const last = $store($getContext(Level));
  // It throws when it reads an index past the end of the list.
  const kidPick = $memo(ran('kidPick', `${list.length} ${last}`) && list[last]!.toUpperCase());
</script>

<p class="kid-pick">{kidPick}</p>
