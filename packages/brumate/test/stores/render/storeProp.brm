<script>
  import { $signal } from 'brumate/signals';
  import StorePropWrap from './StorePropWrap.brm';
  import StoreDiamondLeaf from './StoreDiamondLeaf.brm';

  let letters = $signal(['a', 'b', 'c']);
</script>

<button class="grow" onClick=(() => (letters = [...letters, String.fromCharCode(97 + letters.length)]))>Grow</button>
<StorePropWrap size=(letters.length - 1)>
  <StoreDiamondLeaf list=(letters) />
</StorePropWrap>
