<script>
  import { $getContext, $hasContext, $store } from 'brumate/signals';
  import { Field } from './contexts.ts';

  const field = $hasContext(Field) ? $getContext(Field) : undefined;
  // `?.` guards the read as `$hasContext(Field) ? … : undefined` does.
  const state = $store(field?.state);
</script>

<button class="bump" onClick=(() => field?.bump())>{state ? state.count : 'none'}</button>
