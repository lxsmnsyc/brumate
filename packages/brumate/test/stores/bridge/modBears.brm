<script module>
  import { bridge } from 'brumate/store';
  import type { Bridge } from 'brumate/store';
  import { createStore } from './zustand.ts';
  import type { StoreApi } from './zustand.ts';
  import type { ModBears } from './modContext.ts';

  export const modStore: Bridge<StoreApi<ModBears>, { bears: number }> = bridge({
    create: (snapshot?: { bears: number }) => {
      const counts = ((globalThis as { bridgeCounts?: Record<string, number> }).bridgeCounts ??= {});
      counts.create = (counts.create ?? 0) + 1;
      return createStore<ModBears>()((set) => ({
        bears: (globalThis as { bearsStart?: number }).bearsStart ?? snapshot?.bears ?? 0,
        add: () => set((state) => ({ bears: state.bears + 1 })),
      }));
    },
    get: (source) => ({ bears: source.getState().bears }),
    subscribe: (source, listener) => source.subscribe(listener),
    set: (source, value) => {
      const counts = ((globalThis as { bridgeCounts?: Record<string, number> }).bridgeCounts ??= {});
      counts.set = (counts.set ?? 0) + 1;
      source.setState(value);
    },
  });
</script>

<script>
  import { $setContext } from 'brumate/signals';
  import BearPropReader from './BearPropReader.brm';
  import ModLetReader from './ModLetReader.brm';
  import ModReader from './ModReader.brm';
  import { ModContext } from './modContext.ts';

  $setContext(ModContext, modStore({ bears: 2 }));
  const held = modStore({ bears: 5 });
</script>

<ModReader />
<ModReader />
<ModLetReader />
<BearPropReader given=(held) />
