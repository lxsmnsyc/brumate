<script>
  import { $signal } from 'brumate/signals';
  import SpikeButton from './SpikeButton.brm';
  import SpikeLabel from './SpikeLabel.brm';
  import SpikeListBox from './SpikeListBox.brm';
  import SpikePopover from './SpikePopover.brm';
  import SpikeSelect from './SpikeSelect.brm';
  import SpikeValue from './SpikeValue.brm';

  let shown = $signal(false);
</script>

<button class="show" onClick=(() => (shown = true))>Show</button>
#if (shown) {
  <SpikeSelect>
    <SpikeLabel>Animal</SpikeLabel>
    <SpikeButton><SpikeValue /></SpikeButton>
    <SpikePopover>
      <SpikeListBox items=(['Cat', 'Dog']) />
    </SpikePopover>
  </SpikeSelect>
}
