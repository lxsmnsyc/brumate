<script>
  import { $effect, $props } from 'brumate/signals';

  const { value, add } = $props<{ value: number; add: (n: number) => void }>();

  $effect(() => {
    const g = globalThis as { fnReadRuns?: number };
    g.fnReadRuns = (g.fnReadRuns ?? 0) + 1;
    if (g.fnReadRuns > 50) {
      return;
    }
    add(value);
  });
</script>

<p class="value">{value}</p>
