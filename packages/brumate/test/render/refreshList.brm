<script module>
  const names: string[] = ['Ada'];
</script>

<script>
  import { $memo } from 'brumate/signals';
  import { getEvent } from 'brumate/server';

  async function list() {
    'use server';
    return [...names];
  }

  async function add(name: string) {
    'use server';
    const event = getEvent();
    names.push(name);
    event.refresh(list);
  }

  const all = $memo(list());
</script>

<button class="add" onClick=(() => add('Grace'))>Add</button>
<ul class="names">
  #for (name of all by name) {
    <li>{name}</li>
  }
</ul>
