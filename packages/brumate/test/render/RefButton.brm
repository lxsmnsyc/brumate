<script>
  import { $props, type Bindable } from 'brumate/signals';

  // Forwards its button: the element goes through the binding to the signal of the caller.
  let { ref, label = 'Button' } = $props<{ ref?: Bindable<HTMLElement>; label?: string }>();
</script>

<button class="inner" ref=$bind(ref)>{label}</button>
