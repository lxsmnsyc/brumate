<script>
  import { $setContext, $signal, $toStore } from 'brumate/signals';
  import Themed from './ThemedLive.brm';
  import { ThemeStore } from './theme';

  let theme = $signal('dark');
  let show = $signal(false);
  $setContext(ThemeStore, $toStore(theme));
</script>

<button class="toggle" onClick=(() => (theme = theme === 'dark' ? 'light' : 'dark'))>Toggle</button>
<button class="show" onClick=(() => (show = true))>Show</button>
<div class="a"><Themed /></div>
#if (show) {
  <div class="b"><Themed /></div>
}
