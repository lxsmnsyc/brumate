<script>
  import { $memo, $signal } from 'brumate/signals';
  import { gapFail } from './gapData.ts';

  let show = $signal(false);
</script>

<button class="show" onClick=(() => (show = true))>Show</button>
#if (show) {
  <script>
    const value = $memo(gapFail());
    const always = true;
  </script>
  <div>
    #if (always) {
      <p class="value">{value}</p>
    }
  </div>
  <p class="value">{value}</p>
}
