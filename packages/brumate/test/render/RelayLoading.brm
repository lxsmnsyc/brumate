<script>
  import { $bind, $memo, $props, type Bindable } from 'brumate/signals';
  import RefButton from './RefButton.brm';

  let { ref } = $props<{ ref?: Bindable<HTMLElement> }>();
  const data = $memo(Promise.resolve('Loaded'));
</script>

#loading {
  <RefButton ref=$bind(ref) label=(await data) />
} #else {
  <p>Loading</p>
}
