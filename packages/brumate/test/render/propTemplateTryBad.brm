<script>
  import { $signal } from 'brumate/signals';
  import { check } from './templateTryCheck.ts';
  import TemplateTryLaterKid from './TemplateTryLaterKid.brm';

  let n = $signal(2);
</script>

#template boom(value: number) {
  <span class="v">{check(value)}</span>
}

<button class="bad" onClick=(() => (n = 1))>Bad</button>
<TemplateTryLaterKid item=(boom(n)) />
