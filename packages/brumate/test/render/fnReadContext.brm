<script>
  import { $setContext, $signal } from 'brumate/signals';
  import { FnReadTotal } from './fnReadContext.ts';
  import FnReadContextMid from './FnReadContextMid.brm';
  let total = $signal(0);
  function addTotal(n: number) { total += n; }
  function readTotal() { return total; }
  $setContext(FnReadTotal, { add: addTotal, read: readTotal });
</script>
<p class="total">{total}</p>
<FnReadContextMid />
