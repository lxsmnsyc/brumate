<script>
  import { $id, $props, $setContext, $signal, $toStore } from 'brumate/signals';
  import { SelectContext, SelectOpenContext, SelectValueContext } from './selectContext.ts';

  const { children } = $props();
  let open = $signal(false);
  let value = $signal<string | null>(null);
  const labelId = $id();

  $setContext(SelectOpenContext, $toStore(open));
  $setContext(SelectValueContext, $toStore(value));
  $setContext(SelectContext, {
    labelId,
    toggle: () => (open = !open),
    choose: (next: string) => {
      value = next;
      open = false;
    },
  });
</script>

<div class="select" data-open=(open ? '' : undefined)>{children}</div>
