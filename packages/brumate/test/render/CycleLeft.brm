<script>
  import { $props, $signal } from 'brumate/signals';
  import CycleRight from './CycleRight.brm';

  const { depth = 0 } = $props<{ depth?: number }>();
  let count = $signal(0);
</script>

<button class="CycleLeft" onClick=(() => count++)>{count}</button>
#if (depth > 0) {
  <CycleRight depth=(depth - 1) />
}
