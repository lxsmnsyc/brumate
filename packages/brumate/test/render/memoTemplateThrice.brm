<script>
  import { $signal, $memo } from 'brumate/signals';

  let n = $signal(1);
  const shown = $memo(box(n));
</script>

#template box(value: number) {
  <span class="v">{value}</span>
}

<button onClick=(() => n++)>Add</button>
<div class="a">{shown}</div>
<div class="b">{shown}</div>
<div class="c">{shown}</div>
