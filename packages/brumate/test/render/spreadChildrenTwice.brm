<script>
  import { $props, $store } from 'brumate/signals';
  import { Shown } from './spreadChildrenShown.ts';

  // Renders its children at a first insert, and at a second one when the context says so.
  const { children } = $props<{ children?: unknown }>();
  const shown = $store(Shown);
</script>

<div class="sc-twice-1">{children}</div>
<div class="sc-twice-2">{shown ? children : 'none'}</div>
