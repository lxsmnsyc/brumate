<script>
  import { $setContext, $signal, $toStore } from 'brumate/signals';
  import { check } from './templateTryCheck.ts';
  import ContextTemplateTryKid from './ContextTemplateTryKid.brm';
  import { CallStore } from './templateTryStore.ts';

  let c = $signal(boom(2));
  $setContext(CallStore, $toStore(c));
</script>

#template boom(value: number) {
  <span class="v">{check(value)}</span>
}

<button class="bad" onClick=(() => (c = boom(1)))>Bad</button>
<ContextTemplateTryKid />
