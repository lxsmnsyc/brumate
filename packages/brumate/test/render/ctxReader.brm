<script>
  import { $setContext, $signal, $toStore } from 'brumate/signals';
  import { ReaderTotal } from './ctxReader.ts';
  import CtxReaderMid from './CtxReaderMid.brm';
  let total = $signal(0);
  function addTotal(n: number) { total += n; }
  $setContext(ReaderTotal, { total: $toStore(total), add: addTotal });
</script>
<p class="total">{total}</p>
<CtxReaderMid />
