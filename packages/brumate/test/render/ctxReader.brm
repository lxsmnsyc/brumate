<script>
  import { $setContext, $signal } from 'brumate/signals';
  import { ReaderTotal } from './ctxReader.ts';
  import CtxReaderMid from './CtxReaderMid.brm';
  let total = $signal(0);
  function addTotal(n: number) { total += n; }
  function readTotal() { return total; }
  $setContext(ReaderTotal, { add: addTotal, read: readTotal });
</script>
<p class="total">{total}</p>
<CtxReaderMid />
