<script>
  import { $bind, $signal } from 'brumate/signals';
  import BindChild from './BindChild.brm';

  let open = $signal(false);
  let locked = $signal(false);
  let name = $signal('');
  let more = $signal(false);

  function accept(next: boolean) {
    if (!locked) {
      open = next;
    }
  }
</script>

<p class="parent">{open ? 'open' : 'closed'}</p>
<button class="lock" onClick=(() => (locked = !locked))>Lock</button>
<BindChild label="guarded" open=$bind(open, accept) />
<input class="name" value=$bind(name, (next: string) => (name = next.toUpperCase()))>
<p class="name-out">{name}</p>
<button class="more" onClick=(() => (more = true))>More</button>
#if (more) {
  <BindChild label="later" open=$bind(open, accept) />
}
