<script>
  import { $memo } from 'brumate/signals';
  import { load, note } from './startsData.ts';

  const first = await $memo(load('first'));
  note('between');
  // Rejects before the first settles, and throws here, after the statement above.
  const second = await $memo(load('second'));
</script>

<p class="names">{first} {second}</p>
