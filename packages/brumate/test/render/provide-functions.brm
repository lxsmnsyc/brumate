<script>
  import { $setContext, $signal } from 'brumate/signals';
  import { Counter } from './counter-context.ts';
  import CounterButtons from './CounterButtons.brm';

  let count = $signal(0);

  function increment() {
    count++;
  }

  $setContext(Counter, {
    count,
    increment,
    add: (step: number) => (count += step),
    reset() {
      count = 0;
    },
    // A function in an object inside the value, as the slots of a part give them.
    steps: { double: { run: () => (count *= 2) } },
    // Functions in a list, as the items of a menu or the inputs of a thumb give them.
    actions: [{ run: () => (count += 100) }, { run: () => (count -= 1) }],
  });
</script>

<p class="count">{count}</p>
<CounterButtons />
