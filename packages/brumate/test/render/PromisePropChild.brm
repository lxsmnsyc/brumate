<script>
  import { $props } from 'brumate/signals';

  const { value } = $props<{ value: Promise<string> }>();

  function note(name: string, ...values: unknown[]): void {
    ((globalThis as { reads?: unknown[][] }).reads ??= []).push([name, ...values]);
  }

  function read() {
    try {
      note('prop', value);
    } catch (error) {
      note('prop error', (error as Error).message);
    }
  }
</script>

<button class="read" onClick=read>Read</button>
