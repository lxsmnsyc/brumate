<script module>
  export function fail(): Promise<string> {
    return new Promise((_done, reject) => setTimeout(() => reject(new Error('Nope')), 10));
  }
</script>

<script>
  import { $signal } from 'brumate/signals';
  import PromiseRejectChild from './PromiseRejectChild.brm';

  let show = $signal(false);
</script>

<button class="show" onClick=(() => (show = true))>Show</button>
#if (show) {
  <PromiseRejectChild value=(fail()) />
}
