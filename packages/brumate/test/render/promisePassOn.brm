<script module>
  let open: (value: string) => void = () => {};

  function arm(): Promise<string> {
    return new Promise<string>((resolve) => {
      open = resolve;
    });
  }

  export let later = arm();

  export function reset(): void {
    later = arm();
    (globalThis as { later?: Promise<string> }).later = later;
  }

  export function release(value: string): void {
    open(value);
  }
</script>

<script>
  import { $effect, $signal } from "brumate/signals";
  import PromisePlainChild from "./PromisePlainChild.brm";

  let s = $signal(later);
  let n = $signal(0);

  function note(name: string, ...values: unknown[]): void {
    ((globalThis as { reads?: unknown[][] }).reads ??= []).push([name, ...values]);
  }

  $effect(() => {
    note("parent", n, s);
  });
</script>

<button class="parent" onClick=(() => n++)>{n}</button>
<PromisePlainChild value=(later) />
