<script>
  import { $props, $setContext, $signal, $toStore } from 'brumate/signals';
  import { LevelStore } from './tplContext.ts';

  // Provides a context, and renders a template of its caller in the browser.
  const { item } = $props<{ item: (label: string) => unknown }>();
  let labels = $signal<string[]>(['zero']);
  let seven = $signal(7);
  $setContext(LevelStore, $toStore(seven));
</script>

<button class="ctx-add" onClick=(() => (labels = [...labels, 'one']))>Add</button>
#for (label of labels) {
  {item(label)}
}
