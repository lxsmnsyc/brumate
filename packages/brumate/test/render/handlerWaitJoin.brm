<script>
  import { $effect, $signal } from 'brumate/signals';
  import HandlerWaitKidOk from './HandlerWaitKidOk.brm';
  import HandlerWaitKid from './HandlerWaitKid.brm';

  let n = $signal(0);

  $effect(() => {
    ((globalThis as any).__handlerWait ??= []).push(`effect ${n}`);
  });
</script>

<button class="inc" onClick=(() => (n += 1))>Inc</button>
<HandlerWaitKidOk value=n />
<HandlerWaitKid value=n />
