<script>
  import { $signal } from 'brumate/signals';
  import RestLink from './RestLink.brm';

  // A dynamic tag that names a component that spreads its rest props, with a live prop and a handler.
  let as = $signal<any>(RestLink);
  let flag = $signal(true);
  let n = $signal(0);
</script>

<button class="toggle" onClick=(() => (flag = !flag))>Toggle</button>
<{as} title=(String(flag)) class="h" onClick=(() => n++)>hi</>
<p class="n">{n}</p>
