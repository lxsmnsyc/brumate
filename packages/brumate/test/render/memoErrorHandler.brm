<script>
  import { $memo, $signal } from 'brumate/signals';

  let n = $signal(0);
  let m = $signal(0);
  let after = $signal('no');
  let seen = $signal('none');
  const bad = $memo(n > 0 ? (() => {
    throw new Error(`Bad ${n}`);
  })() : 'ok');
</script>

<button class="warm" onClick=(() => m++)>Warm</button>
<p class="m">{m}</p>
<button class="write" onClick=(() => {
  n++;
  after = 'yes';
})>Write</button>
<p class="after">{after}</p>
<p class="seen">{seen}</p>
#try {
  <button class="read" onClick=(() => {
    seen = String(bad);
  })>Read</button>
} #catch (error) {
  <p class="caught">{String(error)}</p>
}
