<script>
  import { $memo, $signal } from 'brumate/signals';
  import { gapLoad, gapNever } from './gapData.ts';

  let show = $signal(false);
</script>

<button class="show" onClick=(() => (show = true))>Show</button>
#if (show) {
  <script>
    const value = $memo(gapLoad());
    const never = $memo(gapNever());
  </script>
  <p class="value">{value}</p>
  <p class="never">{never}</p>
}
