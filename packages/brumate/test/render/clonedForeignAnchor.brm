<script>
  import { $signal } from 'brumate/signals';
  import ClonedAnchor from './ClonedAnchor.brm';

  let open = $signal(false);
  let n = $signal(1);
</script>

<button class="open" onClick=(() => (open = !open))>Open</button>
<button class="more" onClick=(() => (n = n + 1))>More</button>
#if (open) {
  <svg class="host">
    #if (open) {
      <a class="in-if" href="#x">t</a>
    }
    <ClonedAnchor />
    #for (x of Array.from({ length: n }, (_, i) => i)) {
      <a class="in-for" href="#y">{x}<circle r="1" /></a>
    }
    #if (open) {
      <a class="nest" href="#z"><em class="em">e</em></a>
    }
  </svg>
}
