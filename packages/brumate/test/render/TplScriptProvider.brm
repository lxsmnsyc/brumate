<script>
  import { $props, $setContext, $signal, $toStore } from 'brumate/signals';
  import TplReader from './TplReader.brm';
  import { LevelStore } from './tplContext.ts';

  // Provides from the component script, to a reader in place and to children.
  const { children } = $props<{ children?: unknown }>();
  let count = $signal(1);
  $setContext(LevelStore, $toStore(count));
</script>

<button class="script-bump" onClick=(() => count++)>Bump</button>
<div class="in-script">
  <TplReader label="script-direct" />
  {children}
</div>
