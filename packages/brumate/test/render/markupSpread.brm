<script>
  import { $signal } from 'brumate/signals';
  import { markupLoad } from './markupData.ts';

  let show = $signal(false);
</script>

<button class="show" onClick=(() => (show = true))>Show</button>
#if (show) {
  <p class="spread" {...{ title: markupLoad('spread'), lang: 'en' }}>Spread</p>
  <p class="other" {...{ title: markupLoad('other') }}>Other</p>
}
