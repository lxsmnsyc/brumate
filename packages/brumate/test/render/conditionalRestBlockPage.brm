<script>
  import { $bind, $signal } from 'brumate/signals';
  import ConditionalRestBox from './conditionalRestBox.brm';

  let shown = $signal(false);
  let on = $signal(true);
  let root = $signal<HTMLElement>();
  let seen = $signal('');
</script>

<button class="show" onClick=(() => (shown = true))>Show</button>
<button class="flip" onClick=(() => (on = !on))>Flip</button>
<button class="read" onClick=(() => (seen = root ? `${root.tagName}:${root.getAttribute('title')}` : 'none'))>Read</button>
#if (shown) {
  <ConditionalRestBox ref=$bind(root) title="one" {on} />
}
<p class="seen">{seen}</p>
