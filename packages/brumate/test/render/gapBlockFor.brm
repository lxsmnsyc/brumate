<script>
  import { $memo, $props, $signal } from 'brumate/signals';
  import { gapItems } from './gapData.ts';

  const { open = false } = $props();
  let show = $signal(open);
</script>

<button class="show" onClick=(() => (show = true))>Show</button>
#if (show) {
  <script>
    const user = $memo(gapItems());
  </script>
  <ul>
    #for (item of user by item) {
      <li class="item">{item}</li>
    }
  </ul>
}
