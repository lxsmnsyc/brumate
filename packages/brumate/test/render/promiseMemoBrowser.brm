<script module>
  export function fetchName(): Promise<string> {
    return new Promise((done) => setTimeout(() => done('Ada'), 50));
  }
</script>

<script>
  import { $signal } from 'brumate/signals';
  import PromiseMemoChild from './PromiseMemoChild.brm';

  let show = $signal(false);
</script>

<button class="show" onClick=(() => (show = true))>Show</button>
#if (show) {
  <PromiseMemoChild value=(fetchName()) />
}
