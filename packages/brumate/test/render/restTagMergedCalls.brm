<script>
  import { $signal } from 'brumate/signals';
  import CallsClick from './CallsClick.brm';

  // The component calls `props.onClick` itself, so every merged handler runs.
  let as = $signal<any>(CallsClick);
  let flag = $signal(true);
</script>

<button class="toggle" onClick=(() => (flag = !flag))>Toggle</button>
<{as} title=(String(flag)) onClick=(() => (globalThis as any).order.push('a')) onClick=(() => (globalThis as any).order.push('b'))>hi</>
