<script>
  import { $signal } from 'brumate/signals';
  import { check } from './templateTryCheck.ts';

  let box = $signal({ row: boom(2) });
</script>

#template boom(value: number) {
  <span class="v">{check(value)}</span>
}

<button class="bad" onClick=(() => (box = { row: boom(1) }))>Bad</button>
#try {
  <div class="a">{box.row}</div>
} #catch (error) {
  <p class="caught">{String(error)}</p>
}
