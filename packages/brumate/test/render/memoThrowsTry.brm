<script>
  import { $memo, $signal } from 'brumate/signals';

  let count = $signal(0);
  let other = $signal(0);
</script>

<button class="warm" onClick=(() => other++)>Warm</button>
<p class="other">{other}</p>
#try {
  <script>
    const bad = $memo(count > 0 ? (() => {
      throw new Error(`Bad ${count}`);
    })() : 'ok');
    // It throws when it reads the new count with the old value of `bad`.
    const both = $memo(count > 0 && bad === 'ok' ? (() => {
      throw new Error(`Stale ${count}`);
    })() : `${count}/${bad}`);
  </script>
  <button class="bump" onClick=(() => count++)>Bump</button>
  <p class="both">{both}</p>
} #catch (error) {
  <p class="caught">{String(error)}</p>
}
