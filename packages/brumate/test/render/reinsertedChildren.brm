<script>
  import { $signal } from 'brumate/signals';
  import ReinsertProbe from './ReinsertProbe.brm';
  import ReinsertShell from './ReinsertShell.brm';

  // Children that the server renders in a block that the browser closes and opens again.
  let inline = $signal(true);
</script>

<button class="toggle-inline" onClick=(() => (inline = !inline))>Inline</button>
<ReinsertShell open=inline><ReinsertProbe name="inline-probe" /></ReinsertShell>
<ReinsertProbe name="replaced-probe" />
