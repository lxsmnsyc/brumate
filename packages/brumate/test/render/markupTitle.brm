<script>
  import { $signal } from 'brumate/signals';

  let count = $signal(0);
  let draft = $signal(false);
</script>

<title>{`${count} left | Todos`}</title>
<button class="add" onClick=(() => count++)>Add</button>
<button class="edit" onClick=(() => (draft = !draft))>Edit</button>
#if (draft) {
  <title>Unsaved changes &amp; more | Todos</title>
}
<svg><title>Icon</title></svg>
