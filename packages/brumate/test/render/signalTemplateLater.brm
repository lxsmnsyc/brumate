<script>
  import { $signal } from 'brumate/signals';

  let shown = $signal(box(1));
  let open = $signal(false);
</script>

#template box(value: number) {
  <span class="v">{value}</span>
}

<button class="open" onClick=(() => (open = true))>Open</button>
<button class="add" onClick=(() => (shown = box(2)))>Add</button>
<div class="a">{shown}</div>
#if (open) {
  <div class="b">{shown}</div>
}
