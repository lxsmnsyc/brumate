<script>
  import { $memo, $signal } from 'brumate/signals';
  import { loadUser } from './waitData.ts';

  let open = $signal(false);
  let k = $signal(0);
  let ids = $signal<number[]>([]);
</script>

<button class="toggle" onClick=(() => (open = !open))>Toggle</button>
<button class="next" onClick=(() => k++)>Next</button>
<button class="add" onClick=(() => (ids = [...ids, ids.length + 3]))>Add</button>
#if (open) {
  #key (k) {
    <script>
      const c = await $memo(loadUser(30 + k));
    </script>
    <p class="user">key {c.name}</p>
  }
  #try {
    <script>
      const d = await $memo(loadUser(40));
    </script>
    <p class="user">try {d.name}</p>
  } #catch (error) {
    <p class="caught">{String(error)}</p>
  }
}
<ul>
  #for (id of ids by id) {
    <script>
      const first = await $memo(id * 0 + 1);
      const row = await $memo(loadUser(id));
    </script>
    <b class="user">{first} {row.name}</b> !
  }
</ul>
