<script>
  import { $memo, $props, $signal } from 'brumate/signals';
  import { ran } from './runs.ts';
  import { loadUser } from './waitData.ts';

  const { id } = $props<{ id: number }>();
  ran('before', String(id));
  let n = $signal(0);
  const user = await $memo(loadUser(id));
  const upper = $memo(user.name.toUpperCase());
</script>

<p class="user">{user.name} {upper} {n}</p>
<button class="inc" onClick=(() => n++)>+</button>
