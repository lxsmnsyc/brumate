<script>
  import { check } from './templateTryCheck.ts';
  import { $signal, $memo } from 'brumate/signals';

  let n = $signal(1);
  const c = $memo(boom(n));
</script>

#template boom(value: number) {
  <span class="v">{check(value)}</span>
}

<button class="next" onClick=(() => n++)>Next</button>

#try {
  <div class="a">{c}</div>
} #catch (error) {
  <p class="caught">{String(error)}</p>
}

