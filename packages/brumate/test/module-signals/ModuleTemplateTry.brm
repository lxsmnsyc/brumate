<script>
  import { check } from './templateTryCheck.ts';
  import { row, setRow } from './templateTryBox.brm.ts';
</script>

#template boom(value: number) {
  <span class="v">{check(value)}</span>
}

<button class="set" onClick=(() => setRow(boom(2)))>Set</button>
<button class="bad" onClick=(() => setRow(boom(1)))>Bad</button>
#try {
  <div class="a">{row}</div>
} #catch (error) {
  <p class="caught">{String(error)}</p>
}
