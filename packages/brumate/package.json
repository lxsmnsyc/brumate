{
  "name": "brumate",
  "version": "0.2.0",
  "description": "A component language and compiler for resumable web apps",
  "homepage": "https://github.com/lxsmnsyc/brumate",
  "bugs": "https://github.com/lxsmnsyc/brumate/issues",
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/brumate.git",
    "directory": "packages/brumate"
  },
  "bin": {
    "brumate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "types.d.ts",
    "forms"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/runtime/server.d.ts",
      "default": "./dist/runtime/server.js"
    },
    "./client": {
      "types": "./dist/runtime/client.d.ts",
      "default": "./dist/runtime/client.js"
    },
    "./loader": {
      "types": "./dist/runtime/loader.d.ts",
      "default": "./dist/runtime/loader.js"
    },
    "./static-loader": {
      "types": "./dist/runtime/static-loader.d.ts",
      "default": "./dist/runtime/static-loader.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./context": {
      "types": "./dist/runtime/context.d.ts",
      "default": "./dist/runtime/context.js"
    },
    "./html": {
      "types": "./dist/runtime/html.d.ts",
      "default": "./dist/runtime/html.js"
    },
    "./signals": {
      "types": "./dist/runtime/signals.d.ts",
      "default": "./dist/runtime/signals.js"
    },
    "./routes": {
      "types": "./dist/runtime/routes.d.ts",
      "default": "./dist/runtime/routes.js"
    },
    "./batch": {
      "types": "./dist/runtime/batch.d.ts",
      "default": "./dist/runtime/batch.js"
    },
    "./events": {
      "types": "./dist/runtime/events.d.ts",
      "default": "./dist/runtime/events.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./forms": {
      "types": "./forms/forms.brm.ts",
      "default": "./forms/forms.brm.ts"
    },
    "./forms/core": {
      "types": "./dist/runtime/forms.d.ts",
      "default": "./dist/runtime/forms.js"
    },
    "./devtools": {
      "types": "./dist/runtime/devtools.d.ts",
      "default": "./dist/runtime/devtools.js"
    },
    "./hot": {
      "types": "./dist/runtime/hot.d.ts",
      "default": "./dist/runtime/hot.js"
    },
    "./testing": {
      "types": "./dist/runtime/testing.d.ts",
      "default": "./dist/runtime/testing.js"
    },
    "./env": {
      "types": "./dist/runtime/env.d.ts",
      "default": "./dist/runtime/env.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@twinkleplop/core": "0.3.1",
    "@twinkleplop/css": "0.1.7",
    "@twinkleplop/theme-github": "0.2.4",
    "@twinkleplop/tsx": "0.1.7",
    "oxc-parser": "^0.154.0",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.6",
    "seroval": "^1.7.0",
    "seroval-plugins": "^1.7.0"
  },
  "devDependencies": {
    "@oxc-project/types": "^0.154.0",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.6",
    "less": "^4.9.1",
    "sass": "^1.105.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "less": ">=4",
    "sass": ">=1.70",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "less": {
      "optional": true
    },
    "sass": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "brumate": {
    "version": 1,
    "dir": "forms"
  }
}
