{
  "name": "brumate",
  "version": "0.0.0",
  "description": "A component language and compiler for resumable web apps",
  "license": "MIT",
  "author": "Alexis Munsayac",
  "bin": {
    "brumate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/runtime/server.d.ts",
      "default": "./dist/runtime/server.js"
    },
    "./client": {
      "types": "./dist/runtime/client.d.ts",
      "default": "./dist/runtime/client.js"
    },
    "./loader": {
      "types": "./dist/runtime/loader.d.ts",
      "default": "./dist/runtime/loader.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oxc-parser": "^0.154.0",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.6",
    "seroval": "^1.6.11"
  },
  "devDependencies": {
    "@oxc-project/types": "^0.154.0",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.6",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
