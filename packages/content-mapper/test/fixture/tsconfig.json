{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["brumate/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "contentMappers": [{ "package": "../..", "extensions": [".brm"] }],
  "include": ["src"]
}
