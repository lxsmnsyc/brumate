<script module>
  export interface TransitionChildProps {
    /** The content that moves with the transition around it. */
    children?: unknown;
    [prop: string]: unknown;
  }
</script>

<script>
  import { $props } from 'brumate/signals';
  import Transition from './Transition.brm';

  /**
   * An element that moves with the Transition around it, as TransitionChild of Terracotta. It
   * enters once its parent has entered, or with it under `appear`, and its parent leaves once it
   * has left. It takes the props of Transition, except `show`.
   */
  const { children, ...rest } = $props<TransitionChildProps>();
</script>

<Transition {...rest}>{children}</Transition>
