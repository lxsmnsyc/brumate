<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface OverlayArrowProps extends ElementProps<'div'> {
    /** The shape of the arrow, if it is not drawn with CSS. */
    children?: unknown;
  }
</script>

<script>
  import { $props } from 'brumate/signals';
  import { mergeStyle } from './style.ts';

  /**
   * An arrow from a Popover to its trigger. The Popover
   * places it along its side, with `left` or `top`, and gives it `data-placement`, the side of
   * the trigger that the popover is on, so CSS can point it.
   */
  const { children, style, ...rest } = $props<OverlayArrowProps>();
</script>

<div
  data-overlay-arrow
  aria-hidden="true"
  style=(mergeStyle(style, 'position: absolute'))
  {...rest}
>{children}</div>
