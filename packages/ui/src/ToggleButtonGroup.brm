<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';

  export interface ToggleButtonGroupOwnProps<T extends AsTarget = 'div'> {
    /** `single` allows one button on, as radios. `multiple` allows several, as a toolbar. */
    selectionMode?: 'single' | 'multiple';
    /** Keeps at least one button on. */
    disallowEmptySelection?: boolean;
    /** Disables every button of the group. */
    isDisabled?: boolean;
    /** The direction of the buttons. It picks the arrow keys that move focus. */
    orientation?: 'horizontal' | 'vertical';
    /** Runs with the keys of the buttons that are on, when the user changes them. */
    onSelectionChange?: (keys: string[]) => void;
    /** The ToggleButtons of the group. */
    children?: unknown;
    /** The `id` of each button that is on. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    selectedKeys?: Bindable<string[]>;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of ToggleButtonGroup. `as` takes an element name or a component, and the other props
   * are those of the target.
   */
  export type ToggleButtonGroupProps<T extends AsTarget = 'div'> = AsProps<T, ToggleButtonGroupOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $getContext, $props, $setContext } from 'brumate/signals';
  import { ToggleGroupContext, ToolbarContext } from './contexts.ts';
  import { LocaleContext } from './locale.ts';
  import { keepTabStop, moveFocus, preventEdges, rove } from './toolbar.ts';
  import { afterWrite } from './fields.ts';

  /**
   * ToggleButtons with one selection. With `selectionMode="single"`, the default, it is a
   * radiogroup and its buttons are radios. With "multiple", it is a toolbar, or a group inside a
   * Toolbar. The arrow keys move focus between its buttons, as in a Toolbar. It shows
   * `data-orientation` and `data-disabled`.
   *
   * `selectedKeys=([...])` starts its own selection, and `selectedKeys=$bind(signal)` writes the
   * caller's. Each ToggleButton names itself with `id`.
   */
  const {
    as,
    selectionMode = 'single',
    disallowEmptySelection = false,
    isDisabled = false,
    orientation = 'horizontal',
    onSelectionChange,
    children,
    ...rest
  } = $props<ToggleButtonGroupProps<T>>();
  let { selectedKeys = [] } = $props<ToggleButtonGroupOwnProps<T>>();
  let { ref } = $props<ToggleButtonGroupOwnProps<T>>();

  const locale = $getContext(LocaleContext);
  const nested = $getContext(ToolbarContext);

  $client(() => {
    if (!ref) {
      return undefined;
    }
    const stops = [keepTabStop(ref), preventEdges(ref)];
    return () => {
      for (const stop of stops) {
        stop();
      }
    };
  }, 'load');

  function toggle(id: string) {
    let next: string[];
    if (selectedKeys.includes(id)) {
      next = selectedKeys.filter((key) => key !== id);
      if (next.length === 0 && disallowEmptySelection) {
        return;
      }
    } else {
      next = selectionMode === 'single' ? [id] : [...selectedKeys, id];
    }
    const before = selectedKeys;
    selectedKeys = next;
    // The change handler gets the keys that the caller keeps, and only when they changed.
    afterWrite(
      before,
      next,
      () => selectedKeys,
      (kept) => onSelectionChange?.(kept),
    );
  }

  function keyDown(event: KeyboardEvent & { currentTarget: Element }) {
    moveFocus(event.currentTarget, event.key, orientation, locale.direction);
  }

  function focusIn(event: FocusEvent & { currentTarget: Element }) {
    const group = event.currentTarget;
    const target = document.activeElement;
    if (target && group.contains(target)) {
      rove(group, target);
    }
  }

  // A group with one selection is a radiogroup. Another is a toolbar, or a group in a Toolbar.
  function roleOf(mode: string, inToolbar: boolean): string {
    if (mode === 'single') {
      return 'radiogroup';
    }
    return inToolbar ? 'group' : 'toolbar';
  }

  // preventEdges prevents Home and End, and Up and Down of a vertical group, unless a text field
  // or area has the keys for its caret.

  $setContext(ToggleGroupContext, { selectionMode, selectedKeys, isDisabled, toggle });
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  role=(roleOf(selectionMode, nested))
  aria-orientation=(roleOf(selectionMode, nested) === 'group' ? undefined : orientation)
  aria-disabled=(isDisabled ? 'true' : undefined)
  data-orientation=orientation
  data-disabled=(isDisabled || undefined)
  onKeyDown=keyDown
  onFocusIn=focusIn
  {...rest}
>{children}</>
