<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';

  export interface CheckboxGroupOwnProps<T extends AsTarget = 'div'> {
    /** The name that its boxes post with, when a box has none. */
    name?: string;
    /** Disables every box of the group. */
    isDisabled?: boolean;
    /** Makes every box of the group read only. */
    isReadOnly?: boolean;
    /** Asks for at least one checked box when the form is sent. */
    isRequired?: boolean;
    /** Marks the group as invalid. */
    isInvalid?: boolean;
    /** Runs with the values of the checked boxes when the user changes them. */
    onChange?: (value: string[]) => void;
    /** The Label, Checkboxes, Text and FieldError of the group. */
    children?: unknown;
    /** The `value` of each checked box. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    value?: Bindable<string[]>;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of CheckboxGroup. `as` takes an element name or a component, and the other props are
   * those of the target.
   */
  export type CheckboxGroupProps<T extends AsTarget = 'div'> = AsProps<T, CheckboxGroupOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $id, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import {
    CheckboxGroupContext,
    FieldErrorContext,
    LabelContext,
    TextContext,
  } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { describedBy } from './fields.ts';

  /**
   * A group of checkboxes. It holds a Label, its
   * Checkboxes, a Text with `slot="description"` and a FieldError. Its value is the values of
   * the checked boxes. The element shows `data-disabled`, `data-readonly`, `data-invalid` and
   * `data-required`.
   *
   * `value=([...])` starts its own value, and `value=$bind(signal)` writes the caller's. With
   * `isRequired`, the browser asks for a box when the form is sent.
   *
   * The browser knows no required group of checkboxes, only required boxes. So the boxes are
   * required only once the code of the group runs, which makes them optional as soon as one is
   * checked. Without scripts, the form posts with no box checked, and the server checks it.
   */
  const {
    as,
    name,
    isDisabled = false,
    isReadOnly = false,
    isRequired = false,
    isInvalid = false,
    onChange,
    children,
    ...rest
  } = $props<CheckboxGroupProps<T>>();
  let { value = [] } = $props<CheckboxGroupOwnProps<T>>();
  let { ref } = $props<CheckboxGroupOwnProps<T>>();

  const labelId = $id();
  const descriptionId = $id();
  const { present: hasDescription } = described(descriptionId);
  const errorId = $id();
  // The message of the browser, after a submit with no box checked.
  let message = $signal('');
  const errors = $memo(message && value.length === 0 ? [message] : []);
  const invalid = $memo(isInvalid || errors.length > 0);

  function toggle(item: string, checked: boolean) {
    value = checked ? [...value.filter((other) => other !== item), item] : value.filter((other) => other !== item);
    onChange?.(value);
  }

  function invalidated(text: string) {
    message = text;
  }

  // The code of the group runs, so it can make the boxes optional when one is checked. It stays
  // on 'load', since a form can submit before the page is idle, and a box that is required would
  // block it.
  let running = $signal(false);
  $client(() => {
    running = true;
  }, 'load');

  $setContext(LabelContext, { id: labelId });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(FieldErrorContext, { id: errorId, isInvalid: invalid, errors });
  $setContext(CheckboxGroupContext, {
    name,
    value,
    isDisabled,
    isReadOnly,
    isInvalid: invalid,
    // Each box is required while none is checked, so the browser checks the group on a submit.
    isRequired: isRequired && running && value.length === 0,
    describedBy: describedBy(invalid && errorId),
    toggle,
    onInvalid: invalidated,
  });
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  role="group"
  aria-labelledby=labelId
  aria-describedby=(describedBy(hasDescription && descriptionId, invalid && errorId))
  data-disabled=(isDisabled || undefined)
  data-readonly=(isReadOnly || undefined)
  data-invalid=(invalid || undefined)
  data-required=(isRequired || undefined)
  {...rest}
>{children}</>
