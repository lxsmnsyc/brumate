<script module>
  import type { Bindable } from 'brumate/signals';
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Key } from './collection.ts';

  export interface TabPanelOwnProps<T extends AsTarget = 'div'> {
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
    /** The key of the tab that shows this panel. */
    id: Key;
    /** Keeps the panel on the page, hidden, while its tab is not selected. */
    shouldForceMount?: boolean;
    /** The content of the panel. */
    children?: unknown;
  }

  /**
   * The props of TabPanel. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type TabPanelProps<T extends AsTarget = 'div'> = AsProps<T, TabPanelOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $effect, $getContext, $memo, $props, $signal, $untrack } from 'brumate/signals';
  import { tabbables } from './overlay.ts';
  import { TabsContext, getSelectedKey, tabId } from './tabs.ts';

  /**
   * The panel of a tab. `id` is the key of its Tab.
   *
   * - Only the panel of the selected tab renders its content. Showing it again renders it anew,
   *   with new state. `shouldForceMount` keeps it on the page, hidden.
   * - It takes Tab when it has no content that does, so it can be reached.
   */
  const {
    as,
    id,
    shouldForceMount = false,
    children,
    ...rest
  } = $props<TabPanelProps<T>>();
  let { ref } = $props<TabPanelOwnProps<T>>();

  const tabs = $getContext(TabsContext);
  const selected = $memo(Boolean(tabs) && getSelectedKey(tabs!) === id);
  // Whether the content takes Tab, which the browser checks. The server renders the panel as one
  // that takes Tab itself.
  let hasTabbable = $signal(false);
  function measure() {
    const element = ref;
    hasTabbable = Boolean(element && tabbables(element).length > 0);
  }
  $client(() => measure(), 'visible');
  $effect(() => {
    void selected;
    queueMicrotask(() => $untrack(measure()));
  });
</script>

#if (selected || shouldForceMount) {
  <{as ?? 'div'}
    id=(tabs ? tabId(tabs, id, 'panel') : undefined)
    ref=$bind(ref)
    role="tabpanel"
    tabindex=(hasTabbable ? undefined : '0')
    aria-labelledby=(tabs ? tabId(tabs, id, 'tab') : undefined)
    hidden=(!selected || undefined)
    {...rest}
  >{children}</>
}
