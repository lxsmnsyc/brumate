<script module>
  import type { AsProps, AsTarget } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { Key } from './collection.ts';

  export interface TabsOwnProps {
    /** The keys of the tabs that cannot be selected. */
    disabledKeys?: Key[];
    /** Disables all the tabs. */
    isDisabled?: boolean;
    /** The axis of the tabs: `horizontal` uses Left and Right, and `vertical` uses all four arrows. */
    orientation?: 'horizontal' | 'vertical';
    /** `automatic` selects the tab that the arrow keys move to. `manual` selects it with Enter or Space. */
    keyboardActivation?: 'automatic' | 'manual';
    /** Runs with the key of each newly selected tab. */
    onSelectionChange?: (key: Key) => void;
    /** A `TabList` and the `TabPanel` elements. */
    children?: unknown;
    /** The key of the selected tab. Starts its own state, or binds with `$bind`. */
    selectedKey?: Bindable<Key | null>;
  }

  /**
   * The props of Tabs. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type TabsProps<T extends AsTarget = 'div'> = AsProps<T, TabsOwnProps>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $effect, $id, $props, $setContext, $signal, $untrack } from 'brumate/signals';
  import { enabledItems, keyOf } from './collection.ts';
  import { TabsContext } from './tabs.ts';
  import { afterWrite } from './fields.ts';

  /**
   * Tabs that show one panel at a time. It holds a TabList with
   * Tab elements, and a TabPanel for each tab, with the same `id`.
   *
   * - `selectedKey` is the key of the selected tab. With none, the first tab is selected. A key
   *   of a tab that is not there, or is disabled, selects the first tab that is enabled.
   *   `selectedKey=(key)` starts its own, and `selectedKey=$bind(signal)` writes the caller's.
   * - `keyboardActivation="automatic"`, the default, selects a tab when the arrow keys move to it.
   *   `"manual"` selects it with Enter or Space.
   * - `orientation` is `horizontal` (the default) or `vertical`.
   * - It shows `data-orientation`.
   */
  const {
    as = 'div',
    disabledKeys = [],
    isDisabled = false,
    orientation = 'horizontal',
    keyboardActivation = 'automatic',
    onSelectionChange,
    children,
    ...rest
  } = $props<TabsProps<T>>();
  let { selectedKey = null } = $props<TabsProps<T>>();

  const id = $id();
  // The Tabs write the key of the first one here as they render. See `TabsState`.
  const registry: { first?: Key } = {};

  let root = $signal<HTMLElement>();

  /**
   * In the browser, a selection that no tab shows, such as of a key that has no tab or of a
   * disabled tab, goes to the first tab that is enabled.
   */
  function check() {
    const element = root;
    if (!element || element.querySelector('[role=tab][aria-selected=true]:not([aria-disabled=true])')) {
      return;
    }
    const list = element.querySelector<HTMLElement>('[role=tablist][data-collection]');
    const first = list ? enabledItems(list, 'tab')[0] : undefined;
    const key = first ? keyOf(first) : undefined;
    if (key !== undefined) {
      const before = selectedKey;
      selectedKey = key;
      afterWrite(
        before,
        key,
        () => selectedKey,
        (kept) => onSelectionChange?.(kept as Key),
      );
    }
  }
  $client(() => check(), 'idle');
  $effect(() => {
    void selectedKey;
    // The tabs update after the key does.
    queueMicrotask(() => $untrack(check()));
  });

  function select(key: Key) {
    if (key !== selectedKey && !isDisabled && !disabledKeys.includes(key)) {
      const before = selectedKey;
      selectedKey = key;
      // The change handler gets the key that the caller keeps, and only when it changed.
      afterWrite(
        before,
        key,
        () => selectedKey,
        (kept) => onSelectionChange?.(kept as Key),
      );
    }
  }

  $setContext(TabsContext, {
    selectedKey,
    registry,
    disabledKeys,
    isDisabled,
    orientation,
    keyboardActivation,
    id,
    select,
  });
</script>

<{as} ref=$bind(root) data-orientation=orientation {...rest}>{children}</>
