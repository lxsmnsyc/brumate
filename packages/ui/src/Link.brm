<script module>
  import type { Bindable } from 'brumate/signals';
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { HoverEvent, PressEvent } from './events.ts';

  export interface LinkOwnProps<T extends AsTarget = 'a'> {
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
    /** The address to follow. Without it, the link is an element with `role="link"`. */
    href?: string;
    /** The slot of the context of a part that holds this link. */
    slot?: string | null;
    /** Disables the link. A disabled link renders with no `href` and leaves the order of Tab. */
    isDisabled?: boolean;
    /** The link is to the current page, as in Breadcrumbs. */
    isCurrent?: boolean;
    /** Runs when a press ends on the link. */
    onPress?: (event: PressEvent) => void;
    /** Runs when a press starts. */
    onPressStart?: (event: PressEvent) => void;
    /** Runs when a press ends, on the link or off it. */
    onPressEnd?: (event: PressEvent) => void;
    /** Runs when a pointer or a key is released over the link. */
    onPressUp?: (event: PressEvent) => void;
    /** Runs when the link starts or stops being pressed. */
    onPressChange?: (pressed: boolean) => void;
    /** Runs when a mouse or a pen moves over the link. */
    onHoverStart?: (event: HoverEvent) => void;
    /** Runs when a mouse or a pen leaves the link. */
    onHoverEnd?: (event: HoverEvent) => void;
    /** Runs when the link starts or stops being hovered. */
    onHoverChange?: (hovered: boolean) => void;
    /** Runs when the link gains or loses focus. */
    onFocusChange?: (focused: boolean) => void;
    /** The content of the link. */
    children?: unknown;
  }

  /**
   * The props of Link. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type LinkProps<T extends AsTarget = 'a'> = AsProps<T, LinkOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'a'">
  import { $getContext, $memo, $props } from 'brumate/signals';
  import { LinkContext } from './contexts.ts';
  import { interact } from './interact.brm.ts';
  import { contextAttributes, slotProps } from './slots.ts';

  /**
   * A link. With `href` it is an <a>, and without it an element
   * with role="link". It presses as a Button does, and the browser follows the link. Its state
   * is in `data-current`, `data-pressed`, `data-hovered`, `data-focused`, `data-focus-visible`
   * and `data-disabled`.
   *
   * A disabled link is a <span> with no `href`, so the browser does not follow it, and it leaves
   * the order of Tab, since it has no `tabindex`.
   */
  const {
    href,
    slot,
    isDisabled,
    isCurrent,
    onPress,
    onPressStart,
    onPressEnd,
    onPressUp,
    onPressChange,
    onHoverStart,
    onHoverEnd,
    onHoverChange,
    onFocusChange,
    children,
    ...rest
  } = $props<LinkOwnProps<T>>();
  // The props of the target of `as`, for the type of the component.
  const { as } = $props<LinkProps<T>>();
  let { ref } = $props<LinkOwnProps<T>>();

  const context = $getContext(LinkContext);
  const attributes = $memo(contextAttributes(slotProps(context, slot)));
  const disabled = $memo(Boolean(isDisabled ?? slotProps(context, slot).isDisabled));
  const current = $memo(Boolean(isCurrent ?? slotProps(context, slot).isCurrent));
  const linked = $memo(href !== undefined && !disabled);
  const element = $memo((as ?? (linked ? 'a' : 'span')) as AsTarget);
  const native = $memo(element === 'a' && linked);

  function given() {
    return slotProps(context, slot);
  }
  // The handlers of the context run first, then the link's own, as Button's do.
  function pressed(event: PressEvent) {
    given().onPress?.(event);
    onPress?.(event);
  }
  function pressStarted(event: PressEvent) {
    given().onPressStart?.(event);
    onPressStart?.(event);
  }
  function pressEnded(event: PressEvent) {
    given().onPressEnd?.(event);
    onPressEnd?.(event);
  }
  function pressUp(event: PressEvent) {
    given().onPressUp?.(event);
    onPressUp?.(event);
  }
  function pressChanged(value: boolean) {
    given().onPressChange?.(value);
    onPressChange?.(value);
  }
  function hoverStarted(event: HoverEvent) {
    given().onHoverStart?.(event);
    onHoverStart?.(event);
  }
  function hoverEnded(event: HoverEvent) {
    given().onHoverEnd?.(event);
    onHoverEnd?.(event);
  }
  function hoverChanged(value: boolean) {
    given().onHoverChange?.(value);
    onHoverChange?.(value);
  }
  function focusChanged(value: boolean) {
    given().onFocusChange?.(value);
    onFocusChange?.(value);
  }

  const {
    pressed: isPressed,
    hovered,
    focused,
    focusVisible,
    onPointerDown,
    onPointerMove,
    onPointerUp,
    onPointerCancel,
    onLostPointerCapture,
    onPointerEnter,
    onPointerLeave,
    onKeyDown,
    onKeyUp,
    onClick,
    onFocus,
    onBlur,
  } = interact(
    disabled,
    disabled,
    pressed,
    pressStarted,
    pressEnded,
    pressUp,
    pressChanged,
    hoverStarted,
    hoverEnded,
    hoverChanged,
    focusChanged,
  );
</script>

<{element}
  ref=$bind(ref)
  href=(linked ? href : undefined)
  role=(native ? undefined : 'link')
  tabindex=(native || disabled ? undefined : 0)
  aria-disabled=(disabled ? 'true' : undefined)
  aria-current=(current ? 'page' : undefined)
  data-current=(current || undefined)
  data-pressed=(isPressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(disabled || undefined)
  {onPointerDown}
  {onPointerMove}
  {onPointerUp}
  {onPointerCancel}
  {onLostPointerCapture}
  {onPointerEnter}
  {onPointerLeave}
  {onKeyDown}
  {onKeyUp}
  {onClick}
  {onFocus}
  {onBlur}
  {...attributes}
  {...rest}
>{children}</>
