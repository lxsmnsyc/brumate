<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { DateString } from './calendar.ts';

  export interface CalendarCellProps extends ElementProps<'div'> {
    /** The date as `YYYY-MM-DD`. */
    date: DateString;
    /** The content of the date. Without it, the cell shows the number of the day. */
    children?: unknown;
  }
</script>

<script>
  import { $getContext, $memo, $props } from 'brumate/signals';
  import {
    CalendarContext,
    CalendarGridContext,
    cellLabel,
    dayNumber,
    outOfRange,
    toDate,
  } from './calendar.ts';

  /**
   * A date in a CalendarGrid. It renders a `<td>` with
   * a button inside, which holds the number of the day, or `children`.
   *
   * - A press selects the date. Only the focused date is in the order of Tab.
   * - The button shows `data-selected`, `data-selection-start`, `data-selection-end`,
   *   `data-focused`, `data-focus-visible`, `data-today`,
   *   `data-disabled`, `data-unavailable`, `data-outside-month`, `data-outside-visible-range`,
   *   `data-invalid` and `data-pressed`.
   * - A date outside the month of its grid is disabled, and its button is hidden.
   */
  const { date, children, ...rest } = $props<CalendarCellProps>();

  const calendar = $getContext(CalendarContext);
  const grid = $getContext(CalendarGridContext);
  // A date is in the month of its grid when they share the year and the month, `YYYY-MM`.
  const outsideMonth = $memo(grid ? date.slice(0, 7) !== grid.start.slice(0, 7) : false);
  const outsideRange = $memo(
    calendar ? date < calendar.start || date > calendar.end : false,
  );
  const disabled = $memo(
    !calendar ||
      calendar.isDisabled ||
      outsideMonth ||
      outOfRange(toDate(date), calendar.minValue, calendar.maxValue),
  );
  const unavailable = $memo(
    !disabled && (calendar?.isDateUnavailable?.(date) ?? false),
  );
  // After the first date of a range, a date past the nearest one that cannot be picked is out of
  // reach invalid.
  const unreachable = $memo(
    Boolean(
      calendar?.available &&
        ((calendar.available[0] !== undefined && date < calendar.available[0]) ||
          (calendar.available[1] !== undefined && date > calendar.available[1])),
    ),
  );
  const selectable = $memo(!disabled && !unavailable && !unreachable);
  // In the dates that show as selected: one date, or a range.
  const inSelection = $memo(
    Boolean(calendar?.selection && calendar.selection[0] <= date && date <= calendar.selection[1]),
  );
  const invalidValue = $memo(Boolean(calendar?.isInvalid && inSelection));
  const invalid = $memo(invalidValue || (unreachable && !disabled));
  const selected = $memo((selectable && inSelection) || (invalidValue && !disabled));
  const selectionStart = $memo(selected && calendar?.selection?.[0] === date);
  const selectionEnd = $memo(selected && calendar?.selection?.[1] === date);
  // The date that gets focus, which shows `data-focused` only while focus is in the grid.
  const current = $memo(!outsideMonth && calendar?.focusedDate === date);
  const focused = $memo(current && Boolean(calendar?.isFocused));
  const label = $memo(calendar ? cellLabel(calendar, date, selected) : date);
  const number = $memo(calendar ? dayNumber(date, calendar.locale) : String(Number(date.slice(8))));

  function pressed(event: MouseEvent) {
    if (!calendar || !selectable) {
      return;
    }
    // The press of the pointer that started a range already selected this date.
    if (calendar.startedBy(date)) {
      (event.currentTarget as HTMLElement).focus({ preventScroll: true });
      return;
    }
    if (calendar.isReadOnly) {
      calendar.focusDate(date);
      return;
    }
    calendar.selectDate(date);
    (event.currentTarget as HTMLElement).focus({ preventScroll: true });
  }

  function focusIn(event: FocusEvent) {
    const target = event.currentTarget as HTMLElement;
    // The handler can run after its code loads, when a key has moved focus on. Only the cell that
    // still has focus moves the focused date.
    if (target !== document.activeElement) {
      return;
    }
    target.toggleAttribute('data-focus-visible', target.matches(':focus-visible'));
    if (calendar && !disabled) {
      calendar.cellFocused(date);
    }
  }

  function focusOut(event: FocusEvent) {
    (event.currentTarget as HTMLElement).removeAttribute('data-focus-visible');
  }

  // After the first press of a range, the date under the pointer ends the range that shows.
  function pointerEnter() {
    if (calendar && selectable) {
      calendar.highlight(date);
    }
  }

  function pointerDown(event: PointerEvent) {
    const target = event.currentTarget as HTMLElement;
    target.setAttribute('data-pressed', '');
    if (calendar && selectable) {
      calendar.pressStart(date, event);
    }
  }

  function pointerUp(event: PointerEvent) {
    (event.currentTarget as HTMLElement).removeAttribute('data-pressed');
  }

  // A release on a date after a press on another one ends the range there.
  function released(event: PointerEvent) {
    pointerUp(event);
    if (calendar && selectable) {
      calendar.pressEnd(date);
    }
  }
</script>

<td
  role="gridcell"
  aria-disabled=(!selectable || undefined)
  aria-selected=(selected || undefined)
  aria-invalid=(invalidValue || undefined)
>
  <div
    role="button"
    tabindex=(disabled ? undefined : current ? '0' : '-1')
    autofocus=((calendar?.autoFocus && current) || undefined)
    aria-label=label
    aria-disabled=(!selectable || undefined)
    aria-invalid=(invalid || undefined)
    aria-describedby=(invalidValue && calendar ? calendar.errorId : undefined)
    hidden=(outsideMonth || undefined)
    data-calendar=(calendar?.id)
    data-date=date
    data-selected=(selected || undefined)
    data-selection-start=(selectionStart || undefined)
    data-selection-end=(selectionEnd || undefined)
    data-focused=(focused || undefined)
    data-today=(calendar?.today === date || undefined)
    data-disabled=(disabled || undefined)
    data-unavailable=(unavailable || undefined)
    data-outside-month=(outsideMonth || undefined)
    data-outside-visible-range=(outsideRange || undefined)
    data-invalid=(invalid || undefined)
    onClick=pressed
    onFocusIn=focusIn
    onFocusOut=focusOut
    onPointerEnter=pointerEnter
    onPointerDown=pointerDown
    onPointerUp=released
    onPointerLeave=pointerUp
    {...rest}
  >{children ?? number}</div>
</td>
