<script module>
  import type { TreeNode, TreeRow } from './tree.ts';

  export interface TreeRowProps<V extends TreeNode = TreeNode> {
    row: TreeRow;
    item: (node: V) => unknown;
  }
</script>

<script generics="V extends TreeNode">
  import { $memo, $props, $setContext, $toStore } from 'brumate/signals';
  import { TreeRowContext } from './tree.ts';

  /**
   * One row of a Tree: it gives the TreeItem that the `item` template of the Tree renders its
   * place in the tree. The Tree renders it for each row that shows.
   */
  const { row, item } = $props<TreeRowProps<V>>();

  const rowState = $memo({ row });
  $setContext(TreeRowContext, $toStore(rowState));
</script>

{item(row.item as V)}
