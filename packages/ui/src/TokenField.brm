<script module>
  import type { Bindable } from 'brumate/signals';
  import type { TokenSegment } from './token-field.ts';

  export interface TokenFieldProps {
    /** A regular expression, as a string. Text that matches it becomes a token once a space follows it. */
    pattern?: string;
    /** The hint that the box shows while it is empty. */
    placeholder?: string;
    /** Lets Enter add a new line. */
    allowsNewlines?: boolean;
    /** Disables the field. */
    isDisabled?: boolean;
    /** Makes the field read only. */
    isReadOnly?: boolean;
    /** `textbox`, or `searchbox` for a field that searches. */
    role?: 'textbox' | 'searchbox';
    /** The name of a hidden input that posts the text of the value with the form. */
    name?: string;
    /** Runs with the segments each time the value changes. */
    onChange?: (value: TokenSegment[]) => void;
    /** The Label, TokenInput and Text of the field. */
    children?: unknown;
    /** The segments, each `{ type: 'text' | 'token', text }`. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    value?: Bindable<TokenSegment[]>;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $id, $memo, $props, $setContext } from 'brumate/signals';
  import { LabelContext, TextContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { TokenFieldContext, sameSegments, segmentsText } from './token-field.ts';

  /**
   * A field of text with tokens in it, such as tags, mentions or commands. It holds a Label, a
   * TokenInput, and a Text with `slot="description"`.
   *
   * - `value` is an array of segments, `{ type: 'text' | 'token', text }`, which the page state
   *   holds. `onChange` hears of changes.
   * - `pattern` is a regular expression, as a string, whose matches become tokens once a space
   *   follows them, such as `'[#@]\\S+'` for tags and mentions.
   * - `placeholder`, `allowsNewlines`, `isDisabled`, `isReadOnly`, and `role`: `textbox`, or
   *   `searchbox`.
   * - With `name`, a form sends the text of the value.
   */
  const {
    pattern,
    placeholder,
    allowsNewlines = false,
    isDisabled = false,
    isReadOnly = false,
    role = 'textbox',
    name,
    onChange,
    children,
    ...rest
  } = $props<TokenFieldProps>();
  let { value = [] } = $props<TokenFieldProps>();

  const labelId = $id();
  const descriptionId = $id();
  const { present: hasDescription } = described(descriptionId);
  const text = $memo(segmentsText(value));

  function setValue(next: TokenSegment[]) {
    if (!sameSegments(next, value)) {
      value = next;
      onChange?.(next);
    }
  }

  // The box of the field is no element that a label can point at, so the label names it by ID.
  $setContext(LabelContext, { id: labelId });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(TokenFieldContext, {
    value,
    setValue,
    pattern,
    placeholder,
    allowsNewlines,
    isDisabled,
    isReadOnly,
    // The box has no popup, so it is no combobox.
    role: role === 'searchbox' ? 'searchbox' : 'textbox',
    labelId,
    descriptionId: hasDescription ? descriptionId : undefined,
  });
</script>

<div data-disabled=(isDisabled || undefined) data-readonly=(isReadOnly || undefined) {...rest}>
  {children}
  #if (name) {
    <input type="hidden" {name} value=text disabled=(isDisabled || undefined) />
  }
</div>
