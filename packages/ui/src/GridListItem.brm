<script module>
  import type { Bindable } from 'brumate/signals';
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Key } from './collection.ts';

  export interface GridListItemOwnProps<T extends AsTarget = 'div'> {
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
    /** The key of the row. */
    id: Key;
    /** The text that typing matches, for an item whose content is more than text. */
    textValue?: string;
    /** Keeps the row from focus and selection. */
    isDisabled?: boolean;
    /** Runs when a press or Enter acts on the row. */
    onAction?: () => void;
    /** The content of the row, such as text, a Checkbox and a Button. */
    children?: unknown;
  }

  /**
   * The props of GridListItem. `as` takes an element name or a component, and the other props are
   * those of the target.
   */
  export type GridListItemProps<T extends AsTarget = 'div'> = AsProps<T, GridListItemOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { SelectionIndicatorContext } from './selection-indicator.ts';
  import { $getContext, $isPassed, $memo, $props, $setContext } from 'brumate/signals';
  import { ListBoxContext, keyAttribute } from './collection.ts';
  import { ButtonContext, CheckboxGroupContext } from './contexts.ts';
  import { DEFAULT_SLOT } from './slots.ts';
  import { interact } from './interact.brm.ts';

  /**
   * A row of a GridList. `id` is its key. It can hold
   * buttons, links and checkboxes, which Left and Right reach.
   *
   * - A press selects it, as the GridList says, or acts on it when nothing is selectable.
   * - A Checkbox with `slot="selection"` and no `value` shows its selection and toggles it.
   * - `textValue` is the text that typeahead matches, when its content is more than text. It
   *   names the drag button too.
   * - In a GridList with `onReorder`, a Button with `slot="drag"` starts a drag from the keys. The
   *   row shows `data-dragging` while a drag moves it, and `data-drop-target` with `before` or
   *   `after` while a drag would drop by it.
   * - It shows `data-selected`, `data-disabled`, `data-pressed`, `data-hovered`, `data-focused`
   *   and `data-focus-visible`.
   */
  const {
    as,
    id,
    textValue,
    isDisabled = false,
    onAction,
    children,
    ...rest
  } = $props<GridListItemProps<T>>();
  let { ref } = $props<GridListItemOwnProps<T>>();

  const list = $getContext(ListBoxContext);
  // Enter on an item with `onAction` of its own reaches it through an `itemaction` event.
  const acts = $isPassed(onAction);
  const mode = $memo(list?.selectionMode ?? 'none');
  const selected = $memo(Boolean(list?.selectedKeys.includes(id)));
  const disabled = $memo(isDisabled || Boolean(list?.disabledKeys.includes(id)));

  // The Checkbox of the selection is checked while the row is selected, and toggles it.
  $setContext(CheckboxGroupContext, {
    value: selected ? [''] : [],
    isDisabled: disabled || mode === 'none',
    isReadOnly: false,
    isInvalid: false,
    isRequired: false,
    toggle: () => list?.select(id, { shift: false, toggle: true }),
    onInvalid: () => {},
  });

  function pressed(event: { shiftKey: boolean; ctrlKey: boolean; metaKey: boolean }) {
    if (!list) {
      return;
    }
    if (mode === 'none') {
      onAction?.();
      list.action(id);
      return;
    }
    list.select(id, {
      shift: event.shiftKey,
      toggle: list.selectionBehavior === 'toggle' || event.ctrlKey || event.metaKey,
    });
  }

  // The keys of a row are the GridList's, so the row takes the pointer, the focus and the hover.
  const {
    pressed: isPressed,
    hovered,
    focused,
    focusVisible,
    onPointerDown: pressDown,
    onPointerMove,
    onPointerUp,
    onPointerCancel,
    onPointerEnter,
    onPointerLeave,
    onClick: pressClick,
    onFocus,
    onBlur,
  } = interact(
    disabled,
    disabled,
    pressed,
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
  );

  /** True for an event that starts on a control in the row, such as a button, whose press it is. */
  function fromControl(event: Event): boolean {
    const control = (event.target as Element).closest?.(
      'a[href], button, input, select, textarea, label, [tabindex]',
    );
    return Boolean(control) && control !== event.currentTarget;
  }

  function onPointerDown(event: PointerEvent) {
    if (!fromControl(event)) {
      pressDown(event);
    }
  }

  function onClick(event: MouseEvent) {
    if (!fromControl(event)) {
      pressClick(event);
    }
  }
  const isDragging = $memo(Boolean(list?.dragging?.includes(id)));
  const dropPosition = $memo(list?.dropTarget?.key === id ? list.dropTarget.dropPosition : undefined);

  // A Button with `slot="drag"` starts a drag from the keys, in a list with `onReorder`. Other
  // buttons get nothing.
  $setContext(ButtonContext, {
    slots: {
      [DEFAULT_SLOT]: {},
      drag: {
        'aria-label': textValue ? `Drag ${textValue}` : 'Drag',
        isDisabled: disabled || !list?.isReorderable,
        onPress: () => list?.startDrag?.(id),
      },
    },
  });

  // A SelectionIndicator inside marks the item while it is selected.
  $setContext(SelectionIndicatorContext, { isSelected: selected });
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  role="row"
  data-action=(acts || undefined)
  onItemaction=(() => onAction?.())
  tabindex="-1"
  data-key=(keyAttribute(id))
  data-text-value=textValue
  aria-selected=(mode === 'none' ? undefined : String(selected))
  aria-disabled=(disabled ? 'true' : undefined)
  data-selected=(selected || undefined)
  data-disabled=(disabled || undefined)
  data-pressed=(isPressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  draggable=(list?.isDraggable && !disabled ? 'true' : undefined)
  data-dragging=(isDragging || undefined)
  data-drop-target=dropPosition
  {onPointerDown}
  {onPointerMove}
  {onPointerUp}
  {onPointerCancel}
  {onPointerEnter}
  {onPointerLeave}
  {onClick}
  {onFocus}
  {onBlur}
  {...rest}
><div role="gridcell" style="display: contents">{children}</div></>
