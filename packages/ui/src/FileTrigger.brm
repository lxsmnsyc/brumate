<script module>
  export interface FileTriggerProps {
    acceptedFileTypes?: string[];
    allowsMultiple?: boolean;
    defaultCamera?: 'user' | 'environment';
    acceptDirectory?: boolean;
    name?: string;
    onSelect?: (files: FileList | null) => void;
    children?: unknown;
  }
</script>

<script>
  import { $id, $props, $setContext } from 'brumate/signals';
  import { ButtonContext } from './contexts.ts';

  /**
   * Opens the file picker of the browser from a Button inside. `onSelect` gets the files that the
   * user picked. The input is hidden, so the picker needs scripts. For a form that works without
   * them, use a visible file input.
   */
  const {
    acceptedFileTypes,
    allowsMultiple = false,
    defaultCamera,
    acceptDirectory = false,
    name,
    onSelect,
    children,
  } = $props<FileTriggerProps>();

  const inputId = $id();

  // The input forgets the files of before, so a change fires when the user picks the same file
  // again, such as after an upload that failed.
  function open() {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    if (input) {
      input.value = '';
      input.click();
    }
  }

  function change(event: Event) {
    onSelect?.((event.currentTarget as HTMLInputElement).files);
  }

  $setContext(ButtonContext, { onPress: open });
</script>

{children}
<input
  id=inputId
  type="file"
  hidden
  {name}
  accept=(acceptedFileTypes?.join(','))
  multiple=(allowsMultiple || undefined)
  capture=defaultCamera
  webkitdirectory=(acceptDirectory || undefined)
  onChange=change
>
