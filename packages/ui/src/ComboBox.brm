<script module>
  import type { AsProps, AsTarget } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { Key } from './collection.ts';

  export interface ComboBoxOwnProps {
    /** The name that sends the value with the form. */
    name?: string;
    /** Disables the input and the Button. */
    isDisabled?: boolean;
    /** Makes the input required. */
    isRequired?: boolean;
    /** Marks the field invalid. */
    isInvalid?: boolean;
    /** Keeps text that is not the text of an item, and clears the selection when the text differs. */
    allowsCustomValue?: boolean;
    /** What the form gets: the key of the selection, or the text of the input. */
    formValue?: 'key' | 'text';
    /** What opens the list: typing (the default), focus, or only the keys and the Button. */
    menuTrigger?: 'input' | 'focus' | 'manual';
    /** Whether an item's text matches what was typed. By default, it contains it. */
    defaultFilter?: (text: string, input: string) => boolean;
    /** Runs with each new key, or `null`. */
    onSelectionChange?: (key: Key | null) => void;
    /** Runs with each change of the text in the input. */
    onInputChange?: (value: string) => void;
    /** Runs with each change of whether the list is open. */
    onOpenChange?: (open: boolean) => void;
    /**
     * A `Label`, an `Input`, a `Button`, a `Popover` with a `ListBox`, and optionally a `Text` and a
     * `FieldError`.
     */
    children?: unknown;
    /** The key of the selected item, or `null`. Starts its own state, or binds with `$bind`. */
    selectedKey?: Bindable<Key | null>;
    /** The text in the input. Starts its own state, or binds with `$bind`. */
    inputValue?: Bindable<string>;
    /**
     * Whether the list is open. Alone it holds its own state, which starts closed, and `$bind`
     * writes your signal. A start value of `true` opens the list once the page has loaded.
     */
    isOpen?: Bindable<boolean>;
  }

  /**
   * The props of ComboBox. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type ComboBoxProps<T extends AsTarget = 'div'> = AsProps<T, ComboBoxOwnProps>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $getContext, $id, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import {
    CollectionFocusContext,
    ListBoxGivenContext,
    enabledItems,
    keyOf,
    moveFrom,
    textOfItem,
  } from './collection.ts';
  import {
    ButtonContext,
    FieldErrorContext,
    FieldInputContext,
    FormContext,
    InputContext,
    LabelContext,
    OverlayTriggerContext,
    TextContext,
  } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { describedBy, messagesOf, onFormReset } from './fields.ts';

  /**
   * A text field with a list of suggestions. It holds a
   * Label, an Input, a Button, a Text with `slot="description"`, a FieldError, and a Popover with
   * a ListBox.
   *
   * - Typing opens the list and shows the items whose text contains what was typed. ArrowDown
   *   and ArrowUp open it too, and move through its items, while focus stays in the input. Enter
   *   and a press pick an item, and its text goes in the input.
   * - The Button opens and closes the list, with all of its items, and focus stays in the input.
   * - Escape closes the list and puts the text of the selected item back in the input, or clears
   *   it when nothing is selected. Focus that leaves the field does the same. With
   *   `allowsCustomValue`, the text stays, and text that is not the selected item's clears the
   *   selection.
   * - Enter picks the active item. With no active item, it closes the list the same way.
   * - `selectedKey` and `inputValue` start their own state, or bind with `$bind`.
   * - `name` sends the key with its form, also before its code loads, or the text with
   *   `allowsCustomValue`. `formValue` chooses.
   * - The element shows `data-open`, `data-disabled`, `data-invalid` and `data-required`.
   */
  const {
    as = 'div',
    name,
    isDisabled = false,
    isRequired = false,
    isInvalid,
    allowsCustomValue = false,
    formValue = allowsCustomValue ? 'text' : 'key',
    menuTrigger = 'input',
    defaultFilter,
    onSelectionChange,
    onInputChange,
    onOpenChange,
    children,
    ...rest
  } = $props<ComboBoxProps<T>>();
  let { selectedKey = null } = $props<ComboBoxProps<T>>();
  let { inputValue = '' } = $props<ComboBoxProps<T>>();
  let { isOpen = false } = $props<ComboBoxProps<T>>();
  // The key and the text that a reset of the form gives back.
  let initialKey = $signal(selectedKey);
  let initialText = $signal(inputValue);

  const form = $getContext(FormContext);
  const rootId = $id();
  const inputId = $id();
  const buttonId = $id();
  const labelId = $id();
  const listId = $id();
  const overlayId = $id();
  const descriptionId = $id();
  const errorId = $id();
  const { present: hasDescription } = described(descriptionId);
  // The item that the keys move to, while focus stays in the input.
  let activeKey = $signal<Key | null>(null);
  let activeId = $signal<string>();
  // The text of the selected item, which the input gets back when focus leaves it.
  let selectedText = $signal<string>();
  // The text that the list shows the items of: what was typed, or '' for all of them.
  let filterText = $signal('');
  // The item that becomes active once the list shows its items.
  let strategy = $signal<'first' | 'last' | 'keep'>('keep');
  // The errors of the server, until the user picks. New errors of a later reply show again.
  let edited = $signal<unknown>(undefined);
  // The message of the browser, once the field was checked on a submit.
  let committed = $signal(false);
  let nativeErrors = $signal<string[]>([]);
  // A press of the Button puts focus back in the input, which does not open the list again.
  let refocused = $signal(false);
  const serverErrors = $memo(
    form && edited === form.validationErrors
      ? []
      : messagesOf(name ? (form?.validationErrors[name] as string | string[]) : undefined),
  );
  const errors = $memo([...serverErrors, ...(committed ? nativeErrors : [])]);
  const invalid = $memo(Boolean(isInvalid) || errors.length > 0);

  // A reset of the form gives back the first key and text, as it does for a field of the browser.
  $client(
    () =>
      onFormReset(document.getElementById(rootId), () => {
        selectedKey = initialKey;
        inputValue = initialText;
        selectedText = undefined;
        filterText = '';
        edited = undefined;
        committed = false;
        nativeErrors = [];
        setOpen(false);
      }),
    'load',
  );

  function list() {
    return document.getElementById(listId);
  }

  function input() {
    return document.getElementById(inputId) as HTMLInputElement | null;
  }

  function setOpen(next: boolean) {
    if (next !== isOpen && !(next && isDisabled)) {
      isOpen = next;
      onOpenChange?.(next);
    }
    if (!next) {
      activate(null);
    }
  }

  function activate(key: Key | null) {
    activeKey = key;
    const element = key === null ? undefined : findItem(key);
    activeId = element?.id;
    element?.scrollIntoView?.({ block: 'nearest' });
  }

  function findItem(key: Key) {
    const element = list();
    return element
      ? [...element.querySelectorAll<HTMLElement>('[role=option][data-key]')].find(
          (item) => keyOf(item) === key,
        )
      : undefined;
  }

  /** The list showed the items that match. It closes when none do. */
  function filtered(shown: HTMLElement[]) {
    if (shown.length === 0) {
      setOpen(false);
      return;
    }
    const element = list();
    const items = element ? enabledItems(element, 'option') : [];
    if (strategy === 'first') {
      activate(items[0] ? (keyOf(items[0]) ?? null) : null);
    } else if (strategy === 'last') {
      activate(items.at(-1) ? (keyOf(items.at(-1)!) ?? null) : null);
    } else if (activeKey !== null && !items.some((item) => keyOf(item) === activeKey)) {
      activate(null);
    }
    strategy = 'keep';
  }

  function open(next: 'first' | 'last' | 'keep', all: boolean) {
    strategy = next;
    filterText = all ? '' : inputValue;
    setOpen(true);
  }

  function select(key: Key) {
    const before = inputValue;
    const beforeText = selectedText;
    if (key !== selectedKey) {
      selectedKey = key;
      edited = form?.validationErrors ?? null;
      onSelectionChange?.(key);
    }
    // A setter that refuses leaves the old key, and the input shows the text of that one.
    const kept = selectedKey;
    const item = kept === null ? undefined : findItem(kept);
    selectedText = item ? textOfItem(item) : kept === key ? undefined : beforeText;
    inputValue = kept === null && kept !== key ? before : (selectedText ?? inputValue);
    if (inputValue !== before) {
      onInputChange?.(inputValue);
    }
    recheck();
    setOpen(false);
    input()?.focus();
  }

  // The browser shows no message of its own. The field shows it in its FieldError.
  function invalidated(message: string, first: boolean) {
    committed = true;
    nativeErrors = message ? [message] : [];
    if (first) {
      input()?.focus();
    }
  }

  // After a submit, the message follows what is in the field.
  function recheck() {
    if (!committed) {
      return;
    }
    // The input shows the new text after the update, so the check waits for it.
    setTimeout(() => {
      const element = input();
      if (element) {
        nativeErrors = element.validity.valid ? [] : [element.validationMessage];
      }
    }, 0);
  }

  function typed(text: string) {
    inputValue = text;
    onInputChange?.(text);
    recheck();
    if (text === '' && selectedKey !== null) {
      selectedKey = null;
      onSelectionChange?.(null);
    }
    filterText = text;
    if (menuTrigger !== 'manual' && text !== '') {
      setOpen(true);
    }
  }

  function focused() {
    if (refocused) {
      refocused = false;
      return;
    }
    if (menuTrigger === 'focus' && !isOpen) {
      open('keep', true);
    }
  }

  function blurred() {
    // Focus lands after the blur, so the check waits for it.
    setTimeout(left, 0);
  }

  function left() {
    // A press in the list or of the Button moves focus there for a moment, and the press puts
    // it back.
    const active = document.activeElement;
    if (
      active &&
      (active.id === inputId ||
        active.id === buttonId ||
        document.getElementById(overlayId)?.contains(active))
    ) {
      return;
    }
    commit();
  }

  /**
   * Closes the list, and puts the text of the selected item back in the input, or '' when
   * nothing is selected. With `allowsCustomValue`, the text stays,
   * and the selection goes when the text is not its item's.
   */
  function commit() {
    setOpen(false);
    if (allowsCustomValue) {
      if (selectedKey !== null && inputValue !== selectedText) {
        selectedKey = null;
        onSelectionChange?.(null);
      }
      return;
    }
    const back = selectedKey === null ? '' : (selectedText ?? inputValue);
    if (back !== inputValue) {
      inputValue = back;
      onInputChange?.(back);
    }
  }

  function keyDown(event: KeyboardEvent) {
    if ((event.target as Element).id !== inputId) {
      return;
    }
    const element = list();
    const items = element ? enabledItems(element, 'option') : [];
    const current = items.find((item) => keyOf(item) === activeKey);
    switch (event.key) {
      case 'ArrowDown':
      case 'ArrowUp': {
        const down = event.key === 'ArrowDown';
        // The arrow keys open the list with all of its items.
        if (!isOpen || !element) {
          open(down ? 'first' : 'last', true);
          return;
        }
        const next = moveFrom(element, items, current, down ? 'next' : 'previous', true);
        activate(next ? (keyOf(next) ?? null) : null);
        return;
      }
      case 'Enter':
        // A key that confirms the text of an input method is not a pick.
        if (event.isComposing) {
          return;
        }
        // Enter picks the active item, and sends the form only when the list is closed.
        if (isOpen) {
          event.preventDefault();
          if (activeKey !== null) {
            select(activeKey);
          } else {
            commit();
          }
        }
        return;
      case 'Escape': {
        // An Escape that has something to undo stops here, so it does not close a dialog too.
        const back = selectedKey === null ? '' : (selectedText ?? inputValue);
        if (isOpen || (!allowsCustomValue && inputValue !== back)) {
          event.stopPropagation();
        }
        commit();
        return;
      }
      case 'Tab':
        setOpen(false);
        return;
      default:
        return;
    }
  }

  $setContext(LabelContext, { id: labelId, for: inputId });
  $setContext(InputContext, {
    id: inputId,
    role: 'combobox',
    autocomplete: 'off',
    value: inputValue,
    disabled: isDisabled || undefined,
    'aria-autocomplete': 'list',
    'aria-expanded': isOpen ? 'true' : 'false',
    'aria-controls': isOpen ? listId : undefined,
    'aria-activedescendant': isOpen ? activeId : undefined,
    'aria-invalid': invalid ? 'true' : undefined,
    'aria-required': isRequired ? 'true' : undefined,
    required: isRequired || undefined,
    'aria-describedby': describedBy(hasDescription && descriptionId, invalid && errorId),
    onChange: typed,
    onInvalid: invalidated,
    onBlur: blurred,
    onFocus: focused,
  });
  $setContext(ButtonContext, {
    id: buttonId,
    isDisabled,
    // The Button is out of the order of Tab, since the keys of the input open the list.
    tabindex: '-1',
    'aria-label': 'Show suggestions',
    'aria-labelledby': `${buttonId} ${labelId}`,
    'aria-haspopup': 'listbox',
    'aria-expanded': isOpen ? 'true' : 'false',
    onPress: () => {
      if (isOpen) {
        setOpen(false);
      } else {
        open('keep', true);
      }
      if (document.activeElement?.id !== inputId) {
        refocused = true;
        input()?.focus();
      }
    },
  });
  $setContext(OverlayTriggerContext, {
    isOpen,
    triggerId: rootId,
    overlayId,
    open: () => open('keep', true),
    close: () => setOpen(false),
    placement: 'bottom start',
    isNonModal: true,
    autoFocus: false,
  });
  $setContext(ListBoxGivenContext, {
    selectedKeys: selectedKey === null ? [] : [selectedKey],
    labelledBy: labelId,
    select,
  });
  // An Autocomplete around names its own collection, not the list of the ComboBox.
  $setContext(FieldInputContext, null);
  $setContext(CollectionFocusContext, {
    id: listId,
    activeKey,
    setActive: (key: Key) => activate(key),
    filterText: isOpen ? filterText : undefined,
    filtered,
  });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(FieldErrorContext, { id: errorId, isInvalid: invalid, errors });
</script>

<{as}
  id=rootId
  data-open=(isOpen || undefined)
  data-disabled=(isDisabled || undefined)
  data-invalid=(invalid || undefined)
  data-required=(isRequired || undefined)
  {...rest}
>
  <div style="display: contents" onKeyDown=(prevent(keyDown, 'ArrowDown', 'ArrowUp'))>{children}</div>
  <!-- The key of the selection for the form, which posts without scripts. -->
  <input
    type="hidden"
    {name}
    value=(formValue === 'text' ? inputValue : selectedKey === null ? '' : String(selectedKey))
    disabled=(isDisabled || undefined)
  >
</>
