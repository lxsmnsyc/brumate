<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { Bindable } from 'brumate/signals';

  export interface ModalOverlayProps extends ElementProps<'div'> {
    /** Closes it on a press on the overlay, outside the `Modal`. */
    isDismissable?: boolean;
    /** Stops Escape from closing it. */
    isKeyboardDismissDisabled?: boolean;
    /** Lets CSS animate the overlay and the `Modal`, with `data-closed`, `data-enter` and `data-leave`. */
    transition?: boolean;
    /** Runs when it closes, for one with its own `isOpen`. With a trigger, the trigger reports the change. */
    onOpenChange?: (open: boolean) => void;
    /** A `Modal`. */
    children?: unknown;
    /** Whether it is open, in place of the `DialogTrigger` around it. `$bind` writes your signal. */
    isOpen?: Bindable<boolean | undefined>;
  }
</script>

<script>
  import {
    $client,
    $effect,
    $getContext,
    $id,
    $isPassed,
    $memo,
    $props,
    $setContext,
    $signal,
    $untrack,
  } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import { ButtonContext, DialogContext, LinkContext, ModalOverlayContext, OverlayTriggerContext } from './contexts.ts';
  import { LayerContext } from './layer.ts';
  import { mergeStyle } from './style.ts';
  import {
    containTab,
    focusInto,
    followViewport,
    hold,
    inertOutside,
    keepFocus,
    lockScroll,
    queueLoad,
    release,
  } from './overlay.ts';
  import { TransitionContext, enterSteps, leaveSteps, nextFrame, stepClasses } from './transition.ts';

  /**
   * The layer under a Modal, which covers the page. It
   * opens from a DialogTrigger, or from its own `isOpen`.
   *
   * - It renders a layer at the end of the layer of the floating part around it, or at the end
   *   of <body>. The overlay is `position: fixed` over the whole window, and sets
   *   `--visual-viewport-height`.
   * - While it is open, the rest of the page is inert and does not scroll. Focus moves into the
   *   dialog, stays in the layer, and goes back when it closes.
   * - Escape closes it, unless `isKeyboardDismissDisabled`. A press on the overlay, outside the
   *   Modal, closes it only with `isDismissable`.
   * - `transition` lets CSS animate it and the Modal inside, with `data-closed`, `data-enter` and
   *   `data-leave` on the overlay. It waits for the animations of both before it leaves the page.
   */
  const {
    isDismissable = false,
    isKeyboardDismissDisabled = false,
    transition = false,
    onOpenChange,
    children,
    style,
    ...rest
  } = $props<ModalOverlayProps>();
  // It takes a binding of a value that can be undefined, so a part can pass its own `isOpen` on.
  let { isOpen } = $props<ModalOverlayProps>();

  const trigger = $getContext(OverlayTriggerContext);
  const parentLayer = $getContext(LayerContext);
  const own = $isPassed(isOpen);
  const layerId = $id();
  const ownId = $id();
  const wanted = $memo(own ? Boolean(isOpen) : Boolean(trigger?.isOpen));
  const target = $untrack(parentLayer ? `#${parentLayer.id}` : 'body');

  // It is in the page: open, or leaving.
  let mounted = $signal(false);
  let rested = $signal(false);
  let leaving = $signal(false);
  // Whether it is shown or opening, and not leaving. A change to the value it already shows, such as
  // the first write of a bound start value, opens nothing again.
  let shown = $signal(false);
  let run = $signal(0);
  let overlay = $signal<HTMLElement>();
  let layer = $signal<HTMLElement>();

  $setContext(LayerContext, { id: layerId });
  $setContext(DialogContext, { close });
  $setContext(ModalOverlayContext, { close });
  $setContext(TransitionContext, { show: wanted, entered: rested });
  // An overlay inside opens from a DialogTrigger of its own, not from the one of this overlay.
  $setContext(OverlayTriggerContext, null);
  // The buttons and links inside are not the trigger, which gets these contexts.
  $setContext(ButtonContext, null);
  $setContext(LinkContext, null);

  function close() {
    if (own) {
      // A press or a key during the leave closes nothing again.
      if (!isOpen) {
        return;
      }
      isOpen = false;
      onOpenChange?.(false);
    } else {
      trigger?.close();
    }
  }

  /** The element that takes focus: the dialog, or else the Modal. */
  function focusTarget(element: HTMLElement): HTMLElement {
    return (
      element.querySelector<HTMLElement>('[role=dialog], [role=alertdialog]') ??
      element.querySelector<HTMLElement>('[data-modal]') ??
      element
    );
  }

  async function show(token: number) {
    shown = true;
    mounted = true;
    const returnTo = document.activeElement;
    await nextFrame();
    const element = overlay;
    const holder = layer;
    // The overlay can leave the page within the frame, such as on a route change.
    if (token !== run || !element?.isConnected || !holder) {
      return;
    }
    const stops: (() => void)[] = [];
    hold(element, stops, returnTo, trigger?.triggerId);
    stops.push(
      inertOutside(holder),
      keepFocus(holder, focusTarget(element)),
      lockScroll(),
      followViewport(element),
    );
    // A press on the overlay itself is outside the Modal. A press in a layer inside is not. It is a
    // pointerdown and a pointerup of the first button, so the page under a touch is not clicked
    // once the overlay is gone.
    let started = false;
    const down = (event: PointerEvent): void => {
      started = event.button === 0 && event.target === element;
    };
    const up = (event: PointerEvent): void => {
      if (started && event.target === element && isDismissable) {
        close();
      }
      started = false;
    };
    element.addEventListener('pointerdown', down);
    element.addEventListener('pointerup', up);
    stops.push(() => {
      element.removeEventListener('pointerdown', down);
      element.removeEventListener('pointerup', up);
    });
    if (
      transition &&
      !(await enterSteps(element, stepClasses(), { current: () => token === run, subtree: true }))
    ) {
      return;
    }
    rested = true;
    // Focus moves in once it has entered, so it lands on a modal that has settled.
    focusInto(focusTarget(element));
  }

  async function hide(token: number) {
    shown = false;
    rested = false;
    const element = overlay;
    if (transition && element) {
      const done = await leaveSteps(
        element,
        stepClasses(),
        { current: () => token === run, subtree: true },
        () => {
          leaving = true;
        },
      );
      if (!done) {
        return;
      }
    }
    if (element) {
      release(element, layer);
    }
    leaving = false;
    mounted = false;
  }

  // When the overlay leaves the page while it is open, such as with an #if around it, its element
  // goes with it, and what it held on the page is given back.
  function leave() {
    const element = overlay;
    if (element && !element.isConnected) {
      release(element, layer);
    }
  }

  // A client navigation runs the cleanups of the page before it removes its markup, so the
  // element is still in the page. The scope is gone for good, so everything is given back.
  function leavePage() {
    const element = overlay;
    if (element) {
      release(element, layer);
    }
    // A route that leaves keeps the markup of a portal, so the layer goes here.
    layer?.remove();
    // An #offscreen body that hides runs this too, and runs the client callback again when it shows,
    // which opens the overlay again if it is still wanted.
    shown = false;
    mounted = false;
    rested = false;
    leaving = false;
  }

  $effect(() => {
    const next = wanted;
    $untrack(change(next));
    return leave;
  });

  // An effect never runs when the page loads, so a start value of `true` opens it here, after the
  // modals before it. Its cleanup runs even when the value never changes.
  $client(() => {
    queueLoad(() => {
      if (wanted && !shown) {
        run += 1;
        leaving = false;
        return show(run);
      }
    });
    return leavePage;
  }, 'load');

  function change(next: boolean) {
    if (next && shown) {
      return;
    }
    run += 1;
    if (next) {
      leaving = false;
      void show(run);
    } else if (mounted) {
      void hide(run);
    }
  }

  // A part inside that used Escape prevents it, such as a SearchField that clears its text.
  function keyDown(event: KeyboardEvent) {
    if (event.key === 'Escape' && !isKeyboardDismissDisabled && !event.defaultPrevented) {
      close();
    }
  }

  function trap(event: KeyboardEvent) {
    if (overlay) {
      containTab(overlay, event);
    }
  }
</script>

#if (mounted) {
  #portal (target) {
    <!-- The layer: the overlays that open inside the modal render at its end. -->
    <div ref=$bind(layer) id=layerId data-layer style="display: contents">
      <!-- Tab stays in the modal. The wrapper prevents it, and the handler moves focus. -->
      <div style="display: contents" onKeyDown=(prevent(trap, 'Tab'))>
        <div
          ref=$bind(overlay)
          id=(trigger?.overlayId ?? ownId)
          data-modal-overlay
          style=(mergeStyle(style, 'position: fixed; inset: 0'))
          inert=(leaving || undefined)
          data-closed=($untrack(transition || undefined))
          onKeyDown=keyDown
          {...rest}
        >{children}</div>
      </div>
    </div>
  }
}
