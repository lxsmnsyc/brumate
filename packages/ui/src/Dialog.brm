<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';

  export interface DialogOwnProps<T extends AsTarget = 'section'> {
    /** The role of the dialog. Use `alertdialog` for one that needs an answer. */
    role?: 'dialog' | 'alertdialog';
    /** The content of the dialog, such as a `Heading` with `slot="title"` and a `Button` with `slot="close"`. */
    children?: unknown;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of Dialog. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type DialogProps<T extends AsTarget = 'section'> = AsProps<T, DialogOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'section'">
  import { $getContext, $id, $props, $setContext } from 'brumate/signals';
  import { ButtonContext, DialogContext, HeadingContext, OverlayTriggerContext } from './contexts.ts';
  import { described } from './description.brm.ts';

  /**
   * A dialog, inside a Popover or a Modal. A Heading with `slot="title"` names it, and a Button
   * with `slot="close"` closes it. The overlay around it moves focus into it when it opens.
   * `aria-label` names it in place of the Heading, and a dialog without a Heading leaves out
   * aria-labelledby once the browser is idle. In the overlay of a DatePicker, its Button and Label
   * name it then.
   */
  const {
    as,
    role = 'dialog',
    'aria-label': label,
    children,
    ...rest
  } = $props<DialogProps<T>>();
  let { ref } = $props<DialogOwnProps<T>>();

  const overlay = $getContext(DialogContext);
  const trigger = $getContext(OverlayTriggerContext);
  const titleId = $id();
  const { present: titled } = described(titleId);

  function close() {
    if (overlay) {
      overlay.close();
    } else {
      trigger?.close();
    }
  }

  // A Heading or a Button without a slot gets nothing of the dialog.
  $setContext(HeadingContext, { slots: { default: {}, title: { id: titleId } } });
  $setContext(ButtonContext, { slots: { default: {}, close: { onPress: close } } });
</script>

<{as ?? 'section'}
  ref=$bind(ref)
  {role}
  tabindex="-1"
  aria-label=label
  aria-labelledby=(label !== undefined ? undefined : titled ? titleId : overlay?.labelledBy)
  {...rest}
>{children}</>
