<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface BreadcrumbProps extends ElementProps<'li'> {
    /** Marks the step for the page that is open, and disables its link. */
    isCurrent?: boolean;
    /** A `Link`. */
    children?: unknown;
  }
</script>

<script>
  import { $getContext, $hasContext, $memo, $props, $setContext, $store, $toStore } from 'brumate/signals';
  import { LinkContext } from './contexts.ts';
  import { slotProps } from './slots.ts';

  /**
   * One step of Breadcrumbs: an <li> around a Link.
   * `isCurrent` marks the page that the trail ends at. Its link gets aria-current="page". A part
   * cannot read the structure of its children, so the caller marks it. It shows
   * `data-current` and `data-disabled`. The current step is disabled, so its
   * link does not load the page that is open.
   */
  const { isCurrent = false, children, ...rest } = $props<BreadcrumbProps>();

  const trailGiven = $hasContext(LinkContext) ? $getContext(LinkContext) : undefined;
  const trail = $store(trailGiven?.state);
  const disabled = $memo(Boolean(slotProps(trail, undefined).isDisabled || isCurrent));
  const linkState = $memo({ isCurrent, isDisabled: disabled });
  $setContext(LinkContext, { state: $toStore(linkState) });
</script>

<li data-current=(isCurrent || undefined) data-disabled=(disabled || undefined) {...rest}>{children}</li>
