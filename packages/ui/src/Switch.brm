<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { Bindable } from 'brumate/signals';

  export interface SwitchProps extends Omit<ElementProps<'label'>, 'onChange'> {
    /** The name of the input, posted with the form. */
    name?: string;
    /** The value that the input posts. */
    value?: string;
    /** Disables the switch. */
    isDisabled?: boolean;
    /** Keeps the state: a click does not toggle the switch. */
    isReadOnly?: boolean;
    /** Marks the switch as invalid. A FieldError in the children shows while it is. */
    isInvalid?: boolean;
    /** Runs with the new state when the user toggles the switch. */
    onChange?: (selected: boolean) => void;
    /** The content of the label. Draw the switch here. */
    children?: unknown;
    /** Whether the switch is on. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    isSelected?: Bindable<boolean>;
  }
</script>

<script>
  import { $client, $id, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import VisuallyHidden from './VisuallyHidden.brm';
  import { box } from './box.brm.ts';
  import { FieldErrorContext, LabelContext, TextContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { describedBy, onFormReset } from './fields.ts';

  /**
   * A switch: a <label> around a native checkbox with
   * role="switch". The label shows `data-selected`, `data-pressed`, `data-hovered`,
   * `data-focused`, `data-focus-visible`, `data-disabled` and `data-readonly`. Draw the switch in
   * the children, from these attributes.
   *
   * `isSelected` alone starts its own state as on, and `isSelected=$bind(signal)` writes the
   * caller's.
   */
  const {
    name,
    value,
    isDisabled = false,
    isReadOnly = false,
    isInvalid = false,
    onChange,
    children,
    ...rest
  } = $props<SwitchProps>();
  let { isSelected = false } = $props<SwitchProps>();
  // The state that a reset of the form gives back.
  let initial = $signal(isSelected);
  const inputId = $id();

  const disabled = $memo(isDisabled);

  // The children can hold a Text with `slot="description"` and a FieldError. The input names
  // them in aria-describedby, and the error only while the switch is invalid.
  const descriptionId = $id();
  const { present: hasDescription } = described(descriptionId);
  const errorId = $id();
  const describing = $memo(describedBy(hasDescription && descriptionId, isInvalid && errorId));
  // A Label in the children (`as="span"`) names the input, so the description and the error stay
  // out of its name. Without one, they sit in the text of the label, and aria-hidden keeps them
  // out of the name. The server cannot see the Label, so a box starts without one, and the name
  // is right before any script runs. The browser turns the Label on when it finds it. The input
  // names the description and the error in aria-describedby, which reads hidden elements.
  const labelId = $id();
  const { present: hasLabel } = described(labelId, false);
  const hidden = $memo(hasLabel ? undefined : 'true');
  $setContext(LabelContext, { id: labelId });
  $setContext(TextContext, { slots: { description: { id: descriptionId, 'aria-hidden': hidden } } });
  $setContext(FieldErrorContext, {
    id: errorId,
    isInvalid,
    errors: [],
    attributes: { 'aria-hidden': hidden },
  });

  const {
    hovered,
    pressed,
    focused,
    focusVisible,
    onPointerEnter,
    onPointerLeave,
    onPointerDown,
    onPointerUp,
    onPointerCancel,
    onKeyDown,
    onKeyUp,
    onFocusIn,
    onFocusOut,
  } = box(disabled);

  // The click of a read-only box, which the wrapper prevents.
  function keep() {}

  // A reset of the form gives back the first state, as it does for a box of the browser.
  $client(() => {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    return onFormReset(
      input,
      () => {
        isSelected = initial;
      },
      () => {
        if (input) {
          input.checked = isSelected;
        }
      },
    );
  }, 'load');

  function change(event: Event & { currentTarget: HTMLInputElement }) {
    const input = event.currentTarget;
    // A read-only switch keeps its state. The browser toggled it already.
    if (isReadOnly) {
      input.checked = isSelected;
      return;
    }
    const before = isSelected;
    try {
      isSelected = input.checked;
    } finally {
      // A setter that refuses or throws leaves the old state, so the input goes back to it.
      input.checked = isSelected;
    }
    if (isSelected !== before) {
      onChange?.(isSelected);
    }
  }
</script>

<label
  data-selected=(isSelected || undefined)
  data-pressed=(pressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(isDisabled || undefined)
  data-readonly=(isReadOnly || undefined)
  data-invalid=(isInvalid || undefined)
  {onPointerEnter}
  {onPointerLeave}
  {onPointerDown}
  {onPointerUp}
  {onPointerCancel}
  {onKeyDown}
  {onKeyUp}
  {onFocusIn}
  {onFocusOut}
  {...rest}
>
  <!-- A read-only box prevents its click, so the browser never toggles it, and a screen reader
       announces no change. -->
  #if (isReadOnly) {
    <VisuallyHidden
      as="input"
      id=inputId
      type="checkbox"
      role="switch"
      {name}
      {value}
      checked=isSelected
      disabled=(isDisabled || undefined)
      aria-readonly=(isReadOnly ? 'true' : undefined)
      aria-invalid=(isInvalid ? 'true' : undefined)
      aria-describedby=describing
      aria-labelledby=(hasLabel ? labelId : undefined)
      onChange=change
      onClick=(prevent(keep))
    />
  } #else {
    <VisuallyHidden
      as="input"
      id=inputId
      type="checkbox"
      role="switch"
      {name}
      {value}
      checked=isSelected
      disabled=(isDisabled || undefined)
      aria-readonly=(isReadOnly ? 'true' : undefined)
      aria-invalid=(isInvalid ? 'true' : undefined)
      aria-describedby=describing
      aria-labelledby=(hasLabel ? labelId : undefined)
      onChange=change
    />
  }
  {children}
</label>
