<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { Bindable } from 'brumate/signals';

  export interface SwitchProps extends Omit<ElementProps<'label'>, 'onChange'> {
    /** The name of the input, posted with the form. */
    name?: string;
    /** The value that the input posts. */
    value?: string;
    /** Disables the switch. */
    isDisabled?: boolean;
    /** Keeps the state: a click does not toggle the switch. */
    isReadOnly?: boolean;
    /** Runs with the new state when the user toggles the switch. */
    onChange?: (selected: boolean) => void;
    /** The content of the label. Draw the switch here. */
    children?: unknown;
    /** Whether the switch is on. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    isSelected?: Bindable<boolean>;
  }
</script>

<script>
  import { $client, $id, $memo, $props, $signal } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import VisuallyHidden from './VisuallyHidden.brm';
  import { box } from './box.brm.ts';
  import { onFormReset } from './fields.ts';

  /**
   * A switch: a <label> around a native checkbox with
   * role="switch". The label shows `data-selected`, `data-pressed`, `data-hovered`,
   * `data-focused`, `data-focus-visible`, `data-disabled` and `data-readonly`. Draw the switch in
   * the children, from these attributes.
   *
   * `isSelected` alone starts its own state as on, and `isSelected=$bind(signal)` writes the
   * caller's.
   */
  const { name, value, isDisabled = false, isReadOnly = false, onChange, children, ...rest } =
    $props<SwitchProps>();
  let { isSelected = false } = $props<SwitchProps>();
  // The state that a reset of the form gives back.
  let initial = $signal(isSelected);
  const inputId = $id();

  const disabled = $memo(isDisabled);

  const {
    hovered,
    pressed,
    focused,
    focusVisible,
    onPointerEnter,
    onPointerLeave,
    onPointerDown,
    onPointerUp,
    onPointerCancel,
    onKeyDown,
    onKeyUp,
    onFocusIn,
    onFocusOut,
  } = box(disabled);

  // The click of a read-only box, which the wrapper prevents.
  function keep() {}

  // A reset of the form gives back the first state, as it does for a box of the browser.
  $client(() => {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    return onFormReset(
      input,
      () => {
        isSelected = initial;
      },
      () => {
        if (input) {
          input.checked = isSelected;
        }
      },
    );
  }, 'load');

  function change(event: Event & { currentTarget: HTMLInputElement }) {
    const input = event.currentTarget;
    // A read-only switch keeps its state. The browser toggled it already.
    if (isReadOnly) {
      input.checked = isSelected;
      return;
    }
    isSelected = input.checked;
    onChange?.(input.checked);
  }
</script>

<label
  data-selected=(isSelected || undefined)
  data-pressed=(pressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(isDisabled || undefined)
  data-readonly=(isReadOnly || undefined)
  {onPointerEnter}
  {onPointerLeave}
  {onPointerDown}
  {onPointerUp}
  {onPointerCancel}
  {onKeyDown}
  {onKeyUp}
  {onFocusIn}
  {onFocusOut}
  {...rest}
>
  <!-- A read-only box prevents its click, so the browser never toggles it, and a screen reader
       announces no change. -->
  #if (isReadOnly) {
    <VisuallyHidden
      as="input"
      id=inputId
      type="checkbox"
      role="switch"
      {name}
      {value}
      checked=isSelected
      disabled=(isDisabled || undefined)
      aria-readonly=(isReadOnly ? 'true' : undefined)
      onChange=change
      onClick=(prevent(keep))
    />
  } #else {
    <VisuallyHidden
      as="input"
      id=inputId
      type="checkbox"
      role="switch"
      {name}
      {value}
      checked=isSelected
      disabled=(isDisabled || undefined)
      aria-readonly=(isReadOnly ? 'true' : undefined)
      onChange=change
    />
  }
  {children}
</label>
