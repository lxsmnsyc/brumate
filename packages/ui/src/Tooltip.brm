<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { Placement } from './position.ts';

  export interface TooltipOwnProps<T extends AsTarget = 'div'> {
    /** The side of its trigger that it shows on, such as `top end`. */
    placement?: Placement;
    /** The space between the trigger and the tooltip, in pixels. */
    offset?: number;
    /** A shift along the side of the trigger, in pixels. */
    crossOffset?: number;
    /** Whether it flips to the other side when it does not fit. */
    shouldFlip?: boolean;
    /** The space that it keeps from the edges of the window, in pixels. */
    containerPadding?: number;
    /** Lets CSS animate it, with `data-closed`, `data-enter` and `data-leave`. */
    transition?: boolean;
    /** The text of the tooltip, and an optional `OverlayArrow`. */
    children?: unknown;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of Tooltip. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type TooltipProps<T extends AsTarget = 'div'> = AsProps<T, TooltipOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $effect, $getContext, $id, $props, $setContext, $signal, $untrack } from 'brumate/signals';
  import { ButtonContext, LinkContext } from './contexts.ts';
  import { LayerContext } from './layer.ts';
  import { LocaleContext } from './locale.ts';
  import { followTrigger, keepArrows } from './position.ts';
  import { mergeStyle } from './style.ts';
  import { TooltipTriggerContext, keepStops, runStops } from './tooltip.ts';
  import { enterSteps, leaveSteps, nextFrame, stepClasses } from './transition.ts';

  /**
   * The text of a TooltipTrigger. It is a `role="tooltip"`
   * that names nothing and takes no focus, and the trigger's Button points to it with
   * `aria-describedby`.
   *
   * - It renders at the end of the layer of the floating part around it, or of <body>, and is
   *   placed beside its trigger as a Popover is: `placement` (`top` by default), `offset`,
   *   `crossOffset`, `shouldFlip` and `containerPadding`. It shows `data-placement`, and places
   *   an OverlayArrow inside it.
   * - The pointer can move onto it, and it stays while the pointer is over it.
   * - Escape hides it.
   * - `transition` lets CSS animate it, with `data-closed`, `data-enter` and `data-leave`.
   */
  const {
    as,
    placement = 'top',
    offset = 0,
    crossOffset = 0,
    shouldFlip = true,
    containerPadding = 12,
    transition = false,
    children,
    style,
    ...rest
  } = $props<TooltipProps<T>>();
  let { ref } = $props<TooltipOwnProps<T>>();

  const trigger = $getContext(TooltipTriggerContext);
  const parentLayer = $getContext(LayerContext);
  const locale = $getContext(LocaleContext);
  const layerId = $id();
  const target = $untrack(parentLayer ? `#${parentLayer.id}` : 'body');

  // Nothing inside is the trigger, which gets these contexts.
  $setContext(ButtonContext, null);
  $setContext(LinkContext, null);

  let mounted = $signal(false);
  // Whether it is shown or opening, and not leaving. A change to the value it already shows, such as
  // the first write of a bound start value, opens nothing again.
  let shown = $signal(false);
  let run = $signal(0);

  async function show(token: number) {
    shown = true;
    mounted = true;
    await nextFrame();
    const element = ref as HTMLElement | undefined;
    const anchor = trigger ? document.getElementById(trigger.triggerId) : null;
    if (token !== run || !element) {
      return;
    }
    // A show during a leave stops what the show before it started.
    runStops(element);
    // Escape hides only the tooltip, so a Dialog or a Popover around the
    // trigger stays open. This listener runs during the event, so it can prevent it.
    const escape = (event: KeyboardEvent): void => {
      if (event.key === 'Escape') {
        event.preventDefault();
        event.stopPropagation();
        trigger?.close(true);
      }
    };
    document.addEventListener('keydown', escape, true);
    const stops = [() => document.removeEventListener('keydown', escape, true)];
    if (anchor) {
      const arrows = keepArrows(element);
      stops.push(
        arrows.stop,
        followTrigger(
          anchor,
          element,
          { placement, offset, crossOffset, shouldFlip, containerPadding, direction: locale.direction },
          arrows.place,
        ),
      );
    }
    keepStops(element, stops);
    if (transition) {
      await enterSteps(element, stepClasses(), { current: () => token === run });
    }
  }

  async function hide(token: number) {
    shown = false;
    const element = ref as HTMLElement | undefined;
    if (transition && element) {
      if (!(await leaveSteps(element, stepClasses(), { current: () => token === run }))) {
        return;
      }
    }
    if (element) {
      runStops(element);
    }
    mounted = false;
  }

  function leave() {
    const element = ref as HTMLElement | undefined;
    if (element && !element.isConnected) {
      runStops(element);
    }
  }

  // A client navigation runs the cleanups of the page before it removes its markup, so the
  // tooltip is still in the page. The scope is gone for good, so its stops run.
  function leavePage() {
    const element = ref as HTMLElement | undefined;
    if (element) {
      runStops(element);
      // A route that leaves keeps the markup of a portal, so the layer goes here.
      element.closest('[data-layer]')?.remove();
    }
  }

  $effect(() => {
    const next = Boolean(trigger?.isOpen);
    $untrack(change(next));
    return leave;
  });

  // An effect never runs when the page loads, so a start value of `true` shows it here. Its
  // cleanup runs even when the value never changes.
  $client(() => {
    if (Boolean(trigger?.isOpen) && !shown) {
      change(true);
    }
    return leavePage;
  }, 'load');

  function change(next: boolean) {
    if (next && shown) {
      return;
    }
    run += 1;
    if (next) {
      void show(run);
    } else if (mounted) {
      void hide(run);
    }
  }

  function entered() {
    trigger?.keep();
  }

  function left() {
    trigger?.close(false);
  }
</script>

#if (mounted) {
  #portal (target) {
    <div id=layerId data-layer style="display: contents">
      <{as ?? 'div'}
        ref=$bind(ref)
        id=(trigger?.tooltipId)
        role="tooltip"
        style=(mergeStyle(style, 'position: fixed; top: 0; left: 0'))
        data-closed=($untrack(transition || undefined))
        onPointerEnter=entered
        onPointerLeave=left
        {...rest}
      >{children}</>
    </div>
  }
}
