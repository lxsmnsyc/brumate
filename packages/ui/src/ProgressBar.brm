<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { ProgressBarState } from './progress.ts';

  export interface ProgressBarOwnProps<T extends AsTarget = 'div'> {
    /** The current value. */
    value?: number;
    /** Marks a task of no known length. The bar has no value. */
    isIndeterminate?: boolean;
    /** The smallest value of the range. */
    minValue?: number;
    /** The largest value of the range. */
    maxValue?: number;
    /** The text of the value, in place of the formatted number. */
    valueLabel?: string;
    /** The options of `Intl.NumberFormat` for the text of the value. */
    formatOptions?: Intl.NumberFormatOptions;
    /** A template that gets the percentage and the text of the value, to draw the bar. */
    content?: (state: ProgressBarState) => unknown;
    /** A `Label`, and what the bar shows. */
    children?: unknown;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of ProgressBar. `as` takes an element name or a component, and the other props are
   * those of the target.
   */
  export type ProgressBarProps<T extends AsTarget = 'div'> = AsProps<T, ProgressBarOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $getContext, $id, $memo, $props, $setContext } from 'brumate/signals';
  import { LabelContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { LocaleContext } from './locale.ts';
  import { progressOf } from './progress.ts';

  /**
   * The progress of a task: role="progressbar" with the value, the range and its text in the
   * locale. A Label inside names it. The element has `--percentage` for CSS, from 0% to 100%. A
   * `content` template gets the percentage and the text, to draw the bar. `isIndeterminate` is a
   * task of no known length: it has no value, and shows `data-indeterminate`.
   */
  const {
    as,
    value = 0,
    isIndeterminate = false,
    minValue = 0,
    maxValue = 100,
    valueLabel,
    formatOptions,
    content,
    children,
    ...rest
  } = $props<ProgressBarProps<T>>();
  let { ref } = $props<ProgressBarOwnProps<T>>();

  const locale = $getContext(LocaleContext);
  const labelId = $id();
  // A Label inside names it. Without one, aria-label does, and the ID goes.
  const { present: labelled } = described(labelId);
  const state = $memo(progressOf(value, minValue, maxValue, locale.locale, formatOptions));
  $setContext(LabelContext, { id: labelId });

  // An indeterminate bar has no value, so its content gets none.
  function contentState(indeterminate: boolean, percentage: number, valueText: string) {
    return indeterminate
      ? { percentage: undefined, valueText: undefined, isIndeterminate: true }
      : { percentage, valueText, isIndeterminate: false };
  }
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  role="progressbar"
  aria-valuenow=(isIndeterminate ? undefined : state.value)
  aria-valuemin=minValue
  aria-valuemax=maxValue
  aria-valuetext=(isIndeterminate ? undefined : (valueLabel ?? state.valueText))
  data-indeterminate=(isIndeterminate || undefined)
  aria-labelledby=(labelled ? labelId : undefined)
  style=(isIndeterminate ? undefined : `--percentage: ${state.percentage}%`)
  {...rest}
>
  {children}
  #if (content) {
    {content(contentState(isIndeterminate, state.percentage, valueLabel ?? state.valueText))}
  }
</>
