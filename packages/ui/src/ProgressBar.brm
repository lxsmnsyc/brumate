<script module>
  import type { ProgressBarState } from './progress.ts';

  export interface ProgressBarProps {
    value?: number;
    isIndeterminate?: boolean;
    minValue?: number;
    maxValue?: number;
    /** The text of the value, in place of the formatted number. */
    valueLabel?: string;
    formatOptions?: Intl.NumberFormatOptions;
    content?: (state: ProgressBarState) => unknown;
    children?: unknown;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $getContext, $id, $memo, $props, $setContext } from 'brumate/signals';
  import { LabelContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { LocaleContext } from './locale.ts';
  import { progressOf } from './progress.ts';

  /**
   * The progress of a task, as ProgressBar of React Aria Components:
   * role="progressbar" with the value, the range and its text in the locale. A Label inside names it.
   * The element has `--percentage` for CSS, from 0% to 100%. A `content` template gets the
   * percentage and the text, to draw the bar. `isIndeterminate` is a task of no known length:
   * it has no value, and shows `data-indeterminate`.
   */
  const {
    value = 0,
    isIndeterminate = false,
    minValue = 0,
    maxValue = 100,
    valueLabel,
    formatOptions,
    content,
    children,
    ...rest
  } = $props<ProgressBarProps>();

  const locale = $getContext(LocaleContext);
  const labelId = $id();
  // A Label inside names it. Without one, aria-label does, and the ID goes.
  const { present: labelled } = described(labelId);
  const state = $memo(progressOf(value, minValue, maxValue, locale.locale, formatOptions));
  $setContext(LabelContext, { id: labelId });

  // An indeterminate bar has no value, so its content gets none, as in React Aria.
  function contentState(indeterminate: boolean, percentage: number, valueText: string) {
    return indeterminate
      ? { percentage: undefined, valueText: undefined, isIndeterminate: true }
      : { percentage, valueText, isIndeterminate: false };
  }
</script>

<div
  role="progressbar"
  aria-valuenow=(isIndeterminate ? undefined : state.value)
  aria-valuemin=minValue
  aria-valuemax=maxValue
  aria-valuetext=(isIndeterminate ? undefined : (valueLabel ?? state.valueText))
  data-indeterminate=(isIndeterminate || undefined)
  aria-labelledby=(labelled ? labelId : undefined)
  style=(isIndeterminate ? undefined : `--percentage: ${state.percentage}%`)
  {...rest}
>
  {children}
  #if (content) {
    {content(contentState(isIndeterminate, state.percentage, valueLabel ?? state.valueText))}
  }
</div>
