<script module>
  import type { Key } from './collection.ts';
  import type { ColumnSize } from './table.ts';

  export interface ColumnProps {
    /** The key of the column, which `sortDescriptor` and the resize events use. */
    id?: Key;
    /** Makes the cells of the column name their rows. */
    isRowHeader?: boolean;
    /** Lets a press or Enter sort the table by this column. */
    allowsSorting?: boolean;
    /** The text that names the column, for a column whose content is more than text. */
    textValue?: string;
    /** The width in a ResizableTableContainer: pixels, a percentage, or `fr`. */
    width?: ColumnSize | null;
    /** The starting width in a ResizableTableContainer: pixels, a percentage, or `fr`. */
    defaultWidth?: ColumnSize | null;
    /** The least width in pixels. */
    minWidth?: number | null;
    /** The greatest width in pixels. */
    maxWidth?: number | null;
    /** The content of the column header. */
    children?: unknown;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $getContext, $id, $memo, $props, $setContext } from 'brumate/signals';
  import { keyAttribute } from './collection.ts';
  import { interact } from './interact.brm.ts';
  import { ColumnContext, TableContext, TableResizeContext, cssWidth } from './table.ts';

  /**
   * A column of a Table: its header cell. `id` is its key.
   *
   * - `isRowHeader` makes the cells of the column name their rows, as `th` elements with
   *   `role="rowheader"`. A Table needs one.
   * - With `allowsSorting`, a press or Enter sorts the Table by the column. It shows `aria-sort`,
   *   `data-allows-sorting` and `data-sort-direction`.
   * - In a ResizableTableContainer, `width` or `defaultWidth` sets its width, and `minWidth`
   *   and `maxWidth` its bounds, in pixels. A ColumnResizer in it resizes it, and it shows
   *   `data-resizing` while it does.
   * - With `allowsSorting` or a ColumnResizer, the header takes focus first, and Enter or Space
   *   sorts. A ColumnResizer and other controls in it take the focus after it.
   * - It shows `data-pressed`, `data-hovered`, `data-focused` and `data-focus-visible`.
   */
  const {
    id,
    isRowHeader = false,
    allowsSorting = false,
    textValue,
    width,
    defaultWidth,
    minWidth,
    maxWidth,
    children,
    ...rest
  } = $props<ColumnProps>();

  const table = $getContext(TableContext);
  const sizes = $getContext(TableResizeContext);
  const headerId = $id();
  // A column without an `id` takes the ID of its header, so a resize keeps its width too.
  const key = keyAttribute(id ?? headerId);
  // The width that a resize gave it, or else the one that its props give it.
  const resized = $memo(sizes?.widths[key]);
  const size = $memo(
    resized !== undefined ? `${resized}px` : sizes ? cssWidth(width ?? defaultWidth) : undefined,
  );
  const resizing = $memo(sizes?.resizing === key);
  $setContext(ColumnContext, {
    key,
    headerId,
    minWidth: minWidth ?? 0,
    maxWidth: maxWidth ?? Number.MAX_SAFE_INTEGER,
    width: typeof (width ?? defaultWidth) === 'number' ? (width ?? defaultWidth) as number : undefined,
  });
  // The Table learns its columns from them, in order, before its rows render.
  table?.columns.push({ id, isRowHeader });
  const direction = $memo(
    table?.sortDescriptor && id !== undefined && table.sortDescriptor.column === id
      ? table.sortDescriptor.direction
      : undefined,
  );

  function pressed() {
    if (allowsSorting && id !== undefined) {
      table?.sort(id);
    }
  }

  const {
    pressed: isPressed,
    hovered,
    focused,
    focusVisible,
    onPointerDown: pressDown,
    onPointerMove,
    onPointerUp,
    onPointerCancel,
    onPointerEnter,
    onPointerLeave,
    onClick: pressClick,
    onFocus,
    onBlur,
  } = interact(
    false,
    !allowsSorting,
    pressed,
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
  );

  /** True for an event that starts on a control in the column, such as a ColumnResizer. */
  function fromControl(event: Event): boolean {
    const control = (event.target as Element).closest?.(
      'a[href], button, input, select, textarea, label, [role=presentation]',
    );
    return Boolean(control) && control !== event.currentTarget;
  }

  function onPointerDown(event: PointerEvent) {
    if (!fromControl(event)) {
      pressDown(event);
    }
  }

  function onClick(event: MouseEvent) {
    if (!fromControl(event)) {
      pressClick(event);
    }
  }
</script>

<th
  id=headerId
  role="columnheader"
  tabindex="-1"
  scope="col"
  data-key=key
  data-sized=(size === undefined ? undefined : '')
  data-width=(typeof (width ?? defaultWidth) === 'number' ? (width ?? defaultWidth) : undefined)
  data-min-width=(minWidth ?? undefined)
  data-max-width=(maxWidth ?? undefined)
  data-resizing=(resizing || undefined)
  data-text-value=textValue
  aria-sort=(allowsSorting ? (direction ?? 'none') : undefined)
  data-allows-sorting=(allowsSorting || undefined)
  data-sort-direction=direction
  data-pressed=(isPressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  {onPointerDown}
  {onPointerMove}
  {onPointerUp}
  {onPointerCancel}
  {onPointerEnter}
  {onPointerLeave}
  {onClick}
  {onFocus}
  {onBlur}
  {...rest}
>{children}</th>

<style>
  th[data-sized] {
    width: ${size};
  }
</style>
