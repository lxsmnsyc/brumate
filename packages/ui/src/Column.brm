<script>
  import { $getContext, $memo, $props } from 'brumate/signals';
  import { keyAttribute } from './collection.ts';
  import type { Key } from './collection.ts';
  import { interact } from './interact.brm.ts';
  import { TableContext } from './table.ts';

  /**
   * A column of a Table, as Column of React Aria Components: its header cell. `id` is its key.
   *
   * - `isRowHeader` makes the cells of the column name their rows, as `th` elements with
   *   `role="rowheader"`. A Table needs one.
   * - With `allowsSorting`, a press or Enter sorts the Table by the column. It shows `aria-sort`,
   *   `data-allows-sorting` and `data-sort-direction`.
   * - It shows `data-pressed`, `data-hovered`, `data-focused` and `data-focus-visible`.
   */
  const {
    id,
    isRowHeader = false,
    allowsSorting = false,
    textValue,
    children,
    ...rest
  } = $props<{
    id?: Key;
    isRowHeader?: boolean;
    allowsSorting?: boolean;
    textValue?: string;
    children?: unknown;
    [attribute: string]: unknown;
  }>();

  const table = $getContext(TableContext);
  // The Table learns its columns from them, in order, before its rows render.
  table?.columns.push({ id, isRowHeader });
  const direction = $memo(
    table?.sortDescriptor && id !== undefined && table.sortDescriptor.column === id
      ? table.sortDescriptor.direction
      : undefined,
  );

  function pressed() {
    if (allowsSorting && id !== undefined) {
      table?.sort(id);
    }
  }

  const {
    pressed: isPressed,
    hovered,
    focused,
    focusVisible,
    onPointerDown,
    onPointerMove,
    onPointerUp,
    onPointerCancel,
    onPointerEnter,
    onPointerLeave,
    onClick,
    onFocus,
    onBlur,
  } = interact(
    false,
    !allowsSorting,
    pressed,
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
  );
</script>

<th
  role="columnheader"
  tabindex="-1"
  scope="col"
  data-key=(id === undefined ? undefined : keyAttribute(id))
  data-text-value=textValue
  aria-sort=(allowsSorting ? (direction ?? 'none') : undefined)
  data-allows-sorting=(allowsSorting || undefined)
  data-sort-direction=direction
  data-pressed=(isPressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  {onPointerDown}
  {onPointerMove}
  {onPointerUp}
  {onPointerCancel}
  {onPointerEnter}
  {onPointerLeave}
  {onClick}
  {onFocus}
  {onBlur}
  {...rest}
>{children}</th>
