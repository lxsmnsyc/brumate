<script module>
  import type { Bindable } from 'brumate/signals';
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { HoverEvent, PressEvent } from './events.ts';

  export interface ButtonOwnProps<T extends AsTarget = 'button'> {
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
    /** The `type` of a native button. A pending reset button is `button`. A pending submit button keeps `submit` and cancels its form's submit. */
    type?: 'button' | 'submit' | 'reset';
    /** The slot of the context of a part that holds this button, such as "increment". */
    slot?: string | null;
    /** Disables the button. It sets `disabled` on a native button. */
    isDisabled?: boolean;
    /** Pending: the button keeps its focus and presses nothing, such as while a form sends. */
    isPending?: boolean;
    /** The link of a button that renders as `a`. A disabled button drops it. */
    href?: string;
    /** Runs when a press ends on the button. */
    onPress?: (event: PressEvent) => void;
    /** Runs when a press starts. */
    onPressStart?: (event: PressEvent) => void;
    /** Runs when a press ends, on the button or off it. */
    onPressEnd?: (event: PressEvent) => void;
    /** Runs when a pointer or a key is released over the button. */
    onPressUp?: (event: PressEvent) => void;
    /** Runs when the button starts or stops being pressed. */
    onPressChange?: (pressed: boolean) => void;
    /** Runs when a mouse or a pen moves over the button. */
    onHoverStart?: (event: HoverEvent) => void;
    /** Runs when a mouse or a pen leaves the button. */
    onHoverEnd?: (event: HoverEvent) => void;
    /** Runs when the button starts or stops being hovered. */
    onHoverChange?: (hovered: boolean) => void;
    /** Runs when the button gains or loses focus. */
    onFocusChange?: (focused: boolean) => void;
    /** The content of the button. */
    children?: unknown;
  }

  /**
   * The props of Button. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type ButtonProps<T extends AsTarget = 'button'> = AsProps<T, ButtonOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'button'">
  import { $bind, $getContext, $handler, $memo, $props } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import { ButtonContext } from './contexts.ts';
  import { interact } from './interact.brm.ts';
  import { contextAttributes, slotProps } from './slots.ts';
  import SubmitGuard from './SubmitGuard.brm';

  /**
   * A button. It presses with a pointer, Enter, Space, or a
   * screen reader, and shows its state as data attributes: `data-pressed`, `data-hovered`,
   * `data-focused`, `data-focus-visible`, `data-disabled` and `data-pending`.
   */
  const {
    as,
    type = 'button',
    slot,
    isDisabled,
    isPending,
    href,
    onPress,
    onPressStart,
    onPressEnd,
    onPressUp,
    onPressChange,
    onHoverStart,
    onHoverEnd,
    onHoverChange,
    onFocusChange,
    children,
    ...rest
  } = $props<ButtonProps<T>>();
  let { ref } = $props<ButtonOwnProps<T>>();

  const context = $getContext(ButtonContext);
  const attributes = $memo(contextAttributes(slotProps(context, slot)));
  const disabled = $memo(Boolean(isDisabled ?? slotProps(context, slot).isDisabled));
  const pending = $memo(Boolean(isPending ?? slotProps(context, slot).isPending));
  const inert = $memo(disabled || pending);
  const native = $memo(as === undefined || as === 'button');

  // The props that the context gives this button. A memo cannot hold its handlers, which only
  // the browser calls, so they are read when they run.
  function given() {
    return slotProps(context, slot);
  }

  // The handlers of the context run first, then the button's own.
  function pressed(event: PressEvent) {
    given().onPress?.(event);
    onPress?.(event);
  }
  function pressStarted(event: PressEvent) {
    given().onPressStart?.(event);
    onPressStart?.(event);
  }
  function pressEnded(event: PressEvent) {
    given().onPressEnd?.(event);
    onPressEnd?.(event);
  }
  function pressUp(event: PressEvent) {
    given().onPressUp?.(event);
    onPressUp?.(event);
  }
  function pressChanged(value: boolean) {
    given().onPressChange?.(value);
    onPressChange?.(value);
  }
  function hoverStarted(event: HoverEvent) {
    given().onHoverStart?.(event);
    onHoverStart?.(event);
  }
  function hoverEnded(event: HoverEvent) {
    given().onHoverEnd?.(event);
    onHoverEnd?.(event);
  }
  function hoverChanged(value: boolean) {
    given().onHoverChange?.(value);
    onHoverChange?.(value);
  }
  function focusChanged(value: boolean) {
    given().onFocusChange?.(value);
    onFocusChange?.(value);
  }

  const {
    pressed: isPressed,
    hovered,
    focused,
    focusVisible,
    onPointerDown,
    onPointerMove,
    onPointerUp,
    onPointerCancel,
    onLostPointerCapture,
    onPointerEnter,
    onPointerLeave,
    onKeyDown,
    onKeyUp,
    onClick,
    onFocus,
    onBlur,
  } = interact(
    inert,
    inert,
    pressed,
    pressStarted,
    pressEnded,
    pressUp,
    pressChanged,
    hoverStarted,
    hoverEnded,
    hoverChanged,
    focusChanged,
  );

  // A pending reset button is a plain button, so it resets nothing. A pending submit button keeps
  // its type, so the form still has its submit button and its default button, and the button
  // cancels the submit itself.
  const kind = $memo(pending && type === 'reset' ? 'button' : type);

  // A submit or reset button keeps Space, so the browser clicks it and sends its form.
  // Other buttons prevent it, so the browser does not scroll the page or click them.
  function keys() {
    return native && (kind === 'submit' || kind === 'reset')
      ? { onKeyDown: $handler(onKeyDown), onKeyUp: $handler(onKeyUp) }
      : {
          onKeyDown: $handler(prevent(onKeyDown, 'Space')),
          onKeyUp: $handler(prevent(onKeyUp, 'Space')),
        };
  }
</script>

<!--
  A native button gets `disabled` and `type`. Another element gets the role and the focus of a
  button. A pending button stays focusable, with aria-disabled.
-->
<{as ?? 'button'}
  ref=$bind(ref)
  type=(native ? kind : undefined)
  href=(disabled ? undefined : href)
  role=(native ? undefined : 'button')
  tabindex=(native || disabled ? undefined : 0)
  disabled=(native && disabled ? true : undefined)
  aria-disabled=(!native && disabled || pending ? 'true' : undefined)
  data-pressed=(isPressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(disabled || undefined)
  data-pending=(pending || undefined)
  {onPointerDown}
  {onPointerMove}
  {onPointerUp}
  {onPointerCancel}
  {onLostPointerCapture}
  {onPointerEnter}
  {onPointerLeave}
  {...keys()}
  {onClick}
  {onFocus}
  {onBlur}
  {...attributes}
  {...rest}
>{children}</>
#if (native && type === 'submit') {
  <SubmitGuard ref=$bind(ref) />
}
