<script module>
  import type { AsProps, AsTarget } from './as.ts';
  import type { Bindable } from 'brumate/signals';

  export interface SearchFieldOwnProps {
    name?: string;
    isDisabled?: boolean;
    isReadOnly?: boolean;
    placeholder?: string;
    onChange?: (value: string) => void;
    onSubmit?: (value: string) => void;
    onClear?: () => void;
    children?: unknown;
    value?: Bindable<string>;
  }

  /**
   * The props of SearchField. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type SearchFieldProps<T extends AsTarget = 'div'> = AsProps<T, SearchFieldOwnProps>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $id, $memo, $props, $setContext } from 'brumate/signals';
  import { ButtonContext, InputContext, LabelContext, TextContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { describedBy } from './fields.ts';

  /**
   * A search field. It holds a Label, an Input and a
   * Button that clears it. Escape clears it too, and Enter calls `onSubmit`. It shows
   * `data-empty` and `data-disabled`.
   *
   * Enter sends no form, and Escape on a field with text clears it and keeps
   * its default, so it closes no dialog. A read-only or disabled field does neither.
   *
   * `value=(text)` starts its own value, and `value=$bind(signal)` writes the caller's.
   */
  const {
    as = 'div',
    name,
    isDisabled = false,
    isReadOnly = false,
    placeholder,
    onChange,
    onSubmit,
    onClear,
    children,
    ...rest
  } = $props<SearchFieldProps<T>>();
  let { value = '' } = $props<SearchFieldProps<T>>();

  const inputId = $id();
  const labelId = $id();
  const descriptionId = $id();
  const { present: hasDescription } = described(descriptionId);
  const empty = $memo(value === '');

  function change(next: string) {
    value = next;
    onChange?.(next);
  }

  function clear() {
    change('');
    onClear?.();
    document.getElementById(inputId)?.focus();
  }

  function keyDown(key: string, event: KeyboardEvent) {
    if (isDisabled || isReadOnly) {
      return;
    }
    // Enter while an input method composes ends a word, and sends nothing.
    if (key === 'Enter' && !event.isComposing) {
      onSubmit?.(value);
    } else if (key === 'Escape' && value !== '') {
      clear();
    }
  }

  $setContext(LabelContext, { id: labelId, for: inputId });
  $setContext(InputContext, {
    id: inputId,
    name,
    type: 'search',
    value,
    disabled: isDisabled || undefined,
    readonly: isReadOnly || undefined,
    placeholder,
    'aria-describedby': describedBy(hasDescription && descriptionId),
    onChange: change,
    onKeyDown: keyDown,
    isEnterPrevented: true,
    isEscapePrevented: !empty && !isDisabled && !isReadOnly,
  });
  // The button that clears the field stays out of the order of Tab.
  $setContext(ButtonContext, {
    'aria-label': 'Clear search',
    tabindex: -1,
    isDisabled: isDisabled || isReadOnly,
    onPress: clear,
  });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
</script>

<{as}
  data-empty=(empty || undefined)
  data-disabled=(isDisabled || undefined)
  {...rest}
>{children}</>
