<script module>
  import type { FocusStrategy, MenuTriggerState, SubmenuState } from './menu.ts';

  export interface SubmenuTriggerProps {
    /** The time in milliseconds that the pointer rests on the item before the submenu opens. */
    delay?: number;
    /** A `MenuItem` and a `Popover` with the `Menu` of the submenu. */
    children?: unknown;
  }
</script>

<script>
  import { $effect, $getContext, $hasContext, $id, $memo, $props, $setContext, $signal, $store, $toStore, $untrack } from 'brumate/signals';
  import { OverlayTriggerContext } from './contexts.ts';
  import type { OverlayTriggerState } from './contexts.ts';
  import {
    MenuContext,
    MenuTriggerContext,
    SubmenuContext,
    startHoverTimer,
    stopHoverTimer,
  } from './menu.ts';

  /**
   * Opens a submenu from a MenuItem. Its children are
   * the MenuItem and a Popover with the Menu of the submenu.
   *
   * - The item gets aria-haspopup="menu" and aria-expanded.
   * - A press, Enter, Space, or ArrowRight (ArrowLeft right to left) opens it, with focus on its
   *   first item. The pointer resting on the item for `delay`, 200 milliseconds by default, opens
   *   it and leaves focus on the item.
   * - Its Popover is not modal, and is placed at the end of the item, with its top at the top of
   *   the item.
   * - ArrowLeft and Escape close it, and focus goes back to the item. Focus that moves to another
   *   item of the parent menu closes it too. An action in it closes every menu.
   */
  const { delay = 200, children } = $props<SubmenuTriggerProps>();

  const parentGiven = $hasContext(MenuContext) ? $getContext(MenuContext) : undefined;
  const parent = $store(parentGiven?.state);
  const parentTrigger = $hasContext(MenuTriggerContext) ? $getContext(MenuTriggerContext) : undefined;
  const triggerId = $id();
  const overlayId = $id();
  let isOpen = $signal(false);
  let focusStrategy = $signal<FocusStrategy>('first');
  let autoFocus = $signal(true);

  function open(strategy: FocusStrategy, focus: boolean) {
    stopHoverTimer(triggerId);
    focusStrategy = strategy;
    autoFocus = focus;
    isOpen = true;
  }

  function close() {
    stopHoverTimer(triggerId);
    isOpen = false;
  }

  function hoverStart() {
    stopHoverTimer(triggerId);
    if (!isOpen) {
      startHoverTimer(triggerId, delay, () => open('first', false));
    }
  }

  function hoverEnd() {
    stopHoverTimer(triggerId);
  }

  // The parent menu closes too, with its `onClose`, and the menus around it.
  function closeAll() {
    close();
    if (parentGiven?.closeAll) {
      parentGiven?.closeAll();
    } else {
      parentTrigger?.closeAll?.();
    }
  }

  // Another item of the parent menu took focus, so this submenu is no longer the one in use.
  $effect(() => {
    const focusedId = parent?.focusedId;
    if (focusedId !== undefined && focusedId !== triggerId && $untrack(isOpen)) {
      $untrack(close());
    }
  });

  const submenuState = $memo<SubmenuState>({ triggerId, overlayId, isOpen });
  $setContext(SubmenuContext, { state: $toStore(submenuState), open, hoverStart, hoverEnd });
  const overlayState = $memo<OverlayTriggerState>({
    isOpen,
    triggerId,
    overlayId,
    isNonModal: true,
    placement: 'end top',
    autoFocus,
  });
  $setContext(OverlayTriggerContext, { state: $toStore(overlayState), open: () => open('first', true), close });
  const menuTrigger = $memo<MenuTriggerState>({ triggerId, focusStrategy, isSubmenu: true });
  $setContext(MenuTriggerContext, { state: $toStore(menuTrigger), closeAll });
</script>

{children}
