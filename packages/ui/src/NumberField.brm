<script module>
  import type { AsProps, AsTarget } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { PressEvent } from './events.ts';

  export interface NumberFieldOwnProps {
    /** The name of a hidden input that posts the number with the form. */
    name?: string;
    /** The least number. The field keeps the number at or above it. */
    minValue?: number;
    /** The greatest number. The field keeps the number at or below it. */
    maxValue?: number;
    /** The size of a step, 1 by default, or 1% for a percent. A number off the steps moves to the nearest one. */
    step?: number;
    /** The options of `Intl.NumberFormat` that format the number, such as a currency or a percent. */
    formatOptions?: Intl.NumberFormatOptions;
    /** Disables the field, its input and its buttons. */
    isDisabled?: boolean;
    /** Makes the input read only and disables the step buttons. */
    isReadOnly?: boolean;
    /** Asks the browser to check that the field has a number when its form is sent. */
    isRequired?: boolean;
    /** Marks the field as invalid. */
    isInvalid?: boolean;
    /** Stops the mouse wheel from stepping the number. */
    isWheelDisabled?: boolean;
    /** Runs with the number each time it changes. An empty field gives `NaN`. */
    onChange?: (value: number) => void;
    /** The name of the input when there is no Label. */
    'aria-label'?: string;
    /** The ID of the element that names the input when there is no Label. */
    'aria-labelledby'?: string;
    /** The Label, Group, Text and FieldError of the field. */
    children?: unknown;
    /** The number, or `NaN` when the field is empty. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    value?: Bindable<number>;
  }

  /**
   * The props of NumberField. `as` takes an element name or a component, and the other props are
   * those of the target.
   */
  export type NumberFieldProps<T extends AsTarget = 'div'> = AsProps<T, NumberFieldOwnProps>;
</script>

<script generics="T extends AsTarget = 'div'">
  import {
    $client,
    $effect,
    $getContext,
    $handler,
    $id,
    $memo,
    $props,
    $setContext,
    $signal,
    $untrack,
  } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import { NumberFormatter, NumberParser } from '@internationalized/number';
  import {
    ButtonContext,
    FieldErrorContext,
    FormContext,
    GroupContext,
    InputContext,
    LabelContext,
    TextContext,
  } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { describedBy, messagesOf, onFormReset } from './fields.ts';
  import { LocaleContext } from './locale.ts';
  import {
    addStep,
    clamp,
    listenToWheel,
    nextStep,
    snapToStep,
    startRepeat,
    stopRepeat,
    stopWheel,
  } from './numbers.ts';

  /**
   * A field for a number. It holds a Label, a Group
   * with an Input and two Buttons with `slot="decrement"` and `slot="increment"`, a Text with
   * `slot="description"` and a FieldError.
   *
   * - The number shows in the format of the locale and `formatOptions`, such as a currency or a
   *   percent. Typing keeps only text that can become a number.
   * - Focus that leaves the input, and Enter, read the number, keep it between `minValue` and
   *   `maxValue`, move it to the nearest `step` when there is one, and format it again.
   * - ArrowUp and ArrowDown, PageUp and PageDown, and the Buttons step the number. A held Button
   *   steps again and again. Home and End go to the minimum and the maximum. The wheel steps it
   *   while the input has focus, unless `isWheelDisabled`.
   * - `value` is the number, or `NaN` when the field is empty. `value=(n)` starts its own, and
   *   `value=$bind(signal)` writes the caller's. `name` sends the number with its form, as it
   *   reads in the input, so Enter sends what was typed. A reset of the form gives back the
   *   first number.
   * - `isRequired` asks the browser to check it on a submit, and the FieldError shows the message.
   * - `aria-label` and `aria-labelledby` name the input when there is no Label, and the Buttons
   *   say what they increase and decrease.
   */
  const {
    name,
    minValue,
    maxValue,
    step,
    formatOptions,
    isDisabled = false,
    isReadOnly = false,
    isRequired = false,
    isInvalid,
    isWheelDisabled = false,
    onChange,
    'aria-label': ariaLabel,
    'aria-labelledby': ariaLabelledBy,
    children,
    ...rest
  } = $props<NumberFieldOwnProps>();
  // The props of the target of `as`, for the type of the component.
  const { as = 'div' } = $props<NumberFieldProps<T>>();
  let { value = Number.NaN } = $props<NumberFieldProps<T>>();

  const locale = $getContext(LocaleContext);
  const form = $getContext(FormContext);
  const inputId = $id();
  const labelId = $id();
  const incrementId = $id();
  const decrementId = $id();
  const descriptionId = $id();
  const errorId = $id();
  const { present: hasDescription } = described(descriptionId);
  const { present: hasLabel } = described(labelId);
  // The number that a reset of the form gives back.
  let initialValue = $signal(value);
  // A percent counts in hundredths.
  const stepSize = $memo(step ?? (formatOptions?.style === 'percent' ? 0.01 : 1));
  // The text in the input, which is the formatted number until the user types.
  let text = $signal(format(value));
  let edited = $signal(false);
  // The message of the browser, once the field was checked on a submit.
  let committed = $signal(false);
  let nativeErrors = $signal<string[]>([]);
  const errors = $memo([
    ...(edited ? [] : messagesOf(name ? (form?.validationErrors[name] as string | string[]) : undefined)),
    ...(committed ? nativeErrors : []),
  ]);
  const invalid = $memo(
    Boolean(isInvalid) ||
      errors.length > 0 ||
      (!Number.isNaN(value) &&
        ((minValue !== undefined && value < minValue) || (maxValue !== undefined && value > maxValue))),
  );
  const locked = $memo(isDisabled || isReadOnly);
  // The number as it reads in the input, before it is committed.
  const typedValue = $memo(text.trim() === '' ? Number.NaN : parser().parse(text));
  // A Button can step when a step stays in the range.
  const canIncrement = $memo(
    !locked &&
      (Number.isNaN(typedValue) ||
        maxValue === undefined ||
        snapToStep(typedValue, minValue, maxValue, stepSize) > typedValue ||
        addStep(typedValue, stepSize, 1) <= maxValue),
  );
  const canDecrement = $memo(
    !locked &&
      (Number.isNaN(typedValue) ||
        minValue === undefined ||
        snapToStep(typedValue, minValue, maxValue, stepSize) < typedValue ||
        addStep(typedValue, stepSize, -1) >= minValue),
  );
  // The Buttons say what they change: the field by its label, or by its `aria-label`.
  const fieldLabelledBy = $memo(
    [hasLabel ? labelId : undefined, ariaLabelledBy].filter(Boolean).join(' ') || undefined,
  );
  // A percent or a fraction needs the decimal keys of a touch keyboard.
  const inputMode = $memo(
    formatOptions?.style === 'percent' || (formatOptions?.maximumFractionDigits ?? 0) > 0
      ? 'decimal'
      : 'numeric',
  );

  function format(number: number): string {
    return Number.isNaN(number) ? '' : new NumberFormatter(locale.locale, formatOptions).format(number);
  }

  function parser() {
    return new NumberParser(locale.locale, formatOptions);
  }

  function input() {
    return document.getElementById(inputId) as HTMLInputElement | null;
  }

  function setValue(next: number) {
    if (!Object.is(next, value)) {
      value = next;
      edited = true;
      onChange?.(next);
    }
    text = format(value);
  }

  // A value that the caller sets shows in the input.
  $effect(() => {
    const next = value;
    if (!Object.is($untrack(parser().parse(text)), next)) {
      $untrack((text = format(next)));
    }
  });

  function typed(next: string) {
    // Only text that can become a number stays, such as `-` or `1.`.
    if (next === '' || parser().isValidPartialNumber(next, minValue, maxValue)) {
      text = next;
      return;
    }
    const element = input();
    if (element) {
      element.value = text;
    }
  }

  /** Reads the number in the input, keeps it in the range and on a step, and formats it. */
  function commit() {
    if (text.trim() === '') {
      setValue(Number.NaN);
      return;
    }
    const parsed = parser().parse(text);
    if (Number.isNaN(parsed)) {
      text = format(value);
      return;
    }
    // A number moves to a step only when the field has one. Otherwise it only
    // stays in the range.
    const snapped =
      step === undefined ? clamp(parsed, minValue, maxValue) : snapToStep(parsed, minValue, maxValue, step);
    // The format can round, such as to two digits, so the number is what the format shows.
    setValue(parser().parse(format(snapped)));
  }

  function stepBy(sign: 1 | -1): boolean {
    if (locked) {
      return false;
    }
    const current = parser().parse(text);
    const next = nextStep(current, sign, minValue, maxValue, stepSize);
    if (Object.is(next, value) && text === format(next)) {
      return false;
    }
    setValue(next);
    return true;
  }

  function keyDown(event: KeyboardEvent) {
    if ((event.target as Element).id !== inputId || locked) {
      return;
    }
    // A key with a modifier, such as Shift with an arrow to select text, is not a step.
    if (event.shiftKey || event.ctrlKey || event.altKey || event.metaKey || event.isComposing) {
      return;
    }
    switch (event.key) {
      case 'ArrowUp':
      case 'PageUp':
        stepBy(1);
        return;
      case 'ArrowDown':
      case 'PageDown':
        stepBy(-1);
        return;
      case 'Home':
        if (minValue !== undefined) {
          setValue(minValue);
        }
        return;
      case 'End':
        if (maxValue !== undefined) {
          setValue(snapToStep(maxValue, minValue, maxValue, stepSize));
        }
        return;
      case 'Enter':
        commit();
        return;
      default:
        return;
    }
  }

  function wheel(event: WheelEvent) {
    // A scroll that is mostly sideways, as on a trackpad, is not a step.
    if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) {
      return;
    }
    event.preventDefault();
    stepBy(event.deltaY > 0 ? 1 : -1);
  }

  // The wheel steps the number only while the input has focus, so it listens from then on.
  function focused() {
    const element = input();
    if (element && !isWheelDisabled) {
      listenToWheel(element, (event) => wheel(event));
    }
  }

  function blurred() {
    const element = input();
    if (element) {
      stopWheel(element);
    }
    commit();
  }

  // The loader prevents the keys before the code loads, so the wrapper names them. A field that
  // cannot change keeps every key, and Home and End step only to a limit that there is.
  function keys(isLocked: boolean, hasMin: boolean, hasMax: boolean) {
    if (isLocked) {
      return { onKeyDown: $handler(keyDown) };
    }
    if (hasMin && hasMax) {
      return {
        onKeyDown: $handler(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End')),
      };
    }
    if (hasMin) {
      return { onKeyDown: $handler(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home')) };
    }
    if (hasMax) {
      return { onKeyDown: $handler(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'End')) };
    }
    return { onKeyDown: $handler(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown')) };
  }

  function invalidated(message: string, first: boolean) {
    committed = true;
    nativeErrors = message ? [message] : [];
    if (first) {
      input()?.focus();
    }
  }

  // A reset of the form gives back the first number, as it does for a field of the browser.
  $client(() => {
    return onFormReset(input(), () => {
      setValue(initialValue);
      edited = false;
      committed = false;
      nativeErrors = [];
    });
  }, 'load');

  /** A press of a Button steps at once, and again while it is held. Focus stays in the input. */
  function held(sign: 1 | -1, event: PressEvent) {
    input()?.focus({ preventScroll: true });
    startRepeat(inputId, () => stepBy(sign), event.pointerType === 'touch' ? 600 : 400);
  }

  function released() {
    stopRepeat(inputId);
    // The browser focuses the Button on mousedown, after the press began, so focus goes back.
    input()?.focus({ preventScroll: true });
  }

  $setContext(LabelContext, { id: labelId, for: inputId });
  $setContext(GroupContext, {
    isDisabled,
    isInvalid: invalid,
    'aria-disabled': isDisabled ? 'true' : undefined,
  });
  $setContext(InputContext, {
    id: inputId,
    type: 'text',
    value: text,
    inputmode: inputMode,
    autocomplete: 'off',
    autocorrect: 'off',
    spellcheck: 'false',
    'aria-roledescription': 'Number field',
    disabled: isDisabled || undefined,
    readonly: isReadOnly || undefined,
    required: isRequired || undefined,
    'aria-label': ariaLabel,
    'aria-labelledby': ariaLabelledBy && hasLabel ? `${labelId} ${ariaLabelledBy}` : ariaLabelledBy,
    'aria-invalid': invalid ? 'true' : undefined,
    'aria-describedby': describedBy(hasDescription && descriptionId, invalid && errorId),
    onChange: typed,
    onInvalid: invalidated,
    onFocus: focused,
    onBlur: blurred,
  });
  $setContext(ButtonContext, {
    slots: {
      increment: {
        id: incrementId,
        'aria-label': ariaLabel ? `Increase ${ariaLabel}` : 'Increase',
        'aria-labelledby': fieldLabelledBy ? `${incrementId} ${fieldLabelledBy}` : undefined,
        'aria-controls': inputId,
        tabindex: '-1',
        isDisabled: !canIncrement,
        onPressStart: (event: PressEvent) => held(1, event),
        onPressEnd: released,
      },
      decrement: {
        id: decrementId,
        'aria-label': ariaLabel ? `Decrease ${ariaLabel}` : 'Decrease',
        'aria-labelledby': fieldLabelledBy ? `${decrementId} ${fieldLabelledBy}` : undefined,
        'aria-controls': inputId,
        tabindex: '-1',
        isDisabled: !canDecrement,
        onPressStart: (event: PressEvent) => held(-1, event),
        onPressEnd: released,
      },
    },
  });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(FieldErrorContext, { id: errorId, isInvalid: invalid, errors });
</script>

<{as}
  data-disabled=(isDisabled || undefined)
  data-readonly=(isReadOnly || undefined)
  data-invalid=(invalid || undefined)
  data-required=(isRequired || undefined)
  {...rest}
>
  <div
    style="display: contents"
    {...keys(locked, minValue !== undefined, maxValue !== undefined)}
  >{children}</div>
  <!-- The number for the form, which posts without scripts. -->
  <input
    type="hidden"
    {name}
    value=(Number.isNaN(typedValue) ? '' : String(typedValue))
    disabled=(isDisabled || undefined)
  >
</>
