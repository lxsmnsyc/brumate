<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface ColorSwatchProps extends ElementProps<'div'> {
    /** A color of CSS, such as `#e2445a`. Without it, the swatch shows the color of its ColorSwatchPickerItem, or else of its ColorPicker. */
    color?: string;
    /** The name that screen readers hear. Without it, a short name in English names the color. */
    colorName?: string;
    /** A name that adds to the name of the color, such as `dark blue, Brand`. */
    'aria-label'?: string;
  }
</script>

<script>
  import { $getContext, $memo, $props } from 'brumate/signals';
  import { ColorPickerContext, ColorSwatchContext } from './contexts.ts';
  import { colorName, formatColor, swatchBackground, tryParseColor } from './color.ts';

  /**
   * A sample of a color: role="img", named by the color.
   *
   * - `color` is a color of CSS, such as `#e2445a` or `hsl(355, 74%, 58%)`.
   * - Without `color`, inside a ColorSwatchPickerItem, it shows the color of the item, and inside a
   *   ColorPicker the color of the picker.
   * - `colorName` names it for screen readers. Without it, a short name in English names it, such
   *   as `dark blue`, with how transparent it is. An `aria-label` adds to the name: `dark blue,
   *   Brand`.
   * - The background shows the color over a checkerboard, so its alpha shows. The element has
   *   `--color` for CSS.
   */
  const { color: given, colorName: name, 'aria-label': ariaLabel, ...rest } = $props<ColorSwatchProps>();

  const item = $getContext(ColorSwatchContext);
  const picker = $getContext(ColorPickerContext);
  const color = $memo(given ?? item?.color ?? picker?.value ?? '#000000');
  const parsed = $memo(tryParseColor(color));
  const css = $memo(parsed ? formatColor(parsed) : 'transparent');
  const described = $memo(name ?? (parsed ? colorName(parsed) : color));
  // An `aria-label` of the caller adds to the name of the color.
  const label = $memo(ariaLabel ? `${described}, ${ariaLabel}` : described);
</script>

<!-- The attributes of the caller come last, so its class adds to the part's. -->
<div
  role="img"
  aria-roledescription="color swatch"
  aria-label=label
  class="swatch"
  {...rest}
></div>

<style>
  .swatch {
    --color: ${css};
    background: ${swatchBackground(css)};
  }
</style>
