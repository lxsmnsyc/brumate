<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';

  export interface DisclosureGroupOwnProps<T extends AsTarget = 'div'> {
    allowsMultipleExpanded?: boolean;
    isDisabled?: boolean;
    onExpandedChange?: (keys: string[]) => void;
    children?: unknown;
    expandedKeys?: Bindable<string[]>;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of DisclosureGroup. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type DisclosureGroupProps<T extends AsTarget = 'div'> = AsProps<T, DisclosureGroupOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $props, $setContext } from 'brumate/signals';
  import { DisclosureGroupContext } from './contexts.ts';

  /**
   * Disclosures that open one at a time, or several with `allowsMultipleExpanded`, such as an
   * accordion. Each Disclosure names itself with `id`. It shows `data-disabled`.
   *
   * `expandedKeys=([...])` starts its own state, and `expandedKeys=$bind(signal)` writes the
   * caller's.
   */
  const {
    as,
    allowsMultipleExpanded = false,
    isDisabled = false,
    onExpandedChange,
    children,
    ...rest
  } = $props<DisclosureGroupProps<T>>();
  let { expandedKeys = [] } = $props<DisclosureGroupOwnProps<T>>();
  let { ref } = $props<DisclosureGroupOwnProps<T>>();

  function toggle(id: string) {
    let next: string[];
    if (expandedKeys.includes(id)) {
      next = expandedKeys.filter((key) => key !== id);
    } else {
      next = allowsMultipleExpanded ? [...expandedKeys, id] : [id];
    }
    expandedKeys = next;
    onExpandedChange?.(next);
  }

  $setContext(DisclosureGroupContext, { expandedKeys, isDisabled, toggle });
</script>

<{as ?? 'div'} ref=$bind(ref) data-disabled=(isDisabled || undefined) {...rest}>{children}</>
