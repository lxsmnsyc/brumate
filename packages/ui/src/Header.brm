<script module>
  import type { AsProps, AsTarget } from './as.ts';

  export interface HeaderOwnProps {
    children?: unknown;
  }

  /**
   * The props of Header. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type HeaderProps<T extends AsTarget = 'header'> = AsProps<T, HeaderOwnProps>;
</script>

<script generics="T extends AsTarget = 'header'">
  import { $getContext, $props } from 'brumate/signals';
  import { SectionContext } from './collection.ts';

  /** The header of a section of a collection. It names it. */
  const { as = 'header', children, ...rest } = $props<HeaderProps<T>>();

  const section = $getContext(SectionContext);
</script>

<{as} id=(section?.headerId) {...rest}>{children}</>
