<script module>
  import type { Bindable } from 'brumate/signals';
  import type { ButtonStateProps } from './contexts.ts';
  import type { TooltipTriggerState } from './tooltip.ts';
  import type { HoverEvent, PressEvent } from './events.ts';
  import type { ContextValue } from './slots.ts';

  export interface TooltipTriggerProps {
    /** The time in milliseconds that hover waits before the tooltip shows. */
    delay?: number;
    /** The time in milliseconds between the pointer leaving and the tooltip hiding. */
    closeDelay?: number;
    /** With `focus`, only focus shows the tooltip, and hover does not. */
    trigger?: 'focus';
    /** Never shows the tooltip. */
    isDisabled?: boolean;
    /** Runs with each change of whether the tooltip shows. */
    onOpenChange?: (open: boolean) => void;
    /** A `Button` and a `Tooltip`. */
    children?: unknown;
    /** Whether the tooltip shows. Alone it holds its own state, which starts hidden, and `$bind` writes your signal. A start value of `true` shows it once the page has loaded. */
    isOpen?: Bindable<boolean>;
  }
</script>

<script>
  import { $client, $getContext, $id, $memo, $props, $setContext, $store, $toStore } from 'brumate/signals';
  import { ButtonContext } from './contexts.ts';
  import { isFocusVisible } from './interactions.ts';
  import { TooltipTriggerContext, pressedTriggers, tooltips } from './tooltip.ts';

  /**
   * Shows a Tooltip for the Button inside it.
   *
   * - Hover shows it after `delay`, 1500 milliseconds by default. Once a tooltip has shown, the
   *   others show at once, until none has shown for half a second.
   * - Focus from the keyboard shows it at once. A touch never shows it.
   * - Leaving hides it after `closeDelay`, 500 milliseconds, unless the pointer moves onto the
   *   tooltip. Blur, a press of the button and Escape hide it at once.
   * - `trigger="focus"` shows it only on focus. `isDisabled` never shows it.
   * - The Button gets `aria-describedby` while it shows. Inside a DialogTrigger, it keeps what
   *   the DialogTrigger gives it.
   */
  const {
    delay = 1500,
    closeDelay = 500,
    trigger,
    isDisabled = false,
    onOpenChange,
    children,
  } = $props<TooltipTriggerProps>();
  let { isOpen = false } = $props<TooltipTriggerProps>();

  const parentGiven = $getContext(ButtonContext, undefined);
  const parent = parentGiven ? $store(parentGiven.state) : undefined;
  const ownId = $id();
  const tooltipId = $id();
  // A DialogTrigger around it names the button already, and finds its popover by that ID.
  const triggerId = $memo(getId(parent) ?? ownId);

  function getId(value: ContextValue<ButtonStateProps> | null | undefined) {
    return value && !('slots' in value) && typeof value.id === 'string' ? value.id : undefined;
  }

  function setOpen(next: boolean) {
    if (next !== isOpen) {
      isOpen = next;
      onOpenChange?.(next);
    }
  }

  function open(immediate: boolean) {
    if (!isDisabled) {
      tooltips.show(tooltipId, delay, immediate, () => {
        setOpen(true);
        // A setter that refused leaves it closed.
        return isOpen;
      }, () => setOpen(false));
    }
  }

  function close(immediate: boolean) {
    tooltips.hide(tooltipId, closeDelay, immediate, () => setOpen(false));
  }

  function keep() {
    tooltips.keep(tooltipId);
  }

  // A trigger that leaves the page, such as in an #if or on a route change, stops its timers, so
  // they open nothing later and the next tooltip still waits for its delay.
  $client(() => () => tooltips.forget(tooltipId), 'idle');

  function hoverStarted(event: HoverEvent) {
    plain()?.onHoverStart?.(event);
    if (trigger !== 'focus') {
      open(false);
    }
  }

  function hoverEnded(event: HoverEvent) {
    plain()?.onHoverEnd?.(event);
    // A tooltip that only focus shows stays while the trigger has focus.
    if (trigger !== 'focus') {
      close(false);
    }
  }

  function focusChanged(focused: boolean) {
    plain()?.onFocusChange?.(focused);
    const active = document.activeElement;
    // A press focuses the button, and the press hides the tooltip.
    if (focused && active && isFocusVisible(active) && !pressedTriggers.has(active)) {
      open(true);
    } else if (!focused) {
      close(true);
    }
  }

  function pressStarted(event: PressEvent) {
    plain()?.onPressStart?.(event);
    pressedTriggers.add(event.target);
    close(true);
  }

  function pressEnded(event: PressEvent) {
    plain()?.onPressEnd?.(event);
    pressedTriggers.delete(event.target);
  }

  /** The props of the context around it, when it gives one Button its props. */
  function plain() {
    const handlers = parentGiven?.handlers;
    return handlers && !('slots' in handlers) ? handlers : undefined;
  }

  // The props of the DialogTrigger around it come first, and the handlers of both run.
  const buttonState = $memo({
    ...(parent && !('slots' in parent) ? parent : {}),
    id: triggerId,
    'aria-describedby': isOpen ? tooltipId : undefined,
  });
  $setContext(ButtonContext, {
    state: $toStore(buttonState),
    handlers: {
      onPress: (event: PressEvent) => plain()?.onPress?.(event),
      onPressUp: (event: PressEvent) => plain()?.onPressUp?.(event),
      onPressChange: (pressed: boolean) => plain()?.onPressChange?.(pressed),
      onHoverChange: (hovered: boolean) => plain()?.onHoverChange?.(hovered),
      onHoverStart: hoverStarted,
      onHoverEnd: hoverEnded,
      onFocusChange: focusChanged,
      onPressStart: pressStarted,
      onPressEnd: pressEnded,
    },
  });
  const triggerState = $memo<TooltipTriggerState>({ isOpen, triggerId, tooltipId });
  $setContext(TooltipTriggerContext, { state: $toStore(triggerState), keep, close });
</script>

{children}
