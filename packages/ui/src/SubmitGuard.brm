<script>
  import type { Bindable } from 'brumate/signals';
  import { $client, $props } from 'brumate/signals';

  let { ref } = $props<{ ref?: Bindable<Element | undefined> }>();

  // Cancels a submit of the form while the submit button is pending: a click on it, or Enter in a
  // field, which the browser sends as a click on the default button, the first submit button of
  // the form in tree order. A submit with no submitter, such as `form.requestSubmit()`, is
  // cancelled when the button is the default button. In a form with two submit buttons, only the
  // pending one is blocked. When the button is not pending, the listener does nothing, and the
  // other submit listeners of the page run.
  //
  // The guard is in the set `bCancels` of the form, which the document listener of brumate reads
  // before it runs any handler, so a delegated `onSubmit` does not run either. It is added on
  // load, so it exists before a press can make the button pending. It reads data-pending, because
  // a signal read in a $client callback is the value of the load.
  $client(() => {
    const button = ref as HTMLButtonElement | undefined;
    const form = button?.form;
    if (!form || button.type !== 'submit') {
      return;
    }
    // The default button is the first submit button of the form, in tree order.
    const isDefault = () => {
      for (const element of form.elements) {
        if ((element as HTMLButtonElement).type === 'submit') {
          return element === button;
        }
      }
      return false;
    };
    const cancel = (event: Event) => {
      const { submitter } = event as SubmitEvent;
      if (button.hasAttribute('data-pending') && (submitter === button || (!submitter && isDefault()))) {
        event.preventDefault();
        return true;
      }
      return false;
    };
    const cancels = ((form as { bCancels?: Set<typeof cancel> }).bCancels ??= new Set());
    cancels.add(cancel);
    return () => {
      cancels.delete(cancel);
    };
  }, 'load');
</script>
