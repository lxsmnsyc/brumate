<script module>
  export interface NavigationTreeItemLinkProps {
    children?: unknown;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $getContext, $props } from 'brumate/signals';
  import { NavigationLinkContext } from './navigation-tree.ts';

  /**
   * The link of a NavigationTreeItem. It
   * links to the `href` of its item, and has `aria-current="page"` and `data-current` when that
   * is the route of the tree. An item without an `href` shows its text, with no link. A disabled
   * item shows a span with `aria-disabled` and `data-disabled`, as a disabled Link does: it has no
   * `href` and no tab stop.
   */
  const { children, ...rest } = $props<NavigationTreeItemLinkProps>();

  const link = $getContext(NavigationLinkContext);
</script>

#if (link?.href && !link.isDisabled) {
  <a
    href=(link.href)
    aria-current=(link.isCurrent ? 'page' : undefined)
    data-current=(link.isCurrent || undefined)
    {...rest}
  >{children}</a>
} #else {
  <span
    role=(link?.href ? 'link' : undefined)
    aria-disabled=(link?.isDisabled ? 'true' : undefined)
    data-disabled=(link?.isDisabled || undefined)
    {...rest}
  >{children}</span>
}
