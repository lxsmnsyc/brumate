<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface BreadcrumbsProps extends ElementProps<'ol'> {
    /** Disables every link of the trail. */
    isDisabled?: boolean;
    /** The `Breadcrumb` elements. */
    children?: unknown;
  }
</script>

<script>
  import { $props, $setContext } from 'brumate/signals';
  import { LinkContext } from './contexts.ts';

  /**
   * A trail of links: an <ol> of Breadcrumbs. Put it in
   * a <nav> with a label. `isDisabled` disables every link. It shows `data-disabled`.
   */
  const { isDisabled = false, children, ...rest } = $props<BreadcrumbsProps>();

  $setContext(LinkContext, { isDisabled });
</script>

<ol data-disabled=(isDisabled || undefined) {...rest}>{children}</ol>
