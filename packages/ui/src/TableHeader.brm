<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface TableHeaderProps extends ElementProps<'thead'> {
    children?: unknown;
  }
</script>

<script>
  import { $getContext, $props, $setContext } from 'brumate/signals';
  import { CheckboxGroupContext } from './contexts.ts';
  import { TableContext } from './table.ts';

  /**
   * The header of a Table: a row of Column elements.
   * A Checkbox with `slot="selection"` in a Column selects every row, or none. It shows a mixed
   * state while some rows are selected.
   */
  const { children, ...rest } = $props<TableHeaderProps>();

  const table = $getContext(TableContext);

  $setContext(CheckboxGroupContext, {
    value: table?.selectAll.all ? [''] : [],
    isIndeterminate: Boolean(table && !table.selectAll.all && table.selectAll.some),
    isDisabled: !table,
    isReadOnly: false,
    isInvalid: false,
    isRequired: false,
    toggle: () => table?.toggleAll(),
    onInvalid: () => {},
  });
</script>

<thead role="rowgroup" {...rest}><tr role="row">{children}</tr></thead>
