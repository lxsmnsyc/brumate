<script module>
  import type { Bindable } from 'brumate/signals';

  export interface ModalProps {
    isDismissable?: boolean;
    isKeyboardDismissDisabled?: boolean;
    transition?: boolean;
    onOpenChange?: (open: boolean) => void;
    children?: unknown;
    isOpen?: Bindable<boolean | undefined>;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $bind, $getContext, $isPassed, $props, $setContext } from 'brumate/signals';
  import { ModalOverlayContext } from './contexts.ts';
  import ModalContent from './ModalContent.brm';
  import ModalOverlay from './ModalOverlay.brm';

  /**
   * The box of a modal, which holds a Dialog. Inside a
   * ModalOverlay, it renders only its box. On its own, it renders a ModalOverlay around itself,
   * with the props of the overlay: `isOpen`, `isDismissable`, `isKeyboardDismissDisabled`,
   * `transition` and `onOpenChange`.
   */
  const {
    isDismissable = false,
    isKeyboardDismissDisabled = false,
    transition = false,
    onOpenChange,
    children,
    ...rest
  } = $props<ModalProps>();
  // It takes a binding of a value that can be undefined, so a part can pass its own `isOpen` on.
  let { isOpen } = $props<ModalProps>();

  const overlay = $getContext(ModalOverlayContext);
  const passed = $isPassed(isOpen);
  // A Modal inside this one is not its box, so it opens an overlay of its own.
  $setContext(ModalOverlayContext, null);
</script>

#template box() {
  <div data-modal tabindex="-1" {...rest}><ModalContent>{children}</ModalContent></div>
}

#if (overlay) {
  {box()}
} #else if (passed) {
  <ModalOverlay
    isOpen=$bind(isOpen)
    {isDismissable}
    {isKeyboardDismissDisabled}
    {transition}
    {onOpenChange}
  >{box()}</ModalOverlay>
} #else {
  <ModalOverlay
    {isDismissable}
    {isKeyboardDismissDisabled}
    {transition}
    {onOpenChange}
  >{box()}</ModalOverlay>
}
