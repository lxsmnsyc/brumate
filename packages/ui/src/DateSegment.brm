<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { Segment, SegmentType } from './segments.ts';

  export interface DateSegmentProps extends ElementProps<'span'> {
    /** The segment to show, from the `segment` template of the DateInput. */
    segment: Segment;
  }
</script>

<script>
  import { $getContext, $id, $props } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import { DateFieldContext, PAGE_STEP, SEGMENT_NAMES, focusSegment } from './segments.ts';

  /**
   * One part of the date of a DateField, or the text between two parts.
   *
   * - A part is a spinbutton. ArrowUp and ArrowDown step it around its range, and a part that is
   *   not set starts at the placeholder. PageUp and PageDown step it further, such as by 5 years
   *   or 15 minutes, and Home and End go to the ends of its range.
   * - Digits type into it, and `a` or `p` into AM or PM. Once no other digit could follow, focus
   *   moves to the next part.
   *   Backspace or Delete takes the last digit away, and moves back from an empty part.
   * - It is editable text, so a touch keyboard shows its digits. The browser does not change the
   *   text itself.
   * - It shows `data-type`, `data-placeholder`, `data-focused`, `data-readonly`, `data-disabled`
   *   and `data-invalid`.
   */
  const { segment, ...rest } = $props<DateSegmentProps>();

  const field = $getContext(DateFieldContext);
  const id = $id();

  /** The part that this segment edits. */
  function part(): SegmentType | undefined {
    return segment.type === 'literal' ? undefined : segment.type;
  }

  /** Focuses the part after or before this one in the field. */
  function move(element: HTMLElement, by: 1 | -1) {
    const group = element.closest('[role="group"]');
    const editable = [...(group?.querySelectorAll<HTMLElement>('[data-segment]:not([data-type="literal"])') ?? [])];
    focusSegment(editable[editable.indexOf(element) + by]);
  }

  function keyDown(event: KeyboardEvent) {
    const type = part();
    if (!field || !type) {
      return;
    }
    if (event.ctrlKey || event.altKey || event.metaKey) {
      return;
    }
    switch (event.key) {
      case 'ArrowUp':
        field.step(type, 1);
        return;
      case 'ArrowDown':
        field.step(type, -1);
        return;
      case 'PageUp':
        field.step(type, PAGE_STEP[type]);
        return;
      case 'PageDown':
        field.step(type, -PAGE_STEP[type]);
        return;
      case 'Home':
        field.jump(type, 'min');
        return;
      case 'End':
        field.jump(type, 'max');
        return;
      default:
        return;
    }
  }

  // The browser does not change the text. Each digit types into the part.
  function beforeInput(event: InputEvent & { currentTarget: HTMLElement }) {
    const type = part();
    const element = event.currentTarget;
    if (!field || !type) {
      return;
    }
    if (event.inputType === 'deleteContentBackward' || event.inputType === 'deleteContentForward') {
      if (field.erase(type)) {
        move(element, -1);
      }
      return;
    }
    for (const char of event.data ?? '') {
      if (field.type(type, char)) {
        move(element, 1);
        return;
      }
    }
  }

  function focusIn(event: FocusEvent & { currentTarget: HTMLElement }) {
    event.currentTarget.setAttribute('data-focused', '');
  }

  function focusOut(event: FocusEvent & { currentTarget: HTMLElement }) {
    event.currentTarget.removeAttribute('data-focused');
    field?.settle();
  }
</script>

#if (segment.type === 'literal') {
  <span aria-hidden="true" data-segment data-type="literal" {...rest}>{segment.text}</span>
} #else {
  <span
    {id}
    role="spinbutton"
    tabindex=(field?.isDisabled ? undefined : '0')
    contenteditable=(field?.isDisabled || field?.isReadOnly ? undefined : 'true')
    inputmode=(segment.type === 'dayPeriod' ? 'text' : 'numeric')
    autocorrect="off"
    spellcheck="false"
    enterkeyhint="next"
    aria-label=((field?.segmentNames ?? SEGMENT_NAMES)[segment.type])
    aria-labelledby=(field ? `${id} ${field.labelId}` : undefined)
    aria-describedby=(field?.describedBy)
    aria-valuenow=(segment.value)
    aria-valuemin=(segment.min)
    aria-valuemax=(segment.max)
    aria-valuetext=(segment.isPlaceholder ? (field?.empty ?? 'Empty') : segment.text)
    aria-required=(field?.isRequired || undefined)
    aria-invalid=(field?.isInvalid || undefined)
    aria-readonly=(field?.isReadOnly || undefined)
    aria-disabled=(field?.isDisabled || undefined)
    data-segment
    data-type=(segment.type)
    data-placeholder=(segment.isPlaceholder || undefined)
    data-readonly=(field?.isReadOnly || undefined)
    data-disabled=(field?.isDisabled || undefined)
    data-invalid=(field?.isInvalid || undefined)
    onKeyDown=(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End'))
    onBeforeInput=(prevent(beforeInput))
    onFocusIn=focusIn
    onFocusOut=focusOut
    {...rest}
  >{segment.text}</span>
}
