<script>
  import { $client, $getContext, $id, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import type { Bindable } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import { ListBoxGivenContext, SelectValueContext, itemsOf, keyOf } from './collection.ts';
  import type { Key } from './collection.ts';
  import {
    ButtonContext,
    FieldErrorContext,
    FormContext,
    LabelContext,
    OverlayTriggerContext,
    TextContext,
  } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { describedBy, isFirstInvalid, messagesOf } from './fields.ts';

  /**
   * A field that picks one item from a list, as Select of React Aria Components. It holds a
   * Label, a Button with a SelectValue, a Text with `slot="description"`, a FieldError, and a
   * Popover with a ListBox.
   *
   * - A press of the Button, ArrowDown and ArrowUp open the list, with focus on the selected
   *   item, or the first. A press, Enter or Space on an item selects it and closes the list.
   *   Escape, Tab and a press outside close it with no change.
   * - `selectedKey=(key)` starts its own selection, and `selectedKey=$bind(signal)` writes the
   *   caller's. `onSelectionChange` gets each new key.
   * - `name` sends the key with its form, also before its code loads. `isRequired` asks the
   *   browser to check it on a submit, and the FieldError shows the message.
   * - The element shows `data-open`, `data-disabled`, `data-invalid` and `data-required`.
   */
  const {
    as = 'div',
    name,
    placeholder = 'Select an item',
    isDisabled = false,
    isRequired = false,
    isInvalid,
    onSelectionChange,
    onOpenChange,
    children,
    ...rest
  } = $props<{
    as?: string;
    name?: string;
    placeholder?: string;
    isDisabled?: boolean;
    isRequired?: boolean;
    isInvalid?: boolean;
    onSelectionChange?: (key: Key | null) => void;
    onOpenChange?: (open: boolean) => void;
    children?: unknown;
    [attribute: string]: unknown;
  }>();
  let { selectedKey = null } = $props<{ selectedKey?: Bindable<Key | null> }>();
  let { isOpen = false } = $props<{ isOpen?: Bindable<boolean> }>();

  const form = $getContext(FormContext);
  const triggerId = $id();
  const overlayId = $id();
  const labelId = $id();
  const valueId = $id();
  const inputId = $id();
  const descriptionId = $id();
  const errorId = $id();
  const { present: hasDescription } = described(descriptionId);
  // The text of the selected item, which the Button shows once the list has been open, and the
  // key that it is the text of. A key that the caller sets has no text until the list opens.
  let selectedText = $signal<string>();
  let textKey = $signal<Key | null>(null);
  // The key that a reset of the form gives back.
  let initialKey = $signal(selectedKey);
  // Where focus goes in the list when nothing is selected: ArrowUp opens it at the last item.
  let focusStrategy = $signal<'first' | 'last'>('first');
  // The message of the browser, once the field was checked on a submit.
  let committed = $signal(false);
  let nativeErrors = $signal<string[]>([]);
  let edited = $signal(false);
  const serverErrors = $memo(
    edited ? [] : messagesOf(name ? (form?.validationErrors[name] as string | string[]) : undefined),
  );
  const errors = $memo([...serverErrors, ...(committed ? nativeErrors : [])]);
  const invalid = $memo(Boolean(isInvalid) || errors.length > 0);

  function setOpen(next: boolean) {
    if (next !== isOpen && !(next && isDisabled)) {
      isOpen = next;
      onOpenChange?.(next);
    }
  }

  function open(strategy: 'first' | 'last' = 'first') {
    focusStrategy = strategy;
    setOpen(true);
  }

  function close() {
    setOpen(false);
  }

  function select(key: Key) {
    const list = document.getElementById(overlayId);
    const items = list ? itemsOf(list.querySelector('[data-collection]') ?? list, 'option') : [];
    const found = items.find((element) => keyOf(element) === key);
    selectedText = (found?.dataset.textValue ?? found?.textContent ?? '').trim() || undefined;
    textKey = key;
    if (key !== selectedKey) {
      selectedKey = key;
      edited = true;
      onSelectionChange?.(key);
    }
    // The browser checks the new value at once, so its message goes away.
    nativeErrors = [];
    close();
  }

  function invalidated(event: Event) {
    // The browser shows its own bubble on the hidden input, so the FieldError shows it instead.
    event.preventDefault();
    committed = true;
    nativeErrors = [(event.target as HTMLInputElement).validationMessage];
    if (isFirstInvalid(event.target as HTMLInputElement)) {
      document.getElementById(triggerId)?.focus();
    }
  }

  // The Button keeps its own keys, so the element around it opens the list on the arrow keys.
  function keyDown(event: KeyboardEvent) {
    if (
      (event.target as Element).id === triggerId &&
      (event.key === 'ArrowDown' || event.key === 'ArrowUp')
    ) {
      open(event.key === 'ArrowUp' ? 'last' : 'first');
    }
  }

  // A reset of the form gives back the first key, as it does for a field of the browser.
  $client(() => {
    const owner = (document.getElementById(inputId) as HTMLInputElement | null)?.form;
    if (!owner) {
      return undefined;
    }
    function reset() {
      selectedKey = initialKey;
      committed = false;
      nativeErrors = [];
      edited = false;
    }
    owner.addEventListener('reset', reset);
    return () => owner.removeEventListener('reset', reset);
  }, 'load');

  $setContext(LabelContext, { id: labelId });
  $setContext(ButtonContext, {
    id: triggerId,
    isDisabled,
    'aria-haspopup': 'listbox',
    'aria-expanded': isOpen ? 'true' : 'false',
    'aria-controls': isOpen ? overlayId : undefined,
    'aria-labelledby': `${valueId} ${labelId}`,
    'aria-describedby': describedBy(hasDescription && descriptionId, invalid && errorId),
    onPress: () => (isOpen ? close() : open()),
  });
  $setContext(OverlayTriggerContext, {
    isOpen,
    triggerId,
    overlayId,
    open: () => open(),
    close,
    placement: 'bottom start',
  });
  $setContext(ListBoxGivenContext, {
    selectedKeys: selectedKey === null ? [] : [selectedKey],
    labelledBy: labelId,
    select,
    tab: close,
    focusStrategy,
  });
  $setContext(SelectValueContext, {
    id: valueId,
    selectedKey,
    selectedText: textKey === selectedKey ? selectedText : undefined,
    placeholder,
  });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(FieldErrorContext, { id: errorId, isInvalid: invalid, errors });
</script>

<{as}
  data-open=(isOpen || undefined)
  data-disabled=(isDisabled || undefined)
  data-invalid=(invalid || undefined)
  data-required=(isRequired || undefined)
  {...rest}
>
  <div style="display: contents" onKeyDown=(prevent(keyDown, 'ArrowDown', 'ArrowUp'))>{children}</div>
  <!--
    The value for the form, which posts without scripts. It is out of sight and out of the order
    of Tab, and the browser checks it on a submit when the field is required.
  -->
  <input
    id=inputId
    {name}
    value=(selectedKey === null ? '' : String(selectedKey))
    required=(isRequired || undefined)
    disabled=(isDisabled || undefined)
    tabindex="-1"
    aria-hidden="true"
    style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0"
    onInvalid=invalidated
  >
</>
