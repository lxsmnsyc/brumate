<script>
  import { $client, $getContext, $id, $isPassed, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import type { Bindable } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import {
    ListBoxContext,
    enabledItems,
    focusItem,
    isTyping,
    itemsOf,
    keyOf,
    keysIn,
    lastFocusedOf,
    moveFrom,
    nextSelection,
    rangeOf,
    sameKeys,
    setLastFocused,
    setRange,
    textOf,
    typeahead,
    typeaheadKey,
  } from './collection.ts';
  import type { Key, Movement, SelectionBehavior, SelectionMode, SelectionRequest } from './collection.ts';
  import { LocaleContext } from './locale.ts';
  import { tabbables } from './overlay.ts';
  import { TreeContext, visibleRows } from './tree.ts';
  import { VirtualizerContext } from './virtualizer.ts';
  import type { TreeNode } from './tree.ts';
  import TreeRow from './TreeRow.brm';

  /**
   * A list of rows that nest and open and close, as Tree of React Aria Components. It renders a
   * row for each item of `items` that shows, with the `item` template, which renders a TreeItem.
   * An item with `children` is a parent, even when it is empty.
   *
   * - `expandedKeys` holds the keys of the open items, and `onExpandedChange` hears of changes.
   *   The children of a closed item do not render.
   * - Up and Down move between rows, Home and End to the ends, PageUp and PageDown by a page, and letters to the row whose text
   *   starts with them.
   * - Right opens a closed row. Left closes an open row, or else moves to the row that holds it.
   *   Otherwise Left and Right move through the controls in a row and back to the row, right to
   *   left the other way round.
   * - Tab stops once, at the row that had focus last, and Tab from inside leaves the tree.
   * - Selection is as in a GridList: `selectionMode`, `selectionBehavior`, `selectedKeys`, Space,
   *   Shift, Ctrl+A and Escape. A Checkbox with `slot="selection"` in a row shows and toggles it.
   * - Enter acts on a row with `onAction`. Without it, and with nothing selectable, Enter and a
   *   press open and close a row with children.
   */
  const {
    selectionMode = 'none',
    selectionBehavior = 'toggle',
    disabledKeys = [],
    disallowEmptySelection = false,
    escapeKeyBehavior = 'clearSelection',
    keyboardNavigationBehavior = 'arrow',
    rowHeight,
    getTextValue,
    onAction,
    onSelectionChange,
    onExpandedChange,
    items,
    item,
    ...rest
  } = $props<{
    selectionMode?: SelectionMode;
    selectionBehavior?: SelectionBehavior;
    disabledKeys?: Key[];
    disallowEmptySelection?: boolean;
    escapeKeyBehavior?: 'clearSelection' | 'none';
    /**
     * `'tab'` keeps the controls of the rows, such as links, in the order of Tab, and gives
     * them the focus, as a NavigationTree does. The arrow keys still move between rows.
     */
    keyboardNavigationBehavior?: 'arrow' | 'tab';
    /**
     * The height of a row in pixels, which renders only the rows in view, as in a Virtualizer.
     * A Virtualizer around the Tree gives it too.
     */
    rowHeight?: number;
    /**
     * The text that typeahead matches for an item, for the rows out of view of a windowed Tree.
     * The rows in view use their own `textValue` or text.
     */
    // oxlint-disable-next-line typescript/no-explicit-any -- The items of a Tree are the caller's.
    getTextValue?: (node: any) => string;
    onAction?: (key: Key) => void;
    onSelectionChange?: (keys: Key[]) => void;
    onExpandedChange?: (keys: Key[]) => void;
    items: readonly TreeNode[];
    // oxlint-disable-next-line typescript/no-explicit-any -- The items of a Tree are the caller's.
    item: (node: any) => unknown;
    [attribute: string]: unknown;
  }>();
  let { selectedKeys = [] } = $props<{ selectedKeys?: Bindable<Key[]> }>();
  let { expandedKeys = [] } = $props<{ expandedKeys?: Bindable<Key[]> }>();

  // The rows that show, in order: each item, then its children while it is open.
  const rows = $memo(visibleRows(items, expandedKeys));

  function setExpanded(next: Key[]) {
    if (!sameKeys(next, expandedKeys)) {
      expandedKeys = next;
      onExpandedChange?.(next);
    }
  }

  function toggleExpanded(key: Key) {
    setExpanded(
      expandedKeys.includes(key)
        ? expandedKeys.filter((open) => open !== key)
        : [...expandedKeys, key],
    );
  }

  /** The row that shows the item with a key. */
  function rowFor(key: Key) {
    return rows.find((row) => row.key === key);
  }

  const locale = $getContext(LocaleContext);
  const virtualizer = $getContext(VirtualizerContext);
  const windowHeight = $memo(rowHeight ?? virtualizer?.rowHeight);
  $setContext(TreeContext, { toggle: toggleExpanded, windowed: Boolean(windowHeight) });
  const hasAction = $isPassed(onAction);
  const gridId = $id();
  let root = $signal<HTMLElement>();

  function setSelection(next: Key[]) {
    if (!sameKeys(next, selectedKeys)) {
      selectedKeys = next;
      onSelectionChange?.(next);
    }
  }

  /**
   * The keys of the rows that can take focus, in order. A windowed Tree renders only the rows in
   * view, so the rows are the data, with the disabled keys and the rows in view that are disabled.
   */
  function enabledKeys(element: HTMLElement): Key[] {
    const disabled = new Set(disabledKeys);
    for (const item of itemsOf(element, 'row')) {
      if (item.getAttribute('aria-disabled') === 'true') {
        disabled.add(keyOf(item)!);
      }
    }
    return rows.map((row) => row.key).filter((key) => !disabled.has(key));
  }

  function select(key: Key, request: SelectionRequest) {
    const element = root;
    const range = element ? rangeOf(element) : undefined;
    const shift = Boolean(element && request.shift && range);
    const order = element ? enabledKeys(element) : [];
    setSelection(
      nextSelection(selectedKeys, key, {
        mode: selectionMode,
        behavior: selectionBehavior,
        disallowEmpty: disallowEmptySelection,
        request: { ...request, shift },
        range: shift ? keysIn(order, range!.anchor, key) : undefined,
        previousRange: shift ? keysIn(order, range!.anchor, range!.end) : undefined,
        disabled: disabledKeys,
      }),
    );
    if (element) {
      setRange(element, shift ? range!.anchor : key, key);
    }
  }

  function action(key: Key) {
    onAction?.(key);
  }

  // The rows read the selection from the state of a ListBox, which they share with its options.
  $setContext(ListBoxContext, {
    selectionMode,
    selectionBehavior,
    selectedKeys,
    disabledKeys,
    select,
    action,
    hasAction,
  });

  function rowOf(target: EventTarget | null) {
    const element = root;
    const row = (target as Element | null)?.closest?.('[role=row][data-key]') as HTMLElement | null;
    return row && element?.contains(row) && row.closest('[data-collection]') === element
      ? row
      : undefined;
  }

  function focused(event: FocusEvent) {
    const element = root;
    // The list passes its focus on to a row.
    if (element && event.target === element && document.activeElement === element) {
      const items = enabledItems(element, 'row');
      const last = lastFocusedOf(element);
      focusItem(
        items.find((item) => last !== undefined && keyOf(item) === last) ??
          items.find((item) => item.getAttribute('aria-selected') === 'true') ??
          items[0],
      );
    }
  }

  function focusIn(event: FocusEvent) {
    const element = root;
    const row = rowOf(event.target);
    if (tabMode && row && element) {
      setLastFocused(element, keyOf(row)!);
      return;
    }
    if (element && row) {
      // While a row has focus, Tab leaves the list rather than stopping at it.
      element.tabIndex = -1;
      setLastFocused(element, keyOf(row)!);
    }
  }

  function focusOut(event: FocusEvent) {
    const element = root;
    // In tab mode the tree is no stop of its own, since its links are.
    if (element && !tabMode && !element.contains(event.relatedTarget as Node | null)) {
      element.tabIndex = 0;
    }
  }

  /** Left and Right: through the controls of the row and back to the row. */
  function across(row: HTMLElement, target: HTMLElement, forward: boolean) {
    const stops = [row, ...tabbables(row)];
    const at = stops.indexOf(target);
    focusItem(stops[(at + (forward ? 1 : -1) + stops.length) % stops.length]);
  }

  const tabMode = keyboardNavigationBehavior === 'tab';

  // A row that has focus can leave without a focusout, such as when its parent closes from
  // outside. The tree is a stop of Tab again when no row has focus.
  $client(() => {
    const element = root;
    if (!element || tabMode) {
      return undefined;
    }
    const observer = new MutationObserver(() => {
      if (element.tabIndex === -1 && !element.contains(document.activeElement)) {
        element.tabIndex = 0;
      }
    });
    observer.observe(element, { childList: true, subtree: true });
    return () => observer.disconnect();
  }, 'load');

  /** Focuses a row, or in tab mode its first control, such as its link. */
  function focusRow(row: HTMLElement | undefined) {
    focusItem(tabMode && row ? (tabbables(row)[0] ?? row) : row);
  }

  /** The element that scrolls the rows, or none for the page. */
  function scrollerOf(element: HTMLElement) {
    for (let parent = element.parentElement; parent; parent = parent.parentElement) {
      const style = getComputedStyle(parent);
      if (/^(auto|scroll|overlay)$/.test(style.overflowY || style.overflow)) {
        return parent;
      }
    }
    return undefined;
  }

  /** The height of a row that renders, from the space between the spacers of the window. */
  function measuredHeight(element: HTMLElement) {
    const before = element.querySelector('[data-window=before]');
    const after = element.querySelector('[data-window=after]');
    const count = itemsOf(element, 'row').length;
    const height =
      before && after && count > 0
        ? (after.getBoundingClientRect().top - before.getBoundingClientRect().bottom) / count
        : 0;
    return height > 0 ? height : windowHeight!;
  }

  /**
   * The key that a move reaches from a row, among the rows that can take focus. A windowed Tree
   * has no elements for most rows, so it reads its data. A page is the rows that fit in the box.
   */
  function keyAfter(element: HTMLElement, from: Key, movement: Movement): Key {
    const place = (key: Key) => rows.findIndex((row) => row.key === key);
    const enabled = enabledKeys(element);
    const at = place(from);
    const before = enabled.filter((key) => place(key) < at);
    const after = enabled.filter((key) => place(key) > at);
    const page = Math.max(
      1,
      Math.floor((scrollerOf(element)?.clientHeight ?? window.innerHeight) / measuredHeight(element)),
    );
    switch (movement) {
      case 'first':
        return enabled[0] ?? from;
      case 'last':
        return enabled.at(-1) ?? from;
      case 'next':
        return after[0] ?? from;
      case 'previous':
        return before.at(-1) ?? from;
      case 'pageDown':
        return after.filter((key) => place(key) <= at + page).at(-1) ?? after[0] ?? from;
      case 'pageUp':
        return before.filter((key) => place(key) >= at - page)[0] ?? before.at(-1) ?? from;
    }
  }

  // The latest move to a row that is out of view, so an earlier one does not take focus later.
  let reveal = 0;

  /**
   * Focuses the row of a key. A windowed Tree may not render it, so it scrolls the row into
   * view first, and focuses it when it renders. `plain` focuses the row, not its first control.
   */
  function focusKey(key: Key | undefined, plain = false) {
    const element = root;
    if (!element || key === undefined) {
      return;
    }
    const find = () => itemsOf(element, 'row').find((item) => keyOf(item) === key);
    const focus = (item: HTMLElement | undefined) => (plain ? focusItem(item) : focusRow(item));
    const found = find();
    reveal++;
    const turn = reveal;
    const at = rows.findIndex((row) => row.key === key);
    if (found || !windowHeight || at === -1) {
      focus(found);
      return;
    }
    const size = measuredHeight(element);
    const scroller = scrollerOf(element);
    const box = scroller?.getBoundingClientRect();
    const height = scroller?.clientHeight ?? window.innerHeight;
    // The top of the row below the top of the tree, which puts the row in the middle of the box.
    const offset = at * size - (height - size) / 2;
    if (scroller && box) {
      scroller.scrollTop = Math.max(
        0,
        element.getBoundingClientRect().top - box.top + scroller.scrollTop + offset,
      );
      scroller.dispatchEvent(new Event('scroll'));
    } else {
      window.scrollTo({ top: Math.max(0, window.scrollY + element.getBoundingClientRect().top + offset) });
    }
    // The window draws on the next frame after the scroll.
    const wait = (frames: number) => {
      const item = find();
      if (turn !== reveal) {
        return;
      }
      if (item) {
        focus(item);
      } else if (frames > 0) {
        requestAnimationFrame(() => wait(frames - 1));
      }
    };
    wait(30);
  }

  /** Focuses the row that a typeahead finds. A windowed Tree searches the data of all its rows. */
  function typeTo(
    element: HTMLElement,
    items: HTMLElement[],
    row: HTMLElement,
    event: KeyboardEvent,
    plain: boolean,
  ) {
    if (!windowHeight) {
      const found = typeahead(element, items, row, event);
      return plain ? focusItem(found) : focusRow(found);
    }
    const shown = new Map(itemsOf(element, 'row').map((item) => [keyOf(item), item]));
    const enabled = new Set(enabledKeys(element));
    // A row in view has its own text, and the others have the text of `getTextValue`.
    const entries = rows
      .filter((place) => enabled.has(place.key))
      .map((place) => {
        const item = shown.get(place.key);
        return {
          key: place.key,
          text: item ? textOf(item) : (getTextValue?.(place.item) ?? '').toLocaleLowerCase(),
        };
      });
    focusKey(typeaheadKey(element, entries, keyOf(row), event), plain);
  }

  function keyDown(event: KeyboardEvent) {
    const element = root;
    const target = event.target as HTMLElement;
    const row = rowOf(target);
    if (!element || !row) {
      return;
    }
    // A field in a row keeps its own keys, other than Up, Down and Tab.
    const typing =
      target !== row &&
      (/^(TEXTAREA|SELECT)$/.test(target.tagName) ||
        (target instanceof HTMLInputElement &&
          !/^(checkbox|radio|button|submit|reset)$/.test(target.type)));
    const items = enabledItems(element, 'row');
    const key = keyOf(row);
    const rtl = locale.direction === 'rtl';
    const replace = selectionBehavior === 'replace';
    const toggle = event.ctrlKey || event.metaKey;
    if (event.key === 'Tab') {
      // In tab mode, Tab goes through the controls of the rows, as the browser moves it.
      if (tabMode) {
        return;
      }
      // Tab leaves the list: the browser moves on from its last control, or back from the list.
      const all = tabbables(element);
      if (event.shiftKey) {
        element.focus({ preventScroll: true });
      } else if (all.length > 0) {
        all.at(-1)!.focus({ preventScroll: true });
      }
      return;
    }
    let movement: Movement | undefined;
    if (event.key === 'ArrowDown') {
      movement = 'next';
    } else if (event.key === 'ArrowUp') {
      movement = 'previous';
    } else if (!typing && event.key === 'Home') {
      movement = 'first';
    } else if (!typing && event.key === 'End') {
      movement = 'last';
    } else if (event.key === 'PageDown') {
      movement = 'pageDown';
    } else if (event.key === 'PageUp') {
      movement = 'pageUp';
    }
    if (movement) {
      // Shift extends a range from the row that has focus, when no press started one.
      if (event.shiftKey && selectionMode === 'multiple' && key !== undefined && !rangeOf(element)) {
        setRange(element, key);
      }
      let nextKey: Key | undefined;
      if (windowHeight && key !== undefined) {
        nextKey = keyAfter(element, key, movement);
        focusKey(nextKey);
      } else {
        const next = moveFrom(element, items, row, movement, false);
        nextKey = next ? keyOf(next) : undefined;
        focusRow(next);
      }
      if (nextKey === undefined || selectionMode === 'none') {
        return;
      }
      if (event.shiftKey && selectionMode === 'multiple') {
        select(nextKey, { shift: true, toggle: false });
      } else if (replace && !toggle) {
        select(nextKey, { shift: false, toggle: false });
      }
      return;
    }
    if (typing) {
      return;
    }
    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
      const expand = (event.key === 'ArrowRight') !== rtl;
      const state = key === undefined ? undefined : rowFor(key);
      const enabled = row.getAttribute('aria-disabled') !== 'true';
      // On the row itself, or anywhere in it in tab mode: Right opens it, and Left closes it or
      // moves to the row that holds it.
      if ((target === row || tabMode) && state && enabled) {
        if (expand && state.hasChildItems && !state.isExpanded) {
          toggleExpanded(state.key);
          return;
        }
        if (!expand && state.isExpanded) {
          toggleExpanded(state.key);
          return;
        }
        if (!expand && state.parent !== undefined) {
          focusKey(state.parent);
          return;
        }
      }
      // In tab mode, Left and Right only open and close rows, as in React Aria.
      if (!tabMode) {
        across(row, target, expand);
      }
      return;
    }
    // A link of a row in tab mode keeps Enter and Space, and letters move to a row.
    if (tabMode && target !== row) {
      if (event.key.length === 1 && event.key !== ' ' && !toggle) {
        typeTo(element, items, row, event, false);
      }
      return;
    }
    if (target !== row) {
      return;
    }
    if (event.key === ' ' && !isTyping(element)) {
      if (key !== undefined) {
        select(key, { shift: event.shiftKey, toggle: !replace || toggle });
      }
      return;
    }
    if (event.key === 'Enter' && key !== undefined) {
      if (hasAction) {
        action(key);
      } else if (selectionMode === 'none') {
        // With nothing to select, Enter opens and closes a row with children.
        if (rowFor(key)?.hasChildItems) {
          toggleExpanded(key);
        }
      } else {
        select(key, { shift: false, toggle: !replace });
      }
      return;
    }
    if ((event.key === 'a' || event.key === 'A') && toggle && selectionMode === 'multiple') {
      setSelection(rows.map((place) => place.key).filter((item) => !disabledKeys.includes(item)));
      window.getSelection()?.removeAllRanges();
      return;
    }
    if (event.key === 'Escape') {
      if (
        escapeKeyBehavior === 'clearSelection' &&
        !disallowEmptySelection &&
        selectedKeys.length > 0
      ) {
        setSelection([]);
      }
      return;
    }
    typeTo(element, items, row, event, true);
  }
</script>

<div
  ref=$bind(root)
  id=gridId
  role="treegrid"
  tabindex=(tabMode ? undefined : '0')
  data-collection
  aria-rowcount=(windowHeight ? rows.length : undefined)
  aria-multiselectable=(selectionMode === 'multiple' ? 'true' : undefined)
  onFocus=focused
  onFocusIn=focusIn
  onFocusOut=focusOut
  onKeyDown=(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Mod+ArrowUp', 'Mod+ArrowDown', 'Mod+PageUp', 'Mod+PageDown'))
  {...rest}
>
  #if (windowHeight) {
    #for (row of rows by row.key) window(windowHeight) {
      <TreeRow {row} {item} />
    }
  } #else {
    #for (row of rows by row.key) {
      <TreeRow {row} {item} />
    }
  }
</div>
