<script module>
  import type { AsProps, AsTarget } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { DateRange, DateString } from './calendar.ts';

  export interface DateRangePickerOwnProps {
    startName?: string;
    endName?: string;
    minValue?: DateString;
    maxValue?: DateString;
    placeholderValue?: DateString;
    isDateUnavailable?: (date: DateString) => boolean;
    isDisabled?: boolean;
    isReadOnly?: boolean;
    isRequired?: boolean;
    isInvalid?: boolean;
    shouldCloseOnSelect?: boolean;
    onChange?: (value: DateRange | null) => void;
    onOpenChange?: (isOpen: boolean) => void;
    children?: unknown;
    value?: Bindable<DateRange | null>;
    isOpen?: Bindable<boolean>;
  }

  /**
   * The props of DateRangePicker. `as` takes an element name or a component, and the other props
   * are those of the target.
   */
  export type DateRangePickerProps<T extends AsTarget = 'div'> = AsProps<T, DateRangePickerOwnProps>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $effect, $getContext, $id, $memo, $props, $setContext, $signal, $untrack } from 'brumate/signals';
  import { DatePickerContext, constrain, outOfRange, toDate, todayString } from './calendar.ts';
  import {
    ButtonContext,
    FieldErrorContext,
    FormContext,
    GroupContext,
    LabelContext,
    OverlayTriggerContext,
    TextContext,
  } from './contexts.ts';
  import { dateSegments, formField } from './date-field.brm.ts';
  import { prevent } from 'brumate/events';
  import { described } from './description.brm.ts';
  import { describedBy, messagesOf } from './fields.ts';
  import { DateStringsContext } from './date-strings.ts';
  import { LocaleContext } from './locale.ts';
  import { DateRangeFieldContext } from './segments.ts';

  /**
   * Two dates that the user types or picks as a range. It holds a Label, a Group with a DateInput
   * with `slot="start"`, one with `slot="end"` and a Button, a Popover with a Dialog and a
   * RangeCalendar, and a Text with `slot="description"` and a FieldError.
   *
   * - `value` is the range as `{ start, end }` of `YYYY-MM-DD` dates, or null until both are set.
   *   `value=(range)` starts its own, and `value=$bind(signal)` writes the caller's. `onChange`
   *   gets each change, typed or picked.
   * - The Button opens the Popover. A range picked in the RangeCalendar sets both dates and closes
   *   the Popover, unless `shouldCloseOnSelect` is false.
   * - `minValue`, `maxValue` and `isDateUnavailable` make a range invalid, and so does a start
   *   after the end. The RangeCalendar follows them too, unless it has its own.
   * - `startName` and `endName` post the dates with a form, from hidden inputs.
   * - It shows `data-open`, `data-disabled`, `data-readonly`, `data-invalid` and `data-required`.
   */
  const {
    as = 'div',
    startName,
    endName,
    minValue,
    maxValue,
    placeholderValue,
    isDateUnavailable,
    isDisabled = false,
    isReadOnly = false,
    isRequired = false,
    isInvalid = false,
    shouldCloseOnSelect = true,
    onChange,
    onOpenChange,
    children,
    ...rest
  } = $props<DateRangePickerProps<T>>();
  let { value = null } = $props<DateRangePickerProps<T>>();
  let { isOpen = false } = $props<DateRangePickerProps<T>>();

  const locale = $getContext(LocaleContext);
  const form = $getContext(FormContext);
  const triggerId = $id();
  const overlayId = $id();
  const labelId = $id();
  const startId = $id();
  const endId = $id();
  // The range that a reset of the form gives back.
  let initialValue = $signal(value);
  const descriptionId = $id();
  const errorId = $id();
  const { present: hasDescription } = described(descriptionId);
  const strings = $getContext(DateStringsContext);
  const placeholder = $memo(
    constrain(toDate(placeholderValue ?? todayString(locale.timeZone)), minValue, maxValue).toString(),
  );
  // The locale and the placeholders can change at run time, so the fields get them as memos.
  const language = $memo(locale.locale);
  const placeholders = $memo(strings?.placeholders);
  // The date of each field, which the field follows, and which the range follows once both are set.
  let startValue = $signal<DateString | null>(value?.start ?? null);
  let endValue = $signal<DateString | null>(value?.end ?? null);
  const {
    segments: startSegments,
    date: startDate,
    step: startStep,
    jump: startJump,
    type: startType,
    erase: startErase,
    settle: startSettle,
  } = dateSegments(startValue, placeholder, language, placeholders, isDisabled, isReadOnly);
  const {
    segments: endSegments,
    date: endDate,
    step: endStep,
    jump: endJump,
    type: endType,
    erase: endErase,
    settle: endSettle,
  } = dateSegments(endValue, placeholder, language, placeholders, isDisabled, isReadOnly);
  let edited = $signal(false);
  // A date out of range blocks a submit.
  const rangeMessage = $memo(
    value !== null &&
      [value.start, value.end].some((date) => outOfRange(toDate(date), minValue, maxValue))
      ? 'The date is outside the allowed range.'
      : '',
  );
  const { committed, nativeErrors, invalidated, changed } = formField(startId, () => {
    value = initialValue;
    startValue = value?.start ?? null;
    endValue = value?.end ?? null;
    edited = false;
  }, rangeMessage);
  const errors = $memo([
    ...(edited
      ? []
      : messagesOf(
          [startName, endName].flatMap((field) =>
            field ? messagesOf(form?.validationErrors[field] as string | string[]) : [],
          ),
        )),
    ...(committed ? nativeErrors : []),
  ]);
  const invalid = $memo(
    isInvalid ||
      errors.length > 0 ||
      (value !== null &&
        (value.start > value.end ||
          [value.start, value.end].some(
            (date) =>
              outOfRange(toDate(date), minValue, maxValue) || (isDateUnavailable?.(date) ?? false),
          ))),
  );

  function rangeOf(start: DateString | null, end: DateString | null): DateRange | null {
    return start !== null && end !== null ? { start, end } : null;
  }

  function same(a: DateRange | null, b: DateRange | null): boolean {
    return a === b || (a !== null && b !== null && a.start === b.start && a.end === b.end);
  }

  // The range is the dates of the fields once both are set.
  $effect(() => {
    const from = startDate;
    const to = endDate;
    $untrack((startValue = from));
    $untrack((endValue = to));
    const next = rangeOf(from, to);
    if (!same(next, $untrack(value))) {
      const before = $untrack(value);
      $untrack((value = next));
      // A setter that refuses leaves the old range, and the fields show that one.
      if (!same($untrack(value), next)) {
        $untrack((startValue = $untrack(value)?.start ?? null));
        $untrack((endValue = $untrack(value)?.end ?? null));
      }
      edited = true;
      changed();
      if (!same($untrack(value), before)) {
        onChange?.($untrack(value));
      }
    }
  });

  // A range that the caller sets, or that the RangeCalendar picks, shows in the fields. A date that
  // is only typed so far stays.
  $effect(() => {
    const next = value;
    if (!same(next, $untrack(rangeOf(startDate, endDate)))) {
      $untrack((startValue = next?.start ?? null));
      $untrack((endValue = next?.end ?? null));
    }
  });

  function setOpen(next: boolean) {
    if (next !== isOpen && !(next && (isDisabled || isReadOnly))) {
      isOpen = next;
      onOpenChange?.(next);
    }
  }

  function select(picked: DateString | DateRange) {
    if (typeof picked === 'string') {
      return;
    }
    if (!same(picked, value)) {
      const before = value;
      value = picked;
      edited = true;
      // The setter of a bound value may keep another range, or none.
      if (!same(value, before)) {
        onChange?.(value);
      }
    }
    if (shouldCloseOnSelect) {
      setOpen(false);
    }
  }

  $setContext(LabelContext, { id: labelId });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(FieldErrorContext, { id: errorId, isInvalid: invalid, errors });
  $setContext(DateRangeFieldContext, {
    start: {
      segments: startSegments,
      labelId,
      describedBy: describedBy(hasDescription && descriptionId, invalid && errorId),
      isDisabled,
      isReadOnly,
      isRequired,
      isInvalid: invalid,
      direction: locale.direction,
      segmentNames: strings?.segmentNames,
      empty: strings?.empty,
      step: startStep,
      jump: startJump,
      type: startType,
      erase: startErase,
      settle: startSettle,
    },
    end: {
      segments: endSegments,
      labelId,
      describedBy: describedBy(hasDescription && descriptionId, invalid && errorId),
      isDisabled,
      isReadOnly,
      isRequired,
      isInvalid: invalid,
      direction: locale.direction,
      segmentNames: strings?.segmentNames,
      empty: strings?.empty,
      step: endStep,
      jump: endJump,
      type: endType,
      erase: endErase,
      settle: endSettle,
    },
  });
  $setContext(ButtonContext, {
    id: triggerId,
    'aria-label': strings?.calendar ?? 'Calendar',
    'aria-labelledby': `${triggerId} ${labelId}`,
    'aria-haspopup': 'dialog',
    'aria-expanded': isOpen ? 'true' : 'false',
    'aria-controls': isOpen ? overlayId : undefined,
    isDisabled: isDisabled || isReadOnly,
    onPress: () => setOpen(true),
  });
  $setContext(GroupContext, {
    isDisabled,
    'aria-disabled': isDisabled ? 'true' : undefined,
    'aria-labelledby': labelId,
    'aria-describedby': describedBy(hasDescription && descriptionId, invalid && errorId),
  });
  $setContext(OverlayTriggerContext, {
    isOpen,
    triggerId,
    overlayId,
    open: () => setOpen(true),
    close: () => setOpen(false),
    placement: 'bottom start',
    labelledBy: `${triggerId} ${labelId}`,
  });
  $setContext(DatePickerContext, {
    value,
    select,
    minValue,
    maxValue,
    isDateUnavailable,
    placeholderValue,
    isDisabled,
    isReadOnly,
  });
</script>

<{as}
  data-open=(isOpen || undefined)
  data-disabled=(isDisabled || undefined)
  data-readonly=(isReadOnly || undefined)
  data-invalid=(invalid || undefined)
  data-required=(isRequired || undefined)
  {...rest}
>
  {children}
  <!-- The dates for the form, which post without scripts. -->
  <input
    id=startId
    name=startName
    value=(value?.start ?? '')
    required=(isRequired || undefined)
    disabled=(isDisabled || undefined)
    tabindex="-1"
    aria-hidden="true"
    style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0"
    onInvalid=(prevent(invalidated))
  >
  <input
    id=endId
    name=endName
    value=(value?.end ?? '')
    required=(isRequired || undefined)
    disabled=(isDisabled || undefined)
    tabindex="-1"
    aria-hidden="true"
    style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0"
    onInvalid=(prevent(invalidated))
  >
</>
