<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { DragItem, DropTarget, ReorderEvent } from './drop.ts';
  import type { Key, Movement, SelectionBehavior, SelectionMode, SelectionRequest } from './collection.ts';

  export interface GridListOwnProps<T extends AsTarget = 'div'> {
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
    selectionMode?: SelectionMode;
    selectionBehavior?: SelectionBehavior;
    disabledKeys?: Key[];
    disallowEmptySelection?: boolean;
    escapeKeyBehavior?: 'clearSelection' | 'none';
    onAction?: (key: Key) => void;
    onSelectionChange?: (keys: Key[]) => void;
    onReorder?: (event: ReorderEvent) => void;
    getItems?: (keys: Key[]) => DragItem[];
    /**
     * The height of a row in pixels, which renders only the rows in view, as in a Virtualizer.
     * A Virtualizer around the list gives it too. It needs `items`.
     */
    rowHeight?: number;
    /**
     * The text that typeahead matches for an item, for the rows out of view of a windowed list.
     * The rows in view use their own `textValue` or text.
     */
    // oxlint-disable-next-line typescript/no-explicit-any -- The items of a GridList are the caller's.
    getTextValue?: (item: any) => string;
    /** The data of the rows, each with an `id`. The `item` template renders each one. */
    items?: readonly { id: Key }[];
    // oxlint-disable-next-line typescript/no-explicit-any -- The items of a GridList are the caller's.
    item?: (item: any) => unknown;
    children?: unknown;
    selectedKeys?: Bindable<Key[]>;
  }

  /**
   * The props of GridList. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type GridListProps<T extends AsTarget = 'div'> = AsProps<T, GridListOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $getContext, $id, $isPassed, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import { ROWS_TYPE, setDragData } from './drop.ts';
  import VisuallyHidden from './VisuallyHidden.brm';
  import {
    ListBoxContext,
    enabledItems,
    focusItem,
    itemsOf,
    isTyping,
    keyOf,
    keysBetween,
    keysIn,
    lastFocusedOf,
    moveFrom,
    nextSelection,
    rangeOf,
    sameKeys,
    setLastFocused,
    setRange,
    textOfItem,
    typeahead,
  } from './collection.ts';
  import { LocaleContext } from './locale.ts';
  import { tabbables } from './overlay.ts';
  import { VirtualizerContext } from './virtualizer.ts';
  import { enabledKeysOf, focusKeyIn, keyAfter, typeaheadWindowed } from './windowed.ts';

  /**
   * A list of rows that can hold buttons, checkboxes and links, as GridList of React Aria
   * Components. Its items are GridListItem elements, written out or from a `#for`. Or it takes
   * `items`, as Tree does, and renders each with the `item` template.
   *
   * - With `items` and a `rowHeight`, or in a Virtualizer, it renders only the rows in view. Its
   *   keys then read the data of all the items, so Home, End, the page keys, Ctrl+A, ranges with
   *   Shift and letters reach rows that are out of view, and a move to one scrolls it into view
   *   first. Letters match the text of the rows in view, and `getTextValue` gives the text of the
   *   others.
   * - Up and Down move between rows, Home and End to the ends, and letters to the row whose text
   *   starts with them. Left and Right move through the controls in a row and back to the row,
   *   right to left the other way round.
   * - Tab stops once, at the row that had focus last, and Tab from inside leaves the list.
   * - Selection is as in ListBox: `selectionMode`, `selectionBehavior`, `selectedKeys`, Space,
   *   Shift, Ctrl+A and Escape. A Checkbox with `slot="selection"` in a row shows and toggles it.
   * - Enter acts on a row with `onAction`, and a press does when nothing is selectable.
   * - With `onReorder`, rows drag to new places in the list. With `getItems`, they drag out, such
   *   as to a DropZone, with the data that it gives. A drag takes the selected rows when the
   *   dragged row is selected, else that row. A Button with `slot="drag"` in a row starts a drag
   *   from the keys, with `onReorder`: Up and Down choose where, Enter drops, and Escape, Tab or
   *   focus leaving the list cancel.
   */
  const {
    as,
    selectionMode = 'none',
    selectionBehavior = 'toggle',
    disabledKeys = [],
    disallowEmptySelection = false,
    escapeKeyBehavior = 'clearSelection',
    onAction,
    onSelectionChange,
    onReorder,
    getItems,
    rowHeight,
    getTextValue,
    items,
    item,
    children,
    ...rest
  } = $props<GridListProps<T>>();
  let { selectedKeys = [] } = $props<GridListOwnProps<T>>();
  let { ref } = $props<GridListOwnProps<T>>();

  const locale = $getContext(LocaleContext);
  const virtualizer = $getContext(VirtualizerContext);
  // Only a list with its items as data can window, since the rows are then made from the data.
  const windowHeight = $memo(items ? (rowHeight ?? virtualizer?.rowHeight) : undefined);
  const hasAction = $isPassed(onAction);
  const hasReorder = $isPassed(onReorder);
  const hasItems = $isPassed(getItems);
  const isDraggable = hasReorder || hasItems;
  // The rows that a drag moves, where they would go, and whether the keys drag them.
  let dragging = $signal<Key[]>([]);
  let dropTarget = $signal<DropTarget | null>(null);
  let byKeys = $signal(false);
  let announcement = $signal('');
  const gridId = $id();

  function setSelection(next: Key[]) {
    if (!sameKeys(next, selectedKeys)) {
      selectedKeys = next;
      onSelectionChange?.(next);
    }
  }

  /** The keys of the items, in order. */
  function order(): Key[] {
    return (items ?? []).map((one) => one.id);
  }

  /** The keys of the rows that can take focus. A windowed list reads its data, not the page. */
  function enabledKeys(element: HTMLElement): Key[] {
    return windowHeight
      ? enabledKeysOf(element, 'row', order(), disabledKeys)
      : enabledItems(element, 'row').map((row) => keyOf(row)!);
  }

  /** The keys of the rows from the anchor to a key, in order, that can take focus. */
  function keysFrom(element: HTMLElement, anchor: Key, to: Key): Key[] {
    return windowHeight
      ? keysIn(enabledKeys(element), anchor, to)
      : keysBetween(enabledItems(element, 'row'), anchor, to);
  }

  function select(key: Key, request: SelectionRequest) {
    const element = ref as HTMLElement | undefined;
    const range = element ? rangeOf(element) : undefined;
    const shift = Boolean(element && request.shift && range);
    setSelection(
      nextSelection(selectedKeys, key, {
        mode: selectionMode,
        behavior: selectionBehavior,
        disallowEmpty: disallowEmptySelection,
        request: { ...request, shift },
        range: shift ? keysFrom(element!, range!.anchor, key) : undefined,
        previousRange: shift ? keysFrom(element!, range!.anchor, range!.end) : undefined,
        disabled: disabledKeys,
      }),
    );
    if (element) {
      setRange(element, shift ? range!.anchor : key, key);
    }
  }

  function action(key: Key) {
    onAction?.(key);
  }

  /**
   * The rows that a drag of the row moves: the selection when the row is in it, else the row. They
   * come in the order of the list.
   */
  function draggedKeys(key: Key): Key[] {
    const chosen = selectedKeys.includes(key) ? selectedKeys : [key];
    const element = ref as HTMLElement | undefined;
    const ordered = element
      ? itemsOf(element, 'row')
          .map((item) => keyOf(item)!)
          .filter((item) => chosen.includes(item))
      : [];
    return ordered.length > 0 ? ordered : [key];
  }

  function rowWith(key: Key): HTMLElement | undefined {
    const element = ref as HTMLElement | undefined;
    return element ? itemsOf(element, 'row').find((item) => keyOf(item) === key) : undefined;
  }

  /** Where a drop can go from the keys: before each row that does not move, and after the last. */
  function dropTargets(): DropTarget[] {
    const element = ref as HTMLElement | undefined;
    if (!element) {
      return [];
    }
    const keys = itemsOf(element, 'row').map((item) => keyOf(item)!);
    const staying = keys.filter((key) => !dragging.includes(key));
    const targets: DropTarget[] = staying.map((key) => ({ key, dropPosition: 'before' }));
    const last = staying.at(-1);
    if (last !== undefined) {
      targets.push({ key: last, dropPosition: 'after' });
    }
    return targets;
  }

  /** True when a drop of the rows at the target changes the order of the list. */
  function moves(keys: Key[], target: DropTarget): boolean {
    const element = ref as HTMLElement | undefined;
    if (!element) {
      return true;
    }
    const order = itemsOf(element, 'row').map((item) => keyOf(item)!);
    const rest = order.filter((key) => !keys.includes(key));
    const at = rest.indexOf(target.key);
    if (at < 0) {
      return false;
    }
    rest.splice(target.dropPosition === 'after' ? at + 1 : at, 0, ...keys);
    return rest.some((key, index) => key !== order[index]);
  }

  function aim(target: DropTarget | undefined) {
    if (!target) {
      return;
    }
    dropTarget = target;
    const row = rowWith(target.key);
    focusItem(row);
    announcement = `Drop ${target.dropPosition} ${row ? textOfItem(row) : ''}`.trim();
  }

  function startDrag(key: Key) {
    if (!onReorder) {
      return;
    }
    dragging = draggedKeys(key);
    byKeys = true;
    const targets = dropTargets();
    // The first place after the dragged rows, or else the last.
    const row = rowWith(key);
    const after = targets.find((target) => {
      const other = rowWith(target.key);
      return Boolean(row && other && row.compareDocumentPosition(other) & 4 && target.dropPosition === 'before');
    });
    aim(after ?? targets.at(-1));
    announcement = `Dragging ${dragging.length === 1 ? 'a row' : `${dragging.length} rows`}. Up and Down choose where, Enter drops, Escape cancels. ${announcement}`;
  }

  function endDrag(message: string) {
    dragging = [];
    dropTarget = null;
    byKeys = false;
    announcement = message;
  }

  function drop(chosen?: DropTarget) {
    const target = chosen ?? dropTarget;
    const keys = dragging;
    endDrag('Dropped.');
    if (target && keys.length > 0 && moves(keys, target)) {
      onReorder?.({ keys, target });
    }
  }

  // The keys that scroll the page are prevented at once, by a native listener, since the handler
  // of the markup can load after the key. A field in a row keeps its own keys.
  $client(() => {
    const element = ref as HTMLElement | undefined;
    if (!element) {
      return undefined;
    }
    const keyDownNow = (event: KeyboardEvent) => {
      const target = event.target as HTMLElement;
      const row = rowOf(target);
      if (!row || event.defaultPrevented) {
        return;
      }
      const own = target === row;
      if (
        ((event.key === 'Home' || event.key === 'End') && !isField(target, row)) ||
        (event.key === ' ' && own && !isTyping(element)) ||
        (event.key === 'Enter' && own)
      ) {
        event.preventDefault();
      }
    };
    // The list is a tab stop whenever focus is not in it, also when the focused row went away
    // and no focusout came.
    const restore = () => {
      if (!element.contains(document.activeElement)) {
        element.tabIndex = 0;
      }
    };
    const observer = new MutationObserver(restore);
    observer.observe(element, { childList: true, subtree: true });
    element.addEventListener('keydown', keyDownNow);
    document.addEventListener('focusin', restore);
    return () => {
      observer.disconnect();
      element.removeEventListener('keydown', keyDownNow);
      document.removeEventListener('focusin', restore);
    };
  }, 'load');

  // A drag reads and writes its DataTransfer only while its events run, so native listeners,
  // which run at once, take the drags. Only a drag that the list started is taken, so a drag
  // from elsewhere, such as a file, keeps its default.
  $client(() => {
    const element = ref as HTMLElement | undefined;
    if (!element || !isDraggable) {
      return undefined;
    }
    const dragStart = (event: DragEvent) => {
      const row = rowOf(event.target);
      const key = row ? keyOf(row) : undefined;
      if (!row || key === undefined || !event.dataTransfer || disabledKeys.includes(key)) {
        return;
      }
      const keys = draggedKeys(key);
      setDragData(event.dataTransfer, getItems ? getItems(keys) : keys.map((item) => ({ 'text/plain': String(item) })));
      event.dataTransfer.setData(ROWS_TYPE, gridId);
      event.dataTransfer.effectAllowed = onReorder ? 'copyMove' : 'copy';
      dragging = keys;
    };
    /** Where a drop at the event goes: by the row under it, unless the row moves. */
    const targetAt = (event: DragEvent): DropTarget | undefined => {
      const row = rowOf(event.target);
      const key = row ? keyOf(row) : undefined;
      if (!row || key === undefined || dragging.includes(key)) {
        return undefined;
      }
      const box = row.getBoundingClientRect();
      return { key, dropPosition: event.clientY < box.top + box.height / 2 ? 'before' : 'after' };
    };
    const dragOver = (event: DragEvent) => {
      if (!onReorder || dragging.length === 0 || byKeys) {
        return;
      }
      const target = targetAt(event);
      if (!target) {
        // Not over a row that stays, such as the gap of the list, takes no drop.
        if (dropTarget) {
          dropTarget = null;
        }
        return;
      }
      event.preventDefault();
      if (event.dataTransfer) {
        event.dataTransfer.dropEffect = 'move';
      }
      if (dropTarget?.key !== target.key || dropTarget.dropPosition !== target.dropPosition) {
        dropTarget = target;
      }
    };
    const dragLeave = (event: DragEvent) => {
      if (!element.contains(event.relatedTarget as Node | null)) {
        dropTarget = null;
      }
    };
    const dropped = (event: DragEvent) => {
      if (dragging.length === 0 || byKeys) {
        return;
      }
      const target = onReorder ? targetAt(event) : undefined;
      if (target) {
        event.preventDefault();
        drop(target);
      } else {
        endDrag('');
      }
    };
    // The source row can go away during the drag, and then its dragend never reaches the list,
    // so the document hears the end of the drag, and a drop elsewhere.
    const dragEnd = () => {
      if (dragging.length > 0 && !byKeys) {
        endDrag('');
      }
    };
    element.addEventListener('dragstart', dragStart);
    element.addEventListener('dragover', dragOver);
    element.addEventListener('dragleave', dragLeave);
    element.addEventListener('drop', dropped);
    document.addEventListener('dragend', dragEnd);
    document.addEventListener('drop', dragEnd);
    return () => {
      element.removeEventListener('dragstart', dragStart);
      element.removeEventListener('dragover', dragOver);
      element.removeEventListener('dragleave', dragLeave);
      element.removeEventListener('drop', dropped);
      document.removeEventListener('dragend', dragEnd);
      document.removeEventListener('drop', dragEnd);
    };
  }, 'visible');

  // The rows read the selection from the state of a ListBox, which they share with its options.
  $setContext(ListBoxContext, {
    selectionMode,
    selectionBehavior,
    selectedKeys,
    disabledKeys,
    select,
    action,
    hasAction,
    isDraggable,
    dragging,
    dropTarget,
    isReorderable: hasReorder,
    startDrag,
  });

  function rowOf(target: EventTarget | null) {
    const element = ref as HTMLElement | undefined;
    const row = (target as Element | null)?.closest?.('[role=row][data-key]') as HTMLElement | null;
    return row && element?.contains(row) && row.closest('[data-collection]') === element
      ? row
      : undefined;
  }

  function focused(event: FocusEvent) {
    const element = ref as HTMLElement | undefined;
    // The list passes its focus on to a row.
    if (element && event.target === element && document.activeElement === element) {
      const rendered = enabledItems(element, 'row');
      const last = lastFocusedOf(element);
      focusItem(
        rendered.find((row) => last !== undefined && keyOf(row) === last) ??
          rendered.find((row) => row.getAttribute('aria-selected') === 'true') ??
          rendered[0],
      );
    }
  }

  function focusIn(event: FocusEvent) {
    const element = ref as HTMLElement | undefined;
    const row = rowOf(event.target);
    if (element && row) {
      // While a row has focus, Tab leaves the list rather than stopping at it.
      element.tabIndex = -1;
      setLastFocused(element, keyOf(row)!);
    }
  }

  function focusOut(event: FocusEvent) {
    const element = ref as HTMLElement | undefined;
    if (element && !element.contains(event.relatedTarget as Node | null)) {
      element.tabIndex = 0;
      // A drag from the keys ends when focus leaves the list, as in React Aria.
      if (byKeys) {
        endDrag('Drag canceled.');
      }
    }
  }

  /** Left and Right: through the controls of the row and back to the row. */
  function across(row: HTMLElement, target: HTMLElement, forward: boolean) {
    const stops = [row, ...tabbables(row)];
    const at = stops.indexOf(target);
    focusItem(stops[(at + (forward ? 1 : -1) + stops.length) % stops.length]);
  }

  /** True for a text field in a row, which keeps its own keys. */
  function isField(target: HTMLElement, row: HTMLElement): boolean {
    return (
      target !== row &&
      (/^(TEXTAREA|SELECT)$/.test(target.tagName) ||
        (target instanceof HTMLInputElement &&
          !/^(checkbox|radio|button|submit|reset)$/.test(target.type)))
    );
  }

  /** The items with their keys, which typeahead reads. */
  function rowsOf() {
    return (items ?? []).map((one) => ({ key: one.id, item: one }));
  }

  /** Focuses the row of a key. A windowed list may not render it, so it scrolls it into view. */
  function focusKey(key: Key | undefined) {
    const element = ref as HTMLElement | undefined;
    if (element && key !== undefined) {
      focusKeyIn(element, 'row', order(), key, windowHeight, focusItem);
    }
  }

  function keyDown(event: KeyboardEvent) {
    const element = ref as HTMLElement | undefined;
    const target = event.target as HTMLElement;
    const row = rowOf(target);
    if (!element || !row) {
      return;
    }
    // A field in a row keeps its own keys, other than Up, Down and Tab.
    const typing = isField(target, row);
    const rendered = enabledItems(element, 'row');
    const key = keyOf(row);
    const rtl = locale.direction === 'rtl';
    const replace = selectionBehavior === 'replace';
    const toggle = event.ctrlKey || event.metaKey;
    // A drag from the keys takes the keys until it drops or cancels.
    if (byKeys) {
      const targets = dropTargets();
      const at = targets.findIndex(
        (target) => target.key === dropTarget?.key && target.dropPosition === dropTarget.dropPosition,
      );
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        aim(targets[Math.min(Math.max(at + (event.key === 'ArrowDown' ? 1 : -1), 0), targets.length - 1)]);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        drop();
      } else if (event.key === 'Escape' || event.key === 'Tab') {
        event.preventDefault();
        const first = dragging[0];
        endDrag('Drag canceled.');
        focusItem(first === undefined ? undefined : rowWith(first));
      }
      return;
    }
    if (event.key === 'Tab') {
      // Tab leaves the list: the browser moves on from its last control, or back from the list.
      const all = tabbables(element);
      if (event.shiftKey) {
        element.focus({ preventScroll: true });
      } else if (all.length > 0) {
        all.at(-1)!.focus({ preventScroll: true });
      }
      return;
    }
    let movement: Movement | undefined;
    if (event.key === 'ArrowDown') {
      movement = 'next';
    } else if (event.key === 'ArrowUp') {
      movement = 'previous';
    } else if (!typing && event.key === 'Home') {
      movement = 'first';
    } else if (!typing && event.key === 'End') {
      movement = 'last';
    } else if (event.key === 'PageDown') {
      movement = 'pageDown';
    } else if (event.key === 'PageUp') {
      movement = 'pageUp';
    }
    if (movement) {
      // Home and End do not scroll the page. The markup prevents the other keys.
      event.preventDefault();
      // Shift extends a range from the row that has focus, when no press started one.
      if (event.shiftKey && selectionMode === 'multiple' && key !== undefined && !rangeOf(element)) {
        setRange(element, key);
      }
      let nextKey: Key | undefined;
      if (windowHeight && key !== undefined) {
        nextKey = keyAfter(element, 'row', order(), enabledKeys(element), key, movement, windowHeight);
        focusKey(nextKey);
      } else {
        const next = moveFrom(element, rendered, row, movement, false);
        nextKey = next ? keyOf(next) : undefined;
        focusItem(next);
      }
      if (nextKey === undefined || selectionMode === 'none') {
        return;
      }
      if (event.shiftKey && selectionMode === 'multiple') {
        select(nextKey, { shift: true, toggle: false });
      } else if (replace && !toggle) {
        select(nextKey, { shift: false, toggle: false });
      }
      return;
    }
    if (typing) {
      return;
    }
    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
      across(row, target, (event.key === 'ArrowRight') !== rtl);
      return;
    }
    // Ctrl+A and Escape work from the controls of a row too.
    if ((event.key === 'a' || event.key === 'A') && toggle && selectionMode === 'multiple') {
      event.preventDefault();
      setSelection(enabledKeys(element));
      window.getSelection()?.removeAllRanges();
      return;
    }
    if (event.key === 'Escape') {
      if (
        escapeKeyBehavior === 'clearSelection' &&
        !disallowEmptySelection &&
        selectedKeys.length > 0
      ) {
        // The Escape clears the selection, so it does not close an overlay around the list too.
        event.stopPropagation();
        setSelection([]);
      }
      return;
    }
    if (target !== row) {
      return;
    }
    if (event.key === ' ' && !isTyping(element)) {
      event.preventDefault();
      if (key !== undefined) {
        select(key, { shift: event.shiftKey, toggle: !replace || toggle });
      }
      return;
    }
    if (event.key === 'Enter' && key !== undefined) {
      // A row with `onAction` of its own acts too, as the list does with `onAction`.
      const rowActs = row.hasAttribute('data-action');
      if (hasAction || rowActs) {
        if (rowActs) {
          row.dispatchEvent(new CustomEvent('itemaction', { bubbles: false }));
        }
        action(key);
      } else {
        select(key, { shift: false, toggle: !replace });
      }
      return;
    }
    let foundKey: Key | undefined;
    if (windowHeight) {
      foundKey = typeaheadWindowed(element, 'row', rowsOf(), enabledKeys(element), key, event, getTextValue);
      focusKey(foundKey);
    } else {
      const found = typeahead(element, rendered, row, event);
      foundKey = found ? keyOf(found) : undefined;
      focusItem(found);
    }
    if (foundKey !== undefined && replace && selectionMode !== 'none') {
      select(foundKey, { shift: false, toggle: false });
    }
  }
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  id=gridId
  role="grid"
  tabindex="0"
  data-collection
  aria-multiselectable=(selectionMode === 'multiple' ? 'true' : undefined)
  onFocus=focused
  onFocusIn=focusIn
  onFocusOut=focusOut
  onKeyDown=(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Mod+ArrowUp', 'Mod+ArrowDown', 'Mod+PageUp', 'Mod+PageDown'))
  data-dragging=(dragging.length > 0 || undefined)
  {...rest}
>
  {children}
  #if (items && item) {
    #if (windowHeight) {
      #for (entry of items by entry.id) window(windowHeight) {
        {item(entry)}
      }
    } #else {
      #for (entry of items by entry.id) {
        {item(entry)}
      }
    }
  }
</>
<VisuallyHidden><span aria-live="assertive">{announcement}</span></VisuallyHidden>
