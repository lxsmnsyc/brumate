<script module>
  import type { AsProps, AsTarget } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { DateParts, SegmentType, TimeGranularity, TimeString } from './segments.ts';

  export interface TimeFieldOwnProps {
    name?: string;
    minValue?: TimeString;
    maxValue?: TimeString;
    placeholderValue?: TimeString;
    granularity?: TimeGranularity;
    hourCycle?: 12 | 24;
    isDisabled?: boolean;
    isReadOnly?: boolean;
    isRequired?: boolean;
    isInvalid?: boolean;
    onChange?: (value: TimeString | null) => void;
    children?: unknown;
    value?: Bindable<TimeString | null>;
  }

  /**
   * The props of TimeField. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type TimeFieldProps<T extends AsTarget = 'div'> = AsProps<T, TimeFieldOwnProps>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $effect, $getContext, $id, $memo, $props, $setContext, $signal, $untrack } from 'brumate/signals';
  import { FieldErrorContext, FormContext, LabelContext, TextContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { formField } from './date-field.brm.ts';
  import { prevent } from 'brumate/events';
  import { describedBy, messagesOf } from './fields.ts';
  import { LocaleContext } from './locale.ts';
  import {
    DateFieldContext,
    erasePart,
    jumpTime,
    secondsOf,
    stepTime,
    timeOf,
    timePartsOf,
    timeSegmentsOf,
    typeTime,
    usesDayPeriod,
  } from './segments.ts';

  /**
   * A time of day that the user edits segment by segment, as TimeField of React Aria Components.
   * It holds the same parts as a DateField: a Label, a DateInput of DateSegments, and a Text with
   * `slot="description"` and a FieldError.
   *
   * - `value` is the time as `HH:MM`, or `HH:MM:SS` with `granularity="second"`, or null until
   *   every segment is set. `value=(time)` starts its own, and `value=$bind(signal)` writes the
   *   caller's. `onChange` gets each change.
   * - `granularity` is the smallest segment: `hour`, `minute`, the default, or `second`.
   * - The hour shows on a 12-hour clock with AM and PM, or on a 24-hour clock, as the locale does,
   *   or as `hourCycle` says.
   * - An empty segment starts at `placeholderValue`, midnight by default.
   * - `minValue` and `maxValue` make a time invalid, as `isInvalid` does.
   * - `name` posts the time with a form, from a hidden input. `isRequired` asks the browser to check
   *   it on a submit, and the FieldError shows the message. A reset of the form gives back the
   *   first time.
   * - On a 12-hour clock, AM and PM are a segment of their own, which must be set too.
   * - It shows `data-disabled`, `data-readonly`, `data-invalid` and `data-required`.
   */
  const {
    as = 'div',
    name,
    minValue,
    maxValue,
    placeholderValue = '00:00',
    granularity = 'minute',
    hourCycle,
    isDisabled = false,
    isReadOnly = false,
    isRequired = false,
    isInvalid = false,
    onChange,
    children,
    ...rest
  } = $props<TimeFieldProps<T>>();
  let { value = null } = $props<TimeFieldProps<T>>();

  const locale = $getContext(LocaleContext);
  const form = $getContext(FormContext);
  const labelId = $id();
  const descriptionId = $id();
  const errorId = $id();
  const { present: hasDescription } = described(descriptionId);
  const twelve = $memo(usesDayPeriod(locale.locale, hourCycle));
  const inputId = $id();
  let parts = $signal<DateParts>(timePartsOf(value));
  let typed = $signal('');
  let edited = $signal(false);
  // The time that a reset of the form gives back.
  let initialValue = $signal(value);
  const { committed, nativeErrors, invalidated, changed } = formField(inputId, () => {
    value = initialValue;
    parts = timePartsOf(initialValue);
    edited = false;
  });
  const segments = $memo(timeSegmentsOf(parts, placeholderValue, locale.locale, granularity, hourCycle));
  const errors = $memo([
    ...(edited ? [] : messagesOf(name ? (form?.validationErrors[name] as string | string[]) : undefined)),
    ...(committed ? nativeErrors : []),
  ]);
  // Times compare by their seconds, so `09:30:00` is not past `09:30`.
  const invalid = $memo(
    isInvalid ||
      errors.length > 0 ||
      (value !== null &&
        ((minValue !== undefined && secondsOf(value) < secondsOf(minValue)) ||
          (maxValue !== undefined && secondsOf(value) > secondsOf(maxValue)))),
  );

  // A time that the caller sets shows in the segments.
  $effect(() => {
    const next = value;
    if ($untrack(timeOf(parts, granularity, twelve)) !== next) {
      $untrack((parts = timePartsOf(next)));
    }
  });

  function update(next: DateParts) {
    parts = next;
    const time = timeOf(next, granularity, twelve);
    if (time !== value) {
      value = time;
      edited = true;
      changed();
      onChange?.(time);
    }
  }

  function isTimePart(type: SegmentType): type is 'hour' | 'minute' | 'second' | 'dayPeriod' {
    return type === 'hour' || type === 'minute' || type === 'second' || type === 'dayPeriod';
  }

  function locked(): boolean {
    return isDisabled || isReadOnly;
  }

  $setContext(LabelContext, { id: labelId });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(FieldErrorContext, { id: errorId, isInvalid: invalid, errors });
  $setContext(DateFieldContext, {
    segments,
    labelId,
    describedBy: describedBy(hasDescription && descriptionId, invalid && errorId),
    isDisabled,
    isReadOnly,
    isRequired,
    isInvalid: invalid,
    direction: locale.direction,
    step: (type: SegmentType, delta: number) => {
      if (!locked() && isTimePart(type)) {
        typed = '';
        update(stepTime(parts, type, delta, placeholderValue, twelve));
      }
    },
    jump: (type: SegmentType, to: 'min' | 'max') => {
      if (!locked() && isTimePart(type)) {
        typed = '';
        update(jumpTime(parts, type, to, placeholderValue, twelve));
      }
    },
    type: (type: SegmentType, char: string) => {
      if (locked() || !isTimePart(type)) {
        return false;
      }
      const next = typeTime(parts, type, typed, char, placeholderValue, twelve, locale.locale);
      typed = next.typed;
      update(next.parts);
      return next.full;
    },
    erase: (type: SegmentType) => {
      if (locked() || !isTimePart(type)) {
        return false;
      }
      typed = '';
      // Backspace empties AM or PM, and moves back from it once it is empty.
      if (type === 'dayPeriod') {
        if (parts.dayPeriod === undefined) {
          return true;
        }
        const next = { ...parts };
        delete next.dayPeriod;
        update(next);
        return false;
      }
      const empty = parts[type] === undefined;
      // An hour on a 12-hour clock is not its digits, so it empties.
      if (type === 'hour' && twelve) {
        const next = { ...parts };
        delete next.hour;
        update(next);
      } else {
        update(erasePart(parts, type));
      }
      return empty;
    },
    settle: () => {
      typed = '';
    },
  });
</script>

<{as}
  data-disabled=(isDisabled || undefined)
  data-readonly=(isReadOnly || undefined)
  data-invalid=(invalid || undefined)
  data-required=(isRequired || undefined)
  {...rest}
>
  {children}
  <!-- The time for the form, which posts without scripts. -->
  <input
    id=inputId
    {name}
    value=(value ?? '')
    required=(isRequired || undefined)
    disabled=(isDisabled || undefined)
    tabindex="-1"
    aria-hidden="true"
    style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0"
    onInvalid=(prevent(invalidated))
  >
</>
