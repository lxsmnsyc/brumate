<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { Bindable } from 'brumate/signals';

  export interface CheckboxProps extends Omit<ElementProps<'label'>, 'onChange'> {
    /** The name of the input, posted with the form. */
    name?: string;
    /** The value that the input posts. In a CheckboxGroup, it names the box in the group. */
    value?: string;
    /** Shows that some of a list is selected. It sets the state of the input to indeterminate. */
    isIndeterminate?: boolean;
    /** Disables the box. A disabled group disables its boxes too. */
    isDisabled?: boolean;
    /** Keeps the state: a click does not toggle the box. */
    isReadOnly?: boolean;
    /** Asks the browser to check the box when its form is sent. */
    isRequired?: boolean;
    /** Marks the box as invalid. */
    isInvalid?: boolean;
    /** Runs with the new state when the user toggles the box. */
    onChange?: (selected: boolean) => void;
    /** The content of the label. Draw the box here. */
    children?: unknown;
    /** Whether the box is checked. A plain value starts its own state, and `$bind(signal)` writes the caller's. A group keeps the state of its boxes. */
    isSelected?: Bindable<boolean>;
  }
</script>

<script>
  import { $client, $getContext, $id, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import VisuallyHidden from './VisuallyHidden.brm';
  import { box } from './box.brm.ts';
  import { CheckboxGroupContext, FieldErrorContext, LabelContext, TextContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { describedBy, isFirstInvalid, onFormReset } from './fields.ts';

  /**
   * A checkbox: a <label> around a native checkbox, which
   * a screen reader reads and a form posts without scripts. The label shows the state as
   * `data-selected`, `data-indeterminate`, `data-pressed`, `data-hovered`, `data-focused`,
   * `data-focus-visible`, `data-disabled`, `data-readonly`, `data-invalid` and `data-required`.
   * Draw the box in the children, from these attributes.
   *
   * `isSelected` alone starts its own state as on, and `isSelected=$bind(signal)` writes the
   * caller's. In a CheckboxGroup, the group keeps the state, and `value` names the box in it.
   */
  const {
    name,
    value,
    isIndeterminate = false,
    isDisabled,
    isReadOnly,
    isRequired,
    isInvalid,
    onChange,
    children,
    ...rest
  } = $props<CheckboxProps>();
  let { isSelected = false } = $props<CheckboxProps>();
  // The state that a reset of the form gives back.
  let initial = $signal(isSelected);
  const inputId = $id();

  const group = $getContext(CheckboxGroupContext);
  const selected = $memo(group ? group.value.includes(value ?? '') : isSelected);
  const disabled = $memo(Boolean(isDisabled || group?.isDisabled));
  const readOnly = $memo(Boolean(isReadOnly || group?.isReadOnly));
  const required = $memo(Boolean(isRequired || group?.isRequired));
  const mixed = $memo(Boolean(isIndeterminate || group?.isIndeterminate));
  // The browser checked the box on a submit, and it was not valid. In a group, the group keeps
  // this state for every box, so a check of any box clears all of them.
  let failed = $signal(false);
  const invalid = $memo(Boolean(isInvalid || (group ? group.isInvalid : failed)));

  // A box outside a group takes a Text with `slot="description"` and a FieldError in its children,
  // as a field does. In a group, the group owns both.
  const descriptionId = $id();
  const { present: hasDescription } = described(descriptionId);
  const errorId = $id();
  // The message of the browser, after a submit with the box off.
  let message = $signal('');
  const errors = $memo(failed && message ? [message] : []);
  const describing = $memo(
    group ? describedBy(group.describedBy) : describedBy(hasDescription && descriptionId, invalid && errorId),
  );
  const labelId = $id();
  const { present: hasLabel } = described(labelId, false);
  const groupLabel = $getContext(LabelContext);
  const groupText = $getContext(TextContext);
  const groupError = $getContext(FieldErrorContext);
  // A Label in the children (`as="span"`) names the input, so the description and the error stay
  // out of its name. Without one, they sit in the text of the label, and aria-hidden keeps them
  // out of the name. The server cannot see the Label, so a box starts without one: the name is right
  // before any script runs, and the browser turns the Label on when it finds it. The input still names them in aria-describedby, which reads hidden elements.
  const hidden = $memo(hasLabel ? undefined : 'true');
  $setContext(LabelContext, group ? groupLabel : { id: labelId });
  $setContext(
    TextContext,
    group ? groupText : { slots: { description: { id: descriptionId, 'aria-hidden': hidden } } },
  );
  $setContext(
    FieldErrorContext,
    group
      ? groupError
      : { id: errorId, isInvalid: invalid, errors, attributes: { 'aria-hidden': hidden } },
  );

  const {
    hovered,
    pressed,
    focused,
    focusVisible,
    onPointerEnter,
    onPointerLeave,
    onPointerDown,
    onPointerUp,
    onPointerCancel,
    onKeyDown,
    onKeyUp,
    onFocusIn,
    onFocusOut,
  } = box(disabled);

  // The click of a read-only box, which the wrapper prevents.
  function keep() {}

  // A reset of the form gives back the first state, as it does for a box of the browser. In a
  // group, the group keeps the state and gives it back. The browser sets its own default on the
  // native input, so this puts it back in step with the state.
  $client(() => {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    return onFormReset(
      input,
      () => {
        if (!group) {
          isSelected = initial;
        }
      },
      () => {
        if (input) {
          input.checked = selected;
        }
      },
    );
  }, 'load');

  function change(event: Event & { currentTarget: HTMLInputElement }) {
    const input = event.currentTarget;
    // A read-only box keeps its state. The browser toggled it already.
    if (readOnly) {
      input.checked = selected;
      return;
    }
    failed = false;
    message = '';
    // A click clears the indeterminate state of the input. It stays while the prop says so.
    input.indeterminate = mixed;
    const before = selected;
    if (group) {
      group.toggle(value ?? '', input.checked);
    } else {
      isSelected = input.checked;
    }
    // A setter that refuses leaves the old state, so the input goes back to it.
    input.checked = selected;
    if (selected !== before) {
      onChange?.(selected);
    }
  }

  // The browser shows no message of its own. The group shows it in its FieldError.
  // The first invalid field of the form gets focus, as the browser does with its own message.
  function invalidated(event: Event & { currentTarget: HTMLInputElement }) {
    const input = event.currentTarget;
    failed = true;
    message = input.validationMessage;
    group?.onInvalid(input.validationMessage);
    if (isFirstInvalid(input)) {
      input.focus();
    }
  }
</script>

<label
  data-selected=(selected || undefined)
  data-indeterminate=(mixed || undefined)
  data-pressed=(pressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(disabled || undefined)
  data-readonly=(readOnly || undefined)
  data-invalid=(invalid || undefined)
  data-required=(required || undefined)
  {onPointerEnter}
  {onPointerLeave}
  {onPointerDown}
  {onPointerUp}
  {onPointerCancel}
  {onKeyDown}
  {onKeyUp}
  {onFocusIn}
  {onFocusOut}
  {...rest}
>
  <!-- A read-only box prevents its click, so the browser never toggles it, and a screen reader
       announces no change. -->
  #if (readOnly) {
    <VisuallyHidden
      as="input"
      id=inputId
      type="checkbox"
      name=(name ?? group?.name)
      {value}
      checked=selected
      disabled=(disabled || undefined)
      required=(required || undefined)
      aria-readonly=(readOnly ? 'true' : undefined)
      aria-invalid=(invalid ? 'true' : undefined)
      aria-describedby=describing
      aria-labelledby=(group || !hasLabel ? undefined : labelId)
      onChange=change
      onClick=(prevent(keep))
      onInvalid=(prevent(invalidated))
    />
  } #else {
    <VisuallyHidden
      as="input"
      id=inputId
      type="checkbox"
      name=(name ?? group?.name)
      {value}
      checked=selected
      disabled=(disabled || undefined)
      required=(required || undefined)
      aria-readonly=(readOnly ? 'true' : undefined)
      aria-invalid=(invalid ? 'true' : undefined)
      aria-describedby=describing
      aria-labelledby=(group || !hasLabel ? undefined : labelId)
      onChange=change
      onInvalid=(prevent(invalidated))
    />
  }
  {children}
  #if (mixed) {
    <script>
      // A box is indeterminate only from code, so only an indeterminate box loads any. It runs
      // when the page is idle, not when the box is in view, since a screen reader reads boxes that
      // are out of view too.
      let marker = $signal<HTMLElement>();
      $client(() => {
        const input = marker?.parentElement?.querySelector('input');
        if (input) {
          input.indeterminate = true;
        }
        return () => {
          if (input) {
            input.indeterminate = false;
          }
        };
      }, 'idle');
    </script>
    <span ref=$bind(marker) hidden></span>
  }
</label>
