<script module>
  import type { Bindable } from 'brumate/signals';

  export interface DialogTriggerProps {
    /** Runs with each change of whether the overlay is open. */
    onOpenChange?: (open: boolean) => void;
    /** A `Button` and an overlay, such as a `Popover` or a `Modal`. */
    children?: unknown;
    /** Whether the overlay is open. Alone it starts open, and `$bind` writes your signal. */
    isOpen?: Bindable<boolean>;
  }
</script>

<script>
  import { $id, $props, $setContext } from 'brumate/signals';
  import { ButtonContext, OverlayTriggerContext } from './contexts.ts';

  /**
   * Opens an overlay, such as a Popover or a Modal, from a Button inside it. The Button gets
   * aria-expanded and aria-controls, and a press toggles the overlay. It gets no aria-haspopup. It renders
   * only its children.
   *
   * `isOpen` alone starts it open, and `isOpen=$bind(signal)` writes the caller's.
   */
  const { onOpenChange, children } = $props<DialogTriggerProps>();
  let { isOpen = false } = $props<DialogTriggerProps>();

  const triggerId = $id();
  const overlayId = $id();

  function setOpen(next: boolean) {
    if (next === isOpen) {
      return;
    }
    isOpen = next;
    onOpenChange?.(next);
  }

  function open() {
    setOpen(true);
  }

  function close() {
    setOpen(false);
  }

  function toggle() {
    setOpen(!isOpen);
  }

  $setContext(ButtonContext, {
    id: triggerId,
    'aria-expanded': isOpen ? 'true' : 'false',
    'aria-controls': isOpen ? overlayId : undefined,
    onPress: toggle,
  });
  $setContext(OverlayTriggerContext, { isOpen, triggerId, overlayId, open, close });
</script>

{children}
