<script>
  import { $getContext, $memo, $props } from 'brumate/signals';
  import { LabelContext } from './contexts.ts';
  import { contextAttributes, slotProps } from './slots.ts';

  /**
   * The label of a field, as Label of React Aria Components. A field gives it an ID and the `for`
   * of its input. The caller's `id` and `for` win.
   */
  const { as = 'label', slot, children, ...rest } = $props<{
    as?: string;
    slot?: string | null;
    children?: unknown;
    [attribute: string]: unknown;
  }>();

  const context = $getContext(LabelContext);
  const attributes = $memo(contextAttributes(slotProps(context, slot)));
</script>

<{as} {...attributes} {...rest}>{children}</>
