<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { Placement } from './position.ts';

  export interface PopoverOwnProps<T extends AsTarget = 'div'> {
    /** The side of its trigger that it opens on, such as `bottom start`. Without it, the placement that the trigger asks for applies. */
    placement?: Placement;
    /** The space between the trigger and the popover, in pixels. */
    offset?: number;
    /** A shift along the side of the trigger, in pixels. */
    crossOffset?: number;
    /** Whether it flips to the other side when it does not fit. */
    shouldFlip?: boolean;
    /** The space that it keeps from the edges of the window, in pixels. */
    containerPadding?: number;
    /** Leaves the rest of the page active, and closes the popover when focus leaves it. */
    isNonModal?: boolean;
    /** Lets CSS animate it, with `data-closed`, `data-enter` and `data-leave`. */
    transition?: boolean;
    /** Runs when it closes, for one with its own `isOpen`. With a trigger, the trigger reports the change. */
    onOpenChange?: (open: boolean) => void;
    /** The content of the popover, often a `Dialog`. */
    children?: unknown;
    /** Whether it is open, in place of the `DialogTrigger` around it. `$bind` writes your signal. */
    isOpen?: Bindable<boolean>;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of Popover. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type PopoverProps<T extends AsTarget = 'div'> = AsProps<T, PopoverOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { store } from 'brumate/store';
  import { $client, $effect, $getContext, $id, $isPassed, $memo, $props, $setContext, $signal, $store, $toStore, $untrack } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import {
    ButtonContext,
    DialogContext,
    LinkContext,
    OverlayTriggerContext,
    PopoverGroupContext,
  } from './contexts.ts';
  import type { DialogState } from './contexts.ts';
  import { LayerContext } from './layer.ts';
  import { DEFAULT_LOCALE, LocaleContext } from './locale.ts';
  import {
    blurOutside,
    containTab,
    escapeOutside,
    focusInto,
    closeOthersInGroup,
    hold,
    inPopoverGroup,
    inertOutside,
    keepFocus,
    leaveByTab,
    lockScroll,
    pressOutside,
    queueLoad,
    release,
    takesText,
  } from './overlay.ts';
  import { followTrigger, keepArrows, pointAnchor, readLength } from './position.ts';
  import { mergeStyle } from './style.ts';
  import { TransitionContext, enterSteps, leaveSteps, nextFrame, stepClasses } from './transition.ts';
  import type { TransitionParent } from './transition.ts';

  /**
   * An overlay next to its trigger. It opens from a
   * DialogTrigger, and holds a Dialog or another part.
   *
   * - It renders a layer at the end of the layer of the floating part around it, or at the end
   *   of <body>. The overlays that open inside it render at the end of its own layer, so they
   *   are above it, and a press in them is a press inside it.
   * - It is placed with `top` and `left` next to its trigger, on the side of `placement`, and
   *   flips to the other side when it does not fit. It follows the trigger as the page scrolls.
   *   It shows `data-placement`, and sets `--trigger-width` and `--available-height`.
   * - It sets `max-height` to the room that is left, with `overflow-y: auto`, unless your CSS
   *   sets them. `--anchor-gap`, `--anchor-offset` and `--anchor-padding` in CSS stand in for
   *   `offset`, `crossOffset` and `containerPadding` when the prop is not passed.
   * - Escape, and a press outside it, close it. Focus moves into it, stays in it, and goes back
   *   to the trigger when it closes.
   * - It is modal: the rest of the page is inert while it is open. `isNonModal` leaves the page
   *   as it is, and Tab can leave the popover.
   * - `transition` lets CSS animate it, with `data-closed`, `data-enter` and `data-leave`. It
   *   waits for its leave before it leaves the page, and is inert while it leaves.
   * - Inside a PopoverGroup, a non-modal popover stays open for focus that moves to the trigger or
   *   the panel of another popover of the group, one that opens closes the others, and Tab leaves its panel for the next element
   *   after its trigger.
   * - In a Select, its content stays in the page while it is closed, out of sight, so the
   *   Select knows its items.
   */
  const {
    as,
    placement = 'bottom',
    offset = 8,
    crossOffset = 0,
    shouldFlip = true,
    containerPadding = 12,
    isNonModal = false,
    transition = false,
    onOpenChange,
    children,
    style,
    ...rest
  } = $props<PopoverProps<T>>();
  let { isOpen } = $props<PopoverOwnProps<T>>();
  let { ref } = $props<PopoverOwnProps<T>>();

  const triggerGiven = $getContext(OverlayTriggerContext, undefined);
  const trigger = triggerGiven ? $store(triggerGiven.state) : undefined;
  const parentLayer = $getContext(LayerContext, undefined);
  const group = $getContext(PopoverGroupContext, undefined);
  const localeValue = $store($getContext(LocaleContext, store(DEFAULT_LOCALE)));
  const locale = $memo(localeValue ?? DEFAULT_LOCALE);
  const own = $isPassed(isOpen);
  const placementPassed = $isPassed(placement);
  const offsetPassed = $isPassed(offset);
  const crossOffsetPassed = $isPassed(crossOffset);
  const paddingPassed = $isPassed(containerPadding);
  const layerId = $id();
  const ownId = $id();
  const wanted = $memo(own ? Boolean(isOpen) : Boolean(trigger?.isOpen));
  const target = $untrack(parentLayer ? `#${parentLayer.id}` : 'body');

  // It is in the page: open, or leaving.
  let mounted = $signal(false);
  let rested = $signal(false);
  let leaving = $signal(false);
  // Whether it is shown or opening, and not leaving. A change to the value it already shows, such as
  // the first write of a bound start value, opens nothing again.
  let shown = $signal(false);
  let run = $signal(0);
  let layer = $signal<HTMLElement>();

  $setContext(LayerContext, { id: layerId });
  // A popover inside this one is not a member of the group of this one.
  $setContext(PopoverGroupContext, null);
  const dialogState = $memo<DialogState>({ labelledBy: trigger?.labelledBy });
  $setContext(DialogContext, { state: $toStore(dialogState), close });
  const transitionGiven = $memo<TransitionParent>({ show: wanted, entered: rested });
  $setContext(TransitionContext, $toStore(transitionGiven));
  // An overlay inside opens from a DialogTrigger of its own, not from the one of this popover.
  $setContext(OverlayTriggerContext, { state: store(null) });
  // The buttons and links inside are not the trigger, which gets these contexts.
  $setContext(ButtonContext, { state: store(null) });
  $setContext(LinkContext, { state: store(null) });

  function close() {
    if (own) {
      // A press outside during the leave closes nothing again.
      if (!isOpen) {
        return;
      }
      isOpen = false;
      onOpenChange?.(false);
    } else {
      triggerGiven?.close?.();
    }
  }

  async function show(token: number, loaded = false) {
    shown = true;
    mounted = true;
    const returnTo = document.activeElement;
    await nextFrame();
    const element = ref as HTMLElement | undefined;
    const holder = layer;
    // The popover can leave the page within the frame, such as on a route change.
    if (token !== run || !element?.isConnected || !holder) {
      return;
    }
    const anchor = trigger ? document.getElementById(trigger.triggerId) : null;
    // A context menu opens at a point, with no element to follow.
    const point = trigger?.point;
    const placed = point ? pointAnchor(point.x, point.y) : anchor;
    const stops: (() => void)[] = [];
    hold(element, stops, returnTo, trigger?.triggerId, Boolean(trigger?.isPreview));
    if (placed) {
      const arrows = keepArrows(element);
      stops.push(
        arrows.stop,
        followTrigger(
          placed,
          element,
          {
            placement: getPlacement(),
            offset: offsetPassed ? offset : (readLength(element, '--anchor-gap') ?? (point ? 0 : offset)),
            crossOffset: crossOffsetPassed
              ? crossOffset
              : (readLength(element, '--anchor-offset') ?? crossOffset),
            shouldFlip,
            containerPadding: paddingPassed
              ? containerPadding
              : (readLength(element, '--anchor-padding') ?? containerPadding),
            direction: locale.direction,
            fitHeight: true,
          },
          arrows.place,
        ),
      );
    }
    // Inside a group, a popover that opens closes the others, as one that is pressed open does.
    if (group) {
      stops.push(closeOthersInGroup(group.id, holder, close));
    }
    // A preview is never modal, and a submenu is not either. A modal popover makes the page inert
    // and locks its scroll, and closes on a press outside. One that
    // is not modal closes when focus leaves it.
    const modal = !isNonModal && !trigger?.isNonModal;
    if (modal && !trigger?.isPreview) {
      stops.push(inertOutside(holder), keepFocus(holder, element), lockScroll());
    }
    if (modal) {
      stops.push(pressOutside(holder, anchor, close));
    } else {
      const groupId = group?.id;
      stops.push(
        blurOutside(
          holder,
          anchor,
          close,
          groupId ? (target) => inPopoverGroup(groupId, target) : undefined,
        ),
      );
      if (isNonModal) {
        stops.push(escapeOutside(holder, anchor, close));
      }
    }
    if (transition && !(await enterSteps(element, stepClasses(), { current: () => token === run }))) {
      return;
    }
    rested = true;
    // Focus moves in once it has entered, so it lands on a popover that has settled. A preview
    // leaves focus where it is, and Tab moves into it, and so does a submenu opened by hover.
    // A popover that starts open on load leaves focus in a field that a reader is typing in,
    // unless it is modal, where the page behind it is inert.
    const typing = loaded && !modal && takesText(document.activeElement);
    if (!trigger?.isPreview && trigger?.autoFocus !== false && !typing) {
      focusInto(
        element.querySelector<HTMLElement>(
          '[role=dialog], [role=alertdialog], [role=menu], [role=listbox]',
        ) ??
          element,
      );
    }
  }

  async function hide(token: number) {
    shown = false;
    rested = false;
    const element = ref as HTMLElement | undefined;
    if (transition && element) {
      const done = await leaveSteps(element, stepClasses(), { current: () => token === run }, () => {
        leaving = true;
      });
      if (!done) {
        return;
      }
    }
    if (element) {
      release(element, layer);
    }
    leaving = false;
    mounted = false;
  }

  // When the popover leaves the page while it is open, such as with an #if around it, its panel
  // goes with it, and what it held on the page is given back.
  function leave() {
    const element = ref as HTMLElement | undefined;
    if (element && !element.isConnected) {
      release(element, layer);
    }
  }

  // A client navigation runs the cleanups of the page before it removes its markup, so the
  // panel is still in the page. The scope is gone for good, so everything is given back.
  function leavePage() {
    const element = ref as HTMLElement | undefined;
    if (element) {
      release(element, layer);
    }
    // A route that leaves keeps the markup of a portal, so the layer goes here.
    layer?.remove();
    // An #offscreen body that hides runs this too, and runs the client callback again when it shows,
    // which opens the overlay again if it is still wanted.
    shown = false;
    mounted = false;
    rested = false;
    leaving = false;
  }

  $effect(() => {
    const next = wanted;
    $untrack(change(next));
    return leave;
  });

  // An effect never runs when the page loads, so a start value of `true` opens it here, after the
  // overlays before it. Its cleanup runs even when the value never changes.
  $client(() => {
    queueLoad(() => {
      if (wanted && !shown) {
        run += 1;
        leaving = false;
        return show(run, true);
      }
    });
    return leavePage;
  }, 'load');

  function change(next: boolean) {
    if (next && shown) {
      return;
    }
    run += 1;
    if (next) {
      leaving = false;
      void show(run);
    } else if (mounted) {
      void hide(run);
    }
  }

  /** The placement: the popover's own, or else the one that its trigger asks for. */
  function getPlacement(): Placement {
    return placementPassed ? placement : (trigger?.placement ?? placement);
  }

  // A part inside that used Escape prevents it, such as a SearchField that clears its text.
  function keyDown(event: KeyboardEvent) {
    // In a group, Tab leaves the panel, which is at the end of the page, for the page after the trigger.
    if (event.key === 'Tab' && group && (isNonModal || trigger?.isNonModal) && !event.defaultPrevented) {
      const element = ref as HTMLElement | undefined;
      if (element && trigger) {
        leaveByTab(element, document.getElementById(trigger.triggerId), event);
      }
    }
    if (event.key === 'Escape' && !event.defaultPrevented) {
      close();
    }
  }

  function trap(event: KeyboardEvent) {
    const element = ref as HTMLElement | undefined;
    if (element) {
      containTab(element, event);
    }
  }
</script>

#template content() {
  <{as ?? 'div'}
    ref=$bind(ref)
    id=(trigger?.overlayId ?? ownId)
    tabindex="-1"
    style=(mergeStyle(style, 'position: fixed; top: 0; left: 0'))
    inert=(leaving || undefined)
    data-closed=($untrack(transition || undefined))
    onKeyDown=keyDown
    {...rest}
  >{children}</>
}

#if (mounted) {
  #portal (target) {
    <!--
      The layer: the element of this floating part, which the overlays inside it render into.
      It has no box of its own, so it clips, moves and contains nothing.
    -->
    <div
      ref=$bind(layer)
      id=layerId
      data-layer
      data-popover-group-panel=(group?.id)
      style="display: contents"
    >
      #if (isNonModal || trigger?.isPreview || trigger?.isNonModal) {
        {content()}
      } #else {
        <!-- Tab stays in a modal popover. The wrapper prevents it, and the handler moves focus. -->
        <div style="display: contents" onKeyDown=(prevent(trap, 'Tab'))>{content()}</div>
      }
    </div>
  }
} #else if (trigger?.keepsContent) {
  <!-- Out of sight, and out of the tree of accessibility and of the order of Tab. -->
  <div id=(`${trigger.overlayId}-closed`) style="display: none">{children}</div>
}
