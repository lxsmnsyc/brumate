<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { TokenSegment } from './token-field.ts';

  export interface TokenInputProps extends ElementProps<'div'> {
    /** A `#template` that renders a Token for each token. Without it, a token shows its text. */
    token?: (segment: TokenSegment) => unknown;
  }
</script>

<script>
  import { $client, $effect, $getContext, $memo, $props, $setContext, $signal, $untrack } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import Token from './Token.brm';
  import {
    EDGE,
    TokenContext,
    TokenFieldContext,
    caretOffset,
    placeCaret,
    readSegments,
    sameSegments,
    tokenize,
  } from './token-field.ts';

  /**
   * The box of a TokenField that the user types in: an
   * element with `contenteditable`. `token`, a `#template`, renders a Token for each token. Without
   * it, each token is a Token with its text.
   *
   * - The browser edits the text. The box reads it back into the value, and makes the text that
   *   the `pattern` of the field matches into tokens.
   * - A token is one piece: the caret goes past it, and Backspace removes it whole.
   * - Enter adds a new line only with `allowsNewlines`. A paste adds plain text.
   * - It shows `data-focused`, `data-focus-visible`, `data-disabled`, `data-readonly` and
   *   `data-empty`, with the placeholder in `data-placeholder` for CSS.
   */
  const { token, ...rest } = $props<TokenInputProps>();

  const field = $getContext(TokenFieldContext);
  if (!field) {
    throw new Error('A TokenInput goes in a TokenField.');
  }
  // The markup of the box renders once. After that, the box is the browser's, and this code
  // writes it from the value, so the browser and the render do not both change it.
  const initial = $untrack(field.value);
  let box = $signal<HTMLElement>();
  let stamps = $signal<HTMLElement>();
  let focused = $signal(false);
  let focusVisible = $signal(false);
  let composing = $signal(false);
  // The last revision of the field that the box saw, and whether one came during a composition.
  let lastRevision = $signal(0);
  let late = $signal(false);
  // Where the caret was in the value, to put it back after the box is written again.
  let caret = $signal<number | undefined>(undefined);
  const disabled = $memo(field.isDisabled);
  const editable = $memo(!field.isDisabled && !field.isReadOnly);
  // Whether the box was read once, for text that the user typed before this code loaded.
  let synced = $signal(false);
  // The tokens of the value, each with a key of its text and its place among the same text, so a
  // new token gets a new stamp, and a stamp is not reused for other text.
  const marks = $memo(stampsOf(field.value));
  $setContext(TokenContext, { isDisabled: disabled });

  function stampsOf(value: TokenSegment[]) {
    const seen: Record<string, number> = {};
    const list: { key: string; segment: TokenSegment }[] = [];
    for (const segment of value) {
      if (segment.type === 'token') {
        const count = seen[segment.text] ?? 0;
        seen[segment.text] = count + 1;
        list.push({ key: `${count}:${segment.text}`, segment });
      }
    }
    return list;
  }

  /** Writes the box from the value, with each token copied from its stamp. A token whose stamp is not the one of its text shows its text. */
  function write(value: TokenSegment[]) {
    const element = box;
    const nodesOfStamps = stamps?.querySelectorAll<HTMLElement>(':scope > [data-stamp]') ?? [];
    if (!element) {
      return;
    }
    const nodes: Node[] = [];
    let index = 0;
    for (const segment of value) {
      if (segment.type === 'text') {
        nodes.push(document.createTextNode(segment.text));
        continue;
      }
      const span = document.createElement('span');
      span.setAttribute('data-token', segment.text);
      span.contentEditable = 'false';
      const stamp = nodesOfStamps[index++];
      if (stamp?.getAttribute('data-stamp') === segment.text) {
        span.append(...[...stamp.childNodes].map((node) => node.cloneNode(true)));
      } else {
        span.textContent = segment.text;
      }
      nodes.push(document.createTextNode(EDGE), span, document.createTextNode(EDGE));
    }
    // A newline that ends the text shows no line, so a line break shows it. It reads as no text.
    const last = value.at(-1);
    if (last?.type === 'text' && last.text.endsWith('\n')) {
      nodes.push(document.createElement('br'));
    }
    element.replaceChildren(...nodes);
  }

  // The value from the field, or a change from outside: the box shows it, and keeps the caret.
  $effect(() => {
    const value = field.value;
    const element = box;
    // A reset writes the box, though the value stays.
    const revision = field.revision;
    if ($untrack(lastRevision) !== revision) {
      $untrack((lastRevision = revision));
      // A reset during a composition is written when the composition ends.
      if ($untrack(composing)) {
        $untrack((late = true));
      }
    }
    // The composition and the caret are no reason to write: the value is.
    if (!element || $untrack(composing)) {
      return;
    }
    const read = readSegments(element);
    if (sameSegments(read, value)) {
      $untrack((synced = true));
      return;
    }
    // Text that the user typed before this code loaded is in the box, so it is the value.
    if (!$untrack(synced)) {
      $untrack((synced = true));
      const next = $untrack(input());
      if (next && !sameSegments(next, read)) {
        write(next);
        showCaret(element);
      }
      return;
    }
    write(value);
    showCaret(element);
  });

  function showCaret(element: HTMLElement) {
    const offset = $untrack(caret);
    if (offset !== undefined && document.activeElement === element) {
      placeCaret(element, offset);
    }
  }

  function input(): TokenSegment[] | undefined {
    const element = box;
    if (!element || composing) {
      return undefined;
    }
    const read = readSegments(element);
    const next = tokenize(read, field!.pattern);
    const offset = caretOffset(element);
    caret = offset;
    // Text that the browser wrote is in the box already. A new token needs the box written.
    field!.setValue(next);
    // A caret in the space around a token goes back to where the value has it, so a Backspace
    // after the text next to a token removes the token, not that space.
    const at = getSelection()?.anchorNode;
    if (offset !== undefined && at?.nodeType === 3 && (at as Text).data.includes(EDGE)) {
      placeCaret(element, offset);
    }
    return next;
  }

  function keyDown(event: KeyboardEvent) {
    if (event.key === 'Enter' && field!.allowsNewlines && !event.isComposing) {
      document.execCommand('insertText', false, '\n');
    }
  }

  function paste(event: ClipboardEvent) {
    const text = event.clipboardData?.getData('text/plain') ?? '';
    const lines = field!.allowsNewlines ? text : text.replaceAll(/\r?\n/g, ' ');
    document.execCommand('insertText', false, lines);
  }

  function focus(event: FocusEvent & { currentTarget: Element }) {
    focused = true;
    focusVisible = event.currentTarget.matches?.(':focus-visible') ?? false;
  }

  function blur() {
    focused = false;
    focusVisible = false;
  }

  // A token shows `data-selected` while the selection covers it.
  $client(() => {
    const selected = () => {
      const element = box;
      const selection = document.getSelection();
      for (const span of element?.querySelectorAll('[data-token]') ?? []) {
        const part = span.querySelector('[data-token-part]');
        const covered = Boolean(selection && !selection.isCollapsed && selection.containsNode(span, true));
        part?.toggleAttribute('data-selected', covered);
      }
    };
    document.addEventListener('selectionchange', selected);
    return () => document.removeEventListener('selectionchange', selected);
  }, 'visible');
</script>

<div
  ref=$bind(box)
  role=(field.role)
  contenteditable=(editable ? 'true' : 'false')
  tabindex=(disabled ? undefined : '0')
  aria-multiline=(field.allowsNewlines ? 'true' : undefined)
  aria-labelledby=(field.labelId)
  aria-describedby=(field.descriptionId)
  aria-disabled=(field.isDisabled ? 'true' : undefined)
  aria-readonly=(field.isReadOnly ? 'true' : undefined)
  aria-placeholder=(field.placeholder)
  data-placeholder=(field.placeholder)
  data-empty=(field.value.length === 0 || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(field.isDisabled || undefined)
  data-readonly=(field.isReadOnly || undefined)
  onInput=input
  onKeyDown=(prevent(keyDown, 'Enter'))
  onPaste=(prevent(paste))
  onCompositionStart=(() => (composing = true))
  onCompositionEnd=(() => {
    composing = false;
    if (late) {
      late = false;
      write(field!.value);
      showCaret(box!);
      return;
    }
    input();
  })
  onFocus=focus
  onBlur=blur
  {...rest}
>
  #for (segment of initial by index) {
    #if (segment.type === 'token') {
      {EDGE}<span data-token=(segment.text) contenteditable="false">#if (token) {
          {token(segment)}
        } #else {
          <Token>{segment.text}</Token>
        }</span>{EDGE}
    } #else {
      {segment.text}
    }
  }
</div>
<!-- The tokens of the value, rendered by the template, which the box copies. -->
<div ref=$bind(stamps) hidden aria-hidden="true">
  #for (stamp of marks by stamp.key) {
    <span data-stamp=(stamp.segment.text)>#if (token) {
        {token(stamp.segment)}
      } #else {
        <Token>{stamp.segment.text}</Token>
      }</span>
  }
</div>

<style>
  div[contenteditable] {
    white-space: pre-wrap;
  }

  div[data-empty]::before {
    content: attr(data-placeholder);
    pointer-events: none;
  }
</style>
