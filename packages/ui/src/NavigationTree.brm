<script module>
  import type { Bindable } from 'brumate/signals';
  import type { Key } from './collection.ts';
  import type { NavigationNode } from './navigation-tree.ts';

  export interface NavigationTreeProps<V extends NavigationNode = NavigationNode> {
    /** The route of the page that shows. The item whose `href` is that route is the current one. */
    selectedRoute?: string | null;
    /** The data of the rows, each with an `id` and an optional `href`. An item with `children` is a parent. */
    items: readonly V[];
    /** A template that renders a `NavigationTreeItem` for each item that shows. */
    item: (node: V) => unknown;
    /** Runs with the keys of the open items after each change. */
    onExpandedChange?: (keys: Key[]) => void;
    /** The keys of the open items. Starts its own state, or binds with `$bind`. */
    expandedKeys?: Bindable<Key[]>;
    [attribute: string]: unknown;
  }
</script>

<script generics="V extends NavigationNode">
  import { $memo, $props, $setContext } from 'brumate/signals';
  import { NavigationTreeContext, findAncestors } from './navigation-tree.ts';
  import Tree from './Tree.brm';

  /**
   * A tree of links, such as the pages of a site. It
   * takes `items` and an `item` template as a Tree does, and each item can have an `href`. The
   * template renders a NavigationTreeItem with a NavigationTreeItemLink.
   *
   * - Nothing is selected. `selectedRoute` names the page that shows: its item is the current
   *   one, and its link has `aria-current="page"`.
   * - The links are in the order of Tab. Up and Down move between the rows, Right opens a row,
   *   and Left closes it or moves to the row that holds it.
   * - `expandedKeys` holds the keys of the open items, as in a Tree.
   * - It is no landmark. Put it in a `nav` with a label.
   */
  const { selectedRoute = null, items, item, onExpandedChange, ...rest } = $props<NavigationTreeProps<V>>();
  let { expandedKeys = [] } = $props<NavigationTreeProps<V>>();

  const ancestors = $memo(findAncestors(items, selectedRoute));
  $setContext(NavigationTreeContext, { selectedRoute, ancestors });

  function expanded(keys: Key[]) {
    expandedKeys = keys;
    onExpandedChange?.(keys);
  }
</script>

<Tree {items} {item} selectionMode="none" keyboardNavigationBehavior="tab" {expandedKeys} onExpandedChange=expanded {...rest} />
