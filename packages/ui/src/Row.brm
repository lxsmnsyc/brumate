<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { Key } from './collection.ts';

  export interface RowProps extends Omit<ElementProps<'tr'>, 'id'> {
    /** The key of the row. */
    id: Key;
    /** The text that typing matches, for an item whose content is more than text. */
    textValue?: string;
    /** Keeps the row from focus and selection. */
    isDisabled?: boolean;
    /** Runs when a press or Enter acts on the row. */
    onAction?: () => void;
    /** The `Cell` elements, one for each column. */
    children?: unknown;
  }
</script>

<script>
  import { SelectionIndicatorContext } from './selection-indicator.ts';
  import { $getContext, $memo, $props, $setContext } from 'brumate/signals';
  import { ListBoxContext, keyAttribute } from './collection.ts';
  import { CheckboxGroupContext } from './contexts.ts';
  import { interact } from './interact.brm.ts';
  import { TableRowContext } from './table.ts';

  /**
   * A row of a Table: a Cell for each column. `id` is its key.
   *
   * - A press selects it, as the Table says, or acts on it when nothing is selectable.
   * - A Checkbox with `slot="selection"` in a Cell shows its selection and toggles it.
   * - `textValue` is the text that typeahead matches, when its content is more than text.
   * - It shows `data-selected`, `data-disabled`, `data-pressed`, `data-hovered`, `data-focused`
   *   and `data-focus-visible`.
   */
  const {
    id,
    textValue,
    isDisabled = false,
    onAction,
    children,
    ...rest
  } = $props<RowProps>();

  const list = $getContext(ListBoxContext);
  const mode = $memo(list?.selectionMode ?? 'none');
  const selected = $memo(Boolean(list?.selectedKeys.includes(id)));
  const disabled = $memo(isDisabled || Boolean(list?.disabledKeys.includes(id)));

  // The Checkbox of the selection is checked while the row is selected, and toggles it.
  $setContext(CheckboxGroupContext, {
    value: selected ? [''] : [],
    isDisabled: disabled || mode === 'none',
    isReadOnly: false,
    isInvalid: false,
    isRequired: false,
    toggle: () => list?.select(id, { shift: false, toggle: true }),
    onInvalid: () => {},
  });

  function pressed(event: { shiftKey: boolean; ctrlKey: boolean; metaKey: boolean }) {
    if (!list) {
      return;
    }
    if (mode === 'none') {
      onAction?.();
      list.action(id);
      return;
    }
    list.select(id, {
      shift: event.shiftKey,
      toggle: list.selectionBehavior === 'toggle' || event.ctrlKey || event.metaKey,
    });
  }

  // The keys of a row are the GridList's, so the row takes the pointer, the focus and the hover.
  const {
    pressed: isPressed,
    hovered,
    focused,
    focusVisible,
    onPointerDown: pressDown,
    onPointerMove,
    onPointerUp,
    onPointerCancel,
    onPointerEnter,
    onPointerLeave,
    onClick: pressClick,
    onFocus,
    onBlur,
  } = interact(
    disabled,
    disabled,
    pressed,
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
  );

  /** True for an event that starts on a control in the row, such as a button, whose press it is. */
  function fromControl(event: Event): boolean {
    const control = (event.target as Element).closest?.(
      'a[href], button, input, select, textarea, label, [tabindex]:not(td, th)',
    );
    return Boolean(control) && control !== event.currentTarget;
  }

  function onPointerDown(event: PointerEvent & { currentTarget: HTMLElement | SVGElement }) {
    if (!fromControl(event)) {
      pressDown(event);
    }
  }

  function onClick(event: MouseEvent & { currentTarget: Element }) {
    if (!fromControl(event)) {
      pressClick(event);
    }
  }
  // A SelectionIndicator inside marks the item while it is selected.
  $setContext(SelectionIndicatorContext, { isSelected: selected });
  // Each Cell takes the next place, so it knows its column.
  $setContext(TableRowContext, { cells: { count: 0 } });
</script>

<tr
  role="row"
  tabindex="-1"
  data-key=(keyAttribute(id))
  data-text-value=textValue
  aria-selected=(mode === 'none' ? undefined : String(selected))
  aria-disabled=(disabled ? 'true' : undefined)
  data-selected=(selected || undefined)
  data-disabled=(disabled || undefined)
  data-pressed=(isPressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  {onPointerDown}
  {onPointerMove}
  {onPointerUp}
  {onPointerCancel}
  {onPointerEnter}
  {onPointerLeave}
  {onClick}
  {onFocus}
  {onBlur}
  {...rest}
>{children}</tr>
