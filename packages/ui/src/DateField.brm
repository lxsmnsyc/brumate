<script module>
  import type { AsProps, AsTarget } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { DateString } from './calendar.ts';

  export interface DateFieldOwnProps {
    /** The name that posts the date with a form, from a hidden input. */
    name?: string;
    /** The earliest date. A date before it makes the field invalid. */
    minValue?: DateString;
    /** The latest date. A date after it makes the field invalid. */
    maxValue?: DateString;
    /** The date that an empty segment starts at when a key steps it. Today by default. */
    placeholderValue?: DateString;
    /** Returns true for a date that cannot be picked. Such a date makes the field invalid. */
    isDateUnavailable?: (date: DateString) => boolean;
    /** Disables the segments and keeps the date out of the form. */
    isDisabled?: boolean;
    /** Keeps the user from changing the date, while the segments can be focused. */
    isReadOnly?: boolean;
    /** Asks the browser to check on a submit that the field has a date. */
    isRequired?: boolean;
    /** Marks the field as invalid, whatever its date. */
    isInvalid?: boolean;
    /** Runs with the date as `YYYY-MM-DD`, or `null` when a segment is emptied, each time the date changes. */
    onChange?: (value: DateString | null) => void;
    /** The ID of the Label, from a DatePicker around the field, which names its Button too. */
    labelId?: string;
    /** The Label, DateInput, description Text and FieldError. */
    children?: unknown;
    /** The date as `YYYY-MM-DD`, or `null` until every segment is set. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    value?: Bindable<DateString | null>;
  }

  /**
   * The props of DateField. `as` takes an element name or a component, and the other props are
   * those of the target.
   */
  export type DateFieldProps<T extends AsTarget = 'div'> = AsProps<T, DateFieldOwnProps>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $effect, $getContext, $id, $memo, $props, $setContext, $signal, $untrack } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import { constrain, outOfRange, toDate, todayString } from './calendar.ts';
  import { FieldErrorContext, FormContext, LabelContext, TextContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { describedBy, messagesOf } from './fields.ts';
  import { DateStringsContext } from './date-strings.ts';
  import { LocaleContext } from './locale.ts';
  import { dateSegments, formField } from './date-field.brm.ts';
  import { DateFieldContext } from './segments.ts';

  /**
   * A date that the user edits segment by segment. It
   * holds a Label, a DateInput of DateSegments, and a Text with `slot="description"` and a
   * FieldError, as a TextField does.
   *
   * - `value` is the date as `YYYY-MM-DD`, or null until every segment is set. `value=(date)`
   *   starts its own, and `value=$bind(signal)` writes the caller's. `onChange` gets each change.
   * - The segments follow the order of the locale, such as month, day and year in `en-US`.
   * - A segment that is not set shows its placeholder. The arrow keys start it at
   *   `placeholderValue`, today by default.
   * - `minValue`, `maxValue` and `isDateUnavailable` make a date invalid, as `isInvalid` does.
   * - `name` posts the date with a form, from a hidden input. `isRequired` asks the browser to
   *   check it on a submit, and the FieldError shows the message. A reset of the form gives back
   *   the first date.
   * - It shows `data-disabled`, `data-readonly`, `data-invalid` and `data-required`.
   */
  const {
    as = 'div',
    name,
    minValue,
    maxValue,
    placeholderValue,
    isDateUnavailable,
    isDisabled = false,
    isReadOnly = false,
    isRequired = false,
    isInvalid = false,
    onChange,
    labelId: givenLabelId,
    children,
    ...rest
  } = $props<DateFieldProps<T>>();
  let { value = null } = $props<DateFieldProps<T>>();

  const locale = $getContext(LocaleContext);
  const form = $getContext(FormContext);
  const ownLabelId = $id();
  const labelId = $memo(givenLabelId ?? ownLabelId);
  const descriptionId = $id();
  const errorId = $id();
  const { present: hasDescription } = described(descriptionId);
  // The date that a segment starts at, in the range.
  const strings = $getContext(DateStringsContext);
  const placeholder = $memo(
    constrain(toDate(placeholderValue ?? todayString(locale.timeZone)), minValue, maxValue).toString(),
  );
  const inputId = $id();
  // The locale and the placeholders can change at run time, so the segments get them as memos.
  const language = $memo(locale.locale);
  const placeholders = $memo(strings?.placeholders);
  // The date that a reset of the form gives back.
  let initialValue = $signal(value);
  const { segments, date, step, jump, type, erase, settle, reset } = dateSegments(
    value,
    placeholder,
    language,
    placeholders,
    isDisabled,
    isReadOnly,
  );
  let edited = $signal(false);
  // A date out of range blocks a submit.
  const rangeMessage = $memo(
    value !== null && outOfRange(toDate(value), minValue, maxValue)
      ? 'The date is outside the allowed range.'
      : '',
  );
  const { committed, nativeErrors, invalidated, changed } = formField(inputId, () => {
    value = initialValue;
    // A setter that refuses leaves the old date, and the segments show that one.
    reset(value);
    edited = false;
  }, rangeMessage);
  const errors = $memo([
    ...(edited ? [] : messagesOf(name ? (form?.validationErrors[name] as string | string[]) : undefined)),
    ...(committed ? nativeErrors : []),
  ]);
  const invalid = $memo(
    isInvalid ||
      errors.length > 0 ||
      (value !== null &&
        (outOfRange(toDate(value), minValue, maxValue) || (isDateUnavailable?.(value) ?? false))),
  );

  // The field has a value once every segment is set.
  $effect(() => {
    const next = date;
    if (next !== $untrack(value)) {
      const before = $untrack(value);
      try {
        $untrack((value = next));
      } finally {
        // A setter that refuses or throws leaves the old date, and the segments show that one.
        if ($untrack(value) !== next) {
          reset($untrack(value));
        }
      }
      edited = true;
      changed();
      if ($untrack(value) !== before) {
        onChange?.($untrack(value));
      }
    }
  });

  $setContext(LabelContext, { id: labelId });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(FieldErrorContext, { id: errorId, isInvalid: invalid, errors });
  $setContext(DateFieldContext, {
    segments,
    labelId,
    describedBy: describedBy(hasDescription && descriptionId, invalid && errorId),
    isDisabled,
    isReadOnly,
    isRequired,
    isInvalid: invalid,
    direction: locale.direction,
    segmentNames: strings?.segmentNames,
    empty: strings?.empty,
    step,
    jump,
    type,
    erase,
    settle,
  });
</script>

<{as}
  data-disabled=(isDisabled || undefined)
  data-readonly=(isReadOnly || undefined)
  data-invalid=(invalid || undefined)
  data-required=(isRequired || undefined)
  {...rest}
>
  {children}
  <!-- The date for the form, which posts without scripts. -->
  <input
    id=inputId
    {name}
    value=(value ?? '')
    required=(isRequired || undefined)
    disabled=(isDisabled || undefined)
    tabindex="-1"
    aria-hidden="true"
    style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0"
    onInvalid=(prevent(invalidated))
  >
</>
