<script module>
  export interface SliderThumbProps {
    /** The position of the value in the list that this thumb moves, 0 by default. */
    index?: number;
    /** The name of the range input, posted with the form. */
    name?: string;
    /** Keeps this thumb still. */
    isDisabled?: boolean;
    /** The name of the thumb. The Label of the Slider names it too. */
    'aria-label'?: string;
    /** The content drawn on the thumb. */
    children?: unknown;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $getContext, $memo, $props, $signal } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import { LocaleContext } from './locale.ts';
  import { SliderContext, percentOf, pointAt, startDrag, thumbId, thumbRange, valueAt } from './slider.ts';

  /**
   * A thumb of a Slider. `index` is the value that it
   * moves, 0 by default. It holds an `<input type="range">` out of sight, which a screen reader
   * reads, the keys move, and a form sends with `name`, also before the code loads.
   *
   * - The arrow keys step it, PageUp and PageDown move a tenth of the range, and Home and End go to
   *   the ends of its range, which the thumbs next to it set.
   * - A drag moves it, from where the pointer took it, so it does not jump to the pointer.
   * - `isDisabled` keeps this thumb still, and a press on the track does not move it.
   * - It is placed with `left` at its value, `right` right to left, or `bottom` when vertical.
   * - It shows `data-dragging`, `data-focused`, `data-focus-visible` and `data-disabled`.
   */
  const {
    index = 0,
    name,
    isDisabled = false,
    'aria-label': label,
    children,
    ...rest
  } = $props<SliderThumbProps>();

  const slider = $getContext(SliderContext);
  const locale = $getContext(LocaleContext);
  let focused = $signal(false);
  let focusVisible = $signal(false);
  const value = $memo(slider?.values[index] ?? 0);
  const range = $memo(slider ? thumbRange(slider, index) : [0, 100]);
  const inputId = $memo(slider ? thumbId(slider, index) : undefined);
  const percent = $memo(slider ? percentOf(slider, value) * 100 : 0);
  const vertical = $memo(slider?.orientation === 'vertical');
  const rtl = $memo(locale.direction === 'rtl');
  const disabled = $memo(Boolean(slider?.isDisabled) || isDisabled);
  const dragging = $memo(Boolean(slider?.dragging.includes(index)));

  function input(event: Event) {
    if (disabled) {
      return;
    }
    slider?.setThumb(index, Number((event.currentTarget as HTMLInputElement).value));
  }

  function changed() {
    slider?.setDragging(index, false);
  }

  // PageUp and PageDown move by a page, which the range input does not know.
  function keyDown(event: KeyboardEvent) {
    if (!slider || disabled || (event.key !== 'PageUp' && event.key !== 'PageDown')) {
      return;
    }
    slider.setThumb(index, value + (event.key === 'PageUp' ? slider.pageSize : -slider.pageSize));
    slider.setDragging(index, false);
  }

  function pressed(event: PointerEvent) {
    if (!slider || disabled || event.button !== 0) {
      return;
    }
    const track = (event.currentTarget as Element).closest('[data-slider-track]');
    document.getElementById(thumbId(slider, index))?.focus({ preventScroll: true });
    if (!track) {
      return;
    }
    // The thumb keeps the distance to the pointer.
    const offset = pointAt(slider, track, event.clientX, event.clientY, rtl) - percentOf(slider, value);
    slider.setDragging(index, true);
    startDrag(
      event.pointerId,
      (move) => slider.setThumb(index, valueAt(slider, track, move.clientX, move.clientY, rtl, offset)),
      () => slider.setDragging(index, false),
      event.currentTarget as Element,
    );
  }

  function focusIn(event: FocusEvent) {
    focused = true;
    focusVisible = (event.target as Element).matches?.(':focus-visible') ?? false;
  }

  function focusOut() {
    focused = false;
    focusVisible = false;
  }
</script>

<!-- The attributes of the caller come last, so its class adds to the part's. -->
<div
  class={ thumb: true, vertical, rtl: rtl && !vertical }
  data-slider-thumb
  data-dragging=(dragging || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(disabled || undefined)
  onPointerDown=(prevent(pressed))
  onFocusIn=focusIn
  onFocusOut=focusOut
  {...rest}
>
  {children}
  <input
    id=inputId
    type="range"
    {name}
    min=(range[0])
    max=(range[1])
    step=(slider?.step)
    value=(String(value))
    disabled=(disabled || undefined)
    dir=(locale.direction)
    aria-label=label
    aria-labelledby=(slider ? (label ? `${inputId} ${slider.labelId}` : slider.labelId) : undefined)
    aria-orientation=(vertical ? 'vertical' : 'horizontal')
    aria-valuetext=(slider?.labels[index])
    class="input"
    onInput=input
    onChange=changed
    onKeyDown=(prevent(keyDown, 'PageUp', 'PageDown'))
  >
</div>

<style>
  /* The thumb sits at its value: from the start of the track, which is the right right to left,
     or from the bottom when vertical. */
  .thumb {
    --at: ${percent}%;
    position: absolute;
    left: var(--at);
    transform: translateX(-50%);
  }

  .thumb.rtl {
    left: auto;
    right: var(--at);
    transform: translateX(50%);
  }

  .thumb.vertical {
    left: auto;
    bottom: var(--at);
    transform: translateY(50%);
  }

  /* The range input is out of sight, and a screen reader and the keys still reach it. */
  .input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }
</style>
