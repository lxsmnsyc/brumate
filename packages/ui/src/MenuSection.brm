<script module>
  export interface MenuSectionProps {
    children?: unknown;
    'aria-label'?: string;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $id, $isPassed, $props, $setContext } from 'brumate/signals';
  import { SectionContext } from './collection.ts';

  /**
   * A group of the items of a Menu, as MenuSection of React Aria Components. A Header inside names
   * it. A section with no Header needs `aria-label`.
   */
  const { children, 'aria-label': label, ...rest } = $props<MenuSectionProps>();

  const headerId = $id();
  const named = $isPassed(label);

  $setContext(SectionContext, { headerId });
</script>

<section role="group" aria-label=label aria-labelledby=(named ? undefined : headerId) {...rest}>{children}</section>
