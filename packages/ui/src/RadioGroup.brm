<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';

  export interface RadioGroupOwnProps<T extends AsTarget = 'div'> {
    /** The name that the radios share. Without it, the group makes one. */
    name?: string;
    /** The direction of the radios, set as `aria-orientation`. */
    orientation?: 'horizontal' | 'vertical';
    /** Disables every radio of the group. */
    isDisabled?: boolean;
    /** Keeps the choice: the user cannot change it. */
    isReadOnly?: boolean;
    /** Asks for a choice when the form is sent. */
    isRequired?: boolean;
    /** Marks the group as invalid. */
    isInvalid?: boolean;
    /** Runs with the `value` of the radio that the user chose. */
    onChange?: (value: string) => void;
    /** The Label, Radios, Text and FieldError of the group. */
    children?: unknown;
    /** The `value` of the chosen radio, or `null` for no choice. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    value?: Bindable<string | null>;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of RadioGroup. `as` takes an element name or a component, and the other props are
   * those of the target.
   */
  export type RadioGroupProps<T extends AsTarget = 'div'> = AsProps<T, RadioGroupOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $id, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import { FieldErrorContext, LabelContext, RadioGroupContext, TextContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { describedBy, onFormReset } from './fields.ts';

  /**
   * A group of radios. It holds a Label, its Radios, a
   * Text with `slot="description"` and a FieldError. The radios are native, so the arrow keys
   * move between them and Tab stops at the checked one, as in every browser. The element shows
   * `data-orientation`, `data-disabled`, `data-readonly`, `data-invalid` and `data-required`.
   *
   * `value=(choice)` starts its own value, and `value=$bind(signal)` writes the caller's. `null`
   * is no choice.
   */
  const {
    as,
    name,
    orientation = 'vertical',
    isDisabled = false,
    isReadOnly = false,
    isRequired = false,
    isInvalid = false,
    onChange,
    children,
    ...rest
  } = $props<RadioGroupProps<T>>();
  let { value = null } = $props<RadioGroupOwnProps<T>>();
  let { ref } = $props<RadioGroupOwnProps<T>>();
  // The value that a reset of the form gives back.
  let initial = $signal(value);

  // The radios of a group share a name, which makes them one group for the browser.
  const ownName = $id();
  const labelId = $id();
  const descriptionId = $id();
  const { present: hasDescription } = described(descriptionId);
  const errorId = $id();
  let message = $signal('');
  const errors = $memo(message && value === null ? [message] : []);
  const invalid = $memo(isInvalid || errors.length > 0);

  function select(next: string) {
    const before = value;
    value = next;
    // The setter of a bound value may keep another choice, or none.
    if (value !== before) {
      onChange?.(value);
    }
  }

  function invalidated(text: string) {
    message = text;
  }

  // A reset of the form gives back the first choice. Each radio puts its native input back in step.
  $client(
    () =>
      onFormReset(ref, () => {
        value = initial;
        message = '';
      }),
    'load',
  );

  $setContext(LabelContext, { id: labelId });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(FieldErrorContext, { id: errorId, isInvalid: invalid, errors });
  $setContext(RadioGroupContext, {
    name: name ?? ownName,
    value,
    isDisabled,
    isReadOnly,
    isRequired,
    isInvalid: invalid,
    describedBy: describedBy(invalid && errorId),
    select,
    onInvalid: invalidated,
  });
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  role="radiogroup"
  aria-labelledby=labelId
  aria-describedby=(describedBy(hasDescription && descriptionId, invalid && errorId))
  aria-orientation=orientation
  aria-readonly=(isReadOnly ? 'true' : undefined)
  aria-invalid=(invalid ? 'true' : undefined)
  aria-required=(isRequired ? 'true' : undefined)
  aria-disabled=(isDisabled ? 'true' : undefined)
  data-orientation=orientation
  data-disabled=(isDisabled || undefined)
  data-readonly=(isReadOnly || undefined)
  data-invalid=(invalid || undefined)
  data-required=(isRequired || undefined)
  {...rest}
>{children}</>
