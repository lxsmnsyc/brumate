<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface RadioProps extends ElementProps<'label'> {
    /** The value of the radio. It names the radio in its group. */
    value: string;
    /** Disables the radio. A disabled group disables its radios too. */
    isDisabled?: boolean;
    /** The content of the label. Draw the circle here. */
    children?: unknown;
  }
</script>

<script>
  import { SelectionIndicatorContext } from './selection-indicator.ts';
  import { $client, $getContext, $id, $memo, $props, $setContext } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import VisuallyHidden from './VisuallyHidden.brm';
  import { box } from './box.brm.ts';
  import { RadioGroupContext } from './contexts.ts';
  import { isFirstInvalid, onFormReset } from './fields.ts';

  /**
   * A radio of a RadioGroup: a <label> around a native radio.
   * The label shows `data-selected`, `data-pressed`, `data-hovered`, `data-focused`,
   * `data-focus-visible`, `data-disabled`, `data-readonly`, `data-invalid` and `data-required`.
   */
  const { value, isDisabled, children, ...rest } = $props<RadioProps>();

  const group = $getContext(RadioGroupContext);
  const inputId = $id();
  const selected = $memo(group?.value === value);
  const disabled = $memo(Boolean(isDisabled || group?.isDisabled));
  const readOnly = $memo(Boolean(group?.isReadOnly));

  const {
    hovered,
    pressed,
    focused,
    focusVisible,
    onPointerEnter,
    onPointerLeave,
    onPointerDown,
    onPointerUp,
    onPointerCancel,
    onKeyDown,
    onKeyUp,
    onFocusIn,
    onFocusOut,
  } = box(disabled);

  // The click of a read-only box, which the wrapper prevents.
  function keep() {}

  // The group gives back the first choice on a reset of the form. The browser sets its own
  // default on the native radio, so this puts it back in step with the group.
  $client(() => {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    return onFormReset(
      input,
      undefined,
      () => {
        if (input) {
          input.checked = selected;
        }
      },
    );
  }, 'load');

  function change(event: Event & { currentTarget: HTMLInputElement }) {
    const input = event.currentTarget;
    if (!input.checked) {
      return;
    }
    // A read-only group keeps its choice. The browser checked this radio already.
    if (readOnly) {
      keepChoice(input);
      return;
    }
    try {
      group?.select(value);
    } finally {
      // A setter that refuses or throws leaves the old choice, so the inputs go back to it.
      if (!selected) {
        keepChoice(input);
      }
    }
  }

  /** Unchecks the radio that the browser checked, and checks the one that the group keeps. */
  function keepChoice(input: HTMLInputElement) {
    input.checked = false;
    const checked = input.form?.querySelector<HTMLInputElement>(
      `input[name="${CSS.escape(input.name)}"][value="${CSS.escape(group?.value ?? '')}"]`,
    );
    if (checked) {
      checked.checked = true;
    }
  }

  // The first invalid field of the form gets focus, as the browser does with its own message.
  function invalidated(event: Event & { currentTarget: HTMLInputElement }) {
    const input = event.currentTarget;
    group?.onInvalid(input.validationMessage);
    if (isFirstInvalid(input)) {
      input.focus();
    }
  }
  // A SelectionIndicator inside marks the item while it is selected.
  $setContext(SelectionIndicatorContext, { isSelected: selected });
</script>

<label
  data-selected=(selected || undefined)
  data-pressed=(pressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(disabled || undefined)
  data-readonly=(readOnly || undefined)
  data-invalid=(group?.isInvalid || undefined)
  data-required=(group?.isRequired || undefined)
  {onPointerEnter}
  {onPointerLeave}
  {onPointerDown}
  {onPointerUp}
  {onPointerCancel}
  {onKeyDown}
  {onKeyUp}
  {onFocusIn}
  {onFocusOut}
  {...rest}
>
  <!-- A read-only box prevents its click, so the browser never toggles it, and a screen reader
       announces no change. -->
  #if (readOnly) {
    <VisuallyHidden
      as="input"
      id=inputId
      type="radio"
      name=(group?.name)
      {value}
      checked=selected
      disabled=(disabled || undefined)
      required=(group?.isRequired || undefined)
      aria-describedby=(group?.describedBy)
      onChange=change
      onClick=(prevent(keep))
      onInvalid=(prevent(invalidated))
    />
  } #else {
    <VisuallyHidden
      as="input"
      id=inputId
      type="radio"
      name=(group?.name)
      {value}
      checked=selected
      disabled=(disabled || undefined)
      required=(group?.isRequired || undefined)
      aria-describedby=(group?.describedBy)
      onChange=change
      onInvalid=(prevent(invalidated))
    />
  }
  {children}
</label>
