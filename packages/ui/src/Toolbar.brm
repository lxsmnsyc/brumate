<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';

  export interface ToolbarOwnProps<T extends AsTarget = 'div'> {
    /** The direction of its items, which decides the arrow keys that move focus. */
    orientation?: 'horizontal' | 'vertical';
    /** The items of the toolbar, such as buttons. */
    children?: unknown;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of Toolbar. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type ToolbarProps<T extends AsTarget = 'div'> = AsProps<T, ToolbarOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $getContext, $props, $setContext } from 'brumate/signals';
  import { LocaleContext } from './locale.ts';
  import { ToolbarContext } from './contexts.ts';
  import { keepTabStop, moveFocus, preventEdges, rove } from './toolbar.ts';

  /**
   * A toolbar: role="toolbar", where the arrow keys move
   * focus between its items, Home and End go to the first and the last, and Tab stops at one
   * item. Right to left, the arrow keys of a horizontal toolbar turn around. It shows
   * `data-orientation`. Inside another toolbar, it is a group.
   */
  const { as, orientation = 'horizontal', children, ...rest } = $props<ToolbarProps<T>>();
  let { ref } = $props<ToolbarOwnProps<T>>();

  const locale = $getContext(LocaleContext);
  const nested = $getContext(ToolbarContext);
  $setContext(ToolbarContext, true);

  $client(() => {
    if (!ref) {
      return undefined;
    }
    const stops = [keepTabStop(ref), preventEdges(ref)];
    return () => {
      for (const stop of stops) {
        stop();
      }
    };
  }, 'load');

  function keyDown(event: KeyboardEvent) {
    moveFocus(event.currentTarget as Element, event.key, orientation, locale.direction);
  }

  function focusIn(event: FocusEvent) {
    const toolbar = event.currentTarget as Element;
    const target = document.activeElement;
    // Handlers run after the event, so focus can have moved on.
    if (target && toolbar.contains(target)) {
      rove(toolbar, target);
    }
  }

  // The keys that move focus keep their default for a field inside. preventEdges prevents Home and
  // End, and Up and Down of a vertical toolbar, unless a field has focus.
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  role=(nested ? 'group' : 'toolbar')
  aria-orientation=(nested ? undefined : orientation)
  data-orientation=orientation
  onKeyDown=keyDown
  onFocusIn=focusIn
  {...rest}
>{children}</>
