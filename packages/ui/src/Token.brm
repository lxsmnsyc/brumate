<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface TokenProps extends ElementProps<'span'> {
    /** The content of the token, such as its text. */
    children?: unknown;
  }
</script>

<script>
  import { $hasContext, $props, $store } from 'brumate/signals';
  import { TokenContext } from './token-field.ts';

  /**
   * A token of a TokenInput. The `token` template of a
   * TokenInput renders one for each token. It shows `data-selected` while the selection covers it,
   * and `data-disabled`.
   */
  const { children, ...rest } = $props<TokenProps>();

  const token = $hasContext(TokenContext) ? $store(TokenContext) : undefined;
</script>

<span data-token-part data-disabled=(token?.isDisabled || undefined) {...rest}>{children}</span>
