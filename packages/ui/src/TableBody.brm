<script module>
  import type { Key } from './collection.ts';

  export interface TableBodyProps<V extends { id: Key } = { id: Key }> {
    /** A template that renders a `Row` for each of the `items` of the Table. */
    item?: (item: V) => unknown;
    /** The `Row` elements. */
    children?: unknown;
    [attribute: string]: unknown;
  }
</script>

<script generics="V extends { id: Key }">
  import { $getContext, $props } from 'brumate/signals';
  import { TableContext } from './table.ts';

  /**
   * The rows of a Table: Row elements, written out or from
   * a `#for`. Or, when the Table has `items`, the `item` template renders a Row for each one, and
   * only the rows in view when the Table is windowed.
   */
  const { item, children, ...rest } = $props<TableBodyProps<V>>();

  // The cast to `V` is unchecked: `V` must be the type of the `items` of the Table.
  const table = $getContext(TableContext);
</script>

<tbody role="rowgroup" {...rest}>
  {children}
  #if (table?.items && item) {
    #if (table.windowHeight) {
      #for (entry of table.items by entry.id) window(table.windowHeight) {
        {item(entry as V)}
      }
    } #else {
      #for (entry of table.items by entry.id) {
        {item(entry as V)}
      }
    }
  }
</tbody>
