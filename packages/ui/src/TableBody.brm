<script>
  import { $getContext, $props } from 'brumate/signals';
  import { TableContext } from './table.ts';

  /**
   * The rows of a Table, as TableBody of React Aria Components: Row elements, written out or from
   * a `#for`. Or, when the Table has `items`, the `item` template renders a Row for each one, and
   * only the rows in view when the Table is windowed.
   */
  const { item, children, ...rest } = $props<{
    // oxlint-disable-next-line typescript/no-explicit-any -- The items of a Table are the caller's.
    item?: (item: any) => unknown;
    children?: unknown;
    [attribute: string]: unknown;
  }>();

  const table = $getContext(TableContext);
</script>

<tbody role="rowgroup" {...rest}>
  {children}
  #if (table?.items && item) {
    #if (table.windowHeight) {
      #for (entry of table.items by entry.id) window(table.windowHeight) {
        {item(entry)}
      }
    } #else {
      #for (entry of table.items by entry.id) {
        {item(entry)}
      }
    }
  }
</tbody>
