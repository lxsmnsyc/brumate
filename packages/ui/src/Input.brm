<script module>
  export interface InputProps {
    slot?: string | null;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $getContext, $handler, $memo, $props } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import { FieldInputContext, InputContext } from './contexts.ts';
  import { focusRing } from './focus.brm.ts';
  import { hover } from './hover.brm.ts';
  import { isFirstInvalid } from './fields.ts';
  import { contextAttributes, slotProps } from './slots.ts';

  /**
   * A text input, as Input of React Aria Components. A field gives it its attributes and value.
   * It shows `data-hovered`, `data-focused`, `data-focus-visible`, `data-disabled` and
   * `data-invalid`.
   */
  const { slot, ...rest } = $props<InputProps>();

  const context = $getContext(InputContext);
  // The attributes of a part around the field, such as an Autocomplete.
  const outer = $getContext(FieldInputContext);
  const outerAttributes = $memo(outer ?? {});
  const attributes = $memo(contextAttributes(slotProps(context, slot)));
  const disabled = $memo(Boolean(attributes.disabled ?? rest.disabled));
  const invalid = $memo(attributes['aria-invalid'] === 'true' || attributes['aria-invalid'] === true);
  // The keys whose default the field takes over, such as Enter in a search field.
  const enterPrevented = $memo(Boolean(slotProps(context, slot).isEnterPrevented));
  const escapePrevented = $memo(Boolean(slotProps(context, slot).isEscapePrevented));

  function given() {
    return slotProps(context, slot);
  }

  const { hovered, onPointerEnter, onPointerLeave } = hover(disabled, undefined, undefined, undefined);
  const { focused, focusVisible, onFocus, onBlur: ringBlur, onKeyDown: ringKeyDown, onPointerDown } =
    focusRing(undefined, undefined, undefined);

  function input(event: Event) {
    given().onChange?.((event.currentTarget as HTMLInputElement).value);
  }

  // The browser shows no message of its own. The field shows it in its FieldError.
  function invalidated(event: Event) {
    const field = event.currentTarget as HTMLInputElement;
    given().onInvalid?.(field.validationMessage, isFirstInvalid(field));
  }

  function keyDown(event: KeyboardEvent) {
    ringKeyDown(event);
    given().onKeyDown?.(event.key, event);
  }

  // The loader prevents these keys before the code loads, so the wrapper names them. The markup
  // passes the memos, so the spread follows them.
  function keys(enter: boolean, escape: boolean) {
    if (enter && escape) {
      return { onKeyDown: $handler(prevent(keyDown, 'Enter', 'Escape')) };
    }
    if (enter) {
      return { onKeyDown: $handler(prevent(keyDown, 'Enter')) };
    }
    return { onKeyDown: $handler(keyDown) };
  }

  function focus(event: FocusEvent) {
    onFocus(event);
    given().onFocus?.();
  }

  function blur(event: FocusEvent) {
    ringBlur(event);
    given().onBlur?.();
  }
</script>

<input
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(disabled || undefined)
  data-invalid=(invalid || undefined)
  {onPointerEnter}
  {onPointerLeave}
  {onPointerDown}
  onFocus=focus
  onBlur=blur
  {...keys(enterPrevented, escapePrevented)}
  onInput=input
  onInvalid=(prevent(invalidated))
  {...outerAttributes}
  {...attributes}
  {...rest}
>
