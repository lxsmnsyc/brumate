<script module>
  export interface NavigationTreeItemProps {
    /** The link of the item. Without it, the link part shows only the text. */
    href?: string;
    /** The text that typing matches, for an item whose content is more than text. */
    textValue?: string;
    /** Keeps the item from focus, and turns its link into a disabled one. */
    isDisabled?: boolean;
    /** Runs when the item is acted on. */
    onAction?: () => void;
    /** A chevron `Button` and a `NavigationTreeItemLink`. */
    children?: unknown;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $getContext, $memo, $props, $setContext } from 'brumate/signals';
  import { ListBoxContext } from './collection.ts';
  import { NavigationLinkContext, NavigationTreeContext } from './navigation-tree.ts';
  import { TreeRowContext } from './tree.ts';
  import TreeItem from './TreeItem.brm';

  /**
   * A row of a NavigationTree. It is a TreeItem
   * with an `href`, which its NavigationTreeItemLink links to.
   *
   * - A disabled item, by `isDisabled` or the `disabledKeys` of the tree, has a link that does not
   *   navigate or take focus.
   * - It shows `data-href`, `data-current` when `href` is the route of the tree, and
   *   `data-current-ancestor` while it is closed and holds the current item.
   */
  const { href, textValue, isDisabled, onAction, children, ...rest } = $props<NavigationTreeItemProps>();

  const tree = $getContext(NavigationTreeContext);
  const place = $getContext(TreeRowContext);
  const list = $getContext(ListBoxContext);
  const disabled = $memo(
    Boolean(isDisabled || (place && list?.disabledKeys.includes(place.row.key))),
  );
  const current = $memo(href !== undefined && href !== '' && tree?.selectedRoute === href);
  const ancestor = $memo(
    Boolean(place && !place.row.isExpanded && tree?.ancestors.includes(place.row.key)),
  );
  $setContext(NavigationLinkContext, { href, isCurrent: current, isDisabled: disabled });
</script>

<TreeItem
  {textValue}
  {isDisabled}
  {onAction}
  data-href=(href || undefined)
  data-current=(current || undefined)
  data-current-ancestor=(ancestor || undefined)
  {...rest}
>{children}</TreeItem>
