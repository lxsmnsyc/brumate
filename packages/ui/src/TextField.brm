<script module>
  import type { AsProps, AsTarget } from './as.ts';
  import type { Bindable } from 'brumate/signals';

  export interface TextFieldOwnProps {
    /** The name of the input, posted with the form. */
    name?: string;
    /** The `type` of the input, such as `email` or `password`. */
    type?: string;
    /** Disables the field and its input. */
    isDisabled?: boolean;
    /** Makes the input read only. The user can focus and select it, but not edit it. */
    isReadOnly?: boolean;
    /** Asks the browser to check that the input has a value when its form is sent. */
    isRequired?: boolean;
    /** Marks the field as invalid, and blocks its form in the native behavior. */
    isInvalid?: boolean;
    /** Returns a message, a list of messages, or `true` or nothing for a valid value. */
    validate?: (value: string) => string | string[] | true | null | undefined;
    /** `native` lets the browser check the field when its form is sent. `aria` shows the errors of `validate` at once and never blocks the form. A Form sets the default. */
    validationBehavior?: 'native' | 'aria';
    /** The `autocomplete` of the input. */
    autoComplete?: string;
    /** The least number of characters that the browser accepts. */
    minLength?: number;
    /** The most number of characters that the input takes. */
    maxLength?: number;
    /** A regular expression, as a string, that the text must match. */
    pattern?: string;
    /** The `inputmode` of the input, which picks the keyboard of a touch device. */
    inputMode?: string;
    /** The hint that the input shows while it is empty. */
    placeholder?: string;
    /** A field of createForm, such as `fields.email`. */
    field?: {
      id: string;
      name: string;
      attrs: object;
      errors?: string[];
      errorAttrs?: object;
    };
    /** Runs with the text each time the user edits it. */
    onChange?: (value: string) => void;
    /** Runs when the input loses focus. */
    onBlur?: () => void;
    /** The Label, Input or TextArea, Text and FieldError of the field. */
    children?: unknown;
    /** The text. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    value?: Bindable<string>;
  }

  /**
   * The props of TextField. `as` takes an element name or a component, and the other props are
   * those of the target.
   */
  export type TextFieldProps<T extends AsTarget = 'div'> = AsProps<T, TextFieldOwnProps>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $client, $effect, $getContext, $id, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import {
    FieldErrorContext,
    FormContext,
    InputContext,
    LabelContext,
    TextAreaContext,
    TextContext,
  } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { afterWrite, describedBy, firstErrors, messagesOf, onFormReset } from './fields.ts';

  /**
   * A text field. It holds a Label, an Input or a
   * TextArea, a Text with `slot="description"` and a FieldError, and gives each one its IDs and
   * state. The element shows `data-disabled`, `data-invalid`, `data-readonly` and
   * `data-required`.
   *
   * `value=(text)` starts its own value, and `value=$bind(signal)` writes the caller's.
   *
   * With `validationBehavior="native"`, the default, the browser checks the field when its form
   * is sent, and the FieldError shows its message. After that, the message follows what the user
   * types. `validate`, the errors of the server and `isInvalid` block the form too, from the first
   * value. With "aria", the field is never blocked, and `validate` shows its errors at once.
   *
   * It shows one source of errors at a time: those of `field`, then those of
   * the server, then those of `validate` in the aria behavior, then those of the browser.
   *
   * A reset of its form gives it back its first value.
   *
   * `field` takes a field of `createForm` from brumate/forms: its name, ID, value, errors and
   * handlers.
   */
  const {
    name,
    type = 'text',
    isDisabled = false,
    isReadOnly = false,
    isRequired = false,
    isInvalid,
    validate,
    validationBehavior,
    autoComplete,
    minLength,
    maxLength,
    pattern,
    inputMode,
    placeholder,
    field,
    onChange,
    onBlur,
    children,
    ...rest
  } = $props<TextFieldOwnProps>();
  // The props of the target of `as`, for the type of the component.
  const { as = 'div' } = $props<TextFieldProps<T>>();
  // A field of createForm gives the value that was posted, or its default value.
  let { value = ((field?.attrs as { value?: string } | undefined)?.value) ?? '' } = $props<TextFieldProps<T>>();
  // The value that a reset of the form gives back.
  let initial = $signal(value);

  const form = $getContext(FormContext);
  const behavior = $memo(validationBehavior ?? form?.validationBehavior ?? 'native');
  const inputId = $id();
  const labelId = $id();
  const descriptionId = $id();
  const { present: hasDescription } = described(descriptionId);
  const ownErrorId = $id();
  const id = $memo(field?.id ?? inputId);
  // The error of a field of createForm has the ID that the field names, and role="alert".
  const errorId = $memo(((field?.errorAttrs as { id?: string } | undefined)?.id) ?? ownErrorId);
  const errorAttributes = $memo({ ...(field?.errorAttrs ?? {}), id: errorId });
  const fieldName = $memo(name ?? field?.name);

  // The messages of the browser, once the field was checked on a submit.
  let committed = $signal(false);
  let nativeErrors = $signal<string[]>([]);
  // The errors of the server, until the user edits the field. New errors of the server, such as
  // those of a later reply, show again.
  let edited = $signal<unknown>(undefined);
  const serverErrors = $memo(
    form && edited === form.validationErrors
      ? []
      : messagesOf(
          (fieldName ? form?.validationErrors[fieldName] : undefined) as string | string[] | undefined,
        ),
  );
  const ariaErrors = $memo(behavior === 'aria' && validate ? messagesOf(validate(value)) : []);
  const errors = $memo(
    firstErrors(
      field?.errors ?? [],
      serverErrors,
      ariaErrors,
      behavior === 'native' && committed ? nativeErrors : [],
    ),
  );
  const invalid = $memo(Boolean(isInvalid) || errors.length > 0);

  function change(next: string) {
    const before = value;
    value = next;
    edited = form?.validationErrors ?? null;
    // The change handler gets the text that the caller keeps, and only when it changed.
    afterWrite(
      before,
      next,
      () => value,
      (kept) => onChange?.(kept),
    );
  }

  // The message that blocks the form in the native behavior: the errors
  // of the server and of `validate`, or a message of its own for `isInvalid`.
  function customMessage(text: string): string {
    const messages = [...serverErrors, ...(validate ? messagesOf(validate(text)) : [])];
    if (messages.length > 0) {
      return messages.join(' ');
    }
    return isInvalid ? 'Invalid value.' : '';
  }

  // The value blocks the form in the native behavior, from the first one
  // on each render. An effect runs only after a change, so the first one is set at load.
  $effect(() => {
    if (behavior === 'native') {
      (document.getElementById(id) as HTMLInputElement | null)?.setCustomValidity(
        customMessage(value),
      );
    }
  });

  // A reset of the form gives back the first value, as it does for a field of the browser.
  $client(() => {
    const element = document.getElementById(id) as HTMLInputElement | null;
    if (!element) {
      return undefined;
    }
    if (behavior === 'native') {
      element.setCustomValidity(customMessage(value));
    }
    return onFormReset(element, () => {
      value = initial;
      committed = false;
      nativeErrors = [];
    });
  }, 'load');

  function invalidated(message: string, first: boolean) {
    committed = true;
    nativeErrors = message ? [message] : [];
    if (first) {
      document.getElementById(id)?.focus();
    }
  }

  // After a submit, the message follows what the user types.
  function recheck() {
    const element = document.getElementById(id) as HTMLInputElement | null;
    if (!element) {
      return;
    }
    if (behavior === 'native') {
      element.setCustomValidity(customMessage(element.value));
    }
    if (committed) {
      nativeErrors = element.validity.valid ? [] : [element.validationMessage];
    }
  }

  function changed(next: string) {
    change(next);
    recheck();
  }

  function blurred() {
    recheck();
    onBlur?.();
  }

  const inputProps = $memo({
    ...(field?.attrs ?? {}),
    id,
    name: fieldName,
    type,
    value,
    disabled: isDisabled || undefined,
    readonly: isReadOnly || undefined,
    // The browser checks a required field only in the native behavior.
    required: (isRequired && behavior === 'native') || undefined,
    'aria-required': (isRequired && behavior === 'aria') || undefined,
    'aria-invalid': invalid ? 'true' : undefined,
    'aria-describedby': describedBy(hasDescription && descriptionId, invalid && errorId),
    autocomplete: autoComplete,
    minlength: minLength,
    maxlength: maxLength,
    pattern,
    inputmode: inputMode,
    placeholder,
  });

  $setContext(LabelContext, { id: labelId, for: id });
  $setContext(InputContext, {
    ...inputProps,
    onChange: changed,
    onInvalid: invalidated,
    onBlur: blurred,
  });
  $setContext(TextAreaContext, {
    ...inputProps,
    type: undefined,
    onChange: changed,
    onInvalid: invalidated,
    onBlur: blurred,
  });
  $setContext(TextContext, { slots: { description: { id: descriptionId } } });
  $setContext(FieldErrorContext, {
    id: errorId,
    isInvalid: invalid,
    errors,
    attributes: errorAttributes,
  });
</script>

<{as}
  data-disabled=(isDisabled || undefined)
  data-invalid=(invalid || undefined)
  data-readonly=(isReadOnly || undefined)
  data-required=(isRequired || undefined)
  {...rest}
>{children}</>
