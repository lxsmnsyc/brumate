<script>
  import { $getContext, $memo, $props } from 'brumate/signals';
  import { SliderContext, thumbId } from './slider.ts';

  /**
   * The values of a Slider in the format of the locale, as SliderOutput of React Aria Components,
   * such as `40` or `20 – 80`. It is an `<output>` for the thumbs, which does not announce each
   * change.
   */
  const { children, ...rest } = $props<{ children?: unknown; [attribute: string]: unknown }>();

  const slider = $getContext(SliderContext);
  const forIds = $memo(slider ? slider.values.map((_, index) => thumbId(slider, index)).join(' ') : undefined);
</script>

<output for=forIds aria-live="off" {...rest}>{slider?.label}</output>
