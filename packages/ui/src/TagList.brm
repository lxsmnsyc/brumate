<script module>
  import type { Bindable } from 'brumate/signals';
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Movement } from './collection.ts';

  export interface TagListOwnProps<T extends AsTarget = 'div'> {
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
    /** The `Tag` elements. */
    children?: unknown;
  }

  /**
   * The props of TagList. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type TagListProps<T extends AsTarget = 'div'> = AsProps<T, TagListOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $getContext, $props } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import {
    enabledItems,
    focusItem,
    focusedItem,
    keyOf,
    lastFocusedOf,
    moveFrom,
    setLastFocused,
  } from './collection.ts';
  import { LocaleContext } from './locale.ts';
  import { TagGroupContext } from './tags.ts';

  /**
   * The list of the tags of a TagGroup. It is a grid, and
   * each Tag is a row, so a screen reader can reach the Button that removes it.
   *
   * - Tab stops once, at the tag that had focus last, or else the first one.
   * - The arrow keys move to the next and the previous tag, Left and Right turning around right
   *   to left, and Home and End go to the ends.
   */
  const { as, children, ...rest } = $props<TagListProps<T>>();
  let { ref } = $props<TagListOwnProps<T>>();

  const group = $getContext(TagGroupContext);
  const locale = $getContext(LocaleContext);

  /** The movement of a key: Left and Right follow the direction, Up and Down do not. */
  function getMovement(key: string): Movement | undefined {
    const rtl = locale.direction === 'rtl';
    switch (key) {
      case 'ArrowDown':
        return 'next';
      case 'ArrowUp':
        return 'previous';
      case 'ArrowRight':
        return rtl ? 'previous' : 'next';
      case 'ArrowLeft':
        return rtl ? 'next' : 'previous';
      case 'Home':
        return 'first';
      case 'End':
        return 'last';
      default:
        return undefined;
    }
  }

  function keyDown(event: KeyboardEvent) {
    const element = ref as HTMLElement | undefined;
    const movement = getMovement(event.key);
    if (!element || !movement) {
      return;
    }
    const items = enabledItems(element, 'row');
    focusItem(moveFrom(element, items, focusedItem(element, 'row'), movement, false));
  }

  function focused(event: FocusEvent) {
    const element = ref as HTMLElement | undefined;
    // The list passes its focus on to a tag.
    if (element && event.target === element && document.activeElement === element) {
      const items = enabledItems(element, 'row');
      const last = lastFocusedOf(element);
      let lastItem: HTMLElement | undefined;
      for (const item of items) {
        if (last !== undefined && keyOf(item) === last) {
          lastItem = item;
          break;
        }
      }
      focusItem(lastItem ?? items[0]);
    }
  }

  function focusIn(event: FocusEvent) {
    const element = ref as HTMLElement | undefined;
    const item = (event.target as Element).closest?.('[role=row][data-key]');
    if (element && item && element.contains(item)) {
      // While a tag has focus, Tab leaves the list rather than stopping at it.
      element.tabIndex = -1;
      setLastFocused(element, keyOf(item)!);
    }
  }

  function focusOut(event: FocusEvent) {
    const element = ref as HTMLElement | undefined;
    if (element && !element.contains(event.relatedTarget as Node | null)) {
      element.tabIndex = 0;
    }
  }
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  role="grid"
  tabindex="0"
  data-collection
  aria-labelledby=(group?.labelId)
  aria-describedby=(group?.descriptionId)
  aria-multiselectable=(group?.selectionMode === 'multiple' ? 'true' : undefined)
  onFocus=focused
  onFocusIn=focusIn
  onFocusOut=focusOut
  onKeyDown=(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End'))
  {...rest}
>{children}</>
