<script module>
  import type { AsProps, AsTarget } from './as.ts';

  export interface CalendarHeadingOwnProps {
    /**
     * Shown in place of the months that the Calendar shows, such as `October 2026`. It renders
     * inside `aria-hidden="true"`, since the label of the Calendar comes from elsewhere.
     */
    children?: unknown;
  }

  /**
   * The props of CalendarHeading. `as` takes an element name or a component, and the other props
   * are those of the target.
   */
  export type CalendarHeadingProps<T extends AsTarget = 'h2'> = AsProps<T, CalendarHeadingOwnProps>;
</script>

<script generics="T extends AsTarget = 'h2'">
  import { $getContext, $props } from 'brumate/signals';
  import { CalendarContext, rangeLabel, toDate } from './calendar.ts';

  /**
   * The months that a Calendar shows, such as `October 2026`. It is hidden from screen readers,
   * which read the name of the Calendar.
   */
  const { as = 'h2', children, ...rest } = $props<CalendarHeadingProps<T>>();

  const calendar = $getContext(CalendarContext);
</script>

<{as} aria-hidden="true" {...rest}>{children ?? (calendar ? rangeLabel(toDate(calendar.start), toDate(calendar.end), calendar.locale, false) : '')}</>
