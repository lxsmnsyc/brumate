<script module>
  export interface ToastContentProps {
    children?: unknown;
    [attribute: string]: unknown;
  }
</script>

<script>
  import { $getContext, $props, $setContext } from 'brumate/signals';
  import { TextContext } from './contexts.ts';
  import { ToastContext } from './toast.ts';

  /**
   * The text of a Toast. It is an `alert`, so a screen
   * reader reads it when the toast shows. A Text with `slot="title"` names the toast, and one
   * with `slot="description"` describes it.
   */
  const { children, ...rest } = $props<ToastContentProps>();

  const toast = $getContext(ToastContext);

  $setContext(TextContext, {
    slots: {
      default: {},
      title: { id: toast?.titleId },
      description: { id: toast?.descriptionId },
    },
  });
</script>

<div role="alert" aria-atomic="true" {...rest}>{children}</div>
