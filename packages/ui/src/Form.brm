<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface FormProps extends ElementProps<'form'> {
    /** The default of its fields. With `aria`, the form has `novalidate`, so the browser never blocks it. */
    validationBehavior?: 'native' | 'aria';
    /** The errors of the server by the name of a field. A field shows them until the user edits it. */
    validationErrors?: Record<string, string | string[]>;
    /** Disables every field and button inside the form. */
    isDisabled?: boolean;
    /** The fields and buttons of the form. */
    children?: unknown;
  }
</script>

<script>
  import { $getContext, $memo, $props, $setContext, $store, $toStore } from 'brumate/signals';
  import { store } from 'brumate/store';
  import { DisabledContext, FormContext } from './contexts.ts';

  /**
   * A form. It tells its fields how to validate, and gives them
   * the errors of the server by their names, such as the errors of a reply. A field shows them
   * until the user edits it.
   *
   * With `validationBehavior="aria"`, the form has `novalidate`, so the browser never blocks it.
   * The fields show their errors themselves.
   *
   * With `isDisabled`, every field and button inside is disabled.
   */
  const { validationBehavior = 'native', validationErrors = {}, isDisabled = false, children, ...rest } = $props<FormProps>();

  const state = $memo({ validationBehavior, validationErrors });
  $setContext(FormContext, $toStore(state));
  const outer = $store($getContext(DisabledContext, store(false)));
  const disabled = $memo(isDisabled || outer);
  $setContext(DisabledContext, $toStore(disabled));
</script>

<form novalidate=(validationBehavior === 'aria' || undefined) data-disabled=(disabled || undefined) {...rest}>{children}</form>
