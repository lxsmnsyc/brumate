<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface FormProps extends ElementProps<'form'> {
    validationBehavior?: 'native' | 'aria';
    validationErrors?: Record<string, string | string[]>;
    children?: unknown;
  }
</script>

<script>
  import { $memo, $props, $setContext } from 'brumate/signals';
  import { FormContext } from './contexts.ts';

  /**
   * A form. It tells its fields how to validate, and gives them
   * the errors of the server by their names, such as the errors of a reply. A field shows them
   * until the user edits it.
   *
   * With `validationBehavior="aria"`, the form has `novalidate`, so the browser never blocks it.
   * The fields show their errors themselves.
   */
  const { validationBehavior = 'native', validationErrors = {}, children, ...rest } = $props<FormProps>();

  const state = $memo({ validationBehavior, validationErrors });
  $setContext(FormContext, state);
</script>

<form novalidate=(validationBehavior === 'aria' || undefined) {...rest}>{children}</form>
