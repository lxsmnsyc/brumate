<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { PressEvent } from './events.ts';

  export interface ToggleButtonOwnProps<T extends AsTarget = 'button'> {
    /** The key of the button in a ToggleButtonGroup. */
    id?: string;
    slot?: string | null;
    isDisabled?: boolean;
    onChange?: (selected: boolean) => void;
    onPress?: (event: PressEvent) => void;
    children?: unknown;
    isSelected?: Bindable<boolean>;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of ToggleButton. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type ToggleButtonProps<T extends AsTarget = 'button'> = AsProps<T, ToggleButtonOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'button'">
  import { SelectionIndicatorContext } from './selection-indicator.ts';
  import { $bind, $getContext, $memo, $props, $setContext } from 'brumate/signals';
  import Button from './Button.brm';
  import { ToggleButtonContext, ToggleGroupContext } from './contexts.ts';
  import { contextAttributes, slotProps } from './slots.ts';

  /**
   * A button that stays pressed, as ToggleButton of React Aria Components. It is a Button with
   * aria-pressed and `data-selected`.
   *
   * `isSelected` alone starts its own state as on, and `isSelected=$bind(signal)` writes the caller's.
   */
  const { as, id, slot, isDisabled, onChange, onPress, children, ...rest } = $props<ToggleButtonProps<T>>();
  let { isSelected = false } = $props<ToggleButtonOwnProps<T>>();
  let { ref } = $props<ToggleButtonOwnProps<T>>();

  const context = $getContext(ToggleButtonContext);
  const group = $getContext(ToggleGroupContext);
  const attributes = $memo(contextAttributes(slotProps(context, slot)));
  // A disabled group disables every button, as in React Aria, even one with isDisabled=(false).
  const disabled = $memo(
    Boolean(isDisabled || group?.isDisabled || slotProps(context, slot).isDisabled),
  );
  // In a group, the group keeps the selection.
  const selected = $memo(group && id !== undefined ? group.selectedKeys.includes(id) : isSelected);
  // The buttons of a group with one selection are radios.
  const radio = $memo(group?.selectionMode === 'single');

  // The ARIA of the button: a radio in a group with one selection, else a toggle. Attributes that
  // do not apply are left out, so they do not replace the role of a Button that is not native.
  function state(radio: boolean, on: boolean) {
    return radio ? { role: 'radio', 'aria-checked': String(on) } : { 'aria-pressed': String(on) };
  }

  function toggle(event: PressEvent) {
    const given = slotProps(context, slot);
    // The new state, before the write changes `selected`.
    const next = !selected;
    if (group && id !== undefined) {
      group.toggle(id);
    } else {
      isSelected = next;
    }
    given.onChange?.(next);
    onChange?.(next);
    given.onPress?.(event);
    onPress?.(event);
  }
  // A SelectionIndicator inside marks the item while it is selected.
  $setContext(SelectionIndicatorContext, { isSelected: selected });
</script>

<!-- The Button reads no ButtonContext, since this button has a context of its own. -->
<Button
  {as}
  ref=$bind(ref)
  slot=(null)
  isDisabled=disabled
  {...state(radio, selected)}
  data-selected=(selected || undefined)
  onPress=toggle
  {...attributes}
  {...rest}
>{children}</Button>
