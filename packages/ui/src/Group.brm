<script module>
  import type { AsProps, AsTarget } from './as.ts';
  import type { HoverEvent } from './events.ts';

  export interface GroupOwnProps {
    /** The role of the group, `group` by default. */
    role?: 'group' | 'region' | 'presentation';
    /** The slot of the context of a part that holds this one. */
    slot?: string | null;
    /** Disables the group, and sets `data-disabled`. */
    isDisabled?: boolean;
    /** Marks the group invalid, and sets `data-invalid`. */
    isInvalid?: boolean;
    /** Runs when a mouse or a pen moves over the group. */
    onHoverStart?: (event: HoverEvent) => void;
    /** Runs when a mouse or a pen leaves the group. */
    onHoverEnd?: (event: HoverEvent) => void;
    /** Runs when the group starts or stops being hovered. */
    onHoverChange?: (hovered: boolean) => void;
    /** The `aria-disabled` of the caller gives the state too. */
    'aria-disabled'?: unknown;
    /** The `aria-invalid` of the caller gives the state too. */
    'aria-invalid'?: unknown;
    /** The parts of the group. */
    children?: unknown;
  }

  /**
   * The props of Group. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type GroupProps<T extends AsTarget = 'div'> = AsProps<T, GroupOwnProps>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $getContext, $memo, $props, $signal } from 'brumate/signals';
  import { GroupContext } from './contexts.ts';
  import { hover } from './hover.brm.ts';
  import { isFocusVisible } from './interactions.ts';
  import { contextAttributes, slotProps } from './slots.ts';

  /**
   * Parts that belong together, such as an input and its buttons. It shows `data-hovered`,
   * `data-focus-within`, `data-focus-visible`, `data-disabled` and `data-invalid`.
   */
  const {
    role = 'group',
    slot,
    isDisabled,
    isInvalid,
    onHoverStart,
    onHoverEnd,
    onHoverChange,
    children,
    ...rest
  } = $props<GroupOwnProps>();
  // The props of the target of `as`, for the type of the component.
  const { as = 'div' } = $props<GroupProps<T>>();

  const context = $getContext(GroupContext);
  const attributes = $memo(contextAttributes(slotProps(context, slot)));
  // aria-disabled and aria-invalid of the caller give the state too.
  const disabled = $memo(
    Boolean(isDisabled ?? slotProps(context, slot).isDisabled ?? ariaTrue(rest['aria-disabled'])),
  );
  const invalid = $memo(
    Boolean(isInvalid ?? slotProps(context, slot).isInvalid ?? ariaTrue(rest['aria-invalid'])),
  );

  function ariaTrue(value: unknown): boolean | undefined {
    return value === undefined ? undefined : value !== false && value !== 'false';
  }

  const {
    hovered,
    onPointerEnter: hoverEnter,
    onPointerLeave: hoverLeave,
  } = hover(disabled, onHoverStart, onHoverEnd, onHoverChange);

  // Focus inside the group, from focusin and focusout, which bubble.
  let focusWithin = $signal(false);
  let focusVisible = $signal(false);

  function focusIn(event: FocusEvent) {
    const group = event.currentTarget as Element;
    const target = document.activeElement;
    // Handlers run after the event, so focus can have moved on.
    if (!target || !group.contains(target)) {
      return;
    }
    focusWithin = true;
    focusVisible = isFocusVisible(target);
  }

  function focusOut(event: FocusEvent) {
    const group = event.currentTarget as Element;
    if (document.activeElement && group.contains(document.activeElement)) {
      return;
    }
    focusWithin = false;
    focusVisible = false;
  }
</script>

<{as}
  {role}
  aria-disabled=(disabled ? 'true' : undefined)
  aria-invalid=(invalid ? 'true' : undefined)
  data-hovered=(hovered || undefined)
  data-focus-within=(focusWithin || undefined)
  data-focus-visible=(focusVisible || undefined)
  data-disabled=(disabled || undefined)
  data-invalid=(invalid || undefined)
  onPointerEnter=hoverEnter
  onPointerLeave=hoverLeave
  onFocusIn=focusIn
  onFocusOut=focusOut
  {...attributes}
  {...rest}
>{children}</>
