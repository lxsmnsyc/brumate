<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';

  export interface DisclosureOwnProps<T extends AsTarget = 'div'> {
    /** The key of the disclosure in a DisclosureGroup. */
    id?: string;
    /** Disables the trigger. */
    isDisabled?: boolean;
    /** Runs when it expands or collapses by itself. In a group, one that the group collapses does not run it. */
    onExpandedChange?: (expanded: boolean) => void;
    /** A `Button` with `slot="trigger"` and a `DisclosurePanel`. */
    children?: unknown;
    /** Whether it is expanded. Alone it starts expanded, and `$bind` writes your signal. */
    isExpanded?: Bindable<boolean>;
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
  }

  /**
   * The props of Disclosure. `as` takes an element name or a component, and the other props are
   * those of the target.
   */
  export type DisclosureProps<T extends AsTarget = 'div'> = AsProps<T, DisclosureOwnProps<T>>;
</script>

<script generics="T extends AsTarget = 'div'">
  import { $getContext, $id, $memo, $props, $setContext, $store, $toStore } from 'brumate/signals';
  import { ButtonContext, DisclosureGroupContext, DisclosurePanelContext } from './contexts.ts';
  import type { DisclosurePanelState } from './contexts.ts';

  /**
   * Content that the user expands and collapses, such as a section of an FAQ. It holds a Button
   * with `slot="trigger"`, often in a Heading, and a DisclosurePanel. The trigger gets
   * aria-expanded and aria-controls. The element shows `data-expanded` and `data-disabled`.
   *
   * `isExpanded` alone starts it open, and `isExpanded=$bind(signal)` writes the caller's. In a
   * DisclosureGroup, the group keeps the state, and `id` names the disclosure in it. Without
   * `id`, it takes an ID of its own, so it still joins the group.
   */
  const { as, id, isDisabled = false, onExpandedChange, children, ...rest } = $props<DisclosureProps<T>>();
  let { isExpanded = false } = $props<DisclosureOwnProps<T>>();
  let { ref } = $props<DisclosureOwnProps<T>>();

  const groupGiven = $getContext(DisclosureGroupContext, undefined);
  const group = groupGiven ? $store(groupGiven.state) : undefined;
  const triggerId = $id();
  const panelId = $id();
  const ownKey = $id();
  const key = $memo(id ?? ownKey);
  const expanded = $memo(group ? group.expandedKeys.includes(key) : isExpanded);
  const disabled = $memo(isDisabled || Boolean(group?.isDisabled));

  function setExpanded(next: boolean) {
    if (next === expanded) {
      return;
    }
    if (group) {
      groupGiven?.toggle!(key);
    } else {
      isExpanded = next;
    }
    onExpandedChange?.(next);
  }

  function toggle() {
    setExpanded(!expanded);
  }

  // Find in page opens a collapsed panel that holds what it found, unless it is disabled.
  function expand() {
    if (!disabled) {
      setExpanded(true);
    }
  }

  // A Button without a slot, such as one in the panel, gets nothing from the disclosure.
  const buttonState = $memo({
    slots: {
      default: {},
      trigger: {
        id: triggerId,
        'aria-expanded': expanded ? 'true' : 'false',
        'aria-controls': panelId,
        isDisabled: disabled,
      },
    },
  });
  $setContext(ButtonContext, {
    state: $toStore(buttonState),
    handlers: {
      slots: {
        trigger: {
          onPress: toggle,
        },
      },
    },
  });
  const panelState = $memo<DisclosurePanelState>({
    id: panelId,
    triggerId,
    isExpanded: expanded,
    isDisabled: disabled,
  });
  $setContext(DisclosurePanelContext, { state: $toStore(panelState), expand });
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  data-expanded=(expanded || undefined)
  data-disabled=(disabled || undefined)
  {...rest}
>{children}</>
