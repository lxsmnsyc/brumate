<script module>
  import type { Bindable } from 'brumate/signals';
  import type {
    Key,
    Movement,
    SelectionBehavior,
    SelectionMode,
    SelectionRequest,
  } from './collection.ts';
  import type { SortDescriptor, TableColumn } from './table.ts';

  export interface TableProps<V extends { id: Key } = { id: Key }> {
    selectionMode?: SelectionMode;
    selectionBehavior?: SelectionBehavior;
    disabledKeys?: Key[];
    disallowEmptySelection?: boolean;
    escapeKeyBehavior?: 'clearSelection' | 'none';
    onRowAction?: (key: Key) => void;
    onSelectionChange?: (keys: Key[]) => void;
    onSortChange?: (descriptor: SortDescriptor) => void;
    /**
     * The height of a row in pixels, which renders only the rows in view, as in a Virtualizer.
     * A Virtualizer around the table gives it too. It needs `items`.
     */
    rowHeight?: number;
    /**
     * The text that typeahead matches for an item, for the rows out of view of a windowed table.
     * The rows in view use their own `textValue` or text.
     */
    getTextValue?: (item: V) => string;
    /** The data of the rows, each with an `id`. The `item` template of the TableBody renders each. */
    items?: readonly V[];
    children?: unknown;
    selectedKeys?: Bindable<Key[]>;
    sortDescriptor?: Bindable<SortDescriptor | null>;
    [attribute: string]: unknown;
  }
</script>

<script generics="V extends { id: Key }">
  import { $client, $getContext, $id, $isPassed, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import {
    ListBoxContext,
    enabledItems,
    focusItem,
    isTyping,
    itemsOf,
    keyOf,
    keysIn,
    lastFocusedOf,
    moveFrom,
    nextSelection,
    rangeOf,
    sameKeys,
    setLastFocused,
    setRange,
    typeahead,
  } from './collection.ts';
  import { LocaleContext } from './locale.ts';
  import { tabbables } from './overlay.ts';
  import { VirtualizerContext } from './virtualizer.ts';
  import { enabledKeysOf, focusKeyIn, keyAfter, typeaheadWindowed } from './windowed.ts';
  import { TableContext, TableResizeContext, nextSort } from './table.ts';

  /**
   * A table of rows and columns that the user can move through, select and sort, as Table of
   * React Aria Components. It holds a TableHeader of Column elements and a TableBody of Row
   * elements, each with a Cell for each column, written out or from a `#for`. Or it takes `items`,
   * and its TableBody renders a Row for each with its `item` template.
   *
   * - With `items` and a `rowHeight`, or in a Virtualizer, it renders only the rows in view. Its
   *   keys then read the data of all the items, so Home, End, the page keys, Ctrl+A, the box in
   *   the header, ranges with Shift and letters reach rows that are out of view, and a move to
   *   one scrolls it into view first. Letters match the text of the rows in view, and
   *   `getTextValue` gives the text of the others.
   * - Tab stops once, at the row or cell that had focus last, and Tab from inside leaves it.
   * - Up and Down move between rows, and from a cell to the cell of its column in the next row.
   *   Up from the first row goes to the column headers.
   * - Right from a row goes to its first cell, and along its cells, then back to the row. Left
   *   goes the other way. Right to left, they turn around. On the column headers, they move
   *   between columns, round the ends.
   * - Home and End go to the first and the last row, or the first and the last cell of a row.
   *   With Ctrl or Cmd, they go to the first cell of the first row, or the last of the last.
   * - Page Up and Page Down move by a page of rows.
   * - Selection is as in a GridList, on the rows. A Checkbox with `slot="selection"` in a Column
   *   selects all the rows, and one in a Cell selects its row.
   * - `sortDescriptor` is the column and direction of the sort. A press of a Column with
   *   `allowsSorting`, or Enter on it, sorts by it, and `onSortChange` hears of it.
   * - Enter acts on a row with `onRowAction`, and a press does when nothing is selectable.
   */
  const {
    selectionMode = 'none',
    selectionBehavior = 'toggle',
    disabledKeys = [],
    disallowEmptySelection = false,
    escapeKeyBehavior = 'clearSelection',
    onRowAction,
    onSelectionChange,
    onSortChange,
    rowHeight,
    getTextValue,
    items,
    children,
    ...rest
  } = $props<TableProps<V>>();
  let { selectedKeys = [] } = $props<TableProps<V>>();
  let { sortDescriptor = null } = $props<TableProps<V>>();

  const locale = $getContext(LocaleContext);
  const virtualizer = $getContext(VirtualizerContext);
  // Only a table with its items as data can window, since the rows are then made from the data.
  const windowHeight = $memo(items ? (rowHeight ?? virtualizer?.rowHeight) : undefined);
  const sizes = $getContext(TableResizeContext);
  // In a ResizableTableContainer, the table lays out its columns by their widths, and is as wide
  // as they are once a resize gives them all widths.
  const resizedWidth = $memo(
    sizes ? Object.values(sizes.widths).reduce((sum, width) => sum + width, 0) : 0,
  );
  const tableWidth = $memo(resizedWidth > 0 ? `${resizedWidth}px` : '100%');
  const hasAction = $isPassed(onRowAction);
  const tableId = $id();
  let root = $signal<HTMLElement>();
  // The keys of the rows that can be selected, which the browser counts when the page loads and
  // when the rows change. The box in the header is checked when all of them are selected, and
  // mixed when some are. The header renders before the rows, so the server cannot count them.
  let selectable = $signal<Key[]>([]);
  // The columns, which each Column adds as it renders.
  const columns: TableColumn[] = [];

  function rows(): HTMLElement[] {
    const element = root;
    return element ? itemsOf(element, 'row').filter((row) => row.closest('tbody')) : [];
  }

  /** The keys of the items, in order. */
  function order(): Key[] {
    return (items ?? []).map((one) => one.id);
  }

  /** The keys of the rows that can take focus. A windowed table reads its data, not the page. */
  function enabledKeys(element: HTMLElement): Key[] {
    return windowHeight
      ? enabledKeysOf(element, 'row', order(), disabledKeys)
      : rows()
          .filter((row) => row.getAttribute('aria-disabled') !== 'true')
          .map((row) => keyOf(row)!);
  }

  function setSelection(next: Key[]) {
    if (!sameKeys(next, selectedKeys)) {
      selectedKeys = next;
      onSelectionChange?.(next);
    }
  }

  function select(key: Key, request: SelectionRequest) {
    const element = root;
    const range = element ? rangeOf(element) : undefined;
    const shift = Boolean(element && request.shift && range);
    setSelection(
      nextSelection(selectedKeys, key, {
        mode: selectionMode,
        behavior: selectionBehavior,
        disallowEmpty: disallowEmptySelection,
        request: { ...request, shift },
        range: shift ? keysIn(enabledKeys(element!), range!.anchor, key) : undefined,
        previousRange: shift ? keysIn(enabledKeys(element!), range!.anchor, range!.end) : undefined,
        disabled: disabledKeys,
      }),
    );
    if (element) {
      setRange(element, shift ? range!.anchor : key, key);
    }
  }

  function action(key: Key) {
    onRowAction?.(key);
  }

  function selectableKeys(): Key[] {
    const element = root;
    return element ? enabledKeys(element) : [];
  }

  function count() {
    const keys = selectableKeys();
    if (!sameKeys(keys, selectable)) {
      selectable = keys;
    }
  }

  $client(() => {
    count();
    const observer = new MutationObserver(count);
    observer.observe(root!, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['aria-disabled'],
    });
    return () => observer.disconnect();
  }, 'idle');

  function toggleAll() {
    if (selectionMode !== 'multiple') {
      return;
    }
    const all = selectableKeys();
    if (all.every((key) => selectedKeys.includes(key))) {
      // A table that needs a selection keeps it.
      if (!disallowEmptySelection) {
        setSelection([]);
      }
    } else {
      setSelection(all);
    }
  }

  function sort(column: Key) {
    const next = nextSort(sortDescriptor, column);
    sortDescriptor = next;
    onSortChange?.(next);
  }

  const selectAll = $memo({
    all: selectable.length > 0 && selectable.every((key) => selectedKeys.includes(key)),
    some: selectedKeys.length > 0,
  });

  // The rows read the selection from the state of a ListBox, as the rows of a GridList do.
  $setContext(ListBoxContext, {
    selectionMode,
    selectionBehavior,
    selectedKeys,
    disabledKeys,
    select,
    action,
    hasAction,
  });
  $setContext(TableContext, {
    columns,
    sortDescriptor,
    sort,
    selectAll,
    toggleAll,
    items,
    windowHeight,
  });

  /** The row, cell or column header of the table that holds an element. */
  function itemOf(target: EventTarget | null) {
    const element = root;
    const item = (target as Element | null)?.closest?.(
      '[role=row][data-key], [role=gridcell], [role=rowheader], [role=columnheader]',
    ) as HTMLElement | null;
    return item && element?.contains(item) && item.closest('[data-collection]') === element
      ? item
      : undefined;
  }

  function cellsOf(row: HTMLElement): HTMLElement[] {
    return [...row.children].filter((cell) =>
      /^(gridcell|rowheader|columnheader)$/.test(cell.getAttribute('role') ?? ''),
    ) as HTMLElement[];
  }

  function headers(): HTMLElement[] {
    const element = root;
    return element
      ? [...element.querySelectorAll<HTMLElement>('thead [role=columnheader]')]
      : [];
  }

  /** The elements in a cell or a column header that take focus, such as a ColumnResizer. */
  function controlsOf(item: HTMLElement): HTMLElement[] {
    return [
      ...item.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]',
      ),
    ];
  }

  /**
   * The places in a cell or a column header that take focus, in order. A column header that sorts
   * or resizes is the first, so Enter and Space reach it before its controls.
   */
  function stopsOf(item: HTMLElement): HTMLElement[] {
    const controls = controlsOf(item);
    const own =
      item.getAttribute('role') === 'columnheader' &&
      (item.hasAttribute('data-allows-sorting') || item.querySelector('[data-resizable-direction]'));
    return own ? [item, ...controls] : controls;
  }

  /**
   * Focuses a row, or a cell or a column header, or its first stop, or its last one when the
   * focus comes from after it, as React Aria focuses a cell's children.
   */
  function focusOn(item: HTMLElement | undefined, fromAfter = false) {
    if (!item) {
      return;
    }
    if (item.getAttribute('role') === 'row') {
      focusItem(item);
      return;
    }
    const stops = stopsOf(item);
    focusItem((fromAfter ? stops.at(-1) : stops[0]) ?? item);
  }

  function focused(event: FocusEvent) {
    const element = root;
    // The table passes its focus on to the row or cell that had it last, or to a row.
    if (element && event.target === element && document.activeElement === element) {
      const rendered = enabledItems(element, 'row').filter((row) => row.closest('tbody'));
      const last = lastFocusedOf(element);
      const lastCell = element.querySelector<HTMLElement>('[data-last-focused]');
      focusOn(
        lastCell ??
          rendered.find((row) => last !== undefined && keyOf(row) === last) ??
          rendered.find((row) => row.getAttribute('aria-selected') === 'true') ??
          rendered[0] ??
          headers()[0],
      );
    }
  }

  function focusIn(event: FocusEvent) {
    const element = root;
    const item = itemOf(event.target);
    if (!element || !item) {
      return;
    }
    // While an item has focus, Tab leaves the table rather than stopping at it.
    element.tabIndex = -1;
    element.querySelector('[data-last-focused]')?.removeAttribute('data-last-focused');
    const row = item.closest<HTMLElement>('[role=row][data-key]');
    if (row) {
      setLastFocused(element, keyOf(row)!);
    }
    if (item !== row) {
      item.setAttribute('data-last-focused', '');
    }
  }

  function focusOut(event: FocusEvent) {
    const element = root;
    if (element && !element.contains(event.relatedTarget as Node | null)) {
      element.tabIndex = 0;
    }
  }

  function keyDown(event: KeyboardEvent) {
    const element = root;
    const target = event.target as HTMLElement;
    const item = itemOf(target);
    // A ColumnResizer that resizes keeps the keys.
    if (!element || !item || target.closest('[data-resizing]')) {
      return;
    }
    // A field in a cell keeps its own keys, other than Up, Down and Tab.
    const typing =
      !item.contains(target) || target === item
        ? false
        : /^(TEXTAREA|SELECT)$/.test(target.tagName) ||
          (target instanceof HTMLInputElement &&
            !/^(checkbox|radio|button|submit|reset|range)$/.test(target.type));
    if (event.key === 'Tab') {
      // Tab leaves the table: the browser moves on from its last control, or back from it.
      const all = tabbables(element);
      if (event.shiftKey) {
        element.focus({ preventScroll: true });
      } else if (all.length > 0) {
        all.at(-1)!.focus({ preventScroll: true });
      }
      return;
    }
    const role = item.getAttribute('role');
    const isHeader = role === 'columnheader';
    const isRow = role === 'row';
    const row = isHeader ? undefined : item.closest<HTMLElement>('[role=row][data-key]')!;
    const bodyRows = enabledItems(element, 'row').filter((one) => one.closest('tbody'));
    const rowAt = row ? bodyRows.indexOf(row) : -1;
    const column = isRow ? -1 : isHeader ? headers().indexOf(item) : cellsOf(row!).indexOf(item);
    const rtl = locale.direction === 'rtl';
    const key = row ? keyOf(row) : undefined;
    const replace = selectionBehavior === 'replace';
    const toggle = event.ctrlKey || event.metaKey;
    const global = toggle;
    let next: HTMLElement | undefined;
    let moved = false;
    // A windowed table reaches rows by their keys, since most have no element. `reach` is the
    // key of the row, and `pick` the element of it to focus: the row, or its cell of the column.
    let reach: Key | undefined;
    let pick: (target: HTMLElement) => HTMLElement | undefined = (target) =>
      isRow ? target : cellsOf(target)[column];
    const enabled = windowHeight ? enabledKeys(element) : [];
    const keyFrom = (movement: Movement) =>
      keyAfter(element, 'row', order(), enabled, key ?? enabled[0]!, movement, windowHeight!);
    if (event.key === 'ArrowDown') {
      moved = true;
      if (windowHeight) {
        reach = isHeader ? enabled[0] : keyFrom('next');
      } else if (isHeader) {
        next = bodyRows[0] && cellsOf(bodyRows[0])[column];
      } else {
        const below = bodyRows[rowAt + 1];
        next = below && (isRow ? below : cellsOf(below)[column]);
      }
    } else if (event.key === 'ArrowUp') {
      moved = true;
      if (windowHeight) {
        reach = isHeader ? undefined : keyFrom('previous');
        // Up from the first row goes to the column headers.
        if (!isHeader && reach === key) {
          reach = undefined;
          next = headers()[isRow ? 0 : column];
        }
      } else if (!isHeader) {
        const above = bodyRows[rowAt - 1];
        next = above
          ? isRow
            ? above
            : cellsOf(above)[column]
          : headers()[isRow ? 0 : column];
      }
    } else if (!typing && (event.key === 'ArrowRight' || event.key === 'ArrowLeft')) {
      moved = true;
      const forward = (event.key === 'ArrowRight') !== rtl;
      // From a stop in a cell or a header: to the next stop in it, then on.
      if (!isRow) {
        const stops = stopsOf(item);
        const at = stops.indexOf(target);
        const stop = at === -1 ? undefined : stops[at + (forward ? 1 : -1)];
        if (stop) {
          focusItem(stop);
          return;
        }
      }
      if (isHeader) {
        const all = headers();
        next = all[(column + (forward ? 1 : -1) + all.length) % all.length];
      } else if (isRow) {
        const cells = cellsOf(row!);
        next = forward ? cells[0] : cells.at(-1);
      } else {
        next = cellsOf(row!)[column + (forward ? 1 : -1)] ?? row;
      }
    } else if (event.key === 'PageDown' || event.key === 'PageUp') {
      moved = true;
      if (windowHeight) {
        reach = isHeader
          ? event.key === 'PageDown'
            ? enabled[0]
            : undefined
          : keyFrom(event.key === 'PageDown' ? 'pageDown' : 'pageUp');
      } else if (isHeader) {
        next = event.key === 'PageDown' && bodyRows[0] ? cellsOf(bodyRows[0])[column] : undefined;
      } else {
        const page = moveFrom(
          element,
          bodyRows,
          row,
          event.key === 'PageDown' ? 'pageDown' : 'pageUp',
          false,
        );
        next = page && (isRow ? page : cellsOf(page)[column]);
      }
    } else if (!typing && (event.key === 'Home' || event.key === 'End')) {
      moved = true;
      const first = event.key === 'Home';
      if (isHeader) {
        const all = headers();
        next = first ? all[0] : all.at(-1);
      } else if (windowHeight && (isRow || global)) {
        reach = keyFrom(first ? 'first' : 'last');
        pick = (target) =>
          isRow ? target : first ? cellsOf(target)[0] : cellsOf(target).at(-1);
      } else if (isRow || global) {
        const edge = first ? bodyRows[0] : bodyRows.at(-1);
        next = edge && (isRow ? edge : first ? cellsOf(edge)[0] : cellsOf(edge).at(-1));
      } else {
        const cells = cellsOf(row!);
        next = first ? cells[0] : cells.at(-1);
      }
    }
    if (moved) {
      // Arrow keys are prevented by the markup. The other keys do not scroll the page.
      if (!event.key.startsWith('Arrow')) {
        event.preventDefault();
      }
      // Shift extends a range from the row that has focus, when no press started one.
      if (event.shiftKey && selectionMode === 'multiple' && key !== undefined && !rangeOf(element)) {
        setRange(element, key);
      }
      const back = event.key === 'ArrowLeft' ? !rtl : event.key === 'ArrowRight' ? rtl : false;
      let nextKey: Key | undefined;
      if (reach !== undefined) {
        // Staying on the row, at the first or the last of the rows, is no move.
        nextKey = reach === key ? undefined : reach;
        focusKeyIn(element, 'row', order(), reach, windowHeight, (target) =>
          focusOn(target && pick(target), back),
        );
      } else {
        focusOn(next, back);
        const nextRow = next?.closest<HTMLElement>('[role=row][data-key]');
        nextKey = nextRow && !next?.closest('thead') ? keyOf(nextRow) : undefined;
      }
      if (
        nextKey === undefined ||
        nextKey === key ||
        selectionMode === 'none' ||
        !/^(ArrowUp|ArrowDown|Home|End)$/.test(event.key)
      ) {
        return;
      }
      if (event.shiftKey && selectionMode === 'multiple') {
        select(nextKey, { shift: true, toggle: false });
      } else if (replace && !toggle) {
        select(nextKey, { shift: false, toggle: false });
      }
      return;
    }
    if (typing || (target !== item && !isRow)) {
      return;
    }
    if (isHeader) {
      const id = item.getAttribute('data-key');
      if ((event.key === 'Enter' || event.key === ' ') && item.hasAttribute('data-allows-sorting') && id) {
        event.preventDefault();
        sort(JSON.parse(id) as Key);
      }
      return;
    }
    if (event.key === ' ' && !isTyping(element)) {
      event.preventDefault();
      if (key !== undefined) {
        select(key, { shift: event.shiftKey, toggle: !replace || toggle });
      }
      return;
    }
    if (event.key === 'Enter' && key !== undefined) {
      event.preventDefault();
      if (hasAction) {
        action(key);
      } else {
        select(key, { shift: false, toggle: !replace });
      }
      return;
    }
    if ((event.key === 'a' || event.key === 'A') && toggle && selectionMode === 'multiple') {
      event.preventDefault();
      setSelection(selectableKeys());
      window.getSelection()?.removeAllRanges();
      return;
    }
    if (event.key === 'Escape') {
      if (
        escapeKeyBehavior === 'clearSelection' &&
        !disallowEmptySelection &&
        selectedKeys.length > 0
      ) {
        setSelection([]);
      }
      return;
    }
    if (isRow) {
      if (windowHeight) {
        const found = typeaheadWindowed(
          element,
          'row',
          (items ?? []).map((one) => ({ key: one.id, item: one })),
          enabledKeys(element),
          key,
          event,
          getTextValue,
        );
        if (found !== undefined) {
          focusKeyIn(element, 'row', order(), found, windowHeight, focusOn);
        }
      } else {
        focusOn(typeahead(element, bodyRows, row, event));
      }
    }
  }
</script>

<table
  ref=$bind(root)
  id=tableId
  role="grid"
  tabindex="0"
  data-collection
  data-resizable=(sizes ? '' : undefined)
  aria-multiselectable=(selectionMode === 'multiple' ? 'true' : undefined)
  onFocus=focused
  onFocusIn=focusIn
  onFocusOut=focusOut
  onKeyDown=(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Mod+ArrowUp', 'Mod+ArrowDown', 'Mod+PageUp', 'Mod+PageDown'))
  {...rest}
>{children}</table>

<style>
  table[data-resizable] {
    table-layout: fixed;
    width: ${tableWidth};
  }
</style>
