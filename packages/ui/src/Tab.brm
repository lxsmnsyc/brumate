<script>
  import { SelectionIndicatorContext } from './selection-indicator.ts';
  import { $getContext, $memo, $props, $setContext } from 'brumate/signals';
  import { keyAttribute } from './collection.ts';
  import type { Key } from './collection.ts';
  import { interact } from './interact.brm.ts';
  import { TabsContext, selectedOf, tabId } from './tabs.ts';

  /**
   * A tab of a TabList, as Tab of React Aria Components. `id` is its key, and the TabPanel with the
   * same `id` is its panel.
   *
   * - A press selects it, and so do Enter and Space.
   * - It shows `data-selected`, `data-disabled`, `data-pressed`, `data-hovered`, `data-focused` and
   *   `data-focus-visible`.
   */
  const {
    id,
    isDisabled = false,
    children,
    ...rest
  } = $props<{ id: Key; isDisabled?: boolean; children?: unknown; [attribute: string]: unknown }>();

  const tabs = $getContext(TabsContext);
  // The first tab is the one that is selected when Tabs hold no key.
  if (tabs && tabs.registry.first === undefined && !isDisabled && !tabs.disabledKeys.includes(id)) {
    tabs.registry.first = id;
  }
  const selected = $memo(Boolean(tabs) && selectedOf(tabs!) === id);
  const disabled = $memo(
    isDisabled || Boolean(tabs?.isDisabled) || Boolean(tabs?.disabledKeys.includes(id)),
  );

  function pressed() {
    tabs?.select(id);
  }

  // A press, Enter and Space select the tab, as a button does.
  const {
    pressed: isPressed,
    hovered,
    focused,
    focusVisible,
    onPointerDown,
    onPointerMove,
    onPointerUp,
    onPointerCancel,
    onPointerEnter,
    onPointerLeave,
    onKeyDown,
    onKeyUp,
    onClick,
    onFocus,
    onBlur,
  } = interact(
    disabled,
    disabled,
    pressed,
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
    () => {},
  );
  // A SelectionIndicator inside marks the item while it is selected.
  $setContext(SelectionIndicatorContext, { isSelected: selected });
</script>

<div
  id=(tabs ? tabId(tabs, id, 'tab') : undefined)
  role="tab"
  data-key=(keyAttribute(id))
  tabindex=(selected ? '0' : '-1')
  aria-selected=(selected ? 'true' : 'false')
  aria-controls=(tabs && selected ? tabId(tabs, id, 'panel') : undefined)
  aria-disabled=(disabled ? 'true' : undefined)
  data-selected=(selected || undefined)
  data-disabled=(disabled || undefined)
  data-pressed=(isPressed || undefined)
  data-hovered=(hovered || undefined)
  data-focused=(focused || undefined)
  data-focus-visible=(focusVisible || undefined)
  onPointerDown=onPointerDown
  onPointerMove=onPointerMove
  onPointerUp=onPointerUp
  onPointerCancel=onPointerCancel
  onPointerEnter=onPointerEnter
  onPointerLeave=onPointerLeave
  onKeyDown=onKeyDown
  onKeyUp=onKeyUp
  onClick=onClick
  onFocus=onFocus
  onBlur=onBlur
  {...rest}
>{children}</div>
