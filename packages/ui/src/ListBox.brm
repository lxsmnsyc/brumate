<script module>
  import type { AsProps, AsTarget, TargetElement } from './as.ts';
  import type { Bindable } from 'brumate/signals';
  import type { Key, SelectionBehavior, SelectionMode, SelectionRequest } from './collection.ts';

  export interface ListBoxOwnProps<V extends { id: Key } = { id: Key }, T extends AsTarget = 'div'> {
    /** The element, bound with `ref=$bind(signal)`. */
    ref?: Bindable<TargetElement<T> | undefined>;
    /** How many items can be selected: `none`, `single` or `multiple`. */
    selectionMode?: SelectionMode;
    /** `toggle` adds and removes items as checkboxes do. `replace` makes the pressed item the selection. */
    selectionBehavior?: SelectionBehavior;
    /** The keys of the items that cannot take focus or selection. */
    disabledKeys?: Key[];
    /** Keeps one item selected. */
    disallowEmptySelection?: boolean;
    /** Moves focus from the last item to the first, and back. */
    shouldFocusWrap?: boolean;
    /** What Escape does: `clearSelection` clears the selection, and `none` does nothing. */
    escapeKeyBehavior?: 'clearSelection' | 'none';
    /** The axis of the list: `vertical` uses Up and Down, and `horizontal` uses Left and Right. */
    orientation?: 'vertical' | 'horizontal';
    /** Runs with the key of an item that a press or Enter acts on. */
    onAction?: (key: Key) => void;
    /** Runs with the keys of the selected items after each change. */
    onSelectionChange?: (keys: Key[]) => void;
    /**
     * The height of an option in pixels, which renders only the options in view, as in a
     * Virtualizer. A Virtualizer around the list gives it too. It needs `items`.
     */
    rowHeight?: number;
    /**
     * The text that typeahead matches for an item, for the options out of view of a windowed list.
     * The options in view use their own `textValue` or text.
     */
    getTextValue?: (item: V) => string;
    /** The data of the options, each with an `id`. The `item` template renders each one. */
    items?: readonly V[];
    /** A template that renders a `ListBoxItem` for each of `items`. */
    item?: (item: V) => unknown;
    /** The `ListBoxItem` and `ListBoxSection` elements. */
    children?: unknown;
    /** The keys of the selected items. Starts its own state, or binds with `$bind`. */
    selectedKeys?: Bindable<Key[]>;
  }

  /**
   * The props of ListBox. `as` takes an element name or a component, and the other props are those
   * of the target.
   */
  export type ListBoxProps<V extends { id: Key } = { id: Key }, T extends AsTarget = 'div'> = AsProps<
    T,
    ListBoxOwnProps<V, T>
  >;
</script>

<script generics="V extends { id: Key }, T extends AsTarget = 'div'">
  import {
    $client,
    $effect,
    $getContext,
    $handler,
    $id,
    $isPassed,
    $memo,
    $props,
    $setContext,
    $signal,
    $untrack,
  } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import {
    CollectionFocusContext,
    ListBoxContext,
    ListBoxGivenContext,
    enabledItems,
    filterItems,
    focusItem,
    focusedItem,
    isTyping,
    keyOf,
    keysBetween,
    keysIn,
    movementOf,
    moveFrom,
    nextSelection,
    passFocus,
    rangeOf,
    sameKeys,
    setRange,
    trackFocusIn,
    trackFocusOut,
    typeahead,
  } from './collection.ts';
  import { FieldInputContext } from './contexts.ts';
  import { LocaleContext } from './locale.ts';
  import { VirtualizerContext } from './virtualizer.ts';
  import { enabledKeysOf, focusKeyIn, keyAfter, typeaheadWindowed } from './windowed.ts';

  /**
   * A list of options that the user selects from. Its items
   * are ListBoxItem elements, written out, from a `#for`, or in ListBoxSection elements. Or it
   * takes `items`, as Tree does, and renders each with the `item` template.
   *
   * - With `items` and a `rowHeight`, or in a Virtualizer, it renders only the options in view. Its
   *   keys then read the data of all the items, so Home, End, the page keys, Ctrl+A, ranges with
   *   Shift and letters reach options that are out of view, and a move to one scrolls it into view
   *   first. Letters match the text of the options in view, and `getTextValue` gives the text of
   *   the others. It windows a vertical list that no field filters.
   * - `selectionMode` is `none` (the default), `single` or `multiple`. `selectedKeys` is the list
   *   of the `id` of the selected items.
   * - `selectionBehavior="toggle"`, the default, adds and removes items as checkboxes do.
   *   `"replace"` selects the item that has focus, with Ctrl or Cmd to add, and Shift for a range.
   * - The arrow keys, Home, End, PageUp and PageDown move focus, and letters move to the item
   *   whose text starts with them. Space selects, Enter acts or selects, Ctrl+A selects all, and
   *   Escape clears the selection.
   * - Tab stops once: at the item that had focus last, or else at the first selected item, or the
   *   first item.
   */
  const {
    as,
    selectionMode = 'none',
    selectionBehavior = 'toggle',
    disabledKeys = [],
    disallowEmptySelection = false,
    shouldFocusWrap = false,
    escapeKeyBehavior = 'clearSelection',
    orientation = 'vertical',
    onAction,
    onSelectionChange,
    rowHeight,
    getTextValue,
    items,
    item,
    children,
    ...rest
  } = $props<ListBoxProps<V, T>>();
  let { selectedKeys = [] } = $props<ListBoxOwnProps<V, T>>();
  let { ref } = $props<ListBoxOwnProps<V, T>>();

  const locale = $getContext(LocaleContext);
  // A Select around the list keeps the selection, with one item at most.
  const given = $getContext(ListBoxGivenContext);
  // A field around the list, such as of a ComboBox, keeps focus and can filter the items.
  const field = $getContext(CollectionFocusContext);
  const virtualizer = $getContext(VirtualizerContext);
  // A list windows when its options are made from data. A field around it filters the options in
  // the page, and a horizontal list has no window.
  const windowHeight = $memo(
    items && !field && orientation === 'vertical' ? (rowHeight ?? virtualizer?.rowHeight) : undefined,
  );
  const mode = $memo(given ? 'single' : selectionMode);
  const chosen = $memo(given ? given.selectedKeys : selectedKeys);
  const hasAction = $isPassed(onAction);
  const listId = $id();

  function setSelection(next: Key[]) {
    if (!sameKeys(next, chosen)) {
      const before = selectedKeys;
      selectedKeys = next;
      // The setter of a bound value may keep other keys, or none.
      if (selectedKeys !== before) {
        onSelectionChange?.(selectedKeys);
      }
    }
  }

  /** The keys of the items, in order. */
  function order(): Key[] {
    return (items ?? []).map((one) => one.id);
  }

  /** The keys of the options that can take focus. A windowed list reads its data, not the page. */
  function enabledKeys(element: HTMLElement): Key[] {
    return windowHeight
      ? enabledKeysOf(element, 'option', order(), disabledKeys)
      : enabledItems(element, 'option').map((option) => keyOf(option)!);
  }

  /** The keys of the options from the anchor to a key, in order, that can take focus. */
  function keysFrom(element: HTMLElement, anchor: Key, to: Key): Key[] {
    return windowHeight
      ? keysIn(enabledKeys(element), anchor, to)
      : keysBetween(enabledItems(element, 'option'), anchor, to);
  }

  /** Focuses the option of a key. A windowed list may not render it, so it scrolls it into view. */
  function focusKey(key: Key | undefined) {
    const element = ref as HTMLElement | undefined;
    if (element && key !== undefined) {
      focusKeyIn(element, 'option', order(), key, windowHeight, focusItem);
    }
  }

  function select(key: Key, request: SelectionRequest) {
    if (given) {
      given.select(key);
      return;
    }
    const element = ref as HTMLElement | undefined;
    const range = element ? rangeOf(element) : undefined;
    const shift = Boolean(element && request.shift && range);
    setSelection(
      nextSelection(chosen, key, {
        mode,
        behavior: selectionBehavior,
        disallowEmpty: disallowEmptySelection,
        request: { ...request, shift },
        range: shift ? keysFrom(element!, range!.anchor, key) : undefined,
        previousRange: shift ? keysFrom(element!, range!.anchor, range!.end) : undefined,
        disabled: disabledKeys,
      }),
    );
    if (element) {
      // Shift moves the end of the range, and any other selection starts a new one.
      setRange(element, shift ? range!.anchor : key, key);
    }
  }

  function action(key: Key) {
    onAction?.(key);
  }

  $setContext(ListBoxContext, {
    selectionMode: mode,
    selectionBehavior,
    selectedKeys: chosen,
    disabledKeys,
    select,
    action,
    hasAction,
    activeKey: field?.activeKey,
    setActive: field?.setActive,
  });
  // The lists inside, such as in an item, have fields of their own.
  $setContext(CollectionFocusContext, null);
  $setContext(FieldInputContext, null);

  // A part around the list, such as a ComboBox, shows only the items that match its text: when
  // the list is on the page, and each time the text changes.
  function applyFilter() {
    const text = field?.filterText;
    const element = ref as HTMLElement | undefined;
    if (text !== undefined && element) {
      field!.filtered?.(filterItems(element, text, field!.filter));
    }
  }
  $client(() => applyFilter(), 'idle');
  $effect(() => {
    void field?.filterText;
    $untrack(applyFilter());
  });

  function focused(event: FocusEvent) {
    // A field around the list keeps the focus.
    if (!field) {
      passFocus(ref as HTMLElement | undefined, event, 'option', (options) =>
        given?.focusStrategy === 'last' ? options.at(-1) : options[0],
      );
    }
  }

  function focusIn(event: FocusEvent) {
    trackFocusIn(ref as HTMLElement | undefined, event, 'option');
  }

  function focusOut(event: FocusEvent) {
    trackFocusOut(ref as HTMLElement | undefined, event);
  }

  function keyDown(event: KeyboardEvent) {
    const element = ref as HTMLElement | undefined;
    if (!element) {
      return;
    }
    const rendered = enabledItems(element, 'option');
    const current = focusedItem(element, 'option');
    const key = current ? keyOf(current) : undefined;
    const movement = movementOf(event.key, orientation, locale.direction);
    const replace = selectionBehavior === 'replace';
    const toggle = event.ctrlKey || event.metaKey;
    if (movement) {
      // Shift extends a range from the item that has focus, when no press started one.
      if (event.shiftKey && mode === 'multiple' && key !== undefined && !rangeOf(element)) {
        setRange(element, key);
      }
      let targetKey: Key | undefined;
      if (windowHeight && key !== undefined) {
        targetKey = keyAfter(
          element,
          'option',
          order(),
          enabledKeys(element),
          key,
          movement,
          windowHeight,
          shouldFocusWrap,
        );
        focusKey(targetKey);
      } else {
        const target = moveFrom(element, rendered, current, movement, shouldFocusWrap);
        targetKey = target ? keyOf(target) : undefined;
        focusItem(target);
      }
      if (targetKey === undefined || mode === 'none' || given) {
        return;
      }
      if (event.shiftKey && mode === 'multiple') {
        select(targetKey, { shift: true, toggle: false });
      } else if (replace && !toggle) {
        // In the replace behavior, the selection follows focus.
        select(targetKey, { shift: false, toggle: false });
      }
      return;
    }
    if (event.key === ' ' && !isTyping(element)) {
      if (key !== undefined) {
        select(key, { shift: event.shiftKey, toggle: !replace || toggle });
      }
      return;
    }
    if (event.key === 'Enter' && key !== undefined) {
      // An item with `onAction` of its own acts too, as the list does with `onAction`.
      const itemActs = current!.hasAttribute('data-action');
      if (hasAction || itemActs) {
        if (itemActs) {
          current!.dispatchEvent(new CustomEvent('itemaction', { bubbles: false }));
        }
        action(key);
      } else {
        select(key, { shift: false, toggle: !replace });
      }
      return;
    }
    if (event.key === 'Tab' && given?.tab) {
      given.tab();
      return;
    }
    if ((event.key === 'a' || event.key === 'A') && toggle && mode === 'multiple') {
      setSelection(enabledKeys(element));
      // The browser selected the text of the page too, before this handler ran.
      window.getSelection()?.removeAllRanges();
      return;
    }
    // Escape closes the popover of a Select, and keeps its selection.
    if (event.key === 'Escape' && !given) {
      if (
        escapeKeyBehavior === 'clearSelection' &&
        !disallowEmptySelection &&
        chosen.length > 0
      ) {
        // The Escape clears the selection, so it does not close an overlay around the list too.
        event.stopPropagation();
        setSelection([]);
      }
      return;
    }
    let foundKey: Key | undefined;
    if (windowHeight) {
      const rows = (items ?? []).map((one) => ({ key: one.id, item: one }));
      foundKey = typeaheadWindowed(element, 'option', rows, enabledKeys(element), key, event, getTextValue);
      focusKey(foundKey);
    } else {
      const found = typeahead(element, rendered, current, event);
      foundKey = found ? keyOf(found) : undefined;
      focusItem(found);
    }
    if (foundKey !== undefined && replace && mode !== 'none' && !given) {
      select(foundKey, { shift: false, toggle: false });
    }
  }

  // Only the arrow keys of its axis are prevented, so the others keep their default, such as
  // scrolling the page.
  function keys(horizontal: boolean) {
    return horizontal
      ? { onKeyDown: $handler(prevent(keyDown, 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown', 'Space', 'Enter', 'Mod+ArrowLeft', 'Mod+ArrowRight', 'Mod+Home', 'Mod+End', 'Mod+PageUp', 'Mod+PageDown', 'Mod+Space')) }
      : { onKeyDown: $handler(prevent(keyDown, 'ArrowUp', 'ArrowDown', 'Home', 'End', 'PageUp', 'PageDown', 'Space', 'Enter', 'Mod+ArrowUp', 'Mod+ArrowDown', 'Mod+Home', 'Mod+End', 'Mod+PageUp', 'Mod+PageDown', 'Mod+Space')) };
  }
</script>

<{as ?? 'div'}
  ref=$bind(ref)
  id=(field?.id ?? listId)
  role="listbox"
  tabindex=(field ? '-1' : '0')
  data-collection
  aria-multiselectable=(mode === 'multiple' ? 'true' : undefined)
  aria-labelledby=(given?.labelledBy)
  aria-orientation=(orientation === 'horizontal' ? 'horizontal' : undefined)
  data-orientation=orientation
  onFocus=focused
  onFocusIn=focusIn
  onFocusOut=focusOut
  {...keys(orientation === 'horizontal')}
  {...rest}
>
  {children}
  #if (items && item) {
    #if (windowHeight) {
      #for (entry of items by entry.id) window(windowHeight) {
        {item(entry)}
      }
    } #else {
      #for (entry of items by entry.id) {
        {item(entry)}
      }
    }
  }
</>
