<script>
  import { $getContext, $id, $memo, $props, $setContext } from 'brumate/signals';
  import { LabelContext } from './contexts.ts';
  import { described } from './description.brm.ts';
  import { LocaleContext } from './locale.ts';
  import { progressOf } from './progress.ts';
  import type { ProgressState } from './progress.ts';

  /**
   * A value in a range, such as the space left on a disk, as Meter of React Aria Components:
   * role="meter" with the value, the range and its text in the locale. A Label inside names it.
   * The element has `--percentage` for CSS, from 0% to 100%. A `content` template gets the
   * percentage and the text, to draw the bar.
   */
  const {
    value = 0,
    minValue = 0,
    maxValue = 100,
    valueLabel,
    formatOptions,
    content,
    children,
    ...rest
  } = $props<{
    value?: number;
    minValue?: number;
    maxValue?: number;
    /** The text of the value, in place of the formatted number. */
    valueLabel?: string;
    formatOptions?: Intl.NumberFormatOptions;
    content?: (state: ProgressState) => unknown;
    children?: unknown;
    [attribute: string]: unknown;
  }>();

  const locale = $getContext(LocaleContext);
  const labelId = $id();
  // A Label inside names it. Without one, aria-label does, and the ID goes.
  const { present: labelled } = described(labelId);
  const state = $memo(progressOf(value, minValue, maxValue, locale.locale, formatOptions));
  $setContext(LabelContext, { id: labelId });
</script>

<div
  role="meter"
  aria-valuenow=state.value
  aria-valuemin=minValue
  aria-valuemax=maxValue
  aria-valuetext=(valueLabel ?? state.valueText)
  aria-labelledby=(labelled ? labelId : undefined)
  style=(`--percentage: ${state.percentage}%`)
  {...rest}
>
  {children}
  #if (content) {
    {content({ ...state, valueText: valueLabel ?? state.valueText })}
  }
</div>
