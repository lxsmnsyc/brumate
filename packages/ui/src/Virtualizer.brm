<script module>
  import type { ElementProps } from 'brumate/elements';

  export interface VirtualizerProps extends ElementProps<'div'> {
    /** The height of a row in pixels. The default is 32. */
    rowHeight?: number;
    /** The collection to scroll. */
    children?: unknown;
  }
</script>

<script>
  import { $props, $setContext } from 'brumate/signals';
  import { VirtualizerContext } from './virtualizer.ts';

  /**
   * A box that scrolls a long collection and renders only the rows in view, in a list layout. Give
   * it a height.
   *
   * - A Tree, a GridList, a ListBox or a Table with `items` in it renders only the rows in view.
   *   Rows that a caller writes out or renders from a `#for` take `window(rowHeight)` on the
   *   `#for` for the same.
   */
  const { rowHeight = 32, children, ...rest } = $props<VirtualizerProps>();

  $setContext(VirtualizerContext, { rowHeight });
</script>

<div data-virtualizer {...rest}>{children}</div>

<style>
  div {
    overflow: auto;
  }
</style>
