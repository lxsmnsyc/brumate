<script module>
  import type { Bindable } from 'brumate/signals';
  import type { ButtonStateProps, LinkStateProps } from './contexts.ts';
  import type { HoverEvent, PressEvent } from './events.ts';
  import type { ContextValue } from './slots.ts';

  export interface PreviewTriggerProps {
    /** The time in milliseconds that hover or focus waits before the preview shows. */
    delay?: number;
    /** The time in milliseconds between the pointer leaving and the preview hiding. */
    closeDelay?: number;
    /** Never shows the preview. */
    isDisabled?: boolean;
    /** Runs with each change of whether the preview shows. */
    onOpenChange?: (open: boolean) => void;
    /** A `Link` or a `Button`, and a `Popover`. */
    children?: unknown;
    /** Whether the preview shows. Alone it holds its own state, which starts hidden, and `$bind` writes your signal. A start value of `true` shows it once the page has loaded. */
    isOpen?: Bindable<boolean>;
  }
</script>

<script>
  import { $client, $effect, $getContext, $id, $memo, $props, $setContext, $store, $toStore, $untrack } from 'brumate/signals';
  import { ButtonContext, LinkContext, OverlayTriggerContext } from './contexts.ts';
  import type { OverlayTriggerState } from './contexts.ts';
  import { isFocusVisible } from './interactions.ts';
  import { cancelLongPress, dismissed, followPreview, pressForgets, startLongPress, startedOpen } from './preview.ts';
  import { previews } from './tooltip.ts';

  /**
   * Shows a Popover for the Link or the Button inside it, on hover, on focus from the keyboard,
   * or on a long press. Unlike a Tooltip, the
   * preview can hold links and buttons.
   *
   * - Hover and focus show it after `delay`, 600 milliseconds by default. Once a preview has
   *   shown, the others show at once, until none has shown for half a second.
   * - A touch that holds the trigger for half a second shows it, and its release presses nothing.
   * - It is not modal, and focus stays where it is. Tab on the trigger moves into it, and Tab past
   *   its end moves on to the element after the trigger.
   * - Leaving the trigger and the preview hides it after `closeDelay`, 200 milliseconds. Focus
   *   that leaves both, a press of the trigger, and Escape hide it at once. Escape gives focus
   *   back to the trigger.
   */
  const {
    delay = 600,
    closeDelay = 200,
    isDisabled = false,
    onOpenChange,
    children,
  } = $props<PreviewTriggerProps>();
  let { isOpen = false } = $props<PreviewTriggerProps>();

  const buttonGiven = $getContext(ButtonContext);
  const button = $store(buttonGiven.state);
  const linkGiven = $getContext(LinkContext);
  const link = $store(linkGiven.state);
  const ownId = $id();
  const overlayId = $id();
  const triggerId = $memo(getId(button) ?? getId(link) ?? ownId);

  function getId(value: ContextValue<ButtonStateProps | LinkStateProps> | null) {
    return value && !('slots' in value) && typeof value.id === 'string' ? value.id : undefined;
  }

  function setOpen(next: boolean) {
    if (next !== isOpen) {
      isOpen = next;
      onOpenChange?.(next);
    }
  }

  function open(immediate: boolean) {
    if (!isDisabled) {
      previews.show(overlayId, delay, immediate, () => {
        setOpen(true);
        // A setter that refused leaves it closed.
        return isOpen;
      }, () => setOpen(false));
    }
  }

  function close(immediate: boolean) {
    cancelLongPress(triggerId);
    previews.hide(overlayId, closeDelay, immediate, () => setOpen(false));
  }

  function hoverStarted(event: HoverEvent) {
    given(buttonGiven.handlers)?.onHoverStart?.(event);
    given(linkGiven.handlers)?.onHoverStart?.(event);
    dismissed.delete(triggerId);
    open(false);
  }

  function hoverEnded(event: HoverEvent) {
    given(buttonGiven.handlers)?.onHoverEnd?.(event);
    given(linkGiven.handlers)?.onHoverEnd?.(event);
    pressForgets.get(triggerId)?.();
    if (!isOpen) {
      close(false);
    }
  }

  function focusChanged(focused: boolean) {
    given(buttonGiven.handlers)?.onFocusChange?.(focused);
    given(linkGiven.handlers)?.onFocusChange?.(focused);
    const active = document.activeElement;
    if (!focused) {
      dismissed.delete(triggerId);
    }
    if (focused && active && isFocusVisible(active) && !dismissed.has(triggerId)) {
      open(false);
    } else if (!focused && !isOpen) {
      close(true);
    }
  }

  function pressStarted(event: PressEvent) {
    given(buttonGiven.handlers)?.onPressStart?.(event);
    given(linkGiven.handlers)?.onPressStart?.(event);
    if (event.pointerType === 'touch') {
      startLongPress(triggerId, event.pointerId, () => open(true));
    } else {
      if (event.pointerType !== 'keyboard') {
        // The focus that this press gives the trigger does not show the preview again. A browser
        // that does not focus the trigger on a press leaves this entry, so the pointer leaving
        // or a key ends it, and Tab onto the trigger still shows the preview.
        pressForgets.get(triggerId)?.();
        dismissed.add(triggerId);
        function forget() {
          document.removeEventListener('keydown', forget, true);
          pressForgets.delete(triggerId);
          dismissed.delete(triggerId);
        }
        pressForgets.set(triggerId, forget);
        document.addEventListener('keydown', forget, true);
      }
      close(true);
    }
  }

  function pressEnded(event: PressEvent) {
    given(buttonGiven.handlers)?.onPressEnd?.(event);
    given(linkGiven.handlers)?.onPressEnd?.(event);
    cancelLongPress(triggerId);
  }

  /** The props of a context around it, when it gives one part its props. */
  function given<T extends object>(value: ContextValue<T> | null | undefined): T | undefined {
    return value && !('slots' in value) ? value : undefined;
  }

  // A trigger that leaves the page stops its timers, so they open nothing later, and the next
  // preview still waits for its delay.
  $client(() => () => {
    cancelLongPress(triggerId);
    previews.forget(overlayId);
  }, 'idle');

  function follow() {
    return followPreview(triggerId, overlayId, {
      keep: () => previews.keep(overlayId),
      leave: () => close(false),
      close: () => close(true),
    });
  }

  // A start value of `true` follows from load, since an effect never runs then. The first run of
  // the effect gives that follow back.
  $client(() => {
    if (isOpen) {
      startedOpen.set(overlayId, follow());
    }
    // The trigger leaves the page with the value unchanged: stop the follow.
    return () => {
      startedOpen.get(overlayId)?.();
      startedOpen.delete(overlayId);
    };
  }, 'load');

  // While it is open, the page decides when it closes.
  $effect(() => {
    startedOpen.get(overlayId)?.();
    startedOpen.delete(overlayId);
    if (!isOpen) {
      return undefined;
    }
    return $untrack(follow());
  });

  // The props of a trigger around it come first, and the handlers of both run.
  const buttonState = $memo({
    ...given(button),
    id: triggerId,
    'aria-expanded': isOpen ? 'true' : 'false',
    'aria-controls': isOpen ? overlayId : undefined,
  });
  $setContext(ButtonContext, {
    state: $toStore(buttonState),
    handlers: {
      onPress: (event: PressEvent) => given(buttonGiven.handlers)?.onPress?.(event),
      onPressUp: (event: PressEvent) => given(buttonGiven.handlers)?.onPressUp?.(event),
      onPressChange: (pressed: boolean) => given(buttonGiven.handlers)?.onPressChange?.(pressed),
      onHoverChange: (hovered: boolean) => given(buttonGiven.handlers)?.onHoverChange?.(hovered),
      onHoverStart: hoverStarted,
      onHoverEnd: hoverEnded,
      onFocusChange: focusChanged,
      onPressStart: pressStarted,
      onPressEnd: pressEnded,
    },
  });
  const linkState = $memo({
    ...given(link),
    id: triggerId,
    'aria-expanded': isOpen ? 'true' : 'false',
    'aria-controls': isOpen ? overlayId : undefined,
  });
  $setContext(LinkContext, {
    state: $toStore(linkState),
    handlers: {
      onPress: (event: PressEvent) => given(linkGiven.handlers)?.onPress?.(event),
      onPressUp: (event: PressEvent) => given(linkGiven.handlers)?.onPressUp?.(event),
      onPressChange: (pressed: boolean) => given(linkGiven.handlers)?.onPressChange?.(pressed),
      onHoverChange: (hovered: boolean) => given(linkGiven.handlers)?.onHoverChange?.(hovered),
      onHoverStart: hoverStarted,
      onHoverEnd: hoverEnded,
      onFocusChange: focusChanged,
      onPressStart: pressStarted,
      onPressEnd: pressEnded,
    },
  });
  const overlayState = $memo<OverlayTriggerState>({ isOpen, triggerId, overlayId, isPreview: true });
  $setContext(OverlayTriggerContext, {
    state: $toStore(overlayState),
    open: () => open(true),
    // The popover closes it, such as on Escape, and gives focus back, which does not open it again.
    // A press outside gives no focus back, so the trigger opens it again on its next focus.
    close: () => {
      const active = document.activeElement;
      const layer = document.getElementById(overlayId)?.closest('[data-layer]');
      if (active && (document.getElementById(triggerId)?.contains(active) || layer?.contains(active))) {
        dismissed.add(triggerId);
      }
      close(true);
    },
  });
</script>

{children}
