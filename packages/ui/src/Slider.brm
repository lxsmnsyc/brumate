<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { Bindable } from 'brumate/signals';

  export interface SliderProps extends Omit<ElementProps<'div'>, 'onChange'> {
    /** The least value, 0 by default. */
    minValue?: number;
    /** The greatest value, 100 by default. */
    maxValue?: number;
    /** The distance between the values a thumb can take, 1 by default. */
    step?: number;
    /** The direction of the track. A vertical slider places its thumbs with `bottom`. */
    orientation?: 'horizontal' | 'vertical';
    /** Disables every thumb and the track. */
    isDisabled?: boolean;
    /** The options of `Intl.NumberFormat` that format the values. */
    formatOptions?: Intl.NumberFormatOptions;
    /** Runs with the value, or the list of values, each time it changes. */
    onChange?: (value: number | number[]) => void;
    /** Runs with the value, or the list of values, when a drag or a key ends. */
    onChangeEnd?: (value: number | number[]) => void;
    /** The Label, SliderOutput and SliderTrack. */
    children?: unknown;
    /** A number for one thumb, or a list of numbers for several. A plain value starts its own state, and `$bind(signal)` writes the caller's. */
    value?: Bindable<number | number[]>;
  }
</script>

<script>
  import { $client, $getContext, $id, $memo, $props, $setContext, $signal } from 'brumate/signals';
  import { NumberFormatter } from '@internationalized/number';
  import { LabelContext } from './contexts.ts';
  import { onFormReset } from './fields.ts';
  import { LocaleContext } from './locale.ts';
  import { snapToStep } from './numbers.ts';
  import { SliderContext, thumbId } from './slider.ts';

  /**
   * A slider with one thumb or several. It holds a Label, a
   * SliderOutput, and a SliderTrack with a SliderThumb for each value.
   *
   * - `value` is a number for one thumb, or a list of numbers for several. `value=(n)` starts its
   *   own, and `value=$bind(signal)` writes the caller's. `onChange` gets each change, and
   *   `onChangeEnd` the value once a drag or a key ends.
   * - The values stay between `minValue` and `maxValue` (0 and 100 by default), on a `step`, and
   *   in order: a thumb cannot pass the thumbs next to it.
   * - `formatOptions` and the locale format the values, for the output and for screen readers.
   * - It is a group that the Label names, and shows `data-orientation` and `data-disabled`.
   * - A reset of the form gives back the first values.
   */
  const {
    minValue = 0,
    maxValue = 100,
    step = 1,
    orientation = 'horizontal',
    isDisabled = false,
    formatOptions,
    onChange,
    onChangeEnd,
    children,
    ...rest
  } = $props<SliderProps>();
  let { value = minValue } = $props<SliderProps>();

  const locale = $getContext(LocaleContext);
  // The values that a reset of the form gives back.
  let initialValue = $signal(value);
  // The thumbs that a drag moves now.
  let dragging = $signal<number[]>([]);
  const id = $id();
  const labelId = $id();
  // Each value on a step, between the values next to it.
  const values = $memo(order(Array.isArray(value) ? value : [value]));
  const pageSize = $memo(
    Math.max(snapToStep((maxValue - minValue) / 10, 0, undefined, step), step),
  );
  const labels = $memo(values.map((item) => format(item)));
  const label = $memo(rangeLabel(values));

  function order(list: number[]): number[] {
    return list.map((item, index) =>
      snapToStep(
        item,
        index === 0 ? minValue : list[index - 1],
        index === list.length - 1 ? maxValue : list[index + 1],
        step,
      ),
    );
  }

  function format(number: number): string {
    return new NumberFormatter(locale.locale, formatOptions).format(number);
  }

  /** One value, two as a range, such as `20 – 80`, or more as a list of the locale. */
  function rangeLabel(list: number[]): string {
    if (list.length === 2) {
      const formatter = new Intl.NumberFormat(locale.locale, formatOptions) as Intl.NumberFormat & {
        formatRange?: (start: number, end: number) => string;
      };
      if (formatter.formatRange) {
        return formatter.formatRange(list[0]!, list[1]!);
      }
    }
    const texts = list.map((item) => format(item));
    return typeof Intl.ListFormat === 'function'
      ? new Intl.ListFormat(locale.locale, { type: 'unit' }).format(texts)
      : texts.join(', ');
  }

  function emit(list: number[]): number | number[] {
    return Array.isArray(value) ? list : list[0]!;
  }

  function setThumb(index: number, next: number) {
    if (isDisabled) {
      return;
    }
    const low = index === 0 ? minValue : values[index - 1]!;
    const high = index === values.length - 1 ? maxValue : values[index + 1]!;
    const snapped = snapToStep(next, low, high, step);
    if (snapped === values[index]) {
      return;
    }
    const list = values.map((item, at) => (at === index ? snapped : item));
    const written = emit(list);
    const before = value;
    value = written;
    // The setter of a bound value may keep other numbers, or none.
    if (value !== before) {
      onChange?.(value);
    }
  }

  function setDragging(index: number, next: boolean) {
    if (next) {
      if (!dragging.includes(index)) {
        dragging = [...dragging, index];
      }
      return;
    }
    dragging = dragging.filter((item) => item !== index);
    onChangeEnd?.(emit(values));
  }

  // A reset of the form gives back the first values, as it does for a field of the browser.
  $client(() => {
    return onFormReset(
      document.getElementById(thumbId({ id }, 0)) as HTMLInputElement | null,
      () => {
        value = initialValue;
      },
    );
  }, 'load');

  $setContext(LabelContext, { id: labelId });
  $setContext(SliderContext, {
    values,
    minValue,
    maxValue,
    step,
    pageSize,
    orientation,
    isDisabled,
    id,
    labelId,
    label,
    labels,
    dragging,
    setThumb,
    setDragging,
  });
</script>

<div
  role="group"
  aria-labelledby=labelId
  data-orientation=orientation
  data-disabled=(isDisabled || undefined)
  {...rest}
>{children}</div>
