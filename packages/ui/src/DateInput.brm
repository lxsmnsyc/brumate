<script module>
  import type { ElementProps } from 'brumate/elements';
  import type { Segment } from './segments.ts';

  export interface DateInputProps extends ElementProps<'div'> {
    /** A `#template` that gets each segment, to render your own DateSegment. */
    segment?: (segment: Segment) => unknown;
    /** In a DateRangePicker, picks the date that the input edits, `start` or `end`. */
    slot?: 'start' | 'end';
  }
</script>

<script>
  import { $getContext, $hasContext, $memo, $props, $setContext, $store, $toStore } from 'brumate/signals';
  import { DateFieldContext, DateRangeFieldContext, focusSegment } from './segments.ts';
  import type { SegmentType } from './segments.ts';
  import DateSegment from './DateSegment.brm';

  /**
   * The segments of a DateField: a group that its Label
   * names, with a DateSegment for each part of the date and the text between them.
   *
   * - `segment` is a `#template` that gets each segment, to render your own DateSegment.
   * - In a DateRangePicker, `slot="start"` and `slot="end"` pick the date that it edits.
   * - ArrowLeft and ArrowRight move focus between the segments, the other way right to left.
   * - A press of the pointer on the group, or on the text between two segments, focuses the last
   *   segment.
   * - It shows `data-disabled` and `data-invalid`.
   */
  const { segment, slot, ...rest } = $props<DateInputProps>();

  const range = $hasContext(DateRangeFieldContext) ? $getContext(DateRangeFieldContext) : undefined;
  const single = $hasContext(DateFieldContext) ? $getContext(DateFieldContext) : undefined;
  const startState = $hasContext(DateRangeFieldContext) ? $store(range.startState) : undefined;
  const endState = $hasContext(DateRangeFieldContext) ? $store(range.endState) : undefined;
  const singleState = $hasContext(DateFieldContext) ? $store(single.state) : undefined;
  /** The date that this input edits: its slot of a DateRangePicker, or the DateField's. */
  const field = $memo(
    (slot && startState ? (slot === 'start' ? startState : endState) : singleState) ?? null,
  );

  /** True when this input edits a date of a DateRangePicker. */
  function ranged(): boolean {
    return Boolean(slot && startState);
  }

  // The segments edit the date of this input.
  $setContext(DateFieldContext, {
    state: $toStore(field),
    step: (type: SegmentType, delta: number) =>
      ranged() ? (slot === 'start' ? range?.startStep : range?.endStep)?.(type, delta) : single?.step?.(type, delta),
    jump: (type: SegmentType, to: 'min' | 'max') =>
      ranged() ? (slot === 'start' ? range?.startJump : range?.endJump)?.(type, to) : single?.jump?.(type, to),
    type: (type: SegmentType, char: string) =>
      (ranged() ? (slot === 'start' ? range?.startType : range?.endType)?.(type, char) : single?.type?.(type, char)) ?? false,
    erase: (type: SegmentType) =>
      (ranged() ? (slot === 'start' ? range?.startErase : range?.endErase)?.(type) : single?.erase?.(type)) ?? false,
    settle: () => (ranged() ? (slot === 'start' ? range?.startSettle : range?.endSettle)?.() : single?.settle?.()),
  });

  function keyDown(event: KeyboardEvent & { currentTarget: HTMLElement }) {
    if (
      !field ||
      (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') ||
      event.ctrlKey ||
      event.altKey ||
      event.metaKey
    ) {
      return;
    }
    // Alt with an arrow is back or forward in some browsers, so only the bare arrows are taken.
    event.preventDefault();
    const group = event.currentTarget;
    const editable = [...group.querySelectorAll<HTMLElement>('[data-segment]:not([data-type="literal"])')];
    const at = editable.indexOf(document.activeElement as HTMLElement);
    const forward = (event.key === 'ArrowRight') !== (field.direction === 'rtl');
    focusSegment(editable[at + (forward ? 1 : -1)]);
  }

  function pointerDown(event: PointerEvent & { currentTarget: HTMLElement }) {
    const group = event.currentTarget;
    const target = event.target as HTMLElement;
    if (event.button !== 0 || target.closest('[role="spinbutton"]')) {
      return;
    }
    const editable = [...group.querySelectorAll<HTMLElement>('[data-segment]:not([data-type="literal"])')];
    focusSegment(editable.at(-1));
  }
</script>

<div
  role="group"
  aria-labelledby=(field?.labelId)
  aria-describedby=(field?.describedBy)
  data-disabled=(field?.isDisabled || undefined)
  data-invalid=(field?.isInvalid || undefined)
  onKeyDown=keyDown
  onPointerDown=pointerDown
  {...rest}
>
  #for (item of field?.segments ?? [] by item.index) {
    #if (segment) {
      {segment(item)}
    } #else {
      <DateSegment segment=item />
    }
  }
</div>
