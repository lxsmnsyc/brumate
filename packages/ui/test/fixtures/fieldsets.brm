<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '../../src/Button.brm';
  import Cell from '../../src/Cell.brm';
  import CheckboxGroup from '../../src/CheckboxGroup.brm';
  import Column from '../../src/Column.brm';
  import Menu from '../../src/Menu.brm';
  import MenuItem from '../../src/MenuItem.brm';
  import MenuTrigger from '../../src/MenuTrigger.brm';
  import Popover from '../../src/Popover.brm';
  import Radio from '../../src/Radio.brm';
  import RadioGroup from '../../src/RadioGroup.brm';
  import Row from '../../src/Row.brm';
  import Tab from '../../src/Tab.brm';
  import TabList from '../../src/TabList.brm';
  import TabPanel from '../../src/TabPanel.brm';
  import Table from '../../src/Table.brm';
  import TableBody from '../../src/TableBody.brm';
  import TableHeader from '../../src/TableHeader.brm';
  import Tabs from '../../src/Tabs.brm';
  import ToggleButton from '../../src/ToggleButton.brm';
  import ToggleButtonGroup from '../../src/ToggleButtonGroup.brm';
  import Checkbox from '../../src/Checkbox.brm';
  import Fieldset from '../../src/Fieldset.brm';
  import Form from '../../src/Form.brm';
  import Input from '../../src/Input.brm';
  import Label from '../../src/Label.brm';
  import Legend from '../../src/Legend.brm';
  import NumberField from '../../src/NumberField.brm';
  import Slider from '../../src/Slider.brm';
  import SliderThumb from '../../src/SliderThumb.brm';
  import SliderTrack from '../../src/SliderTrack.brm';
  import Switch from '../../src/Switch.brm';
  import TextField from '../../src/TextField.brm';

  let off = $signal(true);
  let menuOpen = $signal(true);
  let acted = $signal(0);
  let rowActed = $signal(0);
  let tab = $signal<string | null>('one');
  let toggled = $signal<string[]>([]);
  let picked = $signal<string | null>(null);
  let checked = $signal<string[]>([]);

  function toggle() {
    off = !off;
  }
</script>

<main>
  <button class="toggle" onClick=toggle>Toggle</button>
  <Form class="form">
    <Fieldset class="locked" isDisabled=off>
      <Legend>Locked</Legend>
      <TextField name="name" value="Ada">
        <Label>Name</Label>
        <Input class="name-input" />
      </TextField>
      <NumberField name="age" value=36>
        <Label>Age</Label>
        <Input class="age-input" />
      </NumberField>
      <Checkbox name="news" value="yes" isSelected>News</Checkbox>
      <Switch name="dark" isSelected>Dark</Switch>
      <Slider value=30>
        <Label>Volume</Label>
        <SliderTrack>
          <SliderThumb name="volume" />
        </SliderTrack>
      </Slider>
      <Button class="locked-button">Send</Button>
      <Fieldset class="inner">
        <TextField name="nick" value="ada">
          <Label>Nick</Label>
          <Input class="nick-input" />
        </TextField>
      </Fieldset>
    </Fieldset>
    <Fieldset class="open">
      <TextField name="city" value="Rome">
        <Label>City</Label>
        <Input class="city-input" />
      </TextField>
      <Button class="open-button">Go</Button>
    </Fieldset>
  </Form>
  <Form class="off-form" isDisabled>
    <TextField name="solo" value="x">
      <Label>Solo</Label>
      <Input class="solo-input" />
    </TextField>
    <Button class="solo-button">Go</Button>
  </Form>
  <Fieldset class="more" isDisabled=off>
    <Tabs class="tabs" selectedKey=$bind(tab)>
      <TabList aria-label="Sections">
        <Tab id="one" class="tab-one">One</Tab>
        <Tab id="two" class="tab-two">Two</Tab>
      </TabList>
      <TabPanel id="one">First.</TabPanel>
      <TabPanel id="two">Second.</TabPanel>
    </Tabs>
    <MenuTrigger isOpen=$bind(menuOpen)>
      <Button class="menu-trigger">Actions</Button>
      <Popover class="menu-popover">
        <Menu class="menu" aria-label="Actions" onAction=(() => acted++)>
          <MenuItem id="copy" class="menu-copy">Copy</MenuItem>
          <MenuItem id="cut" class="menu-cut">Cut</MenuItem>
        </Menu>
      </Popover>
    </MenuTrigger>
    <Table class="table" aria-label="Files" selectionMode="multiple" onRowAction=(() => rowActed++)>
      <TableHeader>
        <Column isRowHeader>Name</Column>
      </TableHeader>
      <TableBody>
        <Row id="notes" class="row-notes"><Cell>notes.txt</Cell></Row>
        <Row id="photo" class="row-photo"><Cell>photo.jpg</Cell></Row>
      </TableBody>
    </Table>
    <CheckboxGroup class="check-group" value=$bind(checked)>
      <Checkbox class="check-a" value="a">A</Checkbox>
    </CheckboxGroup>
    <RadioGroup class="radio-group" aria-label="Size" value=$bind(picked)>
      <Radio class="radio-s" value="s">S</Radio>
    </RadioGroup>
    <ToggleButtonGroup class="toggle-group" aria-label="Style" selectionMode="multiple" selectedKeys=$bind(toggled)>
      <ToggleButton id="bold" class="toggle-bold">Bold</ToggleButton>
    </ToggleButtonGroup>
  </Fieldset>
  <p class="counts">{acted}|{rowActed}|{tab}|{toggled.join(',')}|{picked}|{checked.join(',')}</p>
</main>
