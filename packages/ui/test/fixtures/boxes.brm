<script>
  import { $bind, $signal } from 'brumate/signals';
  import Checkbox from '../../src/Checkbox.brm';
  import CheckboxGroup from '../../src/CheckboxGroup.brm';
  import FieldError from '../../src/FieldError.brm';
  import Label from '../../src/Label.brm';
  import Radio from '../../src/Radio.brm';
  import RadioGroup from '../../src/RadioGroup.brm';
  import Switch from '../../src/Switch.brm';
  import Text from '../../src/Text.brm';

  let terms = $signal(false);
  let toppings = $signal(['cheese']);
  let size = $signal<string | null>(null);
  let dark = $signal(false);
  let bad = $signal(false);
</script>

<form class="form">
  <Checkbox class="own" name="news">News</Checkbox>
  <Checkbox class="terms" isSelected=$bind(terms)>Terms</Checkbox>
  <Checkbox class="mixed" isIndeterminate>Some</Checkbox>
  <Checkbox class="locked" isReadOnly isSelected>Locked</Checkbox>
  <CheckboxGroup class="toppings" name="toppings" value=$bind(toppings) isRequired>
    <Label>Toppings</Label>
    <Checkbox class="cheese" value="cheese">Cheese</Checkbox>
    <Checkbox class="olives" value="olives">Olives</Checkbox>
    <Text slot="description">Pick one or more.</Text>
    <FieldError class="toppings-error" />
  </CheckboxGroup>
  <RadioGroup class="sizes" value=$bind(size) isRequired>
    <Label>Size</Label>
    <Radio class="small" value="small">Small</Radio>
    <Radio class="large" value="large">Large</Radio>
    <FieldError class="sizes-error" />
  </RadioGroup>
  <Switch class="dark" isSelected=$bind(dark)>Dark mode</Switch>
  <Switch class="fixed" isReadOnly>Fixed</Switch>
  <RadioGroup class="locked-sizes" value="small" isReadOnly>
    <Label>Locked size</Label>
    <Radio class="locked-small" value="small">Small</Radio>
    <Radio class="locked-large" value="large">Large</Radio>
  </RadioGroup>
  <Checkbox class="described" isInvalid=bad>
    Agree
    <Text slot="description" class="described-text">Needed.</Text>
    <FieldError class="described-error">Please agree.</FieldError>
  </Checkbox>
  <Switch class="described-switch" isInvalid=bad>
    Notify
    <Text slot="description" class="switch-text">Mails.</Text>
    <FieldError class="switch-error">Cannot be off.</FieldError>
  </Switch>
  <Checkbox class="named" isInvalid=bad>
    <Label as="span" class="named-label">Agree</Label>
    <Text slot="description" class="named-text">Needed.</Text>
    <FieldError class="named-error">Please agree.</FieldError>
  </Checkbox>
  <Switch class="named-switch" isInvalid=bad>
    <Label as="span" class="named-switch-label">Notify</Label>
    <Text slot="description" class="named-switch-text">Mails.</Text>
    <FieldError class="named-switch-error">Cannot be off.</FieldError>
  </Switch>
  <button type="button" class="flag" onClick=(() => (bad = true))>Flag</button>
</form>
<p class="values">{String(terms)}|{toppings.join(',')}|{size ?? 'none'}|{String(dark)}</p>
