<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '../../src/Button.brm';
  import Dialog from '../../src/Dialog.brm';
  import DialogTrigger from '../../src/DialogTrigger.brm';
  import Heading from '../../src/Heading.brm';
  import Modal from '../../src/Modal.brm';
  import ModalOverlay from '../../src/ModalOverlay.brm';
  import Popover from '../../src/Popover.brm';
  import Sheet from '../../src/Sheet.brm';

  let open = $signal(false);
  let sheet = $signal(false);
  let shown = $signal(true);
  let own = $signal(false);
  let changes = $signal(0);
</script>

<main class="page">
  <button class="outside" type="button">Outside</button>
  <button class="remove" type="button" onClick=(() => (shown = false))>Remove</button>
  #if (shown) {
  <DialogTrigger isOpen=$bind(open)>
    <Button class="trigger">Delete</Button>
    <ModalOverlay class="overlay">
      <Modal class="modal">
        <Dialog class="dialog">
          <Heading slot="title">Delete the file</Heading>
          <input class="name" aria-label="Name">
          <DialogTrigger>
            <Button class="inner-trigger">Why</Button>
            <Popover class="inner-popover">
              <Dialog class="inner-dialog" aria-label="Why">
                <Button class="inner-button">Because</Button>
              </Dialog>
            </Popover>
          </DialogTrigger>
          <DialogTrigger>
            <Button class="deep-trigger">Deep</Button>
            <Modal class="deep">
              <Dialog class="deep-dialog" aria-label="Deep">Deep</Dialog>
            </Modal>
          </DialogTrigger>
          <Button slot="close" class="close">Cancel</Button>
        </Dialog>
      </Modal>
    </ModalOverlay>
  </DialogTrigger>
  }
  <DialogTrigger>
    <Button class="alert-trigger">Alert</Button>
    <Modal class="alert" isKeyboardDismissDisabled transition>
      <Dialog role="alertdialog" class="alert-dialog" aria-label="Alert">
        <Button slot="close" class="alert-close">OK</Button>
      </Dialog>
    </Modal>
  </DialogTrigger>
  <DialogTrigger>
    <Button class="light-trigger">Light</Button>
    <Modal class="light" isDismissable>
      <Dialog class="light-dialog" aria-label="Light">
        Light
        <DialogTrigger>
          <Button class="lower-trigger">Lower</Button>
          <Modal class="lower">
            <Dialog class="lower-dialog" aria-label="Lower">Lower</Dialog>
          </Modal>
        </DialogTrigger>
      </Dialog>
    </Modal>
  </DialogTrigger>
  <button class="sheet-trigger" type="button" onClick=(() => (sheet = true))>Menu</button>
  <Sheet class="sheet" isOpen=$bind(sheet)>
    <Dialog class="sheet-dialog" aria-label="Menu">
      <Button slot="close" class="sheet-close">Close</Button>
    </Dialog>
  </Sheet>
  <button class="own-trigger" type="button" onClick=(() => (own = true))>Own</button>
  <ModalOverlay class="own-overlay" isOpen=$bind(own) transition onOpenChange=(() => (changes += 1))>
    <Modal class="own-modal">
      <Dialog class="own-dialog" aria-label="Own">Own</Dialog>
    </Modal>
  </ModalOverlay>
  <p class="changes">{changes}</p>
  <p class="state">{String(open)} {String(sheet)}</p>
</main>
