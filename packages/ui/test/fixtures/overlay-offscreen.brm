<script>
  import { $signal } from 'brumate/signals';
  import Button from '../../src/Button.brm';
  import Dialog from '../../src/Dialog.brm';
  import DialogTrigger from '../../src/DialogTrigger.brm';
  import Modal from '../../src/Modal.brm';
  import ModalOverlay from '../../src/ModalOverlay.brm';
  import Popover from '../../src/Popover.brm';
  import Tooltip from '../../src/Tooltip.brm';
  import TooltipTrigger from '../../src/TooltipTrigger.brm';

  let visible = $signal(true);
</script>

<main class="page">
  <button class="toggle" type="button" onClick=(() => (visible = !visible))>Toggle</button>
  #offscreen (visible) {
    <DialogTrigger>
      <Button class="modal-trigger">Modal</Button>
      <ModalOverlay class="overlay">
        <Modal class="modal">
          <Dialog class="modal-dialog" aria-label="Modal">Modal</Dialog>
        </Modal>
      </ModalOverlay>
    </DialogTrigger>
    <DialogTrigger>
      <Button class="popover-trigger">Popover</Button>
      <Popover class="popover">
        <Dialog class="popover-dialog" aria-label="Popover">Popover</Dialog>
      </Popover>
    </DialogTrigger>
    <TooltipTrigger delay=(0) closeDelay=(0)>
      <Button class="tip-trigger">Tip</Button>
      <Tooltip class="tip">Tip</Tooltip>
    </TooltipTrigger>
  }
</main>
