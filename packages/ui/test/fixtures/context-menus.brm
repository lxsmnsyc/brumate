<script>
  import { $bind, $client, $signal } from 'brumate/signals';
  import Button from '../../src/Button.brm';
  import Dialog from '../../src/Dialog.brm';
  import DialogTrigger from '../../src/DialogTrigger.brm';
  import Input from '../../src/Input.brm';
  import Menu from '../../src/Menu.brm';
  import MenuItem from '../../src/MenuItem.brm';
  import Modal from '../../src/Modal.brm';
  import ModalOverlay from '../../src/ModalOverlay.brm';
  import MenuTrigger from '../../src/MenuTrigger.brm';
  import Popover from '../../src/Popover.brm';
  import SubmenuTrigger from '../../src/SubmenuTrigger.brm';
  import type { Key } from '../../src/collection.ts';

  let acted = $signal<Key[]>([]);
  let open = $signal(false);
  let shown = $signal(false);
  let opened = $signal(0);
  let handled = $signal(0);
  let ready = $signal(false);
  $client(() => {
    ready = true;
  }, 'load');
</script>

<main class="page">
  <button class="before" type="button">Before</button>
  <MenuTrigger trigger="contextmenu" isOpen=$bind(open)>
    <div class="area" tabindex="0">
      Area
      <MenuTrigger trigger="contextmenu">
        <div class="inner" tabindex="0">Inner</div>
        <Popover class="inner-popover">
          <Menu class="inner-menu" aria-label="Inner">
            <MenuItem id="inner-item" class="inner-item">Inner item</MenuItem>
          </Menu>
        </Popover>
      </MenuTrigger>
    </div>
    <Popover class="popover">
      <Menu class="menu" aria-label="Actions" onAction=((key) => (acted = [...acted, key]))>
        <MenuItem id="cut" class="cut">Cut</MenuItem>
        <MenuItem id="copy" class="copy">Copy</MenuItem>
        <SubmenuTrigger>
          <MenuItem id="share" class="share">Share</MenuItem>
          <Popover class="submenu-popover">
            <Menu class="submenu" aria-label="Share" onAction=((key) => (acted = [...acted, key]))>
              <MenuItem id="email" class="email">Email</MenuItem>
            </Menu>
          </Popover>
        </SubmenuTrigger>
      </Menu>
    </Popover>
  </MenuTrigger>
  <MenuTrigger trigger="contextmenu">
    <div class="bare" tabindex="0">Bare</div>
    <Popover class="bare-popover">
      <Menu class="bare-menu">
        <MenuItem id="bare-item" class="bare-item">Item</MenuItem>
      </Menu>
    </Popover>
  </MenuTrigger>
  <MenuTrigger>
    <Button class="plain-trigger">Plain</Button>
    <Popover class="plain-popover">
      <Menu class="plain-menu" aria-label="Plain">
        <MenuItem id="one" class="one">One</MenuItem>
      </Menu>
    </Popover>
  </MenuTrigger>
  <DialogTrigger shortcut="Mod+K" isOpen=$bind(shown) onOpenChange=(() => opened++)>
    <Button class="palette-trigger">Palette</Button>
    <ModalOverlay class="backdrop">
      <Modal class="modal">
        <Dialog class="dialog" aria-label="Palette">
          <Input class="palette-input" aria-label="Command" />
        </Dialog>
      </Modal>
    </ModalOverlay>
  </DialogTrigger>
  <DialogTrigger shortcut="Alt+j" shortcutInInput>
    <Button class="alt-trigger">Alt</Button>
    <ModalOverlay class="alt-backdrop">
      <Modal class="alt-modal">
        <Dialog class="alt-dialog" aria-label="Alt"><p>Alt dialog</p></Dialog>
      </Modal>
    </ModalOverlay>
  </DialogTrigger>
  <input class="field" aria-label="Field" />
  <input class="own-field" aria-label="Own" onKeyDown=((event) => { if (event.key === 'k') { event.preventDefault(); handled++; } }) />
  <p class="ready">{ready ? 'ready' : 'waiting'}</p>
  <p class="state">{JSON.stringify([acted, opened, handled])}</p>
</main>
