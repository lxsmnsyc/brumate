<script>
  import { $props } from 'brumate/signals';
  import TreeItem from '../../src/TreeItem.brm';
  import AsTarget from './AsTarget.brm';

  // A TreeItem with the component in `as`. The template of a Tree runs in the browser too, where
  // a component named only as a value is not imported.
  const { children, ...rest } = $props<{ children?: unknown; [attribute: string]: unknown }>();
</script>

<TreeItem as=AsTarget {...rest}>{children}</TreeItem>
