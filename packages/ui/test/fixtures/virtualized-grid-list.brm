<script>
  import { $bind, $signal } from 'brumate/signals';
  import GridList from '../../src/GridList.brm';
  import GridListItem from '../../src/GridListItem.brm';
  import Virtualizer from '../../src/Virtualizer.brm';
  import type { Key } from '../../src/collection.ts';

  const files = Array.from({ length: 300 }, (_, index) => ({
    id: `r${index}`,
    name: index === 120 ? 'Zebra' : `File ${index}`,
  }));
  let picked = $signal<Key[]>([]);
</script>

<Virtualizer class="box" rowHeight=(24) style="height: 120px">
  <GridList class="list" aria-label="Files" items=files item=file selectionMode="multiple" selectedKeys=$bind(picked) getTextValue=((file) => file.name) />
</Virtualizer>
<p class="state">{JSON.stringify(picked)}</p>

#template file(file: { id: string; name: string }) {
  <GridListItem id=(file.id) class=(`row row-${file.id}`)>{file.name}</GridListItem>
}
