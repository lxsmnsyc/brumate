<script>
  import { $bind, $signal } from 'brumate/signals';
  import GridList from '../../src/GridList.brm';
  import GridListItem from '../../src/GridListItem.brm';
  import ListBox from '../../src/ListBox.brm';
  import ListBoxItem from '../../src/ListBoxItem.brm';
  import Menu from '../../src/Menu.brm';
  import MenuItem from '../../src/MenuItem.brm';
  import Tab from '../../src/Tab.brm';
  import TabList from '../../src/TabList.brm';
  import TabPanel from '../../src/TabPanel.brm';
  import Tabs from '../../src/Tabs.brm';
  import Tag from '../../src/Tag.brm';
  import TagGroup from '../../src/TagGroup.brm';
  import TagList from '../../src/TagList.brm';
  import Tree from '../../src/Tree.brm';
  import AsTreeItem from './AsTreeItem.brm';
  import type { Key } from '../../src/collection.ts';
  import AsTarget from './AsTarget.brm';

  let fruit = $signal<Key[]>([]);
  let acted = $signal<Key[]>([]);
  let checked = $signal<Key[]>([]);
  let rows = $signal<Key[]>([]);
  let nodes = $signal<Key[]>([]);
  let open = $signal<Key[]>(['docs']);
  let section = $signal<Key | null>(null);
  let tags = $signal(['news', 'travel', 'gaming']);
  // The signals of elements are `any`, since a signal cannot take the type that `ref` of a part asks for yet.
  // oxlint-disable-next-line typescript/no-explicit-any
  let listRef = $signal<any>();
  // oxlint-disable-next-line typescript/no-explicit-any
  let itemRef = $signal<any>();
  let seen = $signal('');
  const files = [
    { id: 'docs', name: 'Documents', children: [{ id: 'cv', name: 'cv.pdf' }] },
    { id: 'notes', name: 'notes.txt' },
  ];
</script>

<main class="page">
  <ListBox as=AsTarget class="list" aria-label="Fruit" selectionMode="single" selectedKeys=$bind(fruit) disabledKeys=(['cherry'])>
    <ListBoxItem as=AsTarget id="apple" class="apple">Apple</ListBoxItem>
    <ListBoxItem as=AsTarget id="banana" class="banana">Banana</ListBoxItem>
    <ListBoxItem as=AsTarget id="cherry" class="cherry">Cherry</ListBoxItem>
    <ListBoxItem as=AsTarget id="date" class="date">Date</ListBoxItem>
  </ListBox>
  <ListBox as="ul" ref=$bind(listRef) class="ul" aria-label="Elements">
    <ListBoxItem as="li" ref=$bind(itemRef) id="one" class="one">One</ListBoxItem>
  </ListBox>
  <Menu as=AsTarget class="menu" aria-label="Actions" onAction=((key) => (acted = [...acted, key])) selectionMode="multiple" selectedKeys=$bind(checked)>
    <MenuItem as=AsTarget id="copy" class="copy">Copy</MenuItem>
    <MenuItem as=AsTarget id="cut" class="cut">Cut</MenuItem>
    <MenuItem as=AsTarget id="paste" class="paste">Paste</MenuItem>
  </Menu>
  <GridList as=AsTarget class="grid" aria-label="Files" selectionMode="multiple" selectedKeys=$bind(rows)>
    <GridListItem as=AsTarget id="notes" class="row-notes" textValue="notes">Notes</GridListItem>
    <GridListItem as=AsTarget id="photos" class="row-photos" textValue="photos">Photos</GridListItem>
  </GridList>
  <Tree as=AsTarget class="tree" aria-label="Tree" items=files item=file selectionMode="multiple" selectedKeys=$bind(nodes) expandedKeys=$bind(open) />
  <Tabs selectedKey=$bind(section)>
    <TabList as=AsTarget class="tablist" aria-label="Sections">
      <Tab as=AsTarget id="intro" class="tab-intro">Intro</Tab>
      <Tab as=AsTarget id="usage" class="tab-usage">Usage</Tab>
    </TabList>
    <TabPanel as=AsTarget id="intro" class="panel-intro">Hello.</TabPanel>
    <TabPanel as=AsTarget id="usage" class="panel-usage">How to use it.</TabPanel>
  </Tabs>
  <TagGroup onRemove=((keys) => (tags = tags.filter((tag) => !keys.includes(tag))))>
    <TagList as=AsTarget class="tags" aria-label="Tags">
      #for (tag of tags by tag) {
        <Tag as=AsTarget id=tag class=(`tag tag-${tag}`)>{tag}</Tag>
      }
    </TagList>
  </TagGroup>
  <p class="state">{JSON.stringify([fruit, acted, checked, rows, nodes, open, section, tags])}</p>
  <button class="read" type="button" onClick=(() => (seen = `${listRef?.tagName} ${itemRef?.tagName}`))>Read</button>
  <p class="refs">{seen}</p>
</main>

#template file(file: { id: string; name: string }) {
  <AsTreeItem class=(`node node-${file.id}`) textValue=(file.name)>{file.name}</AsTreeItem>
}
