<script>
  import { $getContext, $memo, $store } from 'brumate/signals';
  import { store } from 'brumate/store';
  import { DEFAULT_LOCALE, LocaleContext } from '../../src/locale.ts';

  const given = $store($getContext(LocaleContext, store(DEFAULT_LOCALE)));
  const value = $memo(given ?? DEFAULT_LOCALE);
</script>

<span>{value.locale} {value.direction}</span>
