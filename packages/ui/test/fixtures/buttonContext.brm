<script>
  import { $memo, $setContext, $signal, $toStore } from 'brumate/signals';
  import Button from '../../src/Button.brm';
  import { ButtonContext } from '../../src/contexts.ts';

  let count = $signal(0);
  let own = $signal(0);
  const buttonState = $memo({
    slots: {
      increment: { 'aria-label': 'Increment' },
      decrement: { 'aria-label': 'Decrement', isDisabled: count <= 0 },
    },
  });
  $setContext(ButtonContext, {
    state: $toStore(buttonState),
    handlers: {
      slots: {
        increment: { onPress: () => count++ },
        decrement: { onPress: () => count-- },
      },
    },
  });
</script>

<Button class="up" slot="increment" onPress=(() => own++)>+</Button>
<Button class="down" slot="decrement">-</Button>
<p class="count">{count} {own}</p>
