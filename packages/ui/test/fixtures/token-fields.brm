<script>
  import { $bind, $signal } from 'brumate/signals';
  import Label from '../../src/Label.brm';
  import Text from '../../src/Text.brm';
  import Token from '../../src/Token.brm';
  import TokenField from '../../src/TokenField.brm';
  import TokenInput from '../../src/TokenInput.brm';
  import type { TokenSegment } from '../../src/token-field.ts';

  let value = $signal<TokenSegment[]>([
    { type: 'text', text: 'Hi ' },
    { type: 'token', text: '@ann' },
    { type: 'text', text: ' there' },
  ]);
  let lines = $signal<TokenSegment[]>([{ type: 'text', text: 'a' }]);
  const bo: TokenSegment[] = [{ type: 'token', text: '@bo' }];
  const odd = 'combobox' as 'textbox';
  let off = $signal(false);
  let locked = $signal(false);
</script>

<form class="form">
  <TokenField class="field" name="message" pattern="[#@]\S+" placeholder="Write" value=$bind(value)>
    <Label class="label">Message</Label>
    <TokenInput class="input" token=mention />
    <Text slot="description" class="description">Mention with @</Text>
  </TokenField>
  <TokenField class="empty" placeholder="Nothing yet" isReadOnly>
    <Label>Empty</Label>
    <TokenInput class="empty-input" />
  </TokenField>
  <TokenField class="odd" role=(odd)>
    <Label>Odd</Label>
    <TokenInput class="odd-input" />
  </TokenField>
  <TokenField class="lines" allowsNewlines placeholder="Lines" value=$bind(lines)>
    <Label>Lines</Label>
    <TokenInput class="lines-input" />
  </TokenField>
  <TokenField class="toggled" isDisabled=(off) isReadOnly=(locked) value=(bo)>
    <Label>Toggled</Label>
    <TokenInput class="toggled-input" />
  </TokenField>
</form>
<button class="disable" type="button" onClick=(() => (off = true))>Disable</button>
<button class="lock" type="button" onClick=(() => (locked = true))>Lock</button>
<button class="clear-lines" type="button" onClick=(() => (lines = []))>Clear</button>
<button class="enter-lines" type="button" onClick=(() => (lines = [{ type: 'text', text: 'a\n' }]))>Enter</button>
<p class="lines-state">{JSON.stringify(lines)}</p>
<button class="reset" type="button" onClick=(() => (value = [{ type: 'token', text: '#tag' }]))>Reset</button>
<p class="state">{JSON.stringify(value)}</p>

#template mention(segment: TokenSegment) {
  <Token class="mention">{segment.text}</Token>
}
