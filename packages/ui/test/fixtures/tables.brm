<script>
  import { $bind, $memo, $signal } from 'brumate/signals';
  import Button from '../../src/Button.brm';
  import Cell from '../../src/Cell.brm';
  import Checkbox from '../../src/Checkbox.brm';
  import Column from '../../src/Column.brm';
  import Row from '../../src/Row.brm';
  import Table from '../../src/Table.brm';
  import TableBody from '../../src/TableBody.brm';
  import TableHeader from '../../src/TableHeader.brm';
  import type { Key } from '../../src/collection.ts';
  import type { SortDescriptor } from '../../src/table.ts';

  let files = $signal([
    { id: 'notes', name: 'notes.txt', size: 3 },
    { id: 'photo', name: 'photo.jpg', size: 9 },
    { id: 'music', name: 'music.mp3', size: 5 },
  ]);
  let picked = $signal<Key[]>([]);
  let sort = $signal<SortDescriptor | null>(null);
  let opened = $signal<Key[]>([]);
  let edits = $signal(0);
  const shown = $memo(
    sort
      ? [...files].sort((a, b) => {
          const order = sort!.column === 'size' ? a.size - b.size : a.name.localeCompare(b.name);
          return sort!.direction === 'ascending' ? order : -order;
        })
      : files,
  );
</script>

<main class="page">
  <Table class="table" aria-label="Files" selectionMode="multiple" selectedKeys=$bind(picked) sortDescriptor=$bind(sort) disabledKeys=(['music'])>
    <TableHeader class="head">
      <Column class="col-select"><Checkbox slot="selection" class="select-all" aria-label="Select all" /></Column>
      <Column id="name" class="col-name" isRowHeader allowsSorting>Name</Column>
      <Column id="size" class="col-size" allowsSorting>Size</Column>
      <Column class="col-edit">Edit</Column>
    </TableHeader>
    <TableBody class="body">
      #for (file of shown by file.id) {
        <Row id=(file.id) class=(`row row-${file.id}`)>
          <Cell class=(`cell-select cell-select-${file.id}`)><Checkbox slot="selection" class=(`check check-${file.id}`) aria-label=(`Select ${file.name}`) /></Cell>
          <Cell class=(`cell-name cell-name-${file.id}`)>{file.name}</Cell>
          <Cell class=(`cell-size cell-size-${file.id}`)>{file.size}</Cell>
          <Cell class=(`cell-edit cell-edit-${file.id}`)><Button class=(`edit edit-${file.id}`) onPress=(() => edits++)>Edit</Button></Cell>
        </Row>
      }
    </TableBody>
  </Table>
  <button class="add" type="button" onClick=(() => (files = [...files, { id: 'video', name: 'video.mp4', size: 7 }]))>Add</button>
  <Table class="acting" aria-label="Actions" onRowAction=((key) => (opened = [...opened, key]))>
    <TableHeader>
      <Column isRowHeader>Folder</Column>
    </TableHeader>
    <TableBody>
      <Row id="inbox" class="inbox"><Cell>Inbox</Cell></Row>
      <Row id="sent" class="sent"><Cell>Sent</Cell></Row>
    </TableBody>
  </Table>
  <p class="state">{JSON.stringify([picked, sort, opened, edits])}</p>
</main>
