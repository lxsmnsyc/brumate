<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '../../src/Button.brm';
  import Heading from '../../src/Heading.brm';
  import Link from '../../src/Link.brm';
  import AsTarget from './AsTarget.brm';

  // The elements that the parts give back through `ref`.
  let linkRef = $signal<HTMLElement>();
  let buttonRef = $signal<HTMLElement>();
  let headingRef = $signal<HTMLElement>();
  let asLinkRef = $signal<HTMLElement>();
  let asButtonRef = $signal<HTMLElement>();
  let asHeadingRef = $signal<HTMLElement>();
  let plain = $signal('');
  let targeted = $signal('');

  // The tag of each element, or '-' while the signal is empty.
  function probe() {
    plain = [linkRef, buttonRef, headingRef].map((el) => el?.tagName ?? '-').join(' ');
    targeted = [asLinkRef, asButtonRef, asHeadingRef]
      .map((el) => (el?.hasAttribute('data-as-target') ? 'target' : '-'))
      .join(' ');
  }
</script>

<main>
  <Link ref=$bind(linkRef) class="link" href="/a">Link</Link>
  <Button ref=$bind(buttonRef) class="button">Button</Button>
  <Heading ref=$bind(headingRef) class="heading">Heading</Heading>
  <Link as=AsTarget ref=$bind(asLinkRef) class="as-link" href="/a">Link</Link>
  <Button as=AsTarget ref=$bind(asButtonRef) class="as-button">Button</Button>
  <Heading as=AsTarget ref=$bind(asHeadingRef) class="as-heading">Heading</Heading>
  <button class="probe" onClick=probe>Probe</button>
  <p class="plain">{plain}</p>
  <p class="targeted">{targeted}</p>
</main>
