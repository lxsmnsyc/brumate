<script>
  import { $bind, $signal } from 'brumate/signals';
  import DateInput from '../../src/DateInput.brm';
  import FieldError from '../../src/FieldError.brm';
  import I18nProvider from '../../src/I18nProvider.brm';
  import Label from '../../src/Label.brm';
  import TimeField from '../../src/TimeField.brm';

  let meeting = $signal<string | null>('14:30');
  let alarm = $signal<string | null>('07:05');
  let empty = $signal<string | null>(null);
  let forced = $signal<string | null>('14:30');
  let late = $signal<string | null>('11:00');
  let need = $signal<string | null>(null);
</script>

<main>
  <TimeField class="meeting" name="meeting" value=$bind(meeting) minValue="09:00" maxValue="17:00">
    <Label class="meeting-label">Meeting</Label>
    <DateInput class="meeting-input" />
    <FieldError class="meeting-error">Outside office hours</FieldError>
  </TimeField>
  <I18nProvider locale="de-DE">
    <TimeField class="alarm" value=$bind(alarm)>
      <Label>Wecker</Label>
      <DateInput class="alarm-input" />
    </TimeField>
  </I18nProvider>
  <TimeField class="empty" value=$bind(empty) granularity="second">
    <Label>Lap</Label>
    <DateInput class="empty-input" />
  </TimeField>
  <TimeField class="forced" value=$bind(forced) hourCycle=(24)>
    <Label>Departure</Label>
    <DateInput class="forced-input" />
  </TimeField>
  <form class="form" onSubmit=((event) => event.preventDefault())>
    <TimeField class="late" name="late" value=$bind(late) hourCycle=(12)>
      <Label>Late</Label>
      <DateInput class="late-input" />
    </TimeField>
    <TimeField class="need" name="need" value=$bind(need) isRequired>
      <Label>Need</Label>
      <DateInput class="need-input" />
      <FieldError class="need-error" />
    </TimeField>
  </form>
  <TimeField class="exact" value=("17:00:00") granularity="second" maxValue="17:00">
    <Label>Exact</Label>
    <DateInput class="exact-input" />
  </TimeField>
  <p class="state">{JSON.stringify([meeting, alarm, empty, forced, late, need])}</p>
</main>
