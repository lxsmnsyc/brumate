<script>
  import { $signal } from 'brumate/signals';
  import Button from '../../src/Button.brm';
  import Meter from '../../src/Meter.brm';
  import ProgressBar from '../../src/ProgressBar.brm';
  import ToggleButton from '../../src/ToggleButton.brm';
  import ToggleButtonGroup from '../../src/ToggleButtonGroup.brm';
  import Toolbar from '../../src/Toolbar.brm';

  let saved = $signal(false);
</script>

<Toolbar class="edit" aria-label="Edit">
  <Button class="save" isDisabled=saved onPress=(() => (saved = true))>Save</Button>
  <Button class="undo">Undo</Button>
  <ToggleButtonGroup class="marks" aria-label="Marks" selectionMode="multiple">
    <ToggleButton id="bold" class="bold">Bold</ToggleButton>
  </ToggleButtonGroup>
  <Toolbar class="inner" aria-label="Inner">
    <Button class="inner-button">Inner</Button>
  </Toolbar>
</Toolbar>
<Toolbar class="side" aria-label="Side" orientation="vertical">
  <Button class="up">Up</Button>
  <Button class="down">Down</Button>
</Toolbar>
<Toolbar class="notes" aria-label="Notes" orientation="vertical">
  <Button class="note-button">Note</Button>
  <textarea class="area" aria-label="Notes"></textarea>
</Toolbar>
<Toolbar class="fields" aria-label="Fields">
  <Button class="before">Before</Button>
  <input class="field" aria-label="Field" />
  <Button class="after">After</Button>
</Toolbar>
<ToggleButtonGroup class="vgroup" aria-label="Vertical group" selectionMode="multiple" orientation="vertical">
  <ToggleButton id="a" class="va">A</ToggleButton>
  <ToggleButton id="b" class="vb">B</ToggleButton>
</ToggleButtonGroup>
<ToggleButtonGroup class="withfield" aria-label="With field" selectionMode="multiple">
  <ToggleButton id="x" class="wx">X</ToggleButton>
  <input class="gfield" aria-label="Group field" />
</ToggleButtonGroup>
<ToggleButtonGroup class="off" aria-label="Off" isDisabled=(true)>
  <ToggleButton id="on" class="forced" isDisabled=(false)>On</ToggleButton>
</ToggleButtonGroup>
<Meter class="full" value=(150) aria-label="Full" />
#template spinnerText(state: { valueText?: string; percentage?: number }) {
  <span class="spinner-text">{state.valueText ?? 'none'}|{String(state.percentage)}</span>
}
<ProgressBar class="spinner" isIndeterminate=(true) aria-label="Spinner" content=spinnerText />
