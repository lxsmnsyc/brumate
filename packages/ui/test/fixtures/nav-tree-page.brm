<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '../../src/Button.brm';
  import NavigationTree from '../../src/NavigationTree.brm';
  import NavigationTreeItem from '../../src/NavigationTreeItem.brm';
  import NavigationTreeItemLink from '../../src/NavigationTreeItemLink.brm';
  import type { Key } from '../../src/collection.ts';
  import type { NavigationNode } from '../../src/navigation-tree.ts';

  interface Page extends NavigationNode {
    title: string;
    children?: Page[];
    disabled?: boolean;
  }

  const pages: Page[] = [
    { id: 'start', title: 'Start', href: '#start' },
    {
      id: 'guides',
      title: 'Guides',
      children: [
        { id: 'forms', title: 'Forms', href: '#forms' },
        { id: 'data', title: 'Data', children: [{ id: 'tables', title: 'Tables', href: '#tables' }] },
      ],
    },
    { id: 'api', title: 'API', href: '#api' },
    { id: 'old', title: 'Old', href: '#old', disabled: true },
    { id: 'gone', title: 'Gone', href: '#gone' },
  ];
  let open = $signal<Key[]>([]);
</script>

<nav aria-label="Pages">
  <NavigationTree class="nav" aria-label="Pages" items=pages item=page selectedRoute="#tables" expandedKeys=$bind(open) disabledKeys=(['gone']) />
</nav>
<p class="state">{JSON.stringify(open)}</p>

#template page(page: Page) {
  <NavigationTreeItem class=(`item item-${page.id}`) href=(page.href) isDisabled=(page.disabled) textValue=(page.title)>
    #if (page.children) {
      <Button slot="chevron" class=(`chevron chevron-${page.id}`)>▸</Button>
    }
    <NavigationTreeItemLink class=(`link link-${page.id}`)>{page.title}</NavigationTreeItemLink>
  </NavigationTreeItem>
}
