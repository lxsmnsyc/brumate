<script>
  import { $bind, $memo, $signal } from 'brumate/signals';
  import Cell from '@brumate/ui/Cell.brm';
  import Checkbox from '@brumate/ui/Checkbox.brm';
  import Column from '@brumate/ui/Column.brm';
  import ColumnResizer from '@brumate/ui/ColumnResizer.brm';
  import ResizableTableContainer from '@brumate/ui/ResizableTableContainer.brm';
  import Row from '@brumate/ui/Row.brm';
  import Table from '@brumate/ui/Table.brm';
  import TableBody from '@brumate/ui/TableBody.brm';
  import TableHeader from '@brumate/ui/TableHeader.brm';
  import type { Key } from '@brumate/ui/collection.ts';
  import type { SortDescriptor } from '@brumate/ui/table.ts';

  const people = [
    { id: 'ada', name: 'Ada Lovelace', role: 'Analyst', age: 36 },
    { id: 'alan', name: 'Alan Turing', role: 'Mathematician', age: 41 },
    { id: 'grace', name: 'Grace Hopper', role: 'Admiral', age: 85 },
    { id: 'linus', name: 'Linus Torvalds', role: 'Maintainer', age: 55 },
  ];
  let picked = $signal<Key[]>(['alan']);
  let sort = $signal<SortDescriptor | null>({ column: 'name', direction: 'ascending' });
  const rows = $memo(
    [...people].sort((a, b) => {
      const order = sort?.column === 'age' ? a.age - b.age : a.name.localeCompare(b.name);
      return sort?.direction === 'descending' ? -order : order;
    }),
  );
</script>

<div class="table-styled-demo">
  <ResizableTableContainer class="table-styled-container">
    <Table class="table-styled" aria-label="People" selectionMode="multiple" selectedKeys=$bind(picked) sortDescriptor=$bind(sort) disabledKeys=(['linus'])>
      <TableHeader>
        <Column class="table-styled-column table-styled-check">
          <Checkbox slot="selection" class="table-styled-box" aria-label="Select all" />
        </Column>
        <Column id="name" class="table-styled-column" isRowHeader allowsSorting defaultWidth=(180) minWidth=(120)>
          <span tabindex="-1">Name</span>
          <ColumnResizer class="table-styled-resizer" />
        </Column>
        <Column id="role" class="table-styled-column">Role</Column>
        <Column id="age" class="table-styled-column table-styled-number" allowsSorting>Age</Column>
      </TableHeader>
      <TableBody>
        #for (person of rows by person.id) {
          <Row id=(person.id) class="table-styled-row">
            <Cell class="table-styled-cell">
              <Checkbox slot="selection" class="table-styled-box" aria-label=(`Select ${person.name}`) />
            </Cell>
            <Cell class="table-styled-cell">{person.name}</Cell>
            <Cell class="table-styled-cell">{person.role}</Cell>
            <Cell class="table-styled-cell table-styled-number">{person.age}</Cell>
          </Row>
        }
      </TableBody>
    </Table>
  </ResizableTableContainer>
</div>

<style>
  /* The tokens. Change these and the rest follows. */
  :global(.table-styled-demo) {
    --table-styled-bg: Canvas;
    --table-styled-text: CanvasText;
    --table-styled-muted: color-mix(in srgb, CanvasText 68%, Canvas);
    --table-styled-border: color-mix(in srgb, CanvasText 30%, Canvas);
    --table-styled-accent: light-dark(#2a76b2, #6fb2e6);
    --table-styled-on-accent: light-dark(#fff, #101418);
    --table-styled-hover: color-mix(in srgb, var(--table-styled-accent) 10%, Canvas);
    --table-styled-selected: color-mix(in srgb, var(--table-styled-accent) 22%, Canvas);
    color: var(--table-styled-text);
  }

  :global(.table-styled-container) {
    max-width: 100%;
    border: 1px solid var(--table-styled-border);
    border-radius: 8px;
    background: var(--table-styled-bg);
  }

  :global(.table-styled) {
    width: 100%;
    border-collapse: collapse;
    outline: none;
  }

  :global(.table-styled:focus-visible) {
    outline: 2px solid var(--table-styled-accent);
    outline-offset: 2px;
  }

  /* Headers: rest, hover and press on a column that sorts, the arrow, keyboard focus. */
  :global(.table-styled-column) {
    position: relative;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--table-styled-border);
    color: var(--table-styled-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: start;
    outline: none;
  }

  :global(.table-styled-column[data-allows-sorting]) {
    cursor: pointer;
  }

  :global(.table-styled-column[data-hovered][data-allows-sorting]) {
    background: var(--table-styled-hover);
  }

  :global(.table-styled-column[data-pressed]) {
    background: var(--table-styled-selected);
  }

  :global(.table-styled-column[data-sort-direction]) {
    color: var(--table-styled-text);
  }

  :global(.table-styled-column[data-sort-direction='ascending'])::after {
    content: ' ▲';
    font-size: 0.7em;
  }

  :global(.table-styled-column[data-sort-direction='descending'])::after {
    content: ' ▼';
    font-size: 0.7em;
  }

  :global(.table-styled-column[data-focus-visible]),
  :global(.table-styled-row[data-focus-visible]),
  :global(.table-styled-cell[data-focus-visible]) {
    box-shadow:
      inset 0 0 0 2px var(--table-styled-accent),
      inset 0 0 0 4px var(--table-styled-bg);
  }

  :global(.table-styled-check) {
    width: 2.5rem;
  }

  :global(.table-styled-number) {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  /* The resizer: a bar at the end of the column that shows on hover, drag and focus. */
  :global(.table-styled-resizer) {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: 8px;
    cursor: col-resize;
    border-inline-end: 2px solid var(--table-styled-border);
  }

  :global(.table-styled-resizer[data-hovered]),
  :global(.table-styled-resizer[data-resizing]),
  :global(.table-styled-resizer[data-focus-visible]) {
    border-color: var(--table-styled-accent);
  }

  /* Rows: hover, selected, keyboard focus and disabled. */
  :global(.table-styled-row) {
    outline: none;
    transition: background-color 0.15s;
  }

  :global(.table-styled-row[data-hovered]) {
    background: var(--table-styled-hover);
  }

  :global(.table-styled-row[data-selected]) {
    background: var(--table-styled-selected);
  }

  :global(.table-styled-row[data-disabled]) {
    color: var(--table-styled-muted);
    text-decoration: line-through;
  }

  :global(.table-styled-cell) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--table-styled-border) 50%, Canvas);
    outline: none;
  }

  /* The checkbox: empty, checked, mixed, keyboard focus and disabled. */
  :global(.table-styled-box) {
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--table-styled-muted);
    border-radius: 4px;
    background: var(--table-styled-bg);
    color: var(--table-styled-on-accent);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
  }

  :global(.table-styled-box[data-selected]),
  :global(.table-styled-box[data-indeterminate]) {
    border-color: var(--table-styled-accent);
    background: var(--table-styled-accent);
  }

  :global(.table-styled-box[data-selected])::after {
    content: '✓';
  }

  :global(.table-styled-box[data-indeterminate])::after {
    content: '–';
  }

  :global(.table-styled-box[data-focus-visible]) {
    box-shadow:
      0 0 0 2px var(--table-styled-bg),
      0 0 0 4px var(--table-styled-accent);
  }

  :global(.table-styled-box[data-disabled]) {
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.table-styled-row) {
      transition: none;
    }
  }
</style>
