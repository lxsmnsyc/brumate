<script>
  import Button from '@brumate/ui/Button.brm';
  import Label from '@brumate/ui/Label.brm';
  import ListBox from '@brumate/ui/ListBox.brm';
  import ListBoxItem from '@brumate/ui/ListBoxItem.brm';
  import Select from '@brumate/ui/Select.brm';
  import SelectValue from '@brumate/ui/SelectValue.brm';
  import Text from '@brumate/ui/Text.brm';
</script>

<!-- The picture draws the list open in place, since a real Popover renders in a layer at the end of <body>. -->
<Select class="ui-select" selectedKey="cat">
  <Label data-mark="1" data-mark-side="after">Favorite animal</Label>
  <Button class="ui-button ui-select-button" data-mark="2"><SelectValue class="ui-select-value" data-mark="3" data-mark-side="after" render=catValue /></Button>
  <Text slot="description" class="ui-help" data-mark="4" data-mark-side="after">Pick the one you like best.</Text>
</Select>
<div class="anatomy-popover" data-mark="5">
  <ListBox class="ui-listbox" aria-label="Animals" selectedKeys=(['cat'])>
    <ListBoxItem id="cat" class="ui-option" data-mark="6" data-mark-side="inside">Cat</ListBoxItem>
    <ListBoxItem id="dog" class="ui-option">Dog</ListBoxItem>
  </ListBox>
</div>

#template catValue(state) {
  Cat
}
