<script>
  import Button from '@brumate/ui/Button.brm';
  import Dialog from '@brumate/ui/Dialog.brm';
  import Heading from '@brumate/ui/Heading.brm';
</script>

<!-- The picture draws the window, with the dim overlay, and the Sheet in it, since a real Sheet renders in a layer at the end of <body>. -->
<Button class="ui-button" data-mark="1">Open the menu</Button>
<div style="display: flex; width: min(100%, 30rem); height: 11rem; border-radius: 8px; background: rgb(0 0 0 / 45%)">
  <div class="ui-sheet" data-sheet data-side="left" style="position: relative; height: auto; width: 14rem; margin: 0.75rem; border: 1px solid var(--border); border-radius: 8px" data-mark="2">
    <Dialog class="ui-dialog" aria-label="Menu" style="padding: 0.5rem; border: 1px dashed var(--muted); border-radius: 6px"  data-mark="3" data-mark-side="bottom">
      <Heading slot="title" level=(4) class="anatomy-self" data-mark="4" data-mark-side="after">Menu</Heading>
      <Button slot="close" class="ui-button" style="justify-self: start" data-mark="5">Close</Button>
    </Dialog>
  </div>
</div>

<style>
  :global(.anatomy-self) {
    justify-self: start;
  }
</style>
