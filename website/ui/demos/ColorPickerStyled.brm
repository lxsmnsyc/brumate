<script>
  import { $bind, $signal } from 'brumate/signals';
  import ColorArea from '@brumate/ui/ColorArea.brm';
  import ColorField from '@brumate/ui/ColorField.brm';
  import ColorPicker from '@brumate/ui/ColorPicker.brm';
  import ColorSlider from '@brumate/ui/ColorSlider.brm';
  import ColorSwatch from '@brumate/ui/ColorSwatch.brm';
  import ColorSwatchPicker from '@brumate/ui/ColorSwatchPicker.brm';
  import ColorSwatchPickerItem from '@brumate/ui/ColorSwatchPickerItem.brm';
  import ColorThumb from '@brumate/ui/ColorThumb.brm';
  import Input from '@brumate/ui/Input.brm';
  import Label from '@brumate/ui/Label.brm';
  import SliderTrack from '@brumate/ui/SliderTrack.brm';

  let color = $signal('hsb(210, 80%, 90%)');
  const presets = ['#e2445a', '#f59e0b', '#2ea043', '#2563eb', '#8b5cf6'];
</script>

<ColorPicker value=$bind(color)>
  <div class="color-picker-styled">
    <ColorArea class="color-picker-styled-area" xChannel="saturation" yChannel="brightness" aria-label="Saturation and brightness">
      <ColorThumb class="color-picker-styled-thumb" />
    </ColorArea>
    <ColorSlider class="color-picker-styled-slider" channel="hue">
      <Label class="color-picker-styled-label">Hue</Label>
      <SliderTrack class="color-picker-styled-track">
        <ColorThumb class="color-picker-styled-thumb" />
      </SliderTrack>
    </ColorSlider>
    <div class="color-picker-styled-row">
      <ColorField class="color-picker-styled-field">
        <Label class="color-picker-styled-label">Hex</Label>
        <Input class="color-picker-styled-input" />
      </ColorField>
      <ColorSwatch class="color-picker-styled-swatch" />
    </div>
    <ColorSwatchPicker class="color-picker-styled-presets" aria-label="Presets">
      #for (item of presets by item) {
        <ColorSwatchPickerItem class="color-picker-styled-preset" color=item>
          <ColorSwatch class="color-picker-styled-dot" />
        </ColorSwatchPickerItem>
      }
    </ColorSwatchPicker>
  </div>
</ColorPicker>

<style>
  /* The tokens. Change these and the rest follows. */
  :global(.color-picker-styled) {
    --color-picker-styled-page: Canvas;
    --color-picker-styled-edge: color-mix(in srgb, CanvasText 50%, Canvas);
    --color-picker-styled-accent: light-dark(#2a76b2, #6fb2e6);
    display: grid;
    gap: 0.9rem;
    width: min(100%, 15rem);
    color: CanvasText;
  }

  :global(.color-picker-styled-area) {
    height: 10rem;
    border-radius: 0.75rem;
    background: var(--area-background);
    background-blend-mode: var(--area-background-blend-mode);
    box-shadow: 0 0 0 1px var(--color-picker-styled-edge);
  }

  :global(.color-picker-styled-slider) {
    display: grid;
    gap: 0.3rem;
  }

  :global(.color-picker-styled-label) {
    font-weight: 600;
  }

  :global(.color-picker-styled-track) {
    height: 1.25rem;
    border-radius: 0.625rem;
    background: var(--track-background);
    box-shadow: 0 0 0 1px var(--color-picker-styled-edge);
  }

  :global(.color-picker-styled-thumb) {
    box-sizing: border-box;
    width: 1.5rem;
    height: 1.5rem;
    border: 3px solid #fff;
    border-radius: 50%;
    outline: none;
    box-shadow: 0 0 0 1.5px #000, inset 0 0 0 1.5px #000;
  }

  :global(.color-picker-styled-thumb[data-dragging]) {
    scale: 1.15;
  }

  :global(.color-picker-styled-thumb[data-focus-visible]) {
    box-shadow:
      0 0 0 1.5px #000,
      0 0 0 3.5px var(--color-picker-styled-page),
      0 0 0 6px var(--color-picker-styled-accent),
      inset 0 0 0 1.5px #000;
  }

  :global(.color-picker-styled-row) {
    display: flex;
    gap: 0.6rem;
    align-items: end;
  }

  :global(.color-picker-styled-field) {
    display: grid;
    flex: 1;
    gap: 0.3rem;
  }

  :global(.color-picker-styled-input) {
    width: 100%;
    box-sizing: border-box;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--color-picker-styled-edge);
    border-radius: 8px;
    background: var(--color-picker-styled-page);
    color: inherit;
    font: inherit;
    outline: none;
  }

  :global(.color-picker-styled-input[data-hovered]) {
    border-color: var(--color-picker-styled-accent);
  }

  :global(.color-picker-styled-input[data-focus-visible]) {
    border-color: var(--color-picker-styled-accent);
    box-shadow: 0 0 0 2px var(--color-picker-styled-page), 0 0 0 4px var(--color-picker-styled-accent);
  }

  :global(.color-picker-styled-swatch) {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--color-picker-styled-edge);
  }

  :global(.color-picker-styled-presets) {
    display: flex;
    gap: 0.4rem;
    outline: none;
  }

  :global(.color-picker-styled-preset) {
    padding: 3px;
    border-radius: 50%;
    outline: none;
    box-shadow: 0 0 0 2px transparent;
    cursor: pointer;
  }

  :global(.color-picker-styled-preset[data-hovered]) {
    box-shadow: 0 0 0 2px var(--color-picker-styled-edge);
  }

  :global(.color-picker-styled-preset[data-selected]) {
    box-shadow: 0 0 0 3px var(--color-picker-styled-accent);
  }

  :global(.color-picker-styled-preset[data-selected][data-hovered]) {
    box-shadow: 0 0 0 5px var(--color-picker-styled-accent);
  }

  :global(.color-picker-styled-preset[data-pressed]) {
    scale: 0.92;
  }

  :global(.color-picker-styled-preset[data-focus-visible]) {
    box-shadow: 0 0 0 2px var(--color-picker-styled-page), 0 0 0 5px var(--color-picker-styled-accent);
  }

  :global(.color-picker-styled-dot) {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 25%);
  }

</style>
