<script>
  import ListBox from '@brumate/ui/ListBox.brm';
  import ListBoxItem from '@brumate/ui/ListBoxItem.brm';

  const names = ['Aardvark', 'Cat', 'Dog', 'Kangaroo', 'Panda'];
</script>

<ListBox class="sl" aria-label="Animals" selectionMode="multiple" selectedKeys=(['cat', 'dog'])>
  #for (name of names by name) {
    <ListBoxItem id=(name.toLowerCase()) class="sl-item" isDisabled=(name === 'Panda')>{name}</ListBoxItem>
  }
</ListBox>

<style>
  :global(.sl) {
    --sl-accent: #2a76b2;
    --sl-on-accent: #fff;
    display: grid;
    width: min(16rem, 100%);
    padding: 0.25rem;
    border: 1px solid color-mix(in srgb, CanvasText 25%, Canvas);
    border-radius: 10px;
    background: Canvas;
    color: CanvasText;
    outline: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(.sl) {
      --sl-accent: #6fb2e6;
      --sl-on-accent: #101418;
    }
  }

  :global(.sl[data-focus-visible]) {
    outline: 2px solid var(--sl-accent);
    outline-offset: 2px;
  }

  :global(.sl-item) {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    outline: none;
    transition: background 0.1s;
  }

  :global(.sl-item[data-hovered]) {
    background: color-mix(in srgb, var(--sl-accent) 12%, Canvas);
  }

  /* The ring follows the keyboard, not the pointer. */
  :global(.sl-item[data-focus-visible]) {
    box-shadow: inset 0 0 0 2px var(--sl-accent);
  }

  :global(.sl-item[data-selected]) {
    background: var(--sl-accent);
    color: var(--sl-on-accent);
  }

  :global(.sl-item[data-selected])::after {
    content: '✓';
  }

  :global(.sl-item[data-disabled]) {
