<script>
  import ListBox from '@brumate/ui/ListBox.brm';
  import ListBoxItem from '@brumate/ui/ListBoxItem.brm';

  const names = ['Aardvark', 'Cat', 'Dog', 'Kangaroo', 'Panda'];
</script>

<ListBox class="styling-list" aria-label="Animals" selectionMode="multiple" selectedKeys=(['cat', 'dog'])>
  #for (name of names by name) {
    <ListBoxItem id=(name.toLowerCase()) class="styling-list-item" isDisabled=(name === 'Panda')>{name}</ListBoxItem>
  }
</ListBox>

<style>
  :global(.styling-list) {
    /* light-dark() follows color-scheme, which the page sets for its theme. */
    --styling-list-accent: light-dark(#2a76b2, #6fb2e6);
    --styling-list-on-accent: light-dark(#fff, #101418);
    display: grid;
    width: min(16rem, 100%);
    padding: 0.25rem;
    border: 1px solid color-mix(in srgb, CanvasText 25%, Canvas);
    border-radius: 10px;
    background: Canvas;
    color: CanvasText;
    outline: none;
  }

  :global(.styling-list[data-focus-visible]) {
    outline: 2px solid var(--styling-list-accent);
    outline-offset: 2px;
  }

  :global(.styling-list-item) {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    outline: none;
    transition: background 0.1s;
  }

  :global(.styling-list-item[data-hovered]) {
    background: color-mix(in srgb, var(--styling-list-accent) 12%, Canvas);
  }

  /*
    The ring follows the keyboard, not the pointer. It has two bands, an accent one and an inner
    one in the page color, so it shows on the page and on the accent fill of a selected item.
  */
  :global(.styling-list-item[data-focus-visible]) {
    box-shadow:
      inset 0 0 0 2px var(--styling-list-accent),
      inset 0 0 0 4px Canvas;
  }

  :global(.styling-list-item[data-selected]) {
    background: var(--styling-list-accent);
    color: var(--styling-list-on-accent);
  }

  :global(.styling-list-item[data-selected])::after {
    content: '✓';
  }

  :global(.styling-list-item[data-disabled]) {
    opacity: 0.45;
  }
</style>
