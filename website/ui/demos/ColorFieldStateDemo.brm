<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import ColorField from '@brumate/ui/ColorField.brm';
  import Input from '@brumate/ui/Input.brm';
  import Label from '@brumate/ui/Label.brm';

  let mine = $signal<string | null>('#2563eb');
  let asked = $signal<string | null>('#2563eb');
  let locked = $signal(false);
  let log = $signal('');
</script>

<form class="ui-stack">
  <ColorField class="ui-field">
    <Label>Own state</Label>
    <Input class="ui-input" />
  </ColorField>
  <ColorField class="ui-field" value="#f59e0b">
    <Label>Starts at orange, then keeps its own copy</Label>
    <Input class="ui-input" />
  </ColorField>
  <ColorField class="ui-field" value=$bind(mine) onChange=((next) => (log = `changed to ${next ?? 'empty'}`))>
    <Label>Writes your signal</Label>
    <Input class="ui-input" />
  </ColorField>
  <ColorField class="ui-field" value=$bind(asked, (next) => { if (!locked) asked = next; })>
    <Label>Asks you first</Label>
    <Input class="ui-input" />
  </ColorField>
  <div class="ui-row">
    <Button class="ui-button" onClick=(() => (locked = !locked))>{locked ? 'Unlock' : 'Lock'} the signal</Button>
    <Button type="reset" class="ui-button">Reset the form</Button>
  </div>
  <p>Writes: {mine ?? 'empty'}. Asks: {asked ?? 'empty'}. Last callback: {log || 'none'}.</p>
</form>
