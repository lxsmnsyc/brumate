    color: var(--styling-button-on-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, scale 0.1s;
  }

  .styling-button[data-hovered] {
    background: color-mix(in srgb, var(--styling-button-accent) 85%, CanvasText);
  }

  .styling-button[data-pressed] {
    scale: 0.97;
  }

  .styling-button[data-focus-visible] {
    outline: 2px solid var(--styling-button-accent);
    outline-offset: 2px;
  }

  .styling-button[data-disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* A pending button keeps its focus and presses nothing. */
  .styling-button[data-pending] {
