    color: var(--sb-on-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, scale 0.1s;
  }

  @media (prefers-color-scheme: dark) {
    :global(.sb) {
      --sb-accent: #6fb2e6;
      --sb-on-accent: #101418;
    }
  }

  :global(.sb[data-hovered]) {
    background: color-mix(in srgb, var(--sb-accent) 85%, CanvasText);
  }

  :global(.sb[data-pressed]) {
    scale: 0.97;
  }

  :global(.sb[data-focus-visible]) {
    outline: 2px solid var(--sb-accent);
    outline-offset: 2px;
  }

  :global(.sb[data-disabled]) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* A pending button keeps its focus and presses nothing. */
  :global(.sb[data-pending]) {
    cursor: progress;
    opacity: 0.7;
  }

  :global(.sb-quiet) {
    border-color: color-mix(in srgb, CanvasText 25%, Canvas);
    background: transparent;
