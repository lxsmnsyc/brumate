<Button class="styling-button" onPress=(() => saved++)>Save ({saved})</Button>
<Button class="styling-button styling-button-quiet">Cancel</Button>
<Button class="styling-button" isDisabled>Disabled</Button>
<Button class="styling-button" isPending>Pending</Button>

