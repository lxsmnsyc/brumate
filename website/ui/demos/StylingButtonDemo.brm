<script>
  import { $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';

  let saved = $signal(0);
</script>

<Button class="sb" onPress=(() => saved++)>Save ({saved})</Button>
<Button class="sb sb-quiet">Cancel</Button>
<Button class="sb" isDisabled>Disabled</Button>
<Button class="sb" isPending>Pending</Button>

<style>
  :global(.sb) {
    --sb-accent: #2a76b2;
