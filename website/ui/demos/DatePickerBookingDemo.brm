<script>
  import { prevent } from 'brumate/events';
  import { $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import Calendar from '@brumate/ui/Calendar.brm';
  import CalendarGrid from '@brumate/ui/CalendarGrid.brm';
  import CalendarHeading from '@brumate/ui/CalendarHeading.brm';
  import DateInput from '@brumate/ui/DateInput.brm';
  import DatePicker from '@brumate/ui/DatePicker.brm';
  import Dialog from '@brumate/ui/Dialog.brm';
  import Group from '@brumate/ui/Group.brm';
  import Label from '@brumate/ui/Label.brm';
  import Popover from '@brumate/ui/Popover.brm';
  import FieldError from '@brumate/ui/FieldError.brm';
  import Form from '@brumate/ui/Form.brm';
  import Text from '@brumate/ui/Text.brm';

  let sent = $signal('Nothing sent.');
  // Mondays and two days are taken.
  const taken = ['2026-11-04', '2026-11-05'];

  function isTaken(date: string) {
    return taken.includes(date) || new Date(`${date}T00:00:00Z`).getUTCDay() === 1;
  }

  function submit(event: SubmitEvent) {
    const form = event.currentTarget as HTMLFormElement;
    if (form.querySelector('[data-invalid]')) {
      sent = 'Fix the field first.';
      return;
    }
    const data = new FormData(form);
    sent = `Sent visit=${data.get('visit')}.`;
  }
</script>

<Form class="ui-form" onSubmit=(prevent(submit))>
  <DatePicker class="ui-field" name="visit" isRequired minValue="2026-11-02" maxValue="2027-02-28" isDateUnavailable=isTaken>
    <Label>Visit</Label>
    <Group class="ui-group">
      <DateInput class="ui-input ui-date-input" />
      <Button class="ui-button ui-icon-button" aria-label="Calendar">▾</Button>
    </Group>
    <Text slot="description" class="ui-help">From the 2nd of November. Mondays and the 4th and 5th are taken.</Text>
    <FieldError class="ui-error">Pick a free day from the 2nd of November.</FieldError>
    <Popover class="ui-popover">
      <Dialog>
        <Calendar class="ui-calendar">
          <header>
            <Button slot="previous" class="ui-button ui-icon-button">‹</Button>
            <CalendarHeading />
            <Button slot="next" class="ui-button ui-icon-button">›</Button>
          </header>
          <CalendarGrid />
        </Calendar>
      </Dialog>
    </Popover>
  </DatePicker>
  <div class="ui-row">
    <Button type="submit" class="ui-button">Book</Button>
    <Button type="reset" class="ui-button">Reset</Button>
  </div>
  <p role="status">{sent}</p>
</Form>
