<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import Disclosure from '@brumate/ui/Disclosure.brm';
  import DisclosureGroup from '@brumate/ui/DisclosureGroup.brm';
  import DisclosurePanel from '@brumate/ui/DisclosurePanel.brm';

  let open = $signal(['address']);
  let done = $signal<string[]>([]);
</script>

<DisclosureGroup class="ui-accordion" expandedKeys=$bind(open)>
  <Disclosure id="address" class="ui-disclosure">
    <Button slot="trigger" class="ui-disclosure-trigger">1. Address{done.includes('address') ? ' (done)' : ''}</Button>
    <DisclosurePanel transition class="ui-disclosure-panel">
      <p>12 Mill Road, Leeds.</p>
      <p><Button class="ui-button" onPress=(() => { done = [...done, 'address']; open = ['payment']; })>Continue</Button></p>
    </DisclosurePanel>
  </Disclosure>
  <Disclosure id="payment" class="ui-disclosure">
    <Button slot="trigger" class="ui-disclosure-trigger">2. Payment{done.includes('payment') ? ' (done)' : ''}</Button>
    <DisclosurePanel transition class="ui-disclosure-panel">
      <p>Card ending in 4242.</p>
      <p><Button class="ui-button" onPress=(() => { done = [...done, 'payment']; open = []; })>Finish</Button></p>
    </DisclosurePanel>
  </Disclosure>
</DisclosureGroup>
