<!-- The picture draws the trigger and the Popover as blocks of their own, since a real Popover renders in a layer at the end of <body>. -->
<Button class="ui-button" data-mark="1">Rename</Button>
<div class="ui-popover" style="position: relative; width: min(100%, 22rem)" data-mark="2">
  <Dialog class="ui-dialog" style="padding: 0.5rem; border: 1px dashed var(--muted); border-radius: 6px"  data-mark="3" data-mark-side="bottom">
    <Heading slot="title" level=(4) class="anatomy-self" data-mark="4" data-mark-side="after">Rename the file</Heading>
    <p>The title names the dialog.</p>
    <Button slot="close" class="ui-button" style="justify-self: start" data-mark="5">Done</Button>
  </Dialog>
</div>

<style>
  :global(.anatomy-self) {
    justify-self: start;
  }
</style>
