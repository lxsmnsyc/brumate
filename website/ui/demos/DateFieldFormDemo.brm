<script>
  import { prevent } from 'brumate/events';
  import { $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import DateField from '@brumate/ui/DateField.brm';
  import DateInput from '@brumate/ui/DateInput.brm';
  import FieldError from '@brumate/ui/FieldError.brm';
  import Form from '@brumate/ui/Form.brm';
  import Label from '@brumate/ui/Label.brm';
  import Text from '@brumate/ui/Text.brm';

  let sent = $signal('Nothing sent.');

  function submit(event: SubmitEvent) {
    const form = event.currentTarget as HTMLFormElement;
    if (form.querySelector('[data-invalid]')) {
      sent = 'Fix the field first.';
      return;
    }
    const data = new FormData(form);
    sent = `Sent birthday=${data.get('birthday')}.`;
  }
</script>

<Form class="ui-form" onSubmit=(prevent(submit))>
  <DateField class="ui-field" name="birthday" isRequired minValue="1900-01-01" maxValue="2026-12-31" value="2000-02-29">
    <Label>Birthday</Label>
    <DateInput class="ui-input ui-date-input" />
    <Text slot="description" class="ui-help">Empty a segment with Backspace, or type a year before 1900, and press Save.</Text>
    <FieldError class="ui-error">Pick a date from 1900 to 2026.</FieldError>
  </DateField>
  <div class="ui-row">
    <Button type="submit" class="ui-button">Save</Button>
    <Button type="reset" class="ui-button">Reset</Button>
  </div>
  <p role="status">{sent}</p>
</Form>
