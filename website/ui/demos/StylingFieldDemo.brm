  <TextField class="styling-field" isDisabled value="Locked">
    <Label class="styling-field-label">Plan</Label>
    <Input class="styling-field-input" />
  </TextField>
  <Button type="submit" class="styling-field-submit">Send</Button>
</Form>

<style>
  :global(.styling-field-form) {
