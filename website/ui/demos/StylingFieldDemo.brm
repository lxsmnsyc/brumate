  :global(.styling-field-label) {
    font-weight: 600;
  }

  :global(.styling-field-input) {
    padding: 0.5rem 0.75rem;
    border: 1px solid color-mix(in srgb, CanvasText 25%, Canvas);
    border-radius: 8px;
    background: Canvas;
    color: CanvasText;
    font: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  :global(.styling-field-input[data-hovered]) {
    border-color: var(--styling-field-accent);
  }

  :global(.styling-field-input[data-focused]) {
    border-color: var(--styling-field-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--styling-field-accent) 25%, transparent);
    outline: none;
  }

  :global(.styling-field-input[data-invalid]) {
    border-color: var(--styling-field-danger);
  }

  :global(.styling-field-input[data-invalid][data-focused]) {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--styling-field-danger) 25%, transparent);
  }

  :global(.styling-field-input[data-disabled]) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* The field carries the state of the whole group, so a label can use it too. */
  :global(.styling-field[data-invalid] .styling-field-label) {
    color: var(--styling-field-danger);
  }

  :global(.styling-field-help) {
    color: color-mix(in srgb, CanvasText 60%, Canvas);
