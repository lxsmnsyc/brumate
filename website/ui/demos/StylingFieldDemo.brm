<Form class="sf-form">
  <TextField class="sf" name="email" type="email" isRequired>
    <Label class="sf-label">Email</Label>
    <Input class="sf-input" />
    <Text slot="description" class="sf-help">We send the receipt here.</Text>
    <FieldError class="sf-error" />
  </TextField>
  <TextField class="sf" isDisabled value="Locked">
    <Label class="sf-label">Plan</Label>
    <Input class="sf-input" />
  </TextField>
  <Button type="submit" class="sf-submit">Send</Button>
</Form>

