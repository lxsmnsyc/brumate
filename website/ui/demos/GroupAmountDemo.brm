<script>
  import { $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import Group from '@brumate/ui/Group.brm';
  import Icon from '../../src/components/Icon.brm';

  let amount = $signal(2);
</script>

<div class="ui-stack">
  <Group class="ui-group" aria-label="Quantity" isInvalid=(amount > 5)>
    <Button class="ui-button ui-icon-button" aria-label="One less" onPress=(() => (amount = Math.max(1, amount - 1)))><Icon name="minus" /></Button>
    <output class="ui-input" aria-live="polite">{amount}</output>
    <Button class="ui-button ui-icon-button" aria-label="One more" onPress=(() => amount++)><Icon name="plus" /></Button>
  </Group>
  <p>{amount > 5 ? 'The group is invalid: the shop stocks 5.' : `${amount} in the basket.`}</p>
</div>
