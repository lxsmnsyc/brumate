<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import Calendar from '@brumate/ui/Calendar.brm';
  import CalendarGrid from '@brumate/ui/CalendarGrid.brm';
  import CalendarHeading from '@brumate/ui/CalendarHeading.brm';
  import DateInput from '@brumate/ui/DateInput.brm';
  import DatePicker from '@brumate/ui/DatePicker.brm';
  import Dialog from '@brumate/ui/Dialog.brm';
  import Group from '@brumate/ui/Group.brm';
  import Label from '@brumate/ui/Label.brm';
  import Popover from '@brumate/ui/Popover.brm';
  import I18nProvider from '@brumate/ui/I18nProvider.brm';

  let date = $signal<string | null>(null);
</script>

<div class="ui-row" style="align-items: start; flex-wrap: wrap">
  <I18nProvider locale="de-DE" timeZone="Europe/Berlin">
    <DatePicker class="ui-field" value=$bind(date)>
      <Label>Abreise</Label>
      <Group class="ui-group">
        <DateInput class="ui-input ui-date-input" />
        <Button class="ui-button ui-icon-button">▾</Button>
      </Group>
      <Popover class="ui-popover">
        <Dialog>
          <Calendar class="ui-calendar">
            <header>
              <Button slot="previous" class="ui-button ui-icon-button">‹</Button>
              <CalendarHeading />
              <Button slot="next" class="ui-button ui-icon-button">›</Button>
            </header>
            <CalendarGrid />
          </Calendar>
        </Dialog>
      </Popover>
    </DatePicker>
  </I18nProvider>
  <I18nProvider locale="ja-JP" timeZone="Asia/Tokyo">
    <DatePicker class="ui-field" value=$bind(date)>
      <Label>出発日</Label>
      <Group class="ui-group">
        <DateInput class="ui-input ui-date-input" />
        <Button class="ui-button ui-icon-button">▾</Button>
      </Group>
      <Popover class="ui-popover">
        <Dialog>
          <Calendar class="ui-calendar">
            <header>
              <Button slot="previous" class="ui-button ui-icon-button">‹</Button>
              <CalendarHeading />
              <Button slot="next" class="ui-button ui-icon-button">›</Button>
            </header>
            <CalendarGrid />
          </Calendar>
        </Dialog>
      </Popover>
    </DatePicker>
  </I18nProvider>
</div>
<p>Value: {date ?? 'empty'}. The two pickers share one signal. The segments, the Calendar and the name of the Button for a screen reader follow the locale of each provider.</p>
