<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import DateInput from '@brumate/ui/DateInput.brm';
  import Label from '@brumate/ui/Label.brm';
  import TimeField from '@brumate/ui/TimeField.brm';

  let mine = $signal<string | null>('09:30');
  let asked = $signal<string | null>('09:30');
  let locked = $signal(false);
  let log = $signal('');
</script>

<form class="ui-stack">
  <TimeField class="ui-field">
    <Label>Own state</Label>
    <DateInput class="ui-input ui-date-input" />
  </TimeField>
  <TimeField class="ui-field" value="09:30">
    <Label>Starts at 9:30, then keeps its own copy</Label>
    <DateInput class="ui-input ui-date-input" />
  </TimeField>
  <TimeField class="ui-field" value=$bind(mine) onChange=((next) => (log = `changed to ${next ?? 'empty'}`))>
    <Label>Writes your signal</Label>
    <DateInput class="ui-input ui-date-input" />
  </TimeField>
  <TimeField class="ui-field" value=$bind(asked, (next) => { if (!locked) asked = next; })>
    <Label>Asks you first</Label>
    <DateInput class="ui-input ui-date-input" />
  </TimeField>
  <div class="ui-row">
    <Button class="ui-button" onClick=(() => (locked = !locked))>{locked ? 'Unlock' : 'Lock'} the signal</Button>
    <Button type="reset" class="ui-button">Reset the form</Button>
  </div>
  <p>Writes: {mine ?? 'empty'}. Asks: {asked ?? 'empty'}. Last callback: {log || 'none'}.</p>
</form>
