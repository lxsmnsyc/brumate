<script>
  import { $bind, $signal } from 'brumate/signals';
  import Fieldset from '@brumate/ui/Fieldset.brm';
  import Input from '@brumate/ui/Input.brm';
  import Label from '@brumate/ui/Label.brm';
  import Legend from '@brumate/ui/Legend.brm';
  import Switch from '@brumate/ui/Switch.brm';
  import TextField from '@brumate/ui/TextField.brm';

  let locked = $signal(false);
</script>

<Switch class="fieldset-styled-switch" isSelected=$bind(locked)>Lock the address</Switch>
<Fieldset class="fieldset-styled" isDisabled=locked>
  <Legend class="fieldset-styled-legend">Address</Legend>
  <TextField class="fieldset-styled-field" name="street" value="1 Main Street">
    <Label>Street</Label>
    <Input class="fieldset-styled-input" />
  </TextField>
</Fieldset>

