<script>
  import SelectionIndicator from '@brumate/ui/SelectionIndicator.brm';
  import Tab from '@brumate/ui/Tab.brm';
  import TabList from '@brumate/ui/TabList.brm';
  import TabPanel from '@brumate/ui/TabPanel.brm';
  import Tabs from '@brumate/ui/Tabs.brm';

  const views = [
    { id: 'overview', name: 'Overview', text: 'The numbers of the week, in one place.' },
    { id: 'activity', name: 'Activity', text: 'Who did what, and when.' },
    { id: 'billing', name: 'Billing', text: 'Closed for this plan.' },
    { id: 'settings', name: 'Settings', text: 'Names, keys and notices.' },
  ];
</script>

<Tabs class="tabs-styled" disabledKeys=(['billing'])>
  <TabList class="tabs-styled-list" aria-label="Views">
    #for (view of views by view.id) {
      <Tab id=(view.id) class="tabs-styled-tab">{view.name}<SelectionIndicator class="tabs-styled-bar" /></Tab>
    }
  </TabList>
  #for (view of views by view.id) {
    <TabPanel id=(view.id) class="tabs-styled-panel">{view.text}</TabPanel>
  }
</Tabs>

<style>
  /* The tokens. Change these and the rest follows. */
  :global(.tabs-styled) {
    /* light-dark() follows color-scheme, which the page sets for its theme. */
    --tabs-styled-bg: Canvas;
    --tabs-styled-text: CanvasText;
    --tabs-styled-muted: color-mix(in srgb, CanvasText 60%, Canvas);
    --tabs-styled-border: color-mix(in srgb, CanvasText 25%, Canvas);
    --tabs-styled-accent: light-dark(#2a76b2, #6fb2e6);
    --tabs-styled-radius: 8px;
    max-width: 30rem;
    color: var(--tabs-styled-text);
  }

  :global(.tabs-styled-list) {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--tabs-styled-border);
  }

  /* A tab: rest, hover, press, keyboard focus, selected and disabled. */
  :global(.tabs-styled-tab) {
    position: relative;
    padding: 0.5rem 0.9rem;
    border-radius: var(--tabs-styled-radius) var(--tabs-styled-radius) 0 0;
    color: var(--tabs-styled-muted);
    outline: none;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  :global(.tabs-styled-tab[data-hovered]) {
    background: color-mix(in srgb, var(--tabs-styled-accent) 12%, var(--tabs-styled-bg));
    color: var(--tabs-styled-text);
  }

  :global(.tabs-styled-tab[data-pressed]) {
    background: color-mix(in srgb, var(--tabs-styled-accent) 24%, var(--tabs-styled-bg));
  }

  :global(.tabs-styled-tab[data-selected]) {
    color: var(--tabs-styled-text);
    font-weight: 600;
  }

  /* A selected tab that is hovered or pressed keeps its bar and takes the tint. */
  :global(.tabs-styled-tab[data-selected][data-hovered]) {
    background: color-mix(in srgb, var(--tabs-styled-accent) 16%, var(--tabs-styled-bg));
  }

  :global(.tabs-styled-tab[data-selected][data-pressed]) {
    background: color-mix(in srgb, var(--tabs-styled-accent) 28%, var(--tabs-styled-bg));
  }

  /* Two bands, so the ring shows on the page and on the tint of a hovered tab. */
  :global(.tabs-styled-tab[data-focus-visible]) {
    box-shadow:
      inset 0 0 0 2px var(--tabs-styled-accent),
      inset 0 0 0 4px var(--tabs-styled-bg);
  }

  :global(.tabs-styled-tab[data-disabled]) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* The bar slides from the last selected tab to the new one. */
  :global(.tabs-styled-bar) {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: var(--tabs-styled-accent);
    transition-duration: 0.25s;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  :global(.tabs-styled-panel) {
    padding: 0.9rem 0.25rem;
    outline: none;
  }

  :global(.tabs-styled-panel:focus-visible) {
    border-radius: var(--tabs-styled-radius);
    box-shadow:
      inset 0 0 0 2px var(--tabs-styled-accent),
      inset 0 0 0 4px var(--tabs-styled-bg);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.tabs-styled-tab) {
      transition: none;
    }

    :global(.tabs-styled-bar) {
      transition-duration: 0s;
    }
  }
</style>
