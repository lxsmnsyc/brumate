<script>
  import { $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import FileTrigger from '@brumate/ui/FileTrigger.brm';

  let name = $signal('');
</script>

<div class="file-styled-row">
  <FileTrigger onSelect=((files) => (name = files?.[0]?.name ?? ''))>
    <Button class="file-styled-button">Upload a file</Button>
  </FileTrigger>
  <span class="file-styled-name">{name || 'Nothing chosen'}</span>
</div>

<style>
  /* The tokens. Change these and the rest follows. */
  :global(.file-styled-row) {
    --file-styled-border: color-mix(in srgb, CanvasText 35%, Canvas);
    --file-styled-accent: light-dark(#2a76b2, #6fb2e6);
    --file-styled-muted: color-mix(in srgb, CanvasText 60%, Canvas);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: CanvasText;
  }

  /* The trigger draws no element, so the Button inside it carries every state. */
  :global(.file-styled-button) {
    padding: 0.5rem 1rem;
    border: 1px dashed var(--file-styled-border);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
  }

  :global(.file-styled-button[data-hovered]) {
    border-color: var(--file-styled-accent);
    border-style: solid;
  }

  :global(.file-styled-button[data-pressed]) {
    background: color-mix(in srgb, var(--file-styled-accent) 16%, transparent);
  }

  :global(.file-styled-button[data-focus-visible]) {
    outline: 2px solid var(--file-styled-accent);
    outline-offset: 2px;
  }

  :global(.file-styled-button[data-disabled]) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  :global(.file-styled-name) {
    color: var(--file-styled-muted);
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.file-styled-button) {
      transition: none;
    }
  }
</style>
