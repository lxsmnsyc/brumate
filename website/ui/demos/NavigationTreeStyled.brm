<script>
  import { $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import NavigationTree from '@brumate/ui/NavigationTree.brm';
  import NavigationTreeItem from '@brumate/ui/NavigationTreeItem.brm';
  import NavigationTreeItemLink from '@brumate/ui/NavigationTreeItemLink.brm';
  import type { NavigationNode } from '@brumate/ui/navigation-tree.ts';

  interface Page extends NavigationNode {
    title: string;
    children?: Page[];
  }
  const pages: Page[] = [
    { id: 'start', title: 'Getting started', href: '#start' },
    {
      id: 'guides',
      title: 'Guides',
      children: [
        { id: 'forms', title: 'Forms', href: '#forms' },
        { id: 'tables', title: 'Tables', href: '#tables' },
        { id: 'soon', title: 'Charts', href: '#charts' },
      ],
    },
    { id: 'api', title: 'API', href: '#api' },
  ];
  let route = $signal('#tables');
</script>

<div class="nav-styled-demo">
  <nav aria-label="Guide pages">
    <NavigationTree class="nav-styled" aria-label="Guide pages" items=pages item=page selectedRoute=(route) expandedKeys=(['guides']) disabledKeys=(['soon']) />
  </nav>
</div>

#template page(page) {
  <NavigationTreeItem class="nav-styled-item" textValue=(page.title) href=(page.href)>
    #if (page.children) {
      <Button slot="chevron" class="nav-styled-chevron" aria-hidden="true"></Button>
    } #else {
      <span class="nav-styled-gap" aria-hidden="true"></span>
    }
    <NavigationTreeItemLink class="nav-styled-link" onClick=(() => (route = page.href ?? route))>{page.title}</NavigationTreeItemLink>
  </NavigationTreeItem>
}

<style>
  /* The tokens. Change these and the rest follows. */
  :global(.nav-styled-demo) {
    --nav-styled-bg: Canvas;
    --nav-styled-text: CanvasText;
    --nav-styled-muted: color-mix(in srgb, CanvasText 68%, Canvas);
    --nav-styled-border: color-mix(in srgb, CanvasText 30%, Canvas);
    --nav-styled-accent: light-dark(#2a76b2, #6fb2e6);
    --nav-styled-hover: color-mix(in srgb, var(--nav-styled-accent) 10%, Canvas);
    --nav-styled-current: color-mix(in srgb, var(--nav-styled-accent) 22%, Canvas);
    color: var(--nav-styled-text);
  }

  :global(.nav-styled) {
    display: grid;
    width: min(20rem, 100%);
    padding: 0.25rem;
    border: 1px solid var(--nav-styled-border);
    border-radius: 8px;
    background: var(--nav-styled-bg);
  }

  /* A row: rest, hover, press, the page that shows, a closed row that holds it, keyboard focus. */
  :global(.nav-styled-item) {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.1rem 0.5rem;
    padding-inline-start: calc(0.5rem + (var(--tree-item-level) - 1) * 1.25rem);
    border-radius: 6px;
    outline: none;
  }

  :global(.nav-styled-item[data-hovered]) {
    background: var(--nav-styled-hover);
  }

  :global(.nav-styled-item[data-pressed]) {
    background: color-mix(in srgb, var(--nav-styled-accent) 30%, Canvas);
  }

  :global(.nav-styled-item[data-current]) {
    background: var(--nav-styled-current);
  }

  :global(.nav-styled-item[data-current-ancestor])::after {
    width: 6px;
    height: 6px;
    margin-inline-start: auto;
    border-radius: 50%;
    background: var(--nav-styled-accent);
    content: '';
  }

  :global(.nav-styled-item[data-focus-visible]),
  :global(.nav-styled-item:has(.nav-styled-link:focus-visible)) {
    box-shadow:
      inset 0 0 0 2px var(--nav-styled-accent),
      inset 0 0 0 4px var(--nav-styled-bg);
  }

  /* The link fills the row, so a press anywhere on the row follows it. */
  :global(.nav-styled-link) {
    flex: 1;
    padding-block: 0.3rem;
    color: inherit;
    text-decoration: none;
    outline: none;
  }

  :global(.nav-styled-link[aria-current='page']) {
    font-weight: 600;
  }

  :global(.nav-styled-link[data-disabled]) {
    color: var(--nav-styled-muted);
    text-decoration: line-through;
  }

  :global(.nav-styled-chevron),
  :global(.nav-styled-gap) {
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
  }

  :global(.nav-styled-chevron)::before {
    display: block;
    content: '▸';
    text-align: center;
    transition: rotate 0.15s;
  }

  :global(.nav-styled-item[data-expanded] .nav-styled-chevron)::before {
    rotate: 90deg;
  }

  :global(.nav-styled-item:dir(rtl) .nav-styled-chevron)::before {
    content: '◂';
  }

  :global(.nav-styled-item[data-expanded]:dir(rtl) .nav-styled-chevron)::before {
    rotate: -90deg;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.nav-styled-chevron)::before {
      transition: none;
    }
  }
</style>
