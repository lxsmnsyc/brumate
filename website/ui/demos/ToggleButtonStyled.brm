    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }

  :global(.toggle-styled[data-hovered]) {
    border-color: var(--toggle-styled-accent);
  }

  :global(.toggle-styled[data-pressed]) {
    background: color-mix(in srgb, var(--toggle-styled-accent) 18%, var(--toggle-styled-bg));
