<script>
  import { $bind, $signal } from 'brumate/signals';
  import ColorSwatch from '@brumate/ui/ColorSwatch.brm';
  import ColorSwatchPicker from '@brumate/ui/ColorSwatchPicker.brm';
  import ColorSwatchPickerItem from '@brumate/ui/ColorSwatchPickerItem.brm';

  let color = $signal('#2ea043');
  const colors = ['#e2445a', '#f59e0b', '#2ea043', '#2563eb', '#8b5cf6'];
</script>

<div class="ui-stack">
  <ColorSwatchPicker class="ui-swatch-picker" aria-label="Tag color" layout="stack" value=$bind(color)>
    #for (item of colors by item) {
      <ColorSwatchPickerItem class="ui-swatch-option" color=item><ColorSwatch class="ui-swatch" /></ColorSwatchPickerItem>
    }
  </ColorSwatchPicker>
  <p>A stack moves with ArrowUp and ArrowDown only.</p>
  <span class="label-chip">
    <ColorSwatch class="label-chip-dot" color=color />
    bug
  </span>
</div>

<style>
  :global(.label-chip) {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    width: fit-content;
    padding: 0.2rem 0.7rem 0.2rem 0.4rem;
    border: 1px solid color-mix(in srgb, CanvasText 50%, Canvas);
    border-radius: 999px;
  }

  :global(.label-chip-dot) {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
  }
</style>
