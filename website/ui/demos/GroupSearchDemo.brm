<script>
  import { $bind, $signal } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import Button from '@brumate/ui/Button.brm';
  import Group from '@brumate/ui/Group.brm';
  import Input from '@brumate/ui/Input.brm';
  import Label from '@brumate/ui/Label.brm';
  import TextField from '@brumate/ui/TextField.brm';
  import VisuallyHidden from '@brumate/ui/VisuallyHidden.brm';

  let query = $signal('');
  let searched = $signal('');
</script>

<div class="ui-stack">
  <!-- A form, so Enter in the field searches as the button does. -->
  <form onSubmit=(prevent(() => (searched = query)))>
    <TextField value=$bind(query)>
      <Label><VisuallyHidden>Search the shop</VisuallyHidden></Label>
      <Group class="ui-group" aria-label="Search">
        <Input class="ui-input" placeholder="Search" />
        <Button type="submit" class="ui-button" isDisabled=(query === '')>Search</Button>
      </Group>
    </TextField>
  </form>
  <p>{searched === '' ? 'Nothing searched yet.' : `Searched for "${searched}".`}</p>
</div>
