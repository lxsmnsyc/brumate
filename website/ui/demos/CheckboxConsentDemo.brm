<script>
  import { prevent } from 'brumate/events';
  import { $bind, $memo, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import Checkbox from '@brumate/ui/Checkbox.brm';
  import FieldError from '@brumate/ui/FieldError.brm';
  import Form from '@brumate/ui/Form.brm';
  import Icon from '../../src/components/Icon.brm';
  import Text from '@brumate/ui/Text.brm';

  let accepted = $signal(false);
  let tried = $signal(false);
  let sent = $signal('');
  const blocked = $memo(tried && !accepted);

  function submit(event: SubmitEvent) {
    const data = new FormData(event.currentTarget as HTMLFormElement);
    tried = true;
    if (!accepted) {
      return;
    }
    sent = `Sent news=${data.get('news') ?? 'off'}.`;
  }
</script>

<Form class="ui-form" onSubmit=(prevent(submit))>
  <Checkbox class="ui-box" name="news" value="yes">
    <span class="ui-mark" aria-hidden="true"><Icon name="check" size=(12) /></span>
    Send me the newsletter
  </Checkbox>
  <Checkbox class="ui-box" isSelected=$bind(accepted) isInvalid=blocked>
    <span class="ui-mark" aria-hidden="true"><Icon name="check" size=(12) /></span>
    I accept the terms
    <Text slot="description" class="ui-help">Required.</Text>
    <FieldError class="ui-error">Accept the terms to continue.</FieldError>
  </Checkbox>
  <Button type="submit" class="ui-button">Create account</Button>
  <p role="status">{sent}</p>
</Form>
