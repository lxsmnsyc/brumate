<script>
  import Label from '@brumate/ui/Label.brm';
  import Meter from '@brumate/ui/Meter.brm';

  const disks = [
    { name: 'Photos', value: 38 },
    { name: 'Projects', value: 72 },
    { name: 'Backups', value: 94 },
  ];
</script>

#template bar(state) {
  <span class="meter-styled-track">
    <span class="meter-styled-fill" data-level=(state.percentage > 90 ? 'full' : state.percentage > 60 ? 'high' : 'low')></span>
  </span>
  <span class="meter-styled-value">{state.valueText}</span>
}

<div class="meter-styled-list">
  #for (disk of disks by disk.name) {
    <Meter class="meter-styled" value=(disk.value) content=bar>
      <Label class="meter-styled-label">{disk.name}</Label>
    </Meter>
  }
</div>

<style>
  /* The tokens. Change these and the rest follows. */
  :global(.meter-styled-list) {
    --meter-styled-track: color-mix(in srgb, CanvasText 18%, Canvas);
    --meter-styled-low: light-dark(#1d7a4a, #5fcf92);
    --meter-styled-high: light-dark(#a15c00, #f0b04a);
    --meter-styled-full: light-dark(#b3261e, #ff8a80);
    display: grid;
    gap: 1rem;
    width: 100%;
    max-width: 22rem;
    color: CanvasText;
  }

  /* The meter lays out the label, the bar and the value in a row of three. */
  :global(.meter-styled) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 1rem;
  }

  :global(.meter-styled-label) {
    font-weight: 600;
  }

  :global(.meter-styled-value) {
    font-variant-numeric: tabular-nums;
    grid-row: 1;
    grid-column: 2;
  }

  :global(.meter-styled-track) {
    grid-column: 1 / -1;
    height: 0.6rem;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--meter-styled-track);
  }

  /* The fill reads the width from --percentage, which the meter sets. */
  :global(.meter-styled-fill) {
    display: block;
    width: var(--percentage);
    height: 100%;
    border-radius: 1rem;
    transition: width 0.3s, background-color 0.3s;
  }

  :global(.meter-styled-fill[data-level='low']) {
    background: var(--meter-styled-low);
  }

  :global(.meter-styled-fill[data-level='high']) {
    background: var(--meter-styled-high);
  }

  :global(.meter-styled-fill[data-level='full']) {
    background: var(--meter-styled-full);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.meter-styled-fill) {
      transition: none;
    }
  }
</style>
