<script>
  import { $bind, $signal } from 'brumate/signals';
  import ToggleButton from '@brumate/ui/ToggleButton.brm';
  import ToggleButtonGroup from '@brumate/ui/ToggleButtonGroup.brm';

  let pinned = $signal(false);
  let align = $signal(['left']);
</script>

<ToggleButton class="ui-button" isSelected=$bind(pinned)>Pin</ToggleButton>
<ToggleButtonGroup class="ui-group" aria-label="Align" selectedKeys=$bind(align) disallowEmptySelection>
  <ToggleButton id="left" class="ui-button">Left</ToggleButton>
  <ToggleButton id="center" class="ui-button">Center</ToggleButton>
  <ToggleButton id="right" class="ui-button">Right</ToggleButton>
</ToggleButtonGroup>
<p>{pinned ? 'Pinned' : 'Not pinned'}, aligned {align[0]}.</p>
