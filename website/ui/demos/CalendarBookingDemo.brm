<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import Calendar from '@brumate/ui/Calendar.brm';
  import CalendarGrid from '@brumate/ui/CalendarGrid.brm';
  import CalendarHeading from '@brumate/ui/CalendarHeading.brm';

  let slot = $signal<string | null>(null);
  // Booked days and Mondays are taken.
  const booked = ['2026-11-04', '2026-11-05', '2026-11-12'];

  function taken(value: string) {
    return booked.includes(value) || new Date(`${value}T00:00:00Z`).getUTCDay() === 1;
  }
</script>

<Calendar
  class="ui-calendar"
  style="width: 34rem"
  aria-label="Appointment"
  value=$bind(slot)
  focusedValue="2026-11-02"
  minValue="2026-11-02"
  maxValue="2027-02-28"
  visibleDuration=({ months: 2 })
  firstDayOfWeek="mon"
  isDateUnavailable=taken
>
  <header>
    <Button slot="previous" class="ui-button ui-icon-button">‹</Button>
    <CalendarHeading />
    <Button slot="next" class="ui-button ui-icon-button">›</Button>
  </header>
  <div class="ui-row" style="align-items: start">
    <CalendarGrid />
    <CalendarGrid offset=({ months: 1 }) />
  </div>
</Calendar>
<p>{slot ? `Booked for ${slot}.` : 'Pick a day. Mondays and three days of November are taken.'}</p>
