<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import Dialog from '@brumate/ui/Dialog.brm';
  import Heading from '@brumate/ui/Heading.brm';
  import Input from '@brumate/ui/Input.brm';
  import Label from '@brumate/ui/Label.brm';
  import Modal from '@brumate/ui/Modal.brm';
  import ModalOverlay from '@brumate/ui/ModalOverlay.brm';
  import TextField from '@brumate/ui/TextField.brm';

  let saved = $signal('Hello');
  let draft = $signal('Hello');
  let open = $signal(false);
  let asking = $signal(false);

  function edit() {
    draft = saved;
    open = true;
  }

</script>

<p>Greeting: <strong>{saved}</strong></p>
<Button class="ui-button" onPress=edit>Edit the greeting</Button>
<ModalOverlay class="ui-backdrop" isOpen=$bind(open) isKeyboardDismissDisabled=(draft !== saved) transition>
  <Modal class="ui-modal">
    <Dialog class="ui-dialog">
      <Heading slot="title" level=(4)>Edit the greeting</Heading>
      <TextField class="ui-field" value=$bind(draft)>
        <Label>Greeting</Label>
        <Input class="ui-input" autofocus />
      </TextField>
      <p class="ui-help">{draft === saved ? 'Escape closes this.' : 'Changed. Escape is off until you save or cancel.'}</p>
      <div class="ui-actions">
        <Button class="ui-button" onPress=(() => { if (draft === saved) { open = false; } else { asking = true; } })>Cancel</Button>
        <Button class="ui-button" onPress=(() => { saved = draft; open = false; })>Save</Button>
      </div>
    </Dialog>
    <ModalOverlay class="ui-backdrop" isOpen=$bind(asking) transition>
      <Modal class="ui-modal">
        <Dialog role="alertdialog" class="ui-dialog">
          <Heading slot="title" level=(4)>Discard the changes?</Heading>
          <div class="ui-actions">
            <Button slot="close" class="ui-button" autofocus>Keep editing</Button>
            <Button class="ui-button" onPress=(() => { asking = false; open = false; })>Discard</Button>
          </div>
        </Dialog>
      </Modal>
    </ModalOverlay>
  </Modal>
</ModalOverlay>
