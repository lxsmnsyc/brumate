<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import ComboBox from '@brumate/ui/ComboBox.brm';
  import Input from '@brumate/ui/Input.brm';
  import Label from '@brumate/ui/Label.brm';
  import ListBox from '@brumate/ui/ListBox.brm';
  import ListBoxItem from '@brumate/ui/ListBoxItem.brm';
  import Popover from '@brumate/ui/Popover.brm';
  import type { Key } from '@brumate/ui/collection.ts';

  let key = $signal<Key | null>('dog');
  let text = $signal('Dog');
  let held = $signal<Key | null>(null);
  let locked = $signal(false);
  let log = $signal('');
  const animals = ['Cat', 'Dog', 'Panda'];
</script>

<form class="ui-stack">
  <ComboBox class="ui-select">
    <Label>Own state</Label>
    {box()}
  </ComboBox>
  <ComboBox class="ui-select" selectedKey=('cat') inputValue=('Cat')>
    <Label>Starts at Cat, then keeps its own copy</Label>
    {box()}
  </ComboBox>
  <ComboBox class="ui-select" selectedKey=$bind(key) inputValue=$bind(text) onSelectionChange=((next) => (log = `key ${next ?? 'null'}`))>
    <Label>Writes your signals</Label>
    {box()}
  </ComboBox>
  <ComboBox class="ui-select" selectedKey=$bind(held, (next) => { if (!locked) held = next; })>
    <Label>Asks you first</Label>
    {box()}
  </ComboBox>
  <div class="ui-row">
    <Button class="ui-button" onPress=(() => (locked = !locked))>{locked ? 'Unlock' : 'Lock'} the fourth</Button>
    <Button class="ui-button" onPress=(() => { key = 'panda'; text = 'Panda'; })>Write Panda to the third</Button>
    <Button type="reset" class="ui-button">Reset the form</Button>
  </div>
  <p>Third: key {key ?? 'none'}, text "{text}", last callback {log || 'none'}. Fourth key: {held ?? 'none'}.</p>
</form>

#template box() {
  <div class="ui-combobox-box">
    <Input class="ui-input" placeholder="Type to search" />
    <Button class="ui-button ui-select-button" />
  </div>
  <Popover class="ui-popover ui-select-popover">
    <ListBox class="ui-listbox">
      #for (name of animals by name) {
        <ListBoxItem id=(name.toLowerCase()) class="ui-option">{name}</ListBoxItem>
      }
    </ListBox>
  </Popover>
}
