<script>
  import Button from '@brumate/ui/Button.brm';
  import Dialog from '@brumate/ui/Dialog.brm';
  import DialogTrigger from '@brumate/ui/DialogTrigger.brm';
  import Heading from '@brumate/ui/Heading.brm';
  import Modal from '@brumate/ui/Modal.brm';
  import ModalOverlay from '@brumate/ui/ModalOverlay.brm';
</script>

<div class="modal-styled-root">
  <DialogTrigger>
    <Button class="modal-styled-trigger">Delete the draft</Button>
    <ModalOverlay class="modal-styled-backdrop" isDismissable transition>
      <Modal class="modal-styled-box">
        <Dialog role="alertdialog" class="modal-styled-dialog">
          <Heading slot="title" level=(4) class="modal-styled-title">Delete the draft?</Heading>
          <p class="modal-styled-text">It cannot come back. A press on the dim area keeps it.</p>
          <div class="modal-styled-actions">
            <Button slot="close" class="modal-styled-cancel">Cancel</Button>
            <Button slot="close" class="modal-styled-delete">Delete</Button>
          </div>
        </Dialog>
      </Modal>
    </ModalOverlay>
  </DialogTrigger>
</div>

<style>
  /* The tokens. Change these and the rest follows. light-dark() follows the color scheme of the page. */
  :global(.modal-styled-root),
  :global(.modal-styled-backdrop) {
    --modal-styled-bg: Canvas;
    --modal-styled-text: CanvasText;
