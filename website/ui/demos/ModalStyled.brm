    color: var(--modal-styled-text);
    font: inherit;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
  }

  :global(.modal-styled-cancel)[data-hovered] {
    border-color: var(--modal-styled-accent);
