<script>
  import TimeField from '@brumate/ui/TimeField.brm';
  import DateInput from '@brumate/ui/DateInput.brm';
  import DateSegment from '@brumate/ui/DateSegment.brm';
  import FieldError from '@brumate/ui/FieldError.brm';
  import Label from '@brumate/ui/Label.brm';
  import Text from '@brumate/ui/Text.brm';
  import type { Segment } from '@brumate/ui/segments.ts';
</script>

<TimeField class="ui-field" value="09:30" isInvalid style="width: fit-content" data-mark="1">
  <Label data-mark="2" data-mark-side="after">Start</Label>
  <DateInput class="ui-input ui-date-input" style="width: fit-content; padding-top: 1.7rem" segment=part data-mark="3" />
  <Text slot="description" class="ui-help" data-mark="5" data-mark-side="after">Type it, or use the arrow keys.</Text>
  <FieldError class="ui-error" style="justify-self: start" data-mark="6" data-mark-side="after">Pick a time.</FieldError>
</TimeField>

<!-- Only the hour segment carries a mark. -->
#template part(segment: Segment) {
  #if (segment.type === 'hour') {
    <DateSegment {segment} data-mark="4" />
  } #else {
    <DateSegment {segment} />
  }
}

<style>
  /* The badge of a segment sits above it, in the padding of the input, so it stays off the digits. */
  :global(.ui-date-input [data-type='hour'][data-mark])::before {
    top: -1.5rem;
    inset-inline-end: auto;
    inset-inline-start: 0;
  }
</style>
