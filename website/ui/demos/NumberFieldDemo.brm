<script>
  import { $bind, $signal } from 'brumate/signals';
  import Button from '@brumate/ui/Button.brm';
  import Group from '@brumate/ui/Group.brm';
  import Input from '@brumate/ui/Input.brm';
  import Label from '@brumate/ui/Label.brm';
  import NumberField from '@brumate/ui/NumberField.brm';

  let guests = $signal(2);
  let budget = $signal(120);
</script>

<div class="ui-stack">
  <NumberField class="ui-field" minValue=(1) maxValue=(12) value=$bind(guests)>
    <Label>Guests</Label>
    <Group class="ui-number">
      <Button slot="decrement" class="ui-step">−</Button>
      <Input class="ui-input" />
      <Button slot="increment" class="ui-step">+</Button>
    </Group>
  </NumberField>
  <NumberField class="ui-field" minValue=(0) step=(10) value=$bind(budget) formatOptions=({ style: 'currency', currency: 'USD' })>
    <Label>Budget</Label>
    <Group class="ui-number">
      <Button slot="decrement" class="ui-step">−</Button>
      <Input class="ui-input" />
      <Button slot="increment" class="ui-step">+</Button>
    </Group>
  </NumberField>
</div>
<p>{guests} guests, a budget of {budget}.</p>
