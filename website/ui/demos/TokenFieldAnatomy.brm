<script>
  import Label from '@brumate/ui/Label.brm';
  import Text from '@brumate/ui/Text.brm';
  import Token from '@brumate/ui/Token.brm';
  import TokenField from '@brumate/ui/TokenField.brm';
  import TokenInput from '@brumate/ui/TokenInput.brm';
  import type { TokenSegment } from '@brumate/ui/token-field.ts';

  const message: TokenSegment[] = [
    { type: 'text', text: 'Ask ' },
    { type: 'token', text: '@ada' },
    { type: 'text', text: ' about it' },
  ];
</script>

<TokenField class="ui-field" value=(message) pattern="[#@]\S+" style="width: 20rem" data-mark="1">
  <Label class="ui-label" data-mark="2" data-mark-side="after">Message</Label>
  <span class="tokenfield-anatomy-input" data-mark="3">
    <TokenInput class="ui-input ui-token-input" token=chip />
  </span>
  <Text slot="description" class="ui-help" data-mark="5" data-mark-side="after">Type a @name, then a space.</Text>
</TokenField>

#template chip(segment) {
  <Token class="ui-token ui-mention tokenfield-anatomy-token" data-mark="4" data-mark-side="bottom">{segment.text}</Token>
}

<style>
  :global(.tokenfield-anatomy-input) {
    display: block;
  }
</style>
