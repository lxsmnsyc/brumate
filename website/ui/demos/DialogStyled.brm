    --dialog-styled-bg: Canvas;
    --dialog-styled-text: CanvasText;
    --dialog-styled-muted: color-mix(in srgb, CanvasText 60%, Canvas);
    --dialog-styled-border: color-mix(in srgb, CanvasText 25%, Canvas);
    --dialog-styled-accent: light-dark(#2a76b2, #6fb2e6);
    --dialog-styled-on-accent: light-dark(#fff, #101418);
