    box-shadow: 0 12px 32px rgb(0 0 0 / 22%);
    transition: opacity 0.18s, translate 0.18s;
  }

  :global(.dialog-styled-popover[data-closed]) {
    opacity: 0;
    translate: 0 -4px;
  }

  :global(.dialog-styled-popover[data-placement='top'][data-closed]) {
    translate: 0 4px;
  }

  /* The dialog takes focus when it opens, so it draws no ring of its own. */
  :global(.dialog-styled-dialog) {
    display: grid;
    gap: 0.75rem;
