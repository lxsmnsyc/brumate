    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
  }

  :global(.dialog-styled-trigger)[data-hovered] {
    border-color: var(--dialog-styled-accent);
  }

  :global(.dialog-styled-trigger)[data-pressed] {
    background: color-mix(in srgb, var(--dialog-styled-accent) 14%, var(--dialog-styled-bg));
  }

  :global(.dialog-styled-trigger)[aria-expanded='true'] {
    border-color: var(--dialog-styled-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--dialog-styled-accent) 25%, transparent);
  }

  /* Two bands, so the ring shows on the page and on a fill. */
  :global(.dialog-styled-trigger)[data-focus-visible] {
    outline: none;
    box-shadow: 0 0 0 2px var(--dialog-styled-bg), 0 0 0 4px var(--dialog-styled-accent);
  }

  :global(.dialog-styled-trigger)[data-disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  :global(.dialog-styled-close) {
    padding: 0.45rem 0.9rem;
    border: 1px solid transparent;
    border-radius: var(--dialog-styled-radius);
