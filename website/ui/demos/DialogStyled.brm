<script>
  import Button from '@brumate/ui/Button.brm';
  import Dialog from '@brumate/ui/Dialog.brm';
  import DialogTrigger from '@brumate/ui/DialogTrigger.brm';
  import Heading from '@brumate/ui/Heading.brm';
  import Popover from '@brumate/ui/Popover.brm';
</script>

<div class="dialog-styled-root">
  <DialogTrigger>
    <Button class="dialog-styled-trigger">Rename</Button>
    <Popover class="dialog-styled-popover" placement="bottom start" transition>
      <Dialog class="dialog-styled-dialog">
        <Heading slot="title" level=(4) class="dialog-styled-title">Rename the file</Heading>
        <p class="dialog-styled-text">The new name shows in the list at once.</p>
        <div class="dialog-styled-actions">
          <Button slot="close" class="dialog-styled-close">Done</Button>
        </div>
      </Dialog>
    </Popover>
  </DialogTrigger>
</div>

<style>
  /* The tokens. Change these and the rest follows. light-dark() follows the color scheme of the page. */
  :global(.dialog-styled-root),
