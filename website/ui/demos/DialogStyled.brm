    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, box-shadow 0.15s;
  }

  :global(.dialog-styled-close)[data-hovered] {
    background: color-mix(in srgb, var(--dialog-styled-accent) 85%, CanvasText);
  }

  :global(.dialog-styled-close)[data-pressed] {
    background: color-mix(in srgb, var(--dialog-styled-accent) 70%, CanvasText);
  }

  :global(.dialog-styled-close)[data-focus-visible] {
    outline: none;
    box-shadow: 0 0 0 2px var(--dialog-styled-bg), 0 0 0 4px var(--dialog-styled-accent);
  }

  /* The popover is a layer outside the root: z-index puts it above the header of the page. */
  :global(.dialog-styled-popover) {
    z-index: 20;
    box-sizing: border-box;
    max-width: 20rem;
    padding: 1rem;
    border: 1px solid var(--dialog-styled-border);
    border-radius: var(--dialog-styled-radius);
