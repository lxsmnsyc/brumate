<script>
  import { $props } from 'brumate/signals';
  import type { Component } from 'brumate/server';

  // An anatomy picture: the part drawn live, with a numbered callout on each piece, and the
  // list of the pieces below. The part is inert and the picture has a label, so a screen
  // reader reads the list. The callouts are `data-mark="1"` on the pieces.
  const { label, demo, children } = $props<{
    label: string;
    demo: Component;
    children?: unknown;
  }>();
</script>

<figure class="anatomy">
  <div class="anatomy-stage" role="img" aria-label=(`${label}. The numbers are listed below.`) inert>
    <{demo} />
  </div>
  <div class="anatomy-list">{children}</div>
</figure>

<style>
  .anatomy {
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .anatomy-stage {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: 2rem 2rem 1.75rem;
    background: var(--surface);
  }

  .anatomy-list {
    border-top: 1px solid var(--border);
    padding: 0.75rem 1rem;
  }

  .anatomy-list :global(ol) {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: piece;
  }

  .anatomy-list :global(li) {
    position: relative;
    margin: 0;
    padding-inline-start: 2rem;
    counter-increment: piece;
  }

  /* The same badge as the callout on the piece. */
  .anatomy-list :global(li)::before {
    position: absolute;
    top: 0.1rem;
    inset-inline-start: 0;
    box-sizing: border-box;
    min-width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--accent-fill);
    color: var(--on-accent);
    content: counter(piece);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.35rem;
    text-align: center;
  }

  /*
    A callout is a badge that sits on its piece, so it stays on it at every width. It is drawn
    by CSS, and the picture is labelled, so the badges are not read twice.
  */
  .anatomy-stage :global([data-mark]) {
    position: relative;
  }

  .anatomy-stage :global([data-mark])::before {
    position: absolute;
    z-index: 1;
    top: -0.6rem;
    inset-inline-end: -0.6rem;
    box-sizing: border-box;
    min-width: 1.35rem;
    height: 1.35rem;
    border: 2px solid var(--surface);
    border-radius: 999px;
    background: var(--accent-fill);
    color: var(--on-accent);
    content: attr(data-mark);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  /* A label and a description are as wide as their text, so the badge sits at their end. */
  .anatomy-stage :global(:is(label, .ui-help)[data-mark]) {
    justify-self: start;
  }

  /* After the text, for the value inside the Button. */
  .anatomy-stage :global([data-mark-side='after'])::before {
    top: 50%;
    inset-inline-end: auto;
    inset-inline-start: 100%;
    margin-inline-start: 0.4rem;
    translate: 0 -50%;
  }

  /* On the lower edge, for a piece that sits inside another. */
  .anatomy-stage :global([data-mark-side='bottom'])::before {
    top: auto;
    bottom: -0.6rem;
    inset-inline-end: auto;
    inset-inline-start: 0;
  }

  /* Inside the piece, for an item of a list that clips its edge. */
  .anatomy-stage :global([data-mark-side='inside'])::before {
    top: 50%;
    inset-inline-end: 0.35rem;
    translate: 0 -50%;
  }

  .anatomy-stage :global(.anatomy-popover) {
    justify-self: stretch;
    max-width: 16rem;
    padding: 0.5rem;
    border: 1px dashed var(--muted);
    border-radius: var(--radius);
  }

  .anatomy-stage :global(.anatomy-popover .ui-listbox) {
    width: 100%;
    overflow: visible;
  }
</style>
