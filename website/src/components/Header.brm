<script>
  import { $props } from 'brumate/signals';
  import BrandMark from './BrandMark.brm';
  import Icon from './Icon.brm';
  import Search from './Search.brm';
  import { switchTheme } from '../theme-switch.ts';
  import { BRUMATE_VERSION, UI_VERSION } from '../versions.ts';

  // The section of @brumate/ui has a header of its own, which shows only its parts.
  const { section = 'docs' } = $props<{ section?: 'docs' | 'ui' }>();
  const base = import.meta.env.BASE_URL;
</script>

<header class="header">
  <div class="header-inner">
    #if (section === 'ui') {
      <a class="brand" href=(`${base}ui`)>
        <BrandMark />
        <span>brumate<span class="brand-section">/ui</span></span>
        <span class="version">v{UI_VERSION}</span>
      </a>
    } #else {
      <a class="brand" href=base>
        <BrandMark />
        brumate
        <span class="version">v{BRUMATE_VERSION}</span>
      </a>
    }
    <div class="header-search">
      <Search {section} />
    </div>
    <nav class="header-nav" aria-label="Main">
      #if (section === 'ui') {
        <a class="nav-link" href=(`${base}docs`)>brumate</a>
      } #else {
        <a class="nav-link" href=(`${base}docs`)>Docs</a>
        <a class="nav-link" href=(`${base}ui`)>UI</a>
        <a class="nav-link" href=(`${base}repl`)>REPL</a>
      }
      <a class="icon-button" href="https://github.com/lxsmnsyc/brumate" target="_blank" rel="noreferrer" aria-label="brumate on GitHub">
        <Icon name="github" size=(18) />
      </a>
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label="Switch theme"
        onClick=((event) => switchTheme({ x: event.clientX, y: event.clientY }))
      >
        <span class="sun"><Icon name="sun" size=(17) /></span>
        <span class="moon"><Icon name="moon" size=(17) /></span>
      </button>
    </nav>
  </div>
</header>

<style>
  /* Header */

  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    /* The header stays in place while the page fades between pages. */
    view-transition-name: header;
    height: var(--header-height);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    max-width: 82rem;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    justify-self: start;
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand-section {
    color: var(--accent-strong);
  }

  .version {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--muted);
    font: 500 0.7rem var(--mono);
    letter-spacing: 0;
  }

  .header-search {
    display: flex;
    justify-content: center;
    width: 22rem;
  }

  .header-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.15rem;
  }

  .nav-link {
    padding: 0.35rem 0.65rem;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.92rem;
    text-decoration: none;
    transition:
      color var(--duration-fast),
      background var(--duration-fast);
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--surface);
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--duration-fast),
      background var(--duration-fast);
  }

  .icon-button:hover {
    color: var(--text);
    background: var(--surface);
  }

  .theme-toggle .moon,
  :global(:root[data-theme='dark']) .theme-toggle .sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle .moon {
    display: inline;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .sun {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .theme-toggle .moon {
      display: inline;
    }
  }

  /* A narrow screen keeps one row: the search shrinks to an icon, next to the links. */

  @media (max-width: 52rem) {
    .header-inner {
      display: flex;
      gap: 0.25rem;
      padding: 0 0.75rem;
    }

    .brand {
      margin-right: auto;
    }

    .header-search {
      width: auto;
    }

    .header-nav {
      gap: 0;
    }

    .version {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .brand {
      gap: 0.4rem;
      font-size: 1rem;
    }

    .nav-link {
      padding: 0.35rem 0.35rem;
      font-size: 0.85rem;
    }

    .icon-button {
      width: 1.9rem;
    }
  }
</style>
