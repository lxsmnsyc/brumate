<script>
  import type { ElementProps } from 'brumate/elements';
  import { $props } from 'brumate/signals';

  /**
   * An icon of the site: a stroke on a grid of 24, in the color of the text. It is decoration,
   * so it is hidden from screen readers. Name what it does on the button or link around it.
   */
  const { name, size = 16, ...rest } = $props<{
    name:
      | 'check'
      | 'minus'
      | 'plus'
      | 'close'
      | 'search'
      | 'upload'
      | 'sun'
      | 'moon'
      | 'arrow-right'
      | 'chevron'
      | 'grip'
      | 'bolt'
      | 'hash'
      | 'grid'
      | 'file'
      | 'github'
      | 'menu';
    size?: number;
  } & Omit<ElementProps<'svg'>, 'name' | 'size'>>();
</script>

<svg
  class=(`icon icon-${name}`)
  viewBox="0 0 24 24"
  width=size
  height=size
  fill="none"
  stroke="currentColor"
  stroke-width="2.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
>
  #switch {
    #case (name === 'check') {
      <path d="M5 12.5l4.5 4.5L19 7.5" />
    }
    #case (name === 'minus') {
      <path d="M6 12h12" />
    }
    #case (name === 'plus') {
      <path d="M12 5v14M5 12h14" />
    }
    #case (name === 'close') {
      <path d="M6.5 6.5l11 11M17.5 6.5l-11 11" />
    }
    #case (name === 'search') {
      <circle cx="10.5" cy="10.5" r="6" />
      <path d="M15 15l5 5" />
    }
    #case (name === 'upload') {
      <path d="M12 15V4M7.5 8.5L12 4l4.5 4.5M5 15v4h14v-4" />
    }
    #case (name === 'sun') {
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
    }
    #case (name === 'moon') {
      <path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" />
    }
    #case (name === 'chevron') {
      <path d="M6 9l6 6 6-6" />
    }
    #case (name === 'grip') {
      <path d="M9 6h.01M15 6h.01M9 12h.01M15 12h.01M9 18h.01M15 18h.01" />
    }
    #case (name === 'arrow-right') {
      <path d="M5 12h14M13 6l6 6-6 6" />
    }
    #case (name === 'bolt') {
      <path d="M13 2.5 4.5 13.5h7l-1 8 8.5-11h-7z" />
    }
    #case (name === 'hash') {
      <path d="M4.5 9h15M4.5 15h15M10 3.5 8 20.5M16 3.5l-2 17" />
    }
    #case (name === 'grid') {
      <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
      <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
      <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
      <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
    }
    #case (name === 'file') {
      <path d="M14 3H6.5v18h11V6.5z" />
      <path d="M14 3v3.5h3.5" />
    }
    #case (name === 'github') {
      <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
    }
    #case (name === 'menu') {
      <path d="M4 7h16M4 12h16M4 17h16" />
    }
  }
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.15em;
  }
</style>
