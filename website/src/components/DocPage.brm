<script>
  import { $props } from 'brumate/signals';
  import * as docs from '../docs.ts';
  import * as ui from '../ui.ts';
  import LiveSample from './LiveSample.brm';
  import Meta from './Meta.brm';

  // A page of the docs of brumate, or of the section of @brumate/ui.
  const { slug, section = 'docs' } = $props<{ slug: string; section?: 'docs' | 'ui' }>();
  const base = import.meta.env.BASE_URL;
  const { pages, sections } = section === 'ui' ? ui : docs;
  const brand = section === 'ui' ? 'brumate/ui' : 'brumate';
  const page = pages[slug];
  const order = sections.flatMap((group) => group.pages);
  const index = order.findIndex((item) => item.slug === slug);
  const previous = index > 0 ? order[index - 1] : undefined;
  const next = index !== -1 ? order[index + 1] : undefined;
  const link = (target: string): string => `${base}${section}${target ? `/${target}` : ''}`;
  const contents = (page?.headings ?? []).filter((heading) => heading.level === 2 || heading.level === 3);
</script>

#head {
  <title>{page ? (page.title === brand ? brand : `${page.title} | ${brand}`) : `Not found | ${brand}`}</title>
}

#if (page) {
  <Meta
    title=(page.title === brand ? brand : `${page.title} | ${brand}`)
    description=page.description
    path=(slug ? `${section}/${slug}` : section)
    type="article"
  />
}
<article class="prose">
  #if (page) {
    #for (part, index of page.parts by index) {
      #if ('files' in part) {
        <LiveSample files=part.files />
      } #else if ('gallery' in part) {
        <!--
          The home of @brumate/ui: a card with a preview of each part. The preview is inert, so it
          is a picture, and the link of the title covers the whole card.
        -->
        <ul class="ui-gallery">
          #for (card of ui.gallery by card.title) {
            <li class="ui-card">
              <div class="ui-demo-stage" inert><{ui.demos[card.demo]} /></div>
              <a class="ui-card-title" href=(link(card.href))>{card.title}</a>
              <p>{card.summary}</p>
            </li>
          }
        </ul>
      } #else if ('demo' in part) {
        <!-- A demo of @brumate/ui: the parts in the style of the site, then the source. -->
        <figure class="ui-demo">
          <div class="ui-demo-stage"><{ui.demos[part.demo]} /></div>
          {part.source}
        </figure>
      } #else {
        {part.html}
      }
    }
    <nav class="pager" aria-label="Pages">
      #if (previous) {
        <a class="previous" href=(link(previous.slug))><small>Previous</small>{previous.title}</a>
      }
      #if (next) {
        <a class="next" href=(link(next.slug))><small>Next</small>{next.title}</a>
      }
    </nav>
  } #else {
    <h1>Not found</h1>
    <p>No page at this address. <a href=(link(''))>Back to the {section === 'ui' ? 'parts' : 'documentation'}</a>.</p>
  }
</article>
<nav class="toc" aria-label="On this page">
  #if (contents.length > 0) {
    <p>On this page</p>
    #for (heading of contents by heading.id) {
      <a href=(`#${heading.id}`) class=(`level-${heading.level}`)>{heading.text}</a>
    }
  }
</nav>

<style>
  .toc {
    position: sticky;
    top: var(--header-height);
    align-self: start;
    max-height: calc(100vh - var(--header-height));
    padding: 1.5rem 0;
    overflow-y: auto;
  }

  .toc p {
    margin: 1rem 0 0.3rem;
    padding: 0 0.75rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .toc p {
    margin-top: 0;
  }

  .toc a {
    display: block;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.925rem;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc a {
    font-size: 0.85rem;
  }

  .toc a.level-3 {
    padding-left: 1.5rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .pager a:hover {
    border-color: var(--accent);
  }

  .pager small {
    color: var(--muted);
    font-weight: 400;
  }

  .pager .next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 1100px) {
    .toc {
        display: none;
      }
  }
</style>
