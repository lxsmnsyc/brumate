<script>
  import { $client, $props, $signal } from 'brumate/signals';
  import * as docs from '../docs.ts';
  import type { Page } from '../docs.ts';
  import * as ui from '../ui.ts';
  import AnatomyFigure from './AnatomyFigure.brm';
  import LiveSample from './LiveSample.brm';
  import Meta from './Meta.brm';
  import StyledExample from './StyledExample.brm';

  // A page of the docs of brumate, or of the section of @brumate/ui.
  const { slug, section = 'docs' } = $props<{ slug: string; section?: 'docs' | 'ui' }>();
  const base = import.meta.env.BASE_URL;
  const { pages, sections } = section === 'ui' ? ui : docs;
  const brand = section === 'ui' ? 'brumate/ui' : 'brumate';
  const page = pages[slug];
  const order: { slug: string; title: string }[] = [];
  for (const group of sections) {
    order.push(...group.pages);
  }
  function findIndex(): number {
    for (const [at, item] of order.entries()) {
      if (item.slug === slug) {
        return at;
      }
    }
    return -1;
  }
  const index = findIndex();
  const previous = index > 0 ? order[index - 1] : undefined;
  const next = index !== -1 ? order[index + 1] : undefined;
  function link(target: string): string {
    return `${base}${section}${target ? `/${target}` : ''}`;
  }
  // The group of the sidebar that holds the page, as the eyebrow above the title.
  function findGroup(): string {
    for (const group of sections) {
      for (const item of group.pages) {
        if (item.slug === slug) {
          return group.title;
        }
      }
    }
    return section === 'ui' ? 'Parts' : 'Documentation';
  }
  const group = findGroup();
  const source = `https://github.com/lxsmnsyc/brumate/edit/main/website/${section}/${slug || 'index'}.md`;
  const contents: Page['headings'] = [];
  for (const heading of page?.headings ?? []) {
    if (heading.level === 2 || heading.level === 3) {
      contents.push(heading);
    }
  }

  let current = $signal(contents[0]?.id ?? '');

  // The section in view: the first heading, in page order, that is inside the band under the
  // header. When none is, the last heading above the band stays.
  $client(() => {
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            visible.add(entry.target.id);
          } else {
            visible.delete(entry.target.id);
          }
        }
        for (const heading of contents) {
          if (visible.has(heading.id)) {
            current = heading.id;
            return;
          }
        }
      },
      { rootMargin: '-72px 0px -70% 0px' },
    );
    for (const heading of contents) {
      const element = document.getElementById(heading.id);
      if (element) {
        observer.observe(element);
      }
    }
    return () => observer.disconnect();
  });

  // The copy button of a code block. The blocks are plain HTML, so one handler on the page
  // finds the button of the click.
  function copyCode(event: MouseEvent) {
    const button = (event.target as Element).closest<HTMLButtonElement>('.code-copy');
    const text = button?.parentElement?.querySelector('pre')?.textContent;
    if (!button || text === undefined || text === null) {
      return;
    }
    void navigator.clipboard.writeText(text).then(() => {
      button.dataset.copied = '';
      button.textContent = 'Copied';
      setTimeout(() => {
        delete button.dataset.copied;
        button.textContent = 'Copy';
      }, 1600);
    });
  }
</script>

#head {
  <title>{page ? (page.title === brand ? brand : `${page.title} | ${brand}`) : `Not found | ${brand}`}</title>
}

#if (page) {
  <Meta
    title=(page.title === brand ? brand : `${page.title} | ${brand}`)
    description=page.description
    path=(slug ? `${section}/${slug}` : section)
    type="article"
  />
}
<article class="prose" onClick=(copyCode)>
  #if (page) {
    <p class="eyebrow">{group}</p>
    #for (part, index of page.parts by index) {
      #if ('files' in part) {
        <LiveSample files=part.files />
      } #else if ('gallery' in part) {
        <!--
          The home of @brumate/ui: a card with a preview of each part. The preview is inert, so it
          is a picture, and the link of the title covers the whole card.
        -->
        <ul class="ui-gallery">
          #for (card of ui.gallery by card.title) {
            <li class="ui-card">
              <div class="ui-demo-stage" inert><div class="ui-fit"><{ui.demos[card.demo]} /></div></div>
              <a class="ui-card-title" href=(link(card.href))>{card.title}</a>
              <p>{card.summary}</p>
            </li>
          }
        </ul>
      } #else if ('demo' in part && part.variant === 'anatomy') {
        <AnatomyFigure label=(part.label ?? "") demo=ui.demos[part.demo]>{part.source}</AnatomyFigure>
      } #else if ('demo' in part && part.variant === 'styled') {
        <StyledExample demo=ui.demos[part.demo]>{part.source}</StyledExample>
      } #else if ('demo' in part) {
        <!-- A demo of @brumate/ui: the parts in the style of the site, then the source. -->
        <figure class="ui-demo">
          <div class="ui-demo-stage"><{ui.demos[part.demo]} /></div>
          {part.source}
        </figure>
      } #else {
        {part.html}
      }
    }
    <nav class="pager" aria-label="Pages">
      #if (previous) {
        <a class="previous" href=(link(previous.slug))><small>← Previous</small>{previous.title}</a>
      }
      #if (next) {
        <a class="next" href=(link(next.slug))><small>Next →</small>{next.title}</a>
      }
    </nav>
    <p class="edit"><a href=(source) target="_blank" rel="noreferrer">Edit this page on GitHub</a></p>
  } #else {
    <h1>Not found</h1>
    <p>No page at this address. <a href=(link(''))>Back to the {section === 'ui' ? 'parts' : 'documentation'}</a>.</p>
  }
</article>
<nav class="toc" aria-label="On this page">
  #if (contents.length > 0) {
    <p>On this page</p>
    #for (heading of contents by heading.id) {
      <a
        href=(`#${heading.id}`)
        class={ 'level-3': heading.level === 3, active: heading.id === current }
        aria-current=(heading.id === current ? 'location' : undefined)
      >{heading.text}</a>
    }
  }
</nav>

<style>
  .toc {
    position: sticky;
    top: var(--header-height);
    align-self: start;
    max-height: calc(100vh - var(--header-height));
    padding: 1.75rem 0 2rem;
    overflow-y: auto;
  }

  .toc p {
    margin: 0 0 0.5rem;
    padding: 0 0.75rem;
    color: var(--muted);
    font: 500 var(--text-xs) var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .toc a {
    position: relative;
    display: block;
    padding: 0.25rem 0.75rem;
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease);
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc a.level-3 {
    padding-left: 1.5rem;
  }

  /* The accent marker of the section in view: it grows in from the left edge. */
  .toc a::before {
    content: '';
    position: absolute;
    top: 0.2rem;
    bottom: 0.2rem;
    left: 0;
    width: 2px;
    border-radius: var(--radius-full);
    background: var(--accent);
    opacity: 0;
    transform: scaleY(0.3);
    transition:
      opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .toc a.active {
    color: var(--accent-strong);
    font-weight: 600;
  }

  .toc a.active::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease),
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .pager a:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }

  .pager small {
    display: inline-block;
    color: var(--muted);
    font: 500 var(--text-xs) var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: transform var(--duration) var(--ease);
  }

  .pager .previous:hover small {
    transform: translateX(-4px);
  }

  .pager .next:hover small {
    transform: translateX(4px);
  }

  .pager .next {
    grid-column: 2;
    text-align: right;
  }

  .pager .next small {
    align-self: flex-end;
  }

  .edit {
    margin: 1.5rem 0 0;
    font-size: var(--text-sm);
  }

  .edit a {
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .toc {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      grid-column: 1;
    }
  }
</style>
