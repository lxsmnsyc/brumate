<script>
  // What the browser does after the HTML of a page arrives: with hydration, and with brumate.
</script>

<div class="timeline" role="img" aria-label="With hydration, the page loads the code of every component and renders them again before a click works. With brumate, the page works as soon as the HTML arrives. While the browser is idle, it preloads the handlers near the viewport, and a click runs only its handler.">
  <div class="timeline-row">
    <p class="timeline-label">Hydration</p>
    <div class="timeline-track">
      <span class="step html">HTML</span>
      <span class="step load">Load the code of every component</span>
      <span class="step run">Render them again</span>
      <span class="step ready">Clicks work</span>
    </div>
  </div>
  <div class="timeline-row brumate">
    <p class="timeline-label">brumate</p>
    <div class="timeline-track">
      <span class="step html">HTML</span>
      <span class="step ready">Clicks work</span>
      <span class="step idle">Idle: preload nearby handlers</span>
      <span class="step click">Click: run its handler</span>
    </div>
  </div>
</div>
