<script>
  import { $client, $effect, $memo, $props, $signal, $untrack } from 'brumate/signals';
  import type { LiveFile, LiveOutput } from '../live/run.ts';
  import { highlight } from '../repl/highlight.ts';

  // A code sample of the docs that runs in the page. Editing it runs it again.
  const { files } = $props<{ files: LiveFile[] }>();

  let sources = $signal(files.map((file) => file.source));
  let active = $signal(0);
  let view = $signal<'result' | 'output'>('result');
  let error = $signal('');
  let output = $signal<LiveOutput>();
  let running = $signal(false);
  let runs = $signal(0);
  let result = $signal<HTMLElement>();
  let backdrop = $signal<HTMLElement>();

  const language = (name: string): 'brm' | 'ts' | 'css' => (name.endsWith('.brm') ? 'brm' : 'ts');
  // A line break at the end keeps the last line of the editor and the highlight the same height.
  const code = $memo(highlight(`${sources[active]}\n`, language(files[active]!.name)));

  async function run() {
    // Only the latest run writes its result, so an older run that finishes later is dropped.
    runs++;
    const id = runs;
    running = true;
    try {
      const { runSample } = await import('../live/run.ts');
      const next = await runSample(
        result!,
        files.map((file, index) => ({ name: file.name, source: sources[index]! })),
        () => id === runs,
      );
      if (id === runs) {
        output = next;
        error = '';
      }
    } catch (caught) {
      if (id === runs) {
        error = caught instanceof Error ? caught.message : String(caught);
      }
    }
    if (id === runs) {
      running = false;
    }
  }

  // The sample runs when it comes into view.
  $client(() => {
    void run();
  });

  // An edit runs the sample again, once typing pauses. The effect reads only
  // `sources`: `run` reads and writes other values, which must not run it again.
  $effect(() => {
    const current = sources;
    const timer = setTimeout(() => {
      if (current === $untrack(sources)) {
        void $untrack(run());
      }
    }, 400);
    return () => clearTimeout(timer);
  });
</script>

<figure class="live">
  <div class="live-bar">
    #if (files.length > 1) {
      #for (file, index of files by file.name) {
        <button class={ active: index === active } aria-pressed=(index === active) onClick=(() => (active = index))>{file.name}</button>
      }
    } #else {
      <span class="live-file">{files[0]!.name}</span>
    }
    <span class="live-hint">Edit the code to run it again</span>
  </div>
  <div class="live-editor">
    <div class="live-backdrop code" ref=backdrop aria-hidden="true">{code}</div>
    <textarea
      aria-label=(`Source of ${files[active]!.name}`)
      spellcheck="false"
      value=(sources[active])
      onInput=((event) => {
        const next = [...sources];
        next[active] = event.currentTarget.value;
        sources = next;
      })
      onScroll=((event) => {
        backdrop!.scrollLeft = event.currentTarget.scrollLeft;
      })
    >{$untrack(sources[0])}</textarea>
  </div>
  <div class="live-tabs" role="tablist">
    <button role="tab" aria-selected=(view === 'result') class={ active: view === 'result' } onClick=(() => (view = 'result'))>Result</button>
    <button role="tab" aria-selected=(view === 'output') class={ active: view === 'output' } onClick=(() => (view = 'output'))>Compiled</button>
    #if (running) {
      <span class="live-status">Running</span>
    }
  </div>
  #if (error) {
    <pre class="live-error">{error}</pre>
  }
  <div class={ 'live-result': true, hidden: view !== 'result' } ref=result>
    <p class="live-placeholder">The sample runs when it comes into view.</p>
  </div>
  #if (view === 'output' && output) {
    <div class="live-output">
      #for (module of output.modules by module.name) {
        <p class="live-module">{module.name}</p>
        <div class="code">{highlight(module.code, module.language)}</div>
      }
    </div>
  }
  #if (output && output.warnings.length > 0) {
    <ul class="live-warnings">
      #for (warning of output.warnings by warning) {
        <li>{warning}</li>
      }
    </ul>
  }
</figure>

<style>
  /* Live samples of the docs */

  .live {
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--code-bg);
    overflow: hidden;
  }

  .live-bar,
  .live-tabs {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0.5rem;
    background: var(--surface);
    font: 0.8rem var(--mono);
  }

  .live-bar {
    border-bottom: 1px solid var(--border);
  }

  .live-tabs {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .live-bar button,
  .live-tabs button {
    padding: 0.15rem 0.6rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: none;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }

  .live-bar button.active,
  .live-tabs button.active {
    border-color: var(--border);
    background: var(--code-bg);
    color: var(--text);
  }

  .live-file {
    color: var(--muted);
  }

  .live-hint,
  .live-status {
    margin-left: auto;
    color: var(--muted);
  }

  .live-editor {
    position: relative;
  }

  .live-backdrop,
  .live-editor textarea {
    margin: 0;
    padding: 0.9rem 1.1rem;
    font: 0.85rem/1.6 var(--mono);
    white-space: pre;
    overflow-x: auto;
    overflow-y: hidden;
    tab-size: 2;
  }

  .live-backdrop.code {
    border: 0;
    border-radius: 0;
    pointer-events: none;
  }

  .live-editor textarea {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    background: transparent;
    color: transparent;
    caret-color: var(--text);
    resize: none;
  }

  .live-editor textarea:focus {
    outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    outline-offset: -2px;
  }

  .live-editor textarea::selection {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    color: transparent;
  }

  .live-result {
    padding: 1rem 1.1rem;
    background: var(--bg);
    color: var(--text);
  }

  .live-result.hidden {
    display: none;
  }

  .live-placeholder {
    margin: 0;
    color: var(--muted);
  }

  .live-error {
    margin: 0;
    padding: 0.75rem 1.1rem;
    border: 0;
    border-radius: 0;
    background: color-mix(in srgb, #e5484d 12%, var(--bg));
    color: var(--text);
    white-space: pre-wrap;
  }

  .live-output {
    padding: 0.75rem 1.1rem;
  }

  .live-module {
    margin: 0.5rem 0 0.25rem;
    color: var(--muted);
    font: 0.8rem var(--mono);
  }

  .live-warnings {
    margin: 0;
    padding: 0.5rem 1.1rem 0.5rem 2rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
