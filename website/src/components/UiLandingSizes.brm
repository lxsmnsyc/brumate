<script>
  import { core, sizes } from '../ui-landing.ts';

  // Each bar is the kB that the part adds, on a scale where the biggest part fills the track.
  const max = sizes[sizes.length - 1]!.total - core;
  function width(total: number): string {
    return String((total - core) / max);
  }
  function added(total: number): string {
    return (total - core).toFixed(1);
  }
</script>

<div class="sizes card">
  <ul>
    #for (size of sizes by size.name) {
      <li style=(`--w: ${width(size.total)}`)>
        <span class="name">
          {size.total > core ? size.name : 'Page without a part'}
          #if (size.note && size.total > core) {
            <small>{size.note}</small>
          }
        </span>
        <span class="bar" aria-hidden="true"><i></i></span>
        <span class="value">+{added(size.total)} kB</span>
      </li>
    }
  </ul>
  <p class="foot">
    On top of <b>{core.toFixed(1)} kB</b> of gzip JavaScript for the loader and the core, which a page loads
    once it has any script. A part you do not render adds <b>0.0 kB</b>.
  </p>
</div>

<style>
  .sizes {
    min-width: 0;
    padding: 0.5rem 1.5rem 1.25rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) 5.5rem;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 0;
    font-size: var(--text-sm);
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  .name {
    font-weight: 600;
  }

  .name small {
    display: block;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  .bar {
    height: 0.6rem;
    border-radius: var(--radius-full);
    background: var(--surface-strong);
    overflow: hidden;
  }

  i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transform: scaleX(var(--w));
    transform-origin: left;
    animation: grow var(--duration-slow) var(--ease) both;
  }

  .value {
    font: 500 var(--text-sm) var(--mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .foot {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .foot b {
    color: var(--text);
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }

  @media (max-width: 40rem) {
    .sizes {
      padding-inline: 1rem;
    }

    li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.4rem 1rem;
    }

    .bar {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
