<script>
  import { $props } from 'brumate/signals';

  // What the compiler ships for a component, from `brumate inspect` at build time.
  const { report } = $props<{
    report: {
      roots: { label: string; reason: string }[];
      changes: { label: string; reason: string }[];
      staticMarkup: { elements: number; inserts: number };
      sizes: { module: string; bytes: number; gzip: number }[];
    };
  }>();

  const kb = (bytes: number): string => `${(bytes / 1024).toFixed(2)} KB`;
  const total = report.sizes
    .filter((size) => size.module !== 'entry')
    .reduce((sum, size) => sum + size.gzip, 0);
</script>

<div class="shipped">
  <table>
    <thead>
      <tr><th>Module</th><th>Loads</th><th>gzip</th></tr>
    </thead>
    <tbody>
      #for (size of report.sizes by size.module) {
        <tr>
          <td><code>{size.module}</code></td>
          <td>{size.module === 'entry' ? 'on first use' : size.module === 'update' ? 'on the first change' : size.module === 'all' ? 'on the first event' : 'on its event'}</td>
          <td class="num">{kb(size.gzip)}</td>
        </tr>
      }
    </tbody>
  </table>
  <p class="shipped-sum">
    Before any click: <strong>0 KB</strong> of this component. After every event: <strong>{kb(total)}</strong>.{' '}
    {report.staticMarkup.elements} elements ship as HTML only.
  </p>
  <ul class="shipped-roots">
    #for (root of report.roots by root.label) {
      <li><code>{root.label}</code> {root.reason}</li>
    }
  </ul>
</div>

<style>
  .shipped {
    padding: 0.75rem 1rem 1rem;
    font-size: 0.9rem;
  }

  .shipped table {
    width: 100%;
    border-collapse: collapse;
  }

  .shipped th,
  .shipped td {
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .shipped th {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .shipped .num {
    font-family: var(--mono);
    text-align: right;
    white-space: nowrap;
  }

  .shipped-sum {
    margin: 0.75rem 0 0.25rem;
  }

  .shipped-roots {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
