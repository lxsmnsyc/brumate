<script>
  import { $client } from 'brumate/signals';
  import Meta from '../../components/Meta.brm';
  import UiLandingSizes from '../../components/UiLandingSizes.brm';
  import ControlsDemo from '../../../ui/demos/LandingControlsDemo.brm';
  import TabsDemo from '../../../ui/demos/LandingTabsDemo.brm';
  import { unstyled, usage } from '../../ui-landing.ts';
  import { demos, gallery } from '../../ui.ts';

  const base = import.meta.env.BASE_URL;

  // A link from another page to `/ui#parts` scrolls before the layout drops its sidebar, so the
  // heading lands out of place. Scroll again once the page is in place.
  $client(() => {
    const target = location.hash && document.getElementById(location.hash.slice(1));
    let frames = 0;
    const align = () => {
      // The sidebar is gone when the shell has the class `bare`.
      if (target && (document.querySelector('.docs.bare') || ++frames > 30)) {
        target.scrollIntoView();
      } else if (target) {
        requestAnimationFrame(align);
      }
    };
    align();

    // Each preview of the card grid is its demo at natural size. Scale it down to fit the box,
    // never up, when the page loads and when the box or the demo changes size.
    const fit = (stage: Element) => {
      const demo = stage.firstElementChild as HTMLElement | null;
      if (!demo || !demo.offsetWidth || !demo.offsetHeight) {
        return;
      }
      const style = getComputedStyle(stage);
      const width =
        stage.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
      const height =
        stage.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
      const scale = Math.min(1, width / demo.offsetWidth, height / demo.offsetHeight);
      demo.style.setProperty('--fit', String(Math.floor(scale * 1000) / 1000));
    };
    const observer = new ResizeObserver((entries) => {
      for (const entry of entries) {
        fit(entry.target.closest('.ui-demo-stage')!);
      }
    });
    for (const stage of document.querySelectorAll('.ui-card .ui-demo-stage')) {
      fit(stage);
      observer.observe(stage);
      observer.observe(stage.firstElementChild!);
    }
  }, 'load');
</script>

#head {
  <title>brumate/ui: accessible parts that ship only what you use</title>
}

<Meta
  title="brumate/ui: accessible parts that ship only what you use"
  description="Unstyled, accessible parts for brumate pages. The server renders them, the browser keeps their state, and a part you do not render ships nothing."
  path="ui"
/>
<main class="home">
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <p class="eyebrow">Parts for brumate pages</p>
    <h1>Accessible parts that <span class="gradient-text">ship</span> only what you use.</h1>
    <p class="lead">
      Buttons, forms, tabs, dialogs, dates and colors, with the right roles, keys and focus.
      They have no styles, so they look like your site. The server renders them, and a part you do not render ships nothing.
    </p>
    <div class="actions">
      <a class="button primary" href=(`${base}ui/introduction`)>Get started</a>
      <a class="button" href=(`${base}ui#parts`)>All parts</a>
    </div>
    <pre class="install"><span class="prompt">$</span> pnpm add @brumate/ui</pre>
  </section>

  <section class="section stage-section">
    <div class="browser">
      <div class="browser-bar"><span></span><span></span><span></span><em>Live parts, styled like this site</em></div>
      <div class="ui-demo-stage"><ControlsDemo /></div>
    </div>
    <p class="stage-note">Press, switch and check them. Use the keyboard, a touch or a screen reader: it is the same part.</p>
  </section>

  <section class="section ships-section">
    <div class="ships-text">
      <h2>You pay for the parts you render</h2>
      <p class="section-lead">
        The code of a part comes with the page that renders it, so the first press needs no request.
        A page that renders no part adds nothing.
      </p>
      <p class="section-lead">
        Sizes are the gzip JavaScript that the first server render loads. CSS is not counted.
        Run <code>node scripts/measure-ui-sizes.mjs</code> in the <code>website</code> folder for the current numbers.
      </p>
    </div>
    <div>
      <UiLandingSizes />
    </div>
  </section>

  <section class="section rows">
    <article class="row">
      <div class="row-text">
        <p class="eyebrow">Unstyled</p>
        <h2>Style the state, not a class name</h2>
        <p>
          A part renders the right element and sets its state as <code>data-*</code> attributes.
          Your CSS decides the rest, with no class names to override.
        </p>
        <a href=(`${base}ui/styling`)>Styling</a>
      </div>
      <div class="row-media">
        <div class="code" role="group" aria-label="Unstyled example" tabindex="0">{unstyled}</div>
      </div>
    </article>

    <article class="row">
      <div class="row-text">
        <p class="eyebrow">Accessible</p>
        <h2>One behavior for every way to press</h2>
        <p>
          Roles and ARIA attributes, native elements where the browser has them, and the keyboard patterns
          of WAI-ARIA. A mouse, a touch, a pen, a key and a screen reader all end in the same <code>onPress</code>.
        </p>
        <a href=(`${base}ui/influences`)>Design influences</a>
      </div>
      <div class="row-media">
        <div class="browser">
          <div class="browser-bar"><span></span><span></span><span></span><em>Try the arrow keys</em></div>
          <div class="tabs-stage"><TabsDemo /></div>
        </div>
      </div>
    </article>

    <article class="row">
      <div class="row-text">
        <p class="eyebrow">Resumable</p>
        <h2>Rendered on the server, picked up in the browser</h2>
        <p>
          A part is HTML with its state. The browser picks up where the server left off and runs no component twice.
          A native element still works when no script runs.
        </p>
        <a href=(`${base}ui/resuming`)>How the parts resume</a>
      </div>
      <div class="row-media">
        <div class="code" role="group" aria-label="Usage example" tabindex="0">{usage}</div>
      </div>
    </article>
  </section>

  <section class="section" id="parts">
    <h2>Every part</h2>
    <p class="section-lead">A card for each part. The preview is a picture, so open the page of the part to use it.</p>
    <ul class="ui-gallery">
      #for (card of gallery by card.title) {
        <li class="ui-card">
          <div class="ui-demo-stage" inert><div class="ui-fit"><{demos[card.demo]} /></div></div>
          <a class="ui-card-title" href=(`${base}ui/${card.href}`)>{card.title}</a>
          <p>{card.summary}</p>
        </li>
      }
    </ul>
  </section>

  <section class="section cta">
    <h2>Add the first part</h2>
    <p>Install the package, import a part and style its data attributes.</p>
    <div class="actions">
      <a class="button primary" href=(`${base}ui/introduction`)>Get started</a>
      <a class="button" href=(`${base}ui#parts`)>All parts</a>
    </div>
  </section>
</main>

<style>
  .stage-section {
    max-width: 44rem;
    margin: 0 auto;
  }

  .stage-section .ui-demo-stage {
    justify-content: center;
  }

  .stage-note {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .tabs-stage {
    padding: 1.5rem;
    background: var(--surface);
  }
</style>
