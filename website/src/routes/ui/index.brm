<script>
  import { $client } from 'brumate/signals';
  import Meta from '../../components/Meta.brm';
  import UiLandingSizes from '../../components/UiLandingSizes.brm';
  import Cluster from '../../components/ui-landing/Cluster.brm';
  import Compare from '../../components/ui-landing/Compare.brm';
  import Install from '../../components/ui-landing/Install.brm';
  import { kinds } from '../../ui-landing.ts';

  const base = import.meta.env.BASE_URL;

  // A link from another page to `/ui#parts` scrolls before the layout drops its sidebar, so the
  // heading lands out of place. Scroll again once the page is in place.
  $client(() => {
    const target = location.hash && document.getElementById(location.hash.slice(1));
    let frames = 0;
    function align() {
      // The sidebar is gone when the shell has the class `bare`.
      if (target && (document.querySelector('.docs.bare') || ++frames > 30)) {
        target.scrollIntoView();
      } else if (target) {
        requestAnimationFrame(align);
      }
    }
    align();
  }, 'load');
</script>

#head {
  <title>brumate/ui: accessible parts that ship only what you use</title>
}

<Meta
  title="brumate/ui: accessible parts that ship only what you use"
  description="Unstyled, accessible parts for brumate pages. The server renders them, the browser keeps their state, and a part you do not render ships nothing."
  path="ui"
/>
<main class="landing">
  <section class="hero">
    <div class="copy">
      <p class="eyebrow">@brumate/ui</p>
      <h1 class="display">Accessible parts that ship <em>only</em> what you use.</h1>
      <p class="lead">
        Buttons, forms, tabs, dialogs, dates and colors, with the right roles, keys and focus.
        They have no styles, so they look like your site. A part you do not render ships nothing.
      </p>
      <div class="actions">
        <a class="button primary" href=(`${base}ui/introduction`)>Get started</a>
        <a class="button" href=(`${base}ui#parts`)>All parts</a>
      </div>
      <div class="install-row"><Install /></div>
    </div>
    <Cluster />
  </section>

  <section class="section">
    <header class="section-head">
      <span class="numeral" aria-hidden="true">01</span>
      <div>
        <h2>Unstyled, <em>then</em> yours</h2>
        <p>
          A part renders the right element and sets its state as <code>data-*</code> attributes. Your CSS
          decides the rest, with no class names to override. Both sides below are the same part.
        </p>
      </div>
    </header>
    <Compare />
  </section>

  <section class="section">
    <header class="section-head">
      <span class="numeral" aria-hidden="true">02</span>
      <div>
        <h2>Pay <em>per</em> part</h2>
        <p>
          The code of a part comes with the page that renders it, so the first press needs no request.
          These sizes are measured, not estimated. Run <code>node scripts/measure-ui-sizes.mjs</code>
          in the <code>website</code> folder for the current numbers.
        </p>
      </div>
    </header>
    <UiLandingSizes />
  </section>

  <section class="section" id="parts">
    <header class="section-head">
      <span class="numeral" aria-hidden="true">03</span>
      <div>
        <h2>Every <em>part</em></h2>
        <p>Grouped by kind. Each part has a page with a live demo, its anatomy and its styles. A size shows where it is measured.</p>
      </div>
    </header>
    #for (kind of kinds by kind.title) {
      <div class="kind">
        <h3>{kind.title}</h3>
        <ul class="grid">
          #for (card of kind.cards by card.title) {
            <li>
              <a href=(`${base}ui/${card.href}`)>
                <span class="top">
                  <span class="name">{card.title}</span>
                  #if (card.size) {
                    <span class="size">{card.size}</span>
                  }
                </span>
                <span class="summary">{card.summary}</span>
                <span class="go arrow" aria-hidden="true">Open</span>
              </a>
            </li>
          }
        </ul>
      </div>
    }
  </section>

  <section class="section cta">
    <h2 class="display">Add the <em>first</em> part.</h2>
    <p class="lead">Install the package, import a part and style its data attributes.</p>
    <div class="actions">
      <a class="button primary" href=(`${base}ui/introduction`)>Get started</a>
      <a class="button" href=(`${base}ui/styling`)>Styling</a>
    </div>
  </section>
</main>

<style>
  .landing {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 3rem;
    align-items: center;
    padding: 4.5rem 0 5rem;
    /* The shared .hero of styles.css centers its text; this one reads from the left. */
    text-align: left;
  }

  .copy {
    min-width: 0;
  }

  .copy .display {
    margin-top: 1.25rem;
  }

  .lead {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .install-row {
    max-width: 100%;
    margin-top: 1.5rem;
  }

  .section {
    padding: 5rem 0;
    border-top: 1px solid var(--border);
  }

  .kind + .kind {
    margin-top: 2.5rem;
  }

  .kind h3 {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font: 500 var(--text-xs) var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--border);
    list-style: none;
    overflow: hidden;
  }

  .grid li {
    display: flex;
    background: var(--bg);
  }

  .grid a {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding: 1.1rem 1.25rem;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease);
  }

  .grid a:hover {
    background: var(--bg-elevated);
  }

  .grid a:focus-visible {
    outline-offset: -2px;
  }

  .top {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .name {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .size {
    color: var(--accent-strong);
    font: 500 var(--text-xs) var(--mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .summary {
    flex: 1;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .go {
    margin-top: 0.4rem;
    color: var(--accent-strong);
    font: 500 var(--text-xs) var(--mono);
  }

  .grid a:hover .go::after {
    transform: translateX(3px);
  }

  .cta {
    text-align: center;
  }

  .cta .lead {
    margin-inline: auto;
  }

  .cta .actions {
    justify-content: center;
  }

  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding-top: 3rem;
    }

    .section {
      padding: 3.5rem 0;
    }
  }

  @media (max-width: 30rem) {
    .landing {
      padding-inline: 1rem;
    }
  }
</style>
