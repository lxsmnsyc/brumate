  }

  .ui-gridrow[data-hovered] {
    background: var(--surface);
  }

  .ui-gridrow[data-selected] {
    background: var(--accent-soft);
  }

  .ui-gridrow[data-focus-visible] {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  .ui-gridrow[data-dragging] {
    opacity: 0.5;
  }

  .ui-gridrow[data-drop-target='before'] {
    box-shadow: inset 0 2px 0 var(--accent);
  }

  .ui-gridrow[data-drop-target='after'] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .ui-grip {
    display: grid;
    place-items: center;
    padding: 0.15rem;
    border: none;
    border-radius: 4px;
    background: none;
    color: inherit;
    cursor: grab;
  }

  .ui-grip:focus-visible {
    outline: 2px solid var(--accent);
  }

  .ui-gridrow .ui-button {
    margin-inline-start: auto;
    padding: 0.2rem 0.6rem;
  }

  /* A table: its sorted column shows an arrow, and selected rows take the accent. */
  .ui-table {
    width: min(32rem, 100%);
    border-collapse: collapse;
    border: 1px solid var(--border);
    outline: none;
  }

  .ui-table:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ui-column {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    text-align: start;
    outline: none;
  }

  .ui-column[data-allows-sorting] {
    cursor: pointer;
  }

  .ui-column[data-sort-direction='ascending']::after {
    content: ' ▲';
  }

  .ui-column[data-sort-direction='descending']::after {
    content: ' ▼';
  }

  .ui-resizable {
    max-width: 100%;
  }

  .ui-resizable-column {
    position: relative;
  }

  /* A resizer: a bar at the end of the header, which shows while it is used. */
  .ui-resizer {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: 6px;
    cursor: col-resize;
    border-inline-end: 2px solid var(--border);
  }

  .ui-resizer[data-resizing],
  .ui-resizer[data-focus-visible] {
    border-color: var(--accent);
  }

  .ui-select-column {
    width: 2rem;
  }

  .ui-tablerow {
    outline: none;
  }

  .ui-tablerow[data-hovered] {
    background: var(--surface);
  }

  .ui-tablerow[data-selected] {
    background: var(--accent-soft);
  }

  .ui-tablerow[data-focus-visible],
  .ui-column:focus-visible,
  .ui-cell:focus-visible {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  .ui-cell {
    padding: 0.35rem 0.6rem;
    font-weight: normal;
    text-align: start;
    outline: none;
  }

  .ui-number {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  /* A tree: rows indented by their level, with a chevron that turns while the row is open. */
  .ui-tree {
    display: grid;
    width: min(22rem, 100%);
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
  }

  .ui-tree:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ui-treerow {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.3rem 0.5rem;
    padding-inline-start: calc(0.5rem + (var(--tree-item-level) - 1) * 1.25rem);
    border-radius: 6px;
    outline: none;
  }

  .ui-treerow[data-hovered] {
    background: var(--surface);
  }

  .ui-treerow[data-selected] {
    background: var(--accent-soft);
  }

  .ui-treerow[data-focus-visible] {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  .ui-row-action {
    margin-inline-start: auto;
    padding: 0 0.5rem;
  }

  /* A field of text with tokens: each token is a chip in the line of text. */
  .ui-token-input {
    min-height: 2.5rem;
    line-height: 1.8;
  }

  .ui-token {
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .ui-mention {
    border-color: var(--accent);
    font-weight: 600;
  }

  .ui-token[data-selected] {
    background: var(--accent-soft);
  }

  .ui-dropzone {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    padding: 1.5rem;
    width: min(22rem, 100%);
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    text-align: center;
  }

  .ui-dropzone[data-drop-target],
  .ui-dropzone[data-focus-visible] {
    border-style: solid;
    border-color: currentColor;
  }

  .ui-virtualizer {
    height: 16rem;
    width: min(22rem, 100%);
  }

  .ui-virtualizer .ui-tree {
    width: 100%;
  }

  .ui-navlink {
    color: inherit;
    text-decoration: none;
  }

  .ui-navlink[aria-current='page'] {
    color: var(--accent-strong);
    font-weight: 600;
  }

  .ui-navrow[data-current-ancestor]::after {
    content: '';
    width: 6px;
    height: 6px;
    margin-inline-start: auto;
    border-radius: 50%;
    background: var(--accent);
  }

  .ui-chevron {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
    transform: rotate(-90deg);
    transition: transform 0.15s;
  }

  .ui-treerow[data-expanded] .ui-chevron {
    transform: none;
  }

  .ui-treerow:dir(rtl) .ui-chevron {
    transform: rotate(90deg);
  }

  .ui-treerow[data-expanded]:dir(rtl) .ui-chevron {
    transform: none;
  }

  /* A bar under the selected tab, which slides to the next one. */
  .ui-tab:has(.ui-indicator) {
    position: relative;
  }

  .ui-tablist-sliding .ui-tab[data-selected] {
    border-color: transparent;
  }

  .ui-indicator {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--accent);
    transition-duration: 0.25s;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  /* A number field: an input between its two buttons, in one box. */
  .ui-number {
    display: inline-flex;
    width: 12rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
  }

  .ui-number:focus-within {
    border-color: var(--accent);
  }

  .ui-number .ui-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    text-align: center;
  }

  .ui-step {
    width: 2rem;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .ui-step[disabled] {
    color: var(--muted);
    cursor: default;
  }

  /* A slider: a line with round thumbs, and a fill between them. */
  .ui-slider {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    width: 16rem;
  }

  .ui-slider-track {
    position: relative;
    grid-column: 1 / -1;
    height: 1.5rem;
  }

  .ui-slider-track::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 4px;
    transform: translateY(-50%);
    border-radius: 2px;
    background: var(--border);
  }

  .ui-thumb {
    top: 50%;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: -0.625rem;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }

  .ui-thumb[data-dragging] {
    background: var(--accent);
