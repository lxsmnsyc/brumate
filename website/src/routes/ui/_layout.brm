    inset-block: 0;
    width: min(18rem, 85vw);
    padding: 1.25rem;
    border-inline: 1px solid var(--border);
    background: var(--bg);
    outline: none;
    transition: translate 0.25s;
  }

  :global(.ui-sheet[data-side='left']) {
    left: 0;
  }

  :global(.ui-sheet[data-side='right']) {
