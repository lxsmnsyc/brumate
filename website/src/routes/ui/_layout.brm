<script>
  import { $memo, $props, $route } from 'brumate/signals';
  import DocsShell from '../../components/DocsShell.brm';
  import { sections } from '../../ui.ts';

  const { children } = $props();
  const route = $route();
  const base = import.meta.env.BASE_URL;
  // The landing page at /ui has no sidebar, like the home page.
  const landing = $memo(route.url.pathname.replace(/\/$/, '') === `${base}ui`);
</script>

<DocsShell section="ui" {sections} label="Parts" bare=landing>{children}</DocsShell>

<style>
  /*
    The parts of @brumate/ui have no styles. These give the demos the look of the site, from the
    data attributes of the parts.
  */
  :global(.ui-demo) {
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  :global(.ui-demo pre) {
    margin: 0;
    border: 0;
    border-top: 1px solid var(--border);
    border-radius: 0;
  }

  :global(.ui-demo-stage) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 1.5rem;
    background: var(--surface, transparent);
  }

  :global(.ui-gallery) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    grid-auto-rows: 1fr;
    gap: 1rem;
    margin: 1.5rem 0 2.5rem;
    padding: 0;
    list-style: none;
  }

  :global(.ui-card) {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s;
  }

  :global(.ui-card:hover),
  :global(.ui-card:focus-within) {
    border-color: var(--accent);
  }

  /*
    Every preview has the same box. The demo is inside it at its natural size, and a script sets
    --fit to scale it down to fit, never up. Before the script runs, 0.8 fits most demos.
  */
  :global(.ui-card .ui-demo-stage) {
    position: relative;
    flex: none;
    height: 14rem;
    padding: 1rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  :global(.ui-fit) {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
    width: max-content;
    max-width: 24rem;
    transform: translate(-50%, -50%) scale(var(--fit, 0.8));
  }

  /* A line of text in a preview takes a row of its own, under the parts. */
  :global(.ui-card .ui-fit > p) {
    flex-basis: 100%;
    margin: 0;
    text-align: center;
  }

  /* A field in a card is as wide as its parts, so the card centers it. */
  :global(.ui-card .ui-field) {
    min-width: 0;
  }

  /* Boxes stack in a column that starts at one edge, and the column is centered. */
  :global(.ui-stack) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  :global(.ui-card .ui-demo-stage p) {
    margin: 0;
    font-size: 0.875rem;
  }

  :global(.ui-card-title) {
    padding: 0.75rem 1rem 0;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  /* The link covers the card, so a click anywhere on it opens the page. */
  :global(.ui-card-title)::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* The focus ring of the link is the outline of the card. */
  :global(.ui-card-title:focus-visible) {
    outline: none;
  }

  :global(.ui-card-title:focus-visible)::after {
    border-radius: var(--radius);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.ui-card > p) {
    margin: 0.15rem 0 0;
    padding: 0 1rem 0.85rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  :global(.ui-button) {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  :global(.ui-button[data-hovered]) {
    border-color: var(--accent);
  }

  :global(.ui-button[data-pressed]) {
    background: var(--accent-soft);
  }

  :global(.ui-button[data-selected]) {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: var(--bg);
  }

  :global(.ui-button[data-disabled]),
  :global(.ui-button[data-pending]) {
    opacity: 0.55;
    cursor: default;
  }

  :global([data-focus-visible]) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.ui-link) {
    color: var(--accent-strong);
    cursor: pointer;
  }

  :global(.ui-link[data-current]) {
    color: var(--text);
    font-weight: 700;
  }

  :global(.ui-link[data-disabled]) {
    color: var(--muted);
    cursor: default;
  }

  :global(.ui-field) {
    display: grid;
    gap: 0.3rem;
    min-width: 16rem;
  }

  :global(.ui-field label) {
    font-weight: 600;
  }

  :global(.ui-input) {
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }

  :global(.ui-input[data-focused]) {
    border-color: var(--accent);
  }

  :global(.ui-input[data-invalid]) {
    border-color: var(--danger);
  }

  :global(.ui-help) {
    color: var(--muted);
    font-size: 0.875rem;
  }

  :global(.ui-error) {
    color: var(--danger);
    font-size: 0.875rem;
  }

  :global(.ui-box) {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    cursor: pointer;
  }

  :global(.ui-mark) {
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--muted);
    border-radius: 5px;
    color: #fff;
    transition: background 0.15s, border-color 0.15s;
  }

  /* A box shows the icon of its state: a check, or a dash while it is indeterminate. */
  :global(.ui-mark .icon) {
    display: none;
  }

  :global(.ui-box[data-selected]:not([data-indeterminate]) .ui-mark .icon-check),
  :global(.ui-box[data-indeterminate] .ui-mark .icon-minus) {
    display: block;
  }

  :global(.ui-box[data-hovered] .ui-mark) {
    border-color: var(--accent);
  }

  :global(.ui-box[data-pressed] .ui-mark) {
    scale: 0.92;
  }

  :global(.ui-box[data-selected] .ui-mark:not(.round)),
  :global(.ui-box[data-indeterminate] .ui-mark) {
    background: var(--accent);
    border-color: var(--accent);
  }

  /* A radio is a ring, with a dot while it is chosen. */
  :global(.ui-mark.round) {
    border-radius: 50%;
  }

  :global(.ui-mark.round)::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    scale: 0;
    transition: scale 0.15s;
  }

  :global(.ui-box[data-selected] .ui-mark.round) {
    border-color: var(--accent);
  }

  :global(.ui-box[data-selected] .ui-mark.round)::after {
    scale: 1;
  }

  :global(.ui-box[data-focus-visible] .ui-mark),
  :global(.ui-box[data-focus-visible] .ui-track) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.ui-box[data-disabled]) {
    opacity: 0.55;
    cursor: default;
  }

  :global(.ui-track) {
    position: relative;
    width: 2.2rem;
    height: 1.25rem;
    border-radius: 1rem;
    background: var(--border);
    transition: background 0.15s;
  }

  :global(.ui-track)::after {
    content: '';
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: #fff;
    transition: translate 0.15s;
  }

  :global(.ui-box[data-selected] .ui-track) {
    background: var(--accent);
  }

  :global(.ui-box[data-selected] .ui-track)::after {
    translate: 0.95rem 0;
  }

  :global(.ui-group) {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.ui-bar) {
    display: grid;
    gap: 0.35rem;
    min-width: 16rem;
  }

  :global(.ui-bar)::after {
    content: '';
    height: 0.5rem;
    border-radius: 1rem;
    background: linear-gradient(to right, var(--accent) var(--percentage, 0%), var(--border) 0);
  }

  :global(.ui-icon-button) {
    display: inline-grid;
    place-items: center;
    padding: 0.5rem;
  }

  /* An icon inside the start of an input, such as the glass of a search field. */
  :global(.ui-input-icon) {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  :global(.ui-input-icon .icon) {
    position: absolute;
    left: 0.65rem;
    color: var(--muted);
    pointer-events: none;
  }

  :global(.ui-input-icon .ui-input) {
    padding-left: 2rem;
  }

  :global(.ui-crumb) {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--muted);
  }

  :global(.ui-form) {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  :global(.ui-kbd) {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 5px;
    font: 600 0.8rem var(--mono, ui-monospace, monospace);
  }

  :global(.ui-accordion) {
    width: 100%;
    max-width: 26rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  :global(.ui-disclosure + .ui-disclosure) {
    border-top: 1px solid var(--border);
  }

  /* A demo heading is a level below the title of the page, with none of the look of the page's. */
  :global(.ui-disclosure h2) {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: inherit;
    letter-spacing: normal;
  }

  :global(.ui-disclosure-trigger) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    text-align: start;
    cursor: pointer;
  }

  :global(.ui-disclosure-trigger .icon) {
    transition: rotate 0.2s;
  }

  :global(.ui-disclosure[data-expanded] .ui-disclosure-trigger .icon) {
    rotate: 180deg;
  }

  /* The panel slides from the height that it holds while it moves, and fades. */
  :global(.ui-disclosure-panel) {
    height: var(--disclosure-panel-height, auto);
    overflow: clip;
    color: var(--muted);
    transition: height 0.25s, opacity 0.25s;
  }

  :global(.ui-disclosure-panel[data-closed]) {
    opacity: 0;
  }

  :global(.ui-disclosure-panel p) {
    margin: 0;
    padding: 0 0.9rem 0.8rem;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.ui-disclosure-panel) {
      transition: none;
    }
  }

  /* A transition from the data attributes of Transition, with no classes. */
  :global(.ui-note) {
    flex-basis: 100%;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    transition: opacity 0.25s, translate 0.25s;
  }

  :global(.ui-note[data-closed]) {
    opacity: 0;
    translate: 0 -0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.ui-note) {
      transition: none;
    }
  }

  /* A list of options, whose selected options take the accent. */
  :global(.ui-listbox) {
    display: grid;
    width: min(16rem, 100%);
    max-height: 14rem;
    overflow: auto;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    outline: none;
  }

  :global(.ui-listbox:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.ui-listbox-header) {
    padding: 0.5rem 0.6rem 0.25rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  :global(.ui-option) {
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    cursor: default;
    outline: none;
  }

  :global(.ui-option[data-hovered]) {
    background: var(--surface);
  }

  :global(.ui-option[data-focus-visible]) {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  :global(.ui-option[data-selected]) {
    background: var(--accent-strong);
    color: var(--bg);
  }

  :global(.ui-option[data-disabled]) {
    color: var(--muted);
  }

  /* Parts side by side, such as the triggers of two menus. */
  :global(.ui-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* A select: a field whose button shows the value, and a list as wide as the button. */
  :global(.ui-select) {
    display: grid;
    gap: 0.35rem;
    width: min(16rem, 100%);
  }

  :global(.ui-select-button) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 400;
    text-align: start;
  }

  :global(.ui-select-button)::after {
    color: var(--muted);
    content: '▾';
  }

  :global(.ui-select-value[data-placeholder]) {
    color: var(--muted);
  }

  :global(.ui-select-popover .ui-listbox) {
    width: var(--trigger-width);
    box-shadow: var(--shadow);
  }

  /* A combobox: an input and its button in one box. */
  :global(.ui-combobox-box) {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
  }

  :global(.ui-combobox-box:focus-within) {
    border-color: var(--accent);
  }

  :global(.ui-combobox-box .ui-input) {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
  }

  :global(.ui-combobox-box .ui-select-button) {
    border: 0;
    background: none;
  }

  /* Tabs: a row of tabs whose selected one takes the accent, over its panel. */
  :global(.ui-tablist) {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border);
  }

  :global(.ui-tab) {
    padding: 0.45rem 0.8rem;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    cursor: default;
    outline: none;
  }

  :global(.ui-tab[data-hovered]) {
    color: var(--text);
  }

  :global(.ui-tab[data-selected]) {
    border-color: var(--accent);
    color: var(--text);
    font-weight: 600;
  }

  :global(.ui-tab[data-focus-visible]),
  :global(.ui-tabpanel:focus-visible) {
    border-radius: 6px;
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  :global(.ui-tabpanel) {
    padding: 0.75rem 0.25rem;
    outline: none;
  }

  /* Tags: rounded chips in a row, whose selected ones take the accent. */
  :global(.ui-taglist) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    outline: none;
  }

  :global(.ui-tag) {
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: default;
    outline: none;
  }

  :global(.ui-tag[data-hovered]) {
    border-color: var(--muted);
  }

  :global(.ui-tag[data-selected]) {
    border-color: var(--accent-strong);
    background: var(--accent-strong);
    color: var(--bg);
  }

  :global(.ui-tag[data-focus-visible]) {
    box-shadow: 0 0 0 2px var(--accent);
  }

  :global(.ui-tag-remove) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  /* A grid list: rows with a checkbox and a button, whose selected rows take the accent. */
  :global(.ui-gridlist) {
    display: grid;
    width: min(22rem, 100%);
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
  }

  :global(.ui-gridlist:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.ui-gridrow) {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    outline: none;
  }

  :global(.ui-gridrow[data-hovered]) {
    background: var(--surface);
  }

  :global(.ui-gridrow[data-selected]) {
    background: var(--accent-soft);
  }

  :global(.ui-gridrow[data-focus-visible]) {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  :global(.ui-gridrow[data-dragging]) {
    opacity: 0.5;
  }

  :global(.ui-gridrow[data-drop-target='before']) {
    box-shadow: inset 0 2px 0 var(--accent);
  }

  :global(.ui-gridrow[data-drop-target='after']) {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  :global(.ui-grip) {
    display: grid;
    place-items: center;
    padding: 0.15rem;
    border: none;
    border-radius: 4px;
    background: none;
    color: inherit;
    cursor: grab;
  }

  :global(.ui-grip:focus-visible) {
    outline: 2px solid var(--accent);
  }

  :global(.ui-gridrow .ui-button) {
    margin-inline-start: auto;
    padding: 0.2rem 0.6rem;
  }

  /* A table: its sorted column shows an arrow, and selected rows take the accent. */
  :global(.ui-table) {
    width: min(32rem, 100%);
    border-collapse: collapse;
    border: 1px solid var(--border);
    outline: none;
  }

  :global(.ui-table:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.ui-column) {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    text-align: start;
    outline: none;
  }

  :global(.ui-column[data-allows-sorting]) {
    cursor: pointer;
  }

  :global(.ui-column[data-sort-direction='ascending'])::after {
    content: ' ▲';
  }

  :global(.ui-column[data-sort-direction='descending'])::after {
    content: ' ▼';
  }

  :global(.ui-resizable) {
    max-width: 100%;
  }

  :global(.ui-resizable-column) {
    position: relative;
  }

  /* A resizer: a bar at the end of the header, which shows while it is used. */
  :global(.ui-resizer) {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: 6px;
    cursor: col-resize;
    border-inline-end: 2px solid var(--border);
  }

  :global(.ui-resizer[data-resizing]),
  :global(.ui-resizer[data-focus-visible]) {
    border-color: var(--accent);
  }

  :global(.ui-select-column) {
    width: 2rem;
  }

  :global(.ui-tablerow) {
    outline: none;
  }

  :global(.ui-tablerow[data-hovered]) {
    background: var(--surface);
  }

  :global(.ui-tablerow[data-selected]) {
    background: var(--accent-soft);
  }

  :global(.ui-tablerow[data-focus-visible]),
  :global(.ui-column:focus-visible),
  :global(.ui-cell:focus-visible) {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  :global(.ui-cell) {
    padding: 0.35rem 0.6rem;
    font-weight: normal;
    text-align: start;
    outline: none;
  }

  :global(.ui-number) {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  /* A tree: rows indented by their level, with a chevron that turns while the row is open. */
  :global(.ui-tree) {
    display: grid;
    width: min(22rem, 100%);
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
  }

  :global(.ui-tree:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.ui-treerow) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.3rem 0.5rem;
    padding-inline-start: calc(0.5rem + (var(--tree-item-level) - 1) * 1.25rem);
    border-radius: 6px;
    outline: none;
  }

  :global(.ui-treerow[data-hovered]) {
    background: var(--surface);
  }

  :global(.ui-treerow[data-selected]) {
    background: var(--accent-soft);
  }

  :global(.ui-treerow[data-focus-visible]) {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  :global(.ui-row-action) {
    margin-inline-start: auto;
    padding: 0 0.5rem;
  }

  /* A field of text with tokens: each token is a chip in the line of text. */
  :global(.ui-token-input) {
    min-height: 2.5rem;
    line-height: 1.8;
  }

  :global(.ui-token) {
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  :global(.ui-mention) {
    border-color: var(--accent);
    font-weight: 600;
  }

  :global(.ui-token[data-selected]) {
    background: var(--accent-soft);
  }

  :global(.ui-dropzone) {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    padding: 1.5rem;
    width: min(22rem, 100%);
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    text-align: center;
  }

  :global(.ui-dropzone[data-drop-target]),
