  }

  .ui-mark {
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--muted);
    border-radius: 5px;
    color: var(--on-accent);
    transition: background 0.15s, border-color 0.15s;
  }

  /* A box shows the icon of its state: a check, or a dash while it is indeterminate. */
  .ui-mark .icon {
    display: none;
  }

  .ui-box[data-selected]:not([data-indeterminate]) .ui-mark .icon-check,
  .ui-box[data-indeterminate] .ui-mark .icon-minus {
    display: block;
  }

  .ui-box[data-hovered] .ui-mark {
    border-color: var(--accent);
  }

  .ui-box[data-pressed] .ui-mark {
    scale: 0.92;
  }

  .ui-box[data-selected] .ui-mark:not(.round),
  .ui-box[data-indeterminate] .ui-mark {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
  }

  /* A radio is a ring, with a dot while it is chosen. */
  .ui-mark.round {
    border-radius: 50%;
  }

  .ui-mark.round::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    scale: 0;
    transition: scale 0.15s;
  }

  .ui-box[data-selected] .ui-mark.round {
    border-color: var(--accent);
  }

  .ui-box[data-selected] .ui-mark.round::after {
    scale: 1;
  }

  .ui-box[data-focus-visible] .ui-mark,
