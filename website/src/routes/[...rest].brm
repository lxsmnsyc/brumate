<script>
  import { $title } from 'brumate/signals';
  import { getEvent } from 'brumate/server';

  const base = import.meta.env.BASE_URL;
  getEvent().setStatus(404);
  $title('Not found | brumate');
</script>

<main class="not-found">
  <h1>Not found</h1>
  <p>Nothing lives here. <a href=base>Go home</a>.</p>
</main>
