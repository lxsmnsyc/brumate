<script>
  import Meta from '../components/Meta.brm';
  import Install from '../components/home/Install.brm';
  import NetworkStrip from '../components/home/NetworkStrip.brm';
  import ResumeStage from '../components/home/ResumeStage.brm';
  import Scrolly from '../components/home/Scrolly.brm';
  import Cart from '../demos/Cart.brm';
  import Stepper from '../demos/Stepper.brm';
  import * as shop from '../demos/Shop.brm?inspect';

  const base = import.meta.env.BASE_URL;

  /** The gzip size of the client code of the shop demo, in KB, as `brumate inspect` measures it. */
  function measureShop(): string {
    let sum = 0;
    for (const size of shop.report.sizes) {
      sum += size.gzip;
    }
    return (sum / 1024).toFixed(1);
  }
  const shopKb = measureShop();

  // Each feature links to the page of the docs that explains it.
  const features = [
    { label: '#loading', title: 'Stream the data later', page: 'async-data', text: 'Send the page now, and each part when its data is ready. The browser needs no code for it.' },
    { label: "'use server'", title: 'Call the server like a function', page: 'server-functions', text: 'Its body and its imports stay on the server. The browser gets a small function that sends the call.' },
    { label: 'routes/[id].brm', title: 'Files are routes', page: 'routing', text: 'Layouts, params and links that load pages in place, with the state of the layouts kept.' },
    { label: '<form action>', title: 'Forms without scripts', page: 'forms', text: 'A form posts to a server function before any script loads, and better after.' },
    { label: 'brumate inspect', title: 'See what ships', page: 'inspect', text: 'Ask the compiler what each component sends to the browser, and why.' },
    { label: '@brumate/ui', title: 'Accessible parts', page: '../ui', text: 'Unstyled parts with the right roles, keys and focus. A part you do not render ships nothing.' },
  ];
</script>

#head {
  <title>brumate: web apps that resume</title>
}

<Meta
  title="brumate: web apps that resume"
  description="A component language and compiler. Components render on the server, and the browser picks up where the server left off. No hydration, and code only for what responds to the user."
  path=""
/>
<main class="landing">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">A component language and compiler</p>
      <h1 class="display">Web apps that <em>resume</em>, not hydrate.</h1>
      <p class="lead">
        The server renders the page. The browser keeps its state and runs code only for what
        responds to the user. Nothing renders twice.
      </p>
      <div class="actions">
        <a class="button primary" href=(`${base}docs/getting-started`)><span class="arrow">Get started</span></a>
        <a class="button" href=(`${base}repl`)>Open the REPL</a>
      </div>
      <Install />
    </div>
    <ResumeStage kb=shopKb />
  </section>

  <section class="act">
    <div class="section-head">
      <span class="numeral" aria-hidden="true">01</span>
      <div>
        <h2>Ship <em>less</em>.</h2>
        <p>
          Follow one component through the compiler. Every snippet and size on the right is output of the
          build of this site, run on <code>Counter.brm</code>.
        </p>
      </div>
    </div>
    <Scrolly />
  </section>

  <section class="act">
    <div class="section-head">
      <span class="numeral" aria-hidden="true">02</span>
      <div>
        <h2>Pick up <em>where</em> the server left off.</h2>
        <p>
          These demos are brumate components. Their code came with the page. Use one and watch the strip at
          the bottom: the handler runs at once, with no request and no render.
        </p>
      </div>
    </div>
    <div class="demos">
      <article class="card demo" data-demo="Stepper">
        <h3>Counter</h3>
        <p>The server rendered 3. The browser keeps it.</p>
        <Stepper />
      </article>
      <article class="card demo" data-demo="Cart">
        <h3>Cart</h3>
        <p>Each button runs its handler with the state the server sent.</p>
        <Cart />
      </article>
    </div>
  </section>

  <section class="act">
    <div class="section-head">
      <span class="numeral" aria-hidden="true">03</span>
      <div>
        <h2>The rest of an <em>app</em>.</h2>
        <p>Server functions, streaming, routes, forms and tests, in the same language.</p>
      </div>
    </div>
    <div class="grid">
      #for (feature of features by feature.title) {
        <a class="cell" href=(feature.page.startsWith('../') ? `${base}${feature.page.slice(3)}` : `${base}docs/${feature.page}`)>
          <code>{feature.label}</code>
          <h3>{feature.title} <span class="corner" aria-hidden="true">↗</span></h3>
          <p>{feature.text}</p>
        </a>
      }
    </div>
  </section>
</main>
<NetworkStrip />

<style>
  .landing {
    max-width: var(--page-width);
    margin: 0 auto;
    /* Room for the network strip, so it covers nothing. */
    padding: 0 1.5rem 3rem;
  }

  .landing code {
    font-size: 0.88em;
  }

  /* Hero */

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding: 5.5rem 0 4.5rem;
  }

  .hero::before {
    content: '';
    position: absolute;
    /* Inside the hero, so the glow never widens the page. */
    inset: -10% 0 auto 30%;
    z-index: -1;
    height: 32rem;
    background: radial-gradient(closest-side, var(--accent-tint), transparent);
    filter: blur(20px);
    pointer-events: none;
  }

  .hero .display {
    margin: 1.1rem 0 1.4rem;
  }

  .hero .display em {
    position: relative;
  }

  .hero .display em::after {
    content: '';
    position: absolute;
    right: 2%;
    bottom: 0.02em;
    left: 2%;
    height: 0.07em;
    border-radius: 2px;
    background: var(--accent);
    transform-origin: left;
    animation: draw 900ms 400ms var(--ease) both;
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }

  .lead {
    max-width: 34rem;
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  /* Sections */

  .act {
    padding: 5rem 0;
    border-top: 1px solid var(--border);
  }

  /* ii. The demos */

  .demos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .demo {
    padding: 1.6rem;
  }

  .demo h3 {
    margin: 0 0 0.3rem;
    font-size: 1.1rem;
  }

  .demo > p {
    margin: 0 0 1.2rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* iii. The features, a hairline grid of links */

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--border);
    overflow: hidden;
  }

  .cell {
    padding: 1.6rem;
    background: var(--bg-elevated);
    color: var(--text);
    text-decoration: none;
    transition: background var(--duration);
  }

  .cell:hover {
    background: var(--surface);
  }

  .cell code {
    display: block;
    margin-bottom: 0.9rem;
    color: var(--accent-strong);
    font: var(--text-xs) var(--mono);
  }

  .cell h3 {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .corner {
    color: var(--subtle);
    transition:
      transform var(--duration) var(--ease),
      color var(--duration);
  }

  .cell:hover .corner {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .cell p {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
  }

  @media (max-width: 56rem) {
    .hero,
    .demos,
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero {
      padding-top: 3rem;
    }
  }
</style>
