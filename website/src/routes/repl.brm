  /* Editor */

  .editor {
    display: flex;
    flex: 1;
    min-height: 0;
  }

  .gutter {
    flex: none;
    min-width: 3rem;
    margin: 0;
    padding: 1rem 0.75rem 1rem 0.5rem;
    border-right: 1px solid var(--border);
    color: var(--muted);
    font: 0.85rem/1.6 var(--mono);
    text-align: right;
    opacity: 0.6;
    overflow: hidden;
    user-select: none;
