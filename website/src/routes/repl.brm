    font-size: 0.8rem;
  }

  /* A narrow screen puts the output under the files. */
  @media (max-width: 900px) {
    .repl {
      height: auto;
    }

    .repl-panes {
      grid-template-columns: minmax(0, 1fr);
    }

    .splitter {
      display: none;
    }

    .repl-source {
      height: 24rem;
