<script>
  import { $client, $effect, $memo, $signal, $untrack } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import type { LiveOutput } from '../live/run.ts';
  import { decode, encode, examples, measure, validName } from '../repl/files.ts';
  import type { ReplFile } from '../repl/files.ts';
  import { highlight } from '../repl/highlight.ts';
  import Meta from '../components/Meta.brm';

  let files = $signal<ReplFile[]>(examples[0]!.files);
  let active = $signal(0);
  let view = $signal<'result' | 'compiled' | 'ships' | 'console'>('result');
  let shown = $signal('');
  let output = $signal<LiveOutput>();
  let error = $signal('');
  let running = $signal(false);
  let runs = $signal(0);
  // The files of the last run, so the first run of the effect does not run them twice.
  let ranWith = $signal<ReplFile[]>();
  // False until the files of a shared link are open, so the address keeps the link until then.
  let ready = $signal(false);
  let logs = $signal<{ id: number; level: string; text: string }[]>([]);
  let adding = $signal(false);
  let draftName = $signal('');
  let nameError = $signal('');
  let copied = $signal(false);
  let result = $signal<HTMLElement>();
  let backdrop = $signal<HTMLElement>();

  const language = (name: string): 'brm' | 'ts' => (name.endsWith('.brm') ? 'brm' : 'ts');
  // A line break at the end keeps the last line of the editor and the highlight the same height.
  const sourceHtml = $memo(
    highlight(`${files[active]?.source ?? ''}\n`, language(files[active]?.name ?? '')),
  );
  const module = $memo(output?.modules.find((item) => item.name === shown) ?? output?.modules[0]);
  const moduleHtml = $memo(module ? highlight(module.code, module.language) : undefined);
  const sizes = $memo(
    Promise.all(
      (output?.modules ?? [])
        .filter((item) => item.client)
        .map(async (item) => ({ name: item.name, ...(await measure(item.code)) })),
    ),
  );
  const errors = $memo(logs.filter((log) => log.level === 'error').length);

  /** Sets the source of the open file. */
  function edit(source: string) {
    const next = [...files];
    next[active] = { ...next[active]!, source };
    files = next;
  }

  function open(next: ReplFile[]) {
    files = next;
    active = 0;
  }

  /** Adds a file with a start that runs, for its kind. */
  function addFile() {
    const name = draftName.trim();
    const problem = validName(
      name,
      files.map((file) => file.name),
    );
    if (problem) {
      nameError = problem;
      return;
    }
    const source = name.endsWith('.brm.ts')
      ? `import { $signal } from 'brumate/signals';\n\nexport function use() {\n  let value = $signal(0);\n  return { value };\n}\n`
      : name.endsWith('.ts')
        ? `export const value = 1;\n`
        : `<p>${name}</p>\n`;
    files = [...files, { name, source }];
    active = files.length - 1;
    adding = false;
    draftName = '';
    nameError = '';
  }

  function removeFile(index: number) {
    files = files.filter((_, at) => at !== index);
    if (active >= index) {
      active = Math.max(0, active - 1);
    }
  }

  async function run() {
    if (files === ranWith) {
      return;
    }
    ranWith = files;
    // Only the latest run writes its result, so an older run that finishes later is dropped.
    runs++;
    const id = runs;
    running = true;
    logs = [];
    try {
      const { runSample } = await import('../live/run.ts');
      const next = await runSample(result!, files, () => id === runs);
      if (id === runs) {
        output = next;
        error = '';
      }
    } catch (caught) {
      if (id === runs) {
        error = caught instanceof Error ? caught.message : String(caught);
      }
    }
    if (id === runs) {
      running = false;
    }
  }

  async function share() {
    // The address gets the files after a pause in typing, so the link is made from them here.
    history.replaceState(history.state, '', `#${encode(files)}`);
    try {
      await navigator.clipboard.writeText(location.href);
    } catch {
      // The browser can refuse the clipboard. The link is still in the address bar.
      return;
    }
    copied = true;
    setTimeout(() => (copied = false), 1500);
  }

  // The console of the page shows in the REPL, with the errors that nothing caught.
  $client(() => {
    let count = 0;
    const text = (value: unknown): string => {
      if (typeof value === 'string') {
        return value;
      }
      if (value instanceof Error) {
        return `${value.name}: ${value.message}`;
      }
      try {
        return JSON.stringify(value) ?? String(value);
      } catch {
        return String(value);
      }
    };
    const push = (level: string, values: unknown[]) => {
      count++;
      logs = [...$untrack(logs), { id: count, level, text: values.map(text).join(' ') }].slice(-200);
    };
    const levels = ['log', 'info', 'warn', 'error'] as const;
    const originals = levels.map((level) => console[level]);
    for (const [index, level] of levels.entries()) {
      const original = originals[index]!.bind(console);
      console[level] = (...values: unknown[]) => {
        push(level, values);
        original(...values);
      };
    }
    const onError = (event: ErrorEvent) => push('error', [event.error ?? event.message]);
    const onRejection = (event: PromiseRejectionEvent) => push('error', [event.reason]);
    addEventListener('error', onError);
    addEventListener('unhandledrejection', onRejection);

    // A shared link opens its files.
    const shared = decode(location.hash.slice(1));
    if (shared) {
      open(shared);
    }
    ready = true;
    void run();

    // Leaving the REPL gives the console back.
    return () => {
      for (const [index, level] of levels.entries()) {
        console[level] = originals[index]!;
      }
      removeEventListener('error', onError);
      removeEventListener('unhandledrejection', onRejection);
    };
  }, 'load');

  // An edit runs the files again, once typing pauses, and keeps them in the address.
  // The effect reads only `files`: `run` reads and writes other values, which must not run it again.
  $effect(() => {
    const current = files;
    const timer = setTimeout(() => {
      if (current === $untrack(files) && $untrack(ready)) {
        history.replaceState(history.state, '', `#${encode(current)}`);
        void $untrack(run());
      }
    }, 400);
    return () => clearTimeout(timer);
  });
</script>

#head {
  <title>REPL | brumate</title>
}

<Meta
  title="REPL | brumate"
  description="Write brumate components and run them in your browser. See the page they render, the code they compile to, and what the browser loads."
  path="repl"
/>
<main class="repl-page">
  <header class="repl-bar">
    <h1>REPL</h1>
    <label>
      Example
      <select onChange=((event) => open(examples[Number(event.currentTarget.value)]!.files))>
        #for (example, index of examples by example.name) {
          <option value=index>{example.name}</option>
        }
      </select>
    </label>
    <button class="button" type="button" onClick=share>{copied ? 'Copied' : 'Copy link'}</button>
    <p class="repl-note">The compiler and the server runtime run in your browser. They load with the page.</p>
  </header>
  <div class="repl-grid">
    <section class="repl-source" aria-label="Files">
      <div class="tabs repl-files" role="tablist">
        #for (file, index of files by file.name) {
          <span class={ 'repl-file': true, active: index === active }>
            <button role="tab" aria-selected=(index === active) onClick=(() => (active = index))>{file.name}</button>
            #if (index > 0) {
              <button class="repl-remove" aria-label=(`Remove ${file.name}`) onClick=(() => removeFile(index))>×</button>
            }
          </span>
        }
        #if (adding) {
          <form class="repl-add" onSubmit=(prevent(addFile))>
            <input
              aria-label="File name"
              placeholder="Name.brm"
              value=draftName
              onInput=((event) => {
                draftName = event.currentTarget.value;
                nameError = '';
              })
              onKeyDown=((event) => {
                if (event.key === 'Escape') {
                  adding = false;
                }
              })
            >
          </form>
        } #else {
          <button aria-label="Add a file" onClick=(() => (adding = true))>+</button>
        }
      </div>
      #if (nameError) {
        <p class="repl-name-error">{nameError}</p>
      }
      <div class="editor">
        <div class="editor-backdrop code" ref=backdrop aria-hidden="true">{sourceHtml}</div>
        <textarea
          aria-label=(`Source of ${files[active]?.name}`)
          spellcheck="false"
          value=(files[active]?.source ?? '')
          onInput=((event) => edit(event.currentTarget.value))
          onKeyDown=((event) => {
            if (event.key !== 'Tab' || event.shiftKey) {
              return;
            }
            event.preventDefault();
            const area = event.currentTarget;
            area.setRangeText('  ', area.selectionStart, area.selectionEnd, 'end');
            edit(area.value);
          })
          onScroll=((event) => {
            backdrop!.scrollTop = event.currentTarget.scrollTop;
            backdrop!.scrollLeft = event.currentTarget.scrollLeft;
          })
        >{$untrack(files[0]!.source)}</textarea>
      </div>
    </section>
    <section class="output" aria-label="Output">
      <div class="tabs" role="tablist">
        <button role="tab" aria-selected=(view === 'result') class={ active: view === 'result' } onClick=(() => (view = 'result'))>Result</button>
        <button role="tab" aria-selected=(view === 'compiled') class={ active: view === 'compiled' } onClick=(() => (view = 'compiled'))>Compiled</button>
        <button role="tab" aria-selected=(view === 'ships') class={ active: view === 'ships' } onClick=(() => (view = 'ships'))>What ships</button>
        <button role="tab" aria-selected=(view === 'console') class={ active: view === 'console' } onClick=(() => (view = 'console'))>
          Console
          #if (logs.length > 0) {
            <span class={ 'repl-count': true, bad: errors > 0 }>{logs.length}</span>
          }
        </button>
        #if (running) {
          <span class="repl-status">Running</span>
        }
      </div>
      #if (error) {
        <pre class="error">{error}</pre>
      }
      <div class={ 'repl-result': true, hidden: view !== 'result' } ref=result>
        <p class="repl-note">The files run once the page loads.</p>
      </div>
      #if (view === 'compiled' && output) {
        <div class="repl-compiled">
          <select aria-label="Module" onChange=((event) => (shown = event.currentTarget.value))>
            #for (item of output.modules by item.name) {
              <option value=(item.name) selected=(item.name === module?.name)>{item.name}</option>
            }
          </select>
          <div class="code output-code">{moduleHtml}</div>
        </div>
      }
      #if (view === 'ships') {
        #loading {
          <table class="sizes">
            <thead>
              <tr><th>Client module</th><th>Bytes</th><th>gzip</th></tr>
            </thead>
            <tbody>
              #for (size of sizes by size.name) {
                <tr><td><code>{size.name}</code></td><td class="num">{size.bytes}</td><td class="num">{size.gzip}</td></tr>
              }
            </tbody>
          </table>
          <p class="repl-note">
            The client entry loads when a component is first used. Each part loads when its event fires or a value it updates changes.
            The server code never reaches the browser.
          </p>
        } #else {
          <p class="repl-note repl-pad">Measuring</p>
        }
      }
      #if (view === 'console') {
        <ol class="repl-console">
          #for (log of logs by log.id) {
            <li class=(`repl-log ${log.level}`)>{log.text}</li>
          } #else {
            <li class="repl-log empty">Nothing logged yet. Use console.log in a handler.</li>
          }
        </ol>
      }
      #if (output && output.warnings.length > 0) {
        <ul class="warnings">
          #for (warning of output.warnings by warning) {
            <li>{warning}</li>
          }
        </ul>
      }
    </section>
  </div>
</main>

<style>
  /* Playground */

  .repl-page {
    max-width: 90rem;
    margin: 0 auto;
    padding: 1.25rem 1rem 3rem;
  }

  .repl-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-bottom: 1rem;
  }

  .repl-bar h1 {
    margin: 0;
    font-size: 1.5rem;
  }

  .repl-bar label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .repl-bar select {
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  .repl-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .repl-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    height: calc(100vh - var(--header-height) - 6rem);
    min-height: 28rem;
  }

  .editor {
    position: relative;
    min-height: 0;
  }

  .editor-backdrop,
  .editor textarea {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 1rem 1.1rem;
    font: 0.85rem/1.6 var(--mono);
    white-space: pre;
    overflow: auto;
    tab-size: 2;
  }

  .editor-backdrop {
    pointer-events: none;
  }

  .editor textarea {
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: transparent;
    caret-color: var(--text);
    resize: none;
  }

  .editor textarea:focus {
    outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .editor textarea::selection {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    color: transparent;
  }

  .output {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--code-bg);
    overflow: hidden;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .tabs button {
    padding: 0.3rem 0.6rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font: 0.8rem var(--mono);
    cursor: pointer;
  }

  .tabs button.active {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .output-code {
    flex: 1;
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .sizes {
    margin: 1rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .sizes th,
  .sizes td {
    padding: 0.35rem 0.75rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .sizes .num {
    font-family: var(--mono);
    text-align: right;
  }

  .output .repl-note {
    margin: 0 1rem 1rem;
  }

  .warnings {
    margin: 0;
    padding: 0.75rem 1rem 0.75rem 2rem;
    border-top: 1px solid var(--border);
    color: #b7791f;
    font-size: 0.85rem;
  }

  .error {
    margin: 0;
    padding: 1rem;
    color: #d64545;
    font: 0.85rem/1.6 var(--mono);
    white-space: pre-wrap;
  }

  @media (max-width: 900px) {
    .repl-grid {
        grid-template-columns: minmax(0, 1fr);
        height: auto;
      }

    .editor,
    .repl-grid .repl-source .editor {
        flex: none;
        height: 24rem;
      }

    .output {
        height: 28rem;
      }
  }

  .repl-source {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--code-bg);
    overflow: hidden;
  }

  .repl-source .editor {
    flex: 1;
  }

  .repl-source .editor textarea {
    border-radius: 0;
  }

  .repl-files {
    align-items: center;
  }

  .repl-file {
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
  }

  .repl-file.active {
    background: var(--accent-soft);
  }

  .repl-file.active button {
    color: var(--accent-strong);
  }

  .tabs .repl-remove {
    padding: 0.3rem 0.45rem 0.3rem 0;
  }

  .repl-add input {
    width: 9rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font: 0.8rem var(--mono);
  }

  .repl-name-error {
    margin: 0;
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--border);
    color: #d64545;
    font-size: 0.8rem;
  }

  .repl-status {
    margin-left: auto;
    align-self: center;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .repl-count {
    margin-left: 0.35rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--surface-strong);
    font-size: 0.7rem;
  }

  .repl-count.bad {
    background: #d64545;
    color: #fff;
  }

  .repl-result {
    flex: 1;
    padding: 1rem;
    background: var(--bg);
    overflow: auto;
  }

  .repl-result.hidden {
    display: none;
  }

  .repl-compiled {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .repl-compiled select {
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  .repl-compiled select {
    margin: 0.5rem;
    font: 0.8rem var(--mono);
  }

  .repl-compiled .output-code {
    overflow: auto;
  }

  .repl-console {
    flex: 1;
    margin: 0;
    padding: 0;
    overflow: auto;
    font: 0.8rem/1.5 var(--mono);
    list-style: none;
  }

  .repl-log {
    padding: 0.35rem 0.75rem;
    border-bottom: 1px solid var(--border);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .repl-log.warn {
    background: color-mix(in srgb, #b7791f 10%, transparent);
    color: #b7791f;
  }

  .repl-log.error {
    background: color-mix(in srgb, #d64545 10%, transparent);
    color: #d64545;
  }

  .repl-log.empty {
    color: var(--muted);
  }

  .repl-pad {
    padding: 1rem;
  }
</style>
