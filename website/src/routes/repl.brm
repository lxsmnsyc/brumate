  .repl-count.bad {
    background: var(--danger);
    color: var(--bg);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  .segment {
    display: flex;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
  }

  .segment button {
    padding: 0.15rem 0.5rem;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--muted);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .segment button[aria-pressed='true'] {
    background: var(--surface-strong);
    color: var(--text);
  }

  .repl .tool {
    display: inline-grid;
    place-items: center;
    min-width: 1.85rem;
    height: 1.85rem;
    padding: 0 0.55rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--muted);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .repl .tool:hover {
    color: var(--text);
  }

  .preview {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    flex: 1;
    min-height: 0;
  }

  .preview.hidden {
    display: none;
  }

  .canvas {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: center;
    min-height: 0;
    padding: 1.25rem;
    overflow: auto;
  }

  .canvas.dots {
    background:
