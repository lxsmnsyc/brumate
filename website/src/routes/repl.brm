  .editor-body {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .editor-backdrop,
  .editor textarea {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 1rem 1.1rem;
    font: 0.85rem/1.6 var(--mono);
    white-space: pre;
    overflow: auto;
    tab-size: 2;
  }

  .editor-backdrop {
    pointer-events: none;
  }

  /* The highlight takes the colors of a code block, and the editor draws the frame. */
  .editor-backdrop.code {
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .editor textarea {
    border: 0;
    background: transparent;
    color: transparent;
    caret-color: var(--text);
    resize: none;
  }

  .editor textarea:focus {
    outline: none;
  }

  /* The textarea has no outline, so the editor shows the focus instead. */
  .editor:has(textarea:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .editor textarea::selection {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    color: transparent;
  }

  /* Output */

  .views {
    display: flex;
    gap: 0.15rem;
  }

  .views button {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.65rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .views button:hover {
    color: var(--text);
