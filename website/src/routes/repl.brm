<script>
  import Icon from '../components/Icon.brm';
  import { $client, $effect, $memo, $signal, $untrack } from 'brumate/signals';
  import { prevent } from 'brumate/events';
  import type { LiveOutput } from '../live/run.ts';
  import { decode, encode, examples, measure, validName } from '../repl/files.ts';
  import type { ReplFile } from '../repl/files.ts';
  import { highlight } from '../repl/highlight.ts';
  import Meta from '../components/Meta.brm';

  let files = $signal<ReplFile[]>(examples[0]!.files);
  let active = $signal(0);
  let view = $signal<'result' | 'compiled' | 'ships' | 'console'>('result');
  let shown = $signal('');
  let output = $signal<LiveOutput>();
  let error = $signal('');
  let running = $signal(false);
  let runs = $signal(0);
  // The files of the last run, so the first run of the effect does not run them twice.
  let ranWith = $signal<ReplFile[]>();
  // False until the files of a shared link are open, so the address keeps the link until then.
  let ready = $signal(false);
  let logs = $signal<{ id: number; level: string; text: string }[]>([]);
  let adding = $signal(false);
  let draftName = $signal('');
  let nameError = $signal('');
  let copied = $signal(false);
  let result = $signal<HTMLElement>();
  let backdrop = $signal<HTMLElement>();
  let gutter = $signal<HTMLElement>();
  let panes = $signal<HTMLElement>();
  let width = $signal('');
  let canvas = $signal<'dots' | 'plain'>('dots');
  // The width of the source pane, in percent, which the divider changes.
  let split = $signal(50);
  let dragging = $signal(false);
  let nameInput = $signal<HTMLInputElement>();

  // The field for a new name replaces the button that opens it, so focus moves to the field.
  $effect(() => {
    nameInput?.focus();
  });

  function language(name: string): 'brm' | 'ts' {
    return name.endsWith('.brm') ? 'brm' : 'ts';
  }
  // A line break at the end keeps the last line of the editor and the highlight the same height.
  const sourceHtml = $memo(
    highlight(`${files[active]?.source ?? ''}\n`, language(files[active]?.name ?? '')),
  );
  function shownModule() {
    for (const item of output?.modules ?? []) {
      if (item.name === shown) {
        return item;
      }
    }
    return output?.modules[0];
  }
  const module = $memo(shownModule());
  const moduleHtml = $memo(module ? highlight(module.code, module.language) : undefined);
  async function measureClient(item: { name: string; code: string }) {
    return { name: item.name, ...(await measure(item.code)) };
  }
  function measureAll() {
    const measuring = [];
    for (const item of output?.modules ?? []) {
      if (item.client) {
        measuring.push(measureClient(item));
      }
    }
    return Promise.all(measuring);
  }
  const sizes = $memo(measureAll());
  function countErrors(): number {
    let count = 0;
    for (const log of logs) {
      if (log.level === 'error') {
        count++;
      }
    }
    return count;
  }
  const errors = $memo(countErrors());
  function numberLines(): string {
    const numbers: number[] = [];
    const total = (files[active]?.source ?? '').split('\n').length;
    for (let index = 0; index < total; index++) {
      numbers.push(index + 1);
    }
    return numbers.join('\n');
  }
  const lines = $memo(numberLines());
  /** Moves the divider between the panes to a pointer, in percent of their width. */
  function moveSplit(clientX: number) {
    const box = panes!.getBoundingClientRect();
    split = Math.min(78, Math.max(22, ((clientX - box.left) / box.width) * 100));
  }

  /** Sets the source of the open file. */
  function edit(source: string) {
    const next = [...files];
    next[active] = { ...next[active]!, source };
    files = next;
  }

  function open(next: ReplFile[]) {
    files = next;
    active = 0;
  }

  /** Adds a file with a start that runs, for its kind. */
  function addFile() {
    const name = draftName.trim();
    const names: string[] = [];
    for (const file of files) {
      names.push(file.name);
    }
    const problem = validName(name, names);
    if (problem) {
      nameError = problem;
      return;
    }
    const source = name.endsWith('.brm.ts')
      ? `import { $signal } from 'brumate/signals';\n\nexport function use() {\n  let value = $signal(0);\n  return { value };\n}\n`
      : name.endsWith('.ts')
        ? `export const value = 1;\n`
        : `<p>${name}</p>\n`;
    files = [...files, { name, source }];
    active = files.length - 1;
    adding = false;
    draftName = '';
    nameError = '';
  }

  function removeFile(index: number) {
    const kept: ReplFile[] = [];
    for (const [at, file] of files.entries()) {
      if (at !== index) {
        kept.push(file);
      }
    }
    files = kept;
    if (active >= index) {
      active = Math.max(0, active - 1);
    }
  }

  async function run(again = false) {
    if (!again && files === ranWith) {
      return;
    }
    ranWith = files;
    // Only the latest run writes its result, so an older run that finishes later is dropped.
    runs++;
    const id = runs;
    running = true;
    logs = [];
    try {
      const { runSample } = await import('../live/run.ts');
      const next = await runSample(result!, files, () => id === runs);
      if (id === runs) {
        output = next;
        error = '';
      }
    } catch (caught) {
      if (id === runs) {
        error = caught instanceof Error ? caught.message : String(caught);
      }
    }
    if (id === runs) {
      running = false;
    }
  }

  async function share() {
    // The address gets the files after a pause in typing, so the link is made from them here.
    history.replaceState(history.state, '', `#${encode(files)}`);
    try {
      await navigator.clipboard.writeText(location.href);
    } catch {
      // The browser can refuse the clipboard. The link is still in the address bar.
      return;
    }
    copied = true;
    setTimeout(() => (copied = false), 1500);
  }

  // The console of the page shows in the REPL, with the errors that nothing caught.
  $client(() => {
    let count = 0;
    function text(value: unknown): string {
      if (typeof value === 'string') {
        return value;
      }
      if (value instanceof Error) {
        return `${value.name}: ${value.message}`;
      }
      try {
        return JSON.stringify(value) ?? String(value);
      } catch {
        return String(value);
      }
    }
    function push(level: string, values: unknown[]) {
      count++;
      const texts: string[] = [];
      for (const value of values) {
        texts.push(text(value));
      }
      logs = [...$untrack(logs), { id: count, level, text: texts.join(' ') }].slice(-200);
    }
    const levels = ['log', 'info', 'warn', 'error'] as const;
    const originals: (typeof console)[(typeof levels)[number]][] = [];
    for (const level of levels) {
      originals.push(console[level]);
    }
    for (const [index, level] of levels.entries()) {
      const original = originals[index]!.bind(console);
      console[level] = (...values: unknown[]) => {
        push(level, values);
        original(...values);
      };
    }
    function onError(event: ErrorEvent) {
      push('error', [event.error ?? event.message]);
    }
    function onRejection(event: PromiseRejectionEvent) {
      push('error', [event.reason]);
    }
    addEventListener('error', onError);
    addEventListener('unhandledrejection', onRejection);

    // A shared link opens its files.
    const shared = decode(location.hash.slice(1));
    if (shared) {
      open(shared);
    }
    ready = true;
    void run();

    // Leaving the REPL gives the console back.
    return () => {
      for (const [index, level] of levels.entries()) {
        console[level] = originals[index]!;
      }
      removeEventListener('error', onError);
      removeEventListener('unhandledrejection', onRejection);
    };
  }, 'load');

  // An edit runs the files again, once typing pauses, and keeps them in the address.
  // The effect reads only `files`: `run` reads and writes other values, which must not run it again.
  $effect(() => {
    const current = files;
    const timer = setTimeout(() => {
      if (current === $untrack(files) && $untrack(ready)) {
        history.replaceState(history.state, '', `#${encode(current)}`);
        void $untrack(run());
      }
    }, 400);
    return () => clearTimeout(timer);
  });

</script>

#head {
  <title>REPL | brumate</title>
}

<Meta
  title="REPL | brumate"
  description="Write brumate components and run them in your browser. See the page they render, the code they compile to, and what the browser loads."
  path="repl"
/>
<main class="repl" style={ '--split': `${split}%` }>
  <header class="repl-bar">
    <div class="repl-title">
      <h1>REPL</h1>
      <span role="status" class={ status: true, running, failed: !running && Boolean(error) }>
        <i aria-hidden="true"></i>{running ? 'Running' : error ? 'Error' : 'Ready'}
      </span>
    </div>
    <label class="repl-example">
      <span>Example</span>
      <select onChange=((event) => open(examples[Number(event.currentTarget.value)]!.files))>
        #for (example, index of examples by example.name) {
          <option value=index>{example.name}</option>
        }
      </select>
    </label>
    <p class="repl-note">The compiler and the server runtime run in your browser.</p>
    <button class="repl-button" type="button" onClick=share>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 9.5 9.5 6.5M7 4.5l1-1a2.8 2.8 0 0 1 4 4l-1 1M9 11.5l-1 1a2.8 2.8 0 0 1-4-4l1-1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      {copied ? 'Copied' : 'Copy link'}
    </button>
  </header>
  <div class={ 'repl-panes': true, dragging } ref=$bind(panes)>
    <section class="pane repl-source" aria-label="Files">
      <div class="pane-bar repl-files" role="group" aria-label="Files">
        #for (file, index of files by file.name) {
          <span class={ 'repl-file': true, active: index === active }>
            <button aria-current=(index === active ? 'true' : undefined) onClick=(() => (active = index))>
              <i class={ 'file-kind': true, ts: !file.name.endsWith('.brm') } aria-hidden="true"></i>{file.name}
            </button>
            #if (index > 0) {
              <button class="repl-remove" aria-label=(`Remove ${file.name}`) onClick=(() => removeFile(index))><Icon name="close" size=(12) /></button>
            }
          </span>
        }
        #if (adding) {
          <form class="repl-add" onSubmit=(prevent(addFile))>
            <input
              ref=$bind(nameInput)
              aria-label="File name"
              placeholder="Name.brm"
              value=draftName
              onInput=((event) => {
                draftName = event.currentTarget.value;
                nameError = '';
              })
              onKeyDown=((event) => {
                if (event.key === 'Escape') {
                  adding = false;
                }
              })
            >
          </form>
        } #else {
          <button class="repl-new" aria-label="Add a file" title="Add a file" onClick=(() => (adding = true))>+</button>
        }
      </div>
      #if (nameError) {
        <p class="repl-name-error">{nameError}</p>
      }
      <div class="editor">
        <pre class="gutter" ref=$bind(gutter) aria-hidden="true">{lines}</pre>
        <div class="editor-body">
          <div class="editor-backdrop code" ref=$bind(backdrop) aria-hidden="true">{sourceHtml}</div>
          <textarea
            aria-label=(`Source of ${files[active]?.name}`)
            spellcheck="false"
            value=(files[active]?.source ?? '')
            onInput=((event) => edit(event.currentTarget.value))
            onKeyDown=((event) => {
              if (event.key !== 'Tab' || event.shiftKey) {
                return;
              }
              event.preventDefault();
              const area = event.currentTarget;
              area.setRangeText('  ', area.selectionStart, area.selectionEnd, 'end');
              edit(area.value);
            })
            onScroll=((event) => {
              backdrop!.scrollTop = event.currentTarget.scrollTop;
              backdrop!.scrollLeft = event.currentTarget.scrollLeft;
              gutter!.scrollTop = event.currentTarget.scrollTop;
            })
          >{$untrack(files[0]!.source)}</textarea>
        </div>
      </div>
    </section>
    <div
      class="splitter"
      role="separator"
      aria-orientation="vertical"
      aria-label="Resize the panes"
      aria-valuenow=(Math.round(split))
      aria-valuemin="22"
      aria-valuemax="78"
      tabindex="0"
      onPointerDown=((event) => {
        event.currentTarget.setPointerCapture(event.pointerId);
        dragging = true;
      })
      onPointerMove=((event) => {
        if (dragging) {
          moveSplit(event.clientX);
        }
      })
      onPointerUp=(() => (dragging = false))
      onPointerCancel=(() => (dragging = false))
      onLostPointerCapture=(() => (dragging = false))
      onKeyDown=((event) => {
        if (event.key === 'ArrowLeft') {
          split = Math.max(22, split - 4);
        } else if (event.key === 'ArrowRight') {
          split = Math.min(78, split + 4);
        }
      })
    ></div>
    <section class="pane output" aria-label="Output">
      <div class="pane-bar">
        <div class="views" role="tablist">
          <button role="tab" aria-selected=(view === 'result') onClick=(() => (view = 'result'))>Preview</button>
          <button role="tab" aria-selected=(view === 'compiled') onClick=(() => (view = 'compiled'))>Compiled</button>
          <button role="tab" aria-selected=(view === 'ships') onClick=(() => (view = 'ships'))>What ships</button>
          <button role="tab" aria-selected=(view === 'console') onClick=(() => (view = 'console'))>
            Console
            #if (logs.length > 0) {
              <span class={ 'repl-count': true, bad: errors > 0 }>{logs.length}</span>
            }
          </button>
        </div>
        #if (view === 'result') {
          <div class="tools">
            <div class="segment" role="group" aria-label="Width">
              <button type="button" aria-pressed=(width === '') title="Fill the pane" onClick=(() => (width = ''))>Fill</button>
              <button type="button" aria-pressed=(width === '390') title="Phone, 390 px" onClick=(() => (width = '390'))>390</button>
              <button type="button" aria-pressed=(width === '768') title="Tablet, 768 px" onClick=(() => (width = '768'))>768</button>
            </div>
            <div class="segment" role="group" aria-label="Background">
              <button type="button" aria-pressed=(canvas === 'dots') onClick=(() => (canvas = 'dots'))>Dots</button>
              <button type="button" aria-pressed=(canvas === 'plain') onClick=(() => (canvas = 'plain'))>Plain</button>
            </div>
            <button class="tool" type="button" title="Run again" aria-label="Run again" onClick=(() => run(true))>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          </div>
        }
      </div>
      <div class={ preview: true, hidden: view !== 'result' }>
        <div class=(`canvas ${canvas}`)>
          #if (error) {
            <div class="error-card" role="alert">
              <div class="eyebrow">The files do not run</div>
              <pre>{error}</pre>
            </div>
          }
          <div class={ device: true, hidden: Boolean(error) } style={ width: width ? `${width}px` : '100%' }>
            <div class="repl-result" ref=$bind(result)>
              <p class="repl-note">The files run once the page loads.</p>
            </div>
          </div>
          #if (width) {
            <span class="size">{width} px</span>
          }
        </div>
      </div>
      #if (view === 'compiled' && output) {
        <div class="repl-compiled">
          <div class="sub-bar">
            <select aria-label="Module" onChange=((event) => (shown = event.currentTarget.value))>
              #for (item of output.modules by item.name) {
                <option value=(item.name) selected=(item.name === module?.name)>{item.name}</option>
              }
            </select>
            <span class={ chip: true, client: module?.client }>{module?.client ? 'Browser' : 'Server'}</span>
          </div>
          <div class="code output-code">{moduleHtml}</div>
        </div>
      }
      #if (view === 'ships') {
        #loading {
          <div class="ships">
            <div class="ships-total">
              <strong>{sizes.reduce((sum, size) => sum + size.gzip, 0).toLocaleString('en-US')} B</strong>
              <span>gzip, in {sizes.length} {sizes.length === 1 ? 'module' : 'modules'} that the browser can load</span>
            </div>
            <table class="sizes">
              <thead>
                <tr><th>Client module</th><th class="num">Bytes</th><th class="num">gzip</th><th></th></tr>
              </thead>
              <tbody>
                #for (size of sizes by size.name) {
                  <tr>
                    <td><code>{size.name}</code></td>
                    <td class="num">{size.bytes.toLocaleString('en-US')}</td>
                    <td class="num">{size.gzip.toLocaleString('en-US')}</td>
                    <td class="bar-cell"><span class="bar" style={ width: `${(size.gzip / Math.max(1, ...sizes.map((item) => item.gzip))) * 100}%` }></span></td>
                  </tr>
                }
              </tbody>
            </table>
            <p class="repl-note">
              The client entry and its parts load with the page, in the bundle of the page.
              The server code never reaches the browser.
            </p>
          </div>
        } #else {
          <p class="repl-note repl-pad">Measuring</p>
        }
      }
      #if (view === 'console') {
        <div class="repl-console-wrap">
          <div class="sub-bar">
            <span class="repl-note">{logs.length} {logs.length === 1 ? 'entry' : 'entries'}</span>
            <button class="tool" type="button" onClick=(() => (logs = []))>Clear</button>
          </div>
          <ol class="repl-console">
            #for (log of logs by log.id) {
              <li class=(`repl-log ${log.level}`)>{log.text}</li>
            } #else {
              <li class="repl-log empty">Nothing logged yet. Use console.log in a handler.</li>
            }
          </ol>
        </div>
      }
      #if (output && output.warnings.length > 0) {
        <ul class="warnings">
          #for (warning of output.warnings by warning) {
            <li>{warning}</li>
          }
        </ul>
      }
    </section>
  </div>
</main>

<style>
  /* The REPL fills the page under the header: a bar, then the files and the output side by side. */

  .repl {
    --split: 50%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: calc(100vh - var(--header-height));
    min-height: 32rem;
  }

  .repl button,
  .repl select,
  .repl input,
  .repl textarea {
    font: inherit;
    color: inherit;
  }

  .repl-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.4rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .repl-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .repl-title h1 {
    margin: 0;
    font-size: 0.95rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--surface-strong);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .status i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--success);
  }

  .status.running i {
    background: var(--accent);
    animation: pulse 0.9s ease-in-out infinite alternate;
  }

  .status.failed {
    color: var(--danger);
  }

  .status.failed i {
    background: var(--danger);
  }

  @keyframes pulse {
    to {
      opacity: 0.3;
    }
  }

  .repl-example {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .repl select {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    font-size: 0.85rem;
  }

  .repl-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .repl .repl-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--bg);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .repl .repl-button:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .repl-button svg,
  .tool svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .repl-panes {
    display: grid;
    grid-template-columns: minmax(0, var(--split)) 6px minmax(0, 1fr);
    min-height: 0;
  }

  .repl-panes.dragging {
    cursor: col-resize;
    user-select: none;
  }

  .pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--code-bg);
  }

  .pane-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .splitter {
    background: var(--border);
    cursor: col-resize;
    touch-action: none;
    transition: background 0.15s;
  }

  .splitter:hover,
  .splitter:focus-visible,
  .dragging .splitter {
    background: var(--accent);
    outline: none;
  }

  /* Files */

  .repl-file {
    display: inline-flex;
    align-items: center;
    border-radius: 7px;
  }

  .repl-file button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    font: 0.8rem var(--mono);
    cursor: pointer;
  }

  .repl-file:hover {
    background: var(--surface-strong);
  }

  .repl-file.active {
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .repl-file.active button {
    color: var(--text);
  }

  .file-kind {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 2px;
    background: var(--accent);
  }

  .file-kind.ts {
    background: #3178c6;
  }

  .repl-file .repl-remove {
    padding: 0.3rem 0.45rem 0.3rem 0;
    opacity: 0.6;
  }

  .repl-file .repl-remove:hover {
    color: var(--danger);
    opacity: 1;
  }

  .repl-new {
    width: 1.75rem;
    height: 1.75rem;
    border: 1px dashed var(--border);
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .repl-new:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .repl-add input {
    width: 9rem;
