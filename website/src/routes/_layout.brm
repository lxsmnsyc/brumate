<script>
  import { $memo, $props, $route } from 'brumate/signals';
  import { raw } from 'brumate/html';
  import Header from '../components/Header.brm';
  import { NETWORK_SCRIPT, THEME_SCRIPT } from '../scripts.ts';
  import { STYLES } from '../theme.ts';

  const { children } = $props();
  const route = $route();
  // The pages of @brumate/ui are a section of their own, with their own header.
  const section = $memo(
    route.url.pathname.startsWith(`${import.meta.env.BASE_URL}ui`) ? 'ui' : 'docs',
  );
  const base = import.meta.env.BASE_URL;
</script>

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href=(`${base}logo.svg`)>
    <link rel="apple-touch-icon" href=(`${base}apple-touch-icon.png`)>
    {raw(THEME_SCRIPT)}
    {raw(NETWORK_SCRIPT)}
    {raw(STYLES)}
  </head>
  <body>
    <Header {section} />
    {children}
    <footer class="footer">
      <p>MIT licensed. Built with brumate: this page loaded no component code until you used it.</p>
    </footer>
  </body>
</html>

<style>
  .footer {
    padding: 2rem 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
    text-align: center;
  }
</style>
