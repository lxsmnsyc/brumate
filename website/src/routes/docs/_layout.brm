<script>
  import { $effect, $props, $route, $signal } from 'brumate/signals';
  import { sections } from '../../docs.ts';

  // The sidebar of the docs is in a layout, so it stays when a link loads another page,
  // with its scroll position.
  const { children } = $props();
  const route = $route();
  const base = import.meta.env.BASE_URL;
  const link = (target: string): string => `${base}docs${target ? `/${target}` : ''}`;
  let menu = $signal<HTMLDetailsElement>();

  /** The page of the docs at a path, such as `routing` for `/docs/routing`. */
  const slugOf = (pathname: string): string =>
    pathname
      .slice(`${base}docs`.length)
      .replace(/^\/|\/$/g, '');

  // On a narrow screen the menu closes when a link loads another page.
  $effect(() => {
    void route.url.pathname;
    if (menu) {
      menu.open = false;
    }
  });
</script>

<div class="docs">
  <details class="sidebar-toggle" ref=menu>
    <summary>Menu</summary>
  </details>
  <nav class="sidebar" aria-label="Documentation">
    #for (section of sections by section.title) {
      <p class="sidebar-title">{section.title}</p>
      #for (item of section.pages by item.slug) {
        <a
          href=(link(item.slug))
          class={ active: item.slug === slugOf(route.url.pathname) }
          aria-current=(item.slug === slugOf(route.url.pathname) ? 'page' : undefined)
        >{item.title}</a>
      }
    }
  </nav>
  {children}
</div>
