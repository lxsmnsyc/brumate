<script>
  import { setStatus } from 'brumate/server';
  import DocPage from '../../components/DocPage.brm';
  import { pages } from '../../docs.ts';

  const { params } = $props<{ params: { page: string } }>();
  if (!(params.page in pages)) {
    setStatus(404);
  }
</script>

<DocPage slug=(params.page) />
